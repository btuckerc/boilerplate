# macOS
.DS_Store

# Backups
*.bak*
*.backup.*
# ...but not the restic backup job's launchd template, whose name only looks like a backup.
!home/dot_local/share/decent-angl/launchd/com.decentangl.restic.backup.plist.tmpl

# Neovim
lazy-lock.json
home/dot_config/nvim.backup.*

# mise
.mise.*.lock
mise.local.toml
home/dot_config/mise/mise.local.toml
home/dot_config/mise/.optional-tools-prompted

# brew
Brewfile.local
home/Brewfile.local
.config/.brewfile-optional-prompted

# Chezmoi (state is managed per-user, not in repo)
home/.chezmoistate

# Temp files
*.tmp
*.log
# ...but not eval case inputs.
!utils/omp-context-eval/cases/*/*.log
__pycache__/
*.pyc

# Planning documents (untracked)
PLAN.md

.env

# OMP runtime/auth state is per-machine and must not be committed.
home/private_dot_omp/private_agent/agent.db*
home/private_dot_omp/private_agent/sessions/
home/private_dot_omp/private_agent/logs/
home/private_dot_omp/private_agent/*.log

# Generated Rust build output for the shared iMessage TUI.
home/dot_local/share/decent-angl/imsg/tui/target/
# Cwd-local OMP boards are working state, not published config.
docs/board/
docs/board.md
