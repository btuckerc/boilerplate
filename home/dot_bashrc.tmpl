#!/bin/bash
# Managed by chezmoi - https://github.com/btuckerc/boilerplate
# Bash configuration file

# Source shared POSIX-compatible configuration
COMMON_SH="${XDG_CONFIG_HOME:-$HOME/.config}/shell/common.sh"
[ -f "$COMMON_SH" ] && . "$COMMON_SH"
unset COMMON_SH

# Safe fallback if common.sh is temporarily missing
export LOGFILE="${LOGFILE:-$HOME/.shellrc_log}"
declare -F _shell_cached_init >/dev/null || _shell_cached_init() { return 1; }

# Load Ghostty's shell integration early so nested shells keep prompt marks.
if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ] && [ -r "${GHOSTTY_RESOURCES_DIR}/shell-integration/bash/ghostty.bash" ]; then
    builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/bash/ghostty.bash"
fi

# === Bash-Specific Configuration ===

{{- if eq .chezmoi.os "darwin" }}
# === macOS-specific Configuration ===

# Silence bash deprecation warning (macOS prefers zsh)
export BASH_SILENCE_DEPRECATION_WARNING=1

# Load Homebrew: inline `brew shellenv bash` output for the fixed /opt/homebrew
# prefix, including its no-op guard. Spawning brew costs ~70 ms per shell.
# Re-sync if `PATH=/usr/bin:/bin brew shellenv bash` output ever changes, but keep
# ${PATH:+…}: brew's ${PATH+…} turns an empty PATH into a current-directory entry.
if [ -x /opt/homebrew/bin/brew ] && [[ "$PATH:" != "/opt/homebrew/bin:/opt/homebrew/sbin:"* ]]; then
    export HOMEBREW_PREFIX="/opt/homebrew"
    export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
    export HOMEBREW_REPOSITORY="/opt/homebrew"
    export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH:+:$PATH}"
    [ -z "${MANPATH-}" ] || { export MANPATH="${MANPATH%"${MANPATH##*[!:]}"}"; export MANPATH=":${MANPATH#"${MANPATH%%[!:]*}"}"; }
    export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
fi
{{- else if eq .chezmoi.os "linux" }}
# === Linux-specific Configuration ===

# Load Homebrew if installed (Linuxbrew)
# Commented out - not available on this system
# [ -d "/home/linuxbrew/.linuxbrew" ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Enable color support for ls
alias ls='ls --color=auto'

# Add Ruby gems to PATH (for user-installed gems)
export PATH="${PATH:+$PATH:}$HOME/.local/share/gem/ruby/3.4.0/bin"

# Tmux session helper - attach to or create session named 'T'
t() {
    if [[ -z $TMUX ]]; then
        if tmux has-session -t T 2>/dev/null; then
            tmux attach-session -t T
        else
            tmux new-session -s T
        fi
    fi
}
{{- end }}

# === Mise activation ===
if command -v mise >/dev/null; then
    eval "$(mise activate bash)"
fi

# mise can restore a PATH captured before an Omarchy generation upgrade.
if command -v remove_path_dir >/dev/null 2>&1; then
    remove_path_dir "$HOME/.local/share/omarchy/bin"
    unset -f remove_path_dir 2>/dev/null || true
    unset path_entry path_new path_rest path_sep
fi

# Tool init runs after mise so it resolves the real binaries instead of the
# mise shims (each shim exec costs a mise startup, including every prompt).
# zoxide bakes _ZO_ECHO/_ZO_RESOLVE_SYMLINKS (true only when "1") into its init.
_zo_variant=bash
[ "${_ZO_ECHO-}" = 1 ] && _zo_variant=$_zo_variant.echo
[ "${_ZO_RESOLVE_SYMLINKS-}" = 1 ] && _zo_variant=$_zo_variant.resolve
if _shell_cached_init "$_zo_variant" zoxide init bash &&
    . "$_shell_init_file" && [ "$_shell_init_ok" = 1 ]; then
    :
else
    [ -n "${_shell_init_file-}" ] && rm -f -- "$_shell_init_file"
    command -v zoxide >/dev/null && eval "$(zoxide init bash)"
fi
unset _zo_variant _shell_init_ok

# Skip prompt/UI shell setup for non-interactive or TERM=dumb shells.
# This keeps batch/login shells like `bash -lc` quiet for tools.
case "$-" in
    *i*) ;;
    *) return 0 2>/dev/null || true ;;
esac
{{- if eq .chezmoi.os "linux" }}

# Load bash completion if available (interactive shells only)
if [ -r "/usr/share/bash-completion/bash_completion" ]; then
    . "/usr/share/bash-completion/bash_completion"
fi
{{- end }}

if [ "${TERM:-}" = "dumb" ]; then
    return 0 2>/dev/null || true
fi

# === Starship prompt ===
if command -v starship >/dev/null; then
    export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
    if _shell_cached_init bash starship init bash --print-full-init &&
        . "$_shell_init_file" && [ "$_shell_init_ok" = 1 ]; then
        :
    else
        [ -n "${_shell_init_file-}" ] && rm -f -- "$_shell_init_file"
        eval "$(starship init bash)"
    fi
    unset _shell_init_ok
fi

# === Bash Options ===
for bash_opt in \
    checkwinsize \
    histappend \
    cmdhist \
    lithist \
    autocd \
    globstar \
    nocaseglob \
    cdspell \
    dirspell
do
    shopt -s "$bash_opt" 2>/dev/null || true
done
unset bash_opt

# === History Configuration ===
export HISTFILESIZE=1000000   # Increased from 10000 (match zsh)
export HISTSIZE=100000        # Increased from 5000 (closer to zsh)
export HISTCONTROL=ignoreboth:erasedups  # Ignore dupes and spaces, erase old dupes
export HISTTIMEFORMAT="%F %T "
history_sync_prompt='history -a; history -c; history -r'
if [ -n "${PROMPT_COMMAND:-}" ]; then
    case "$PROMPT_COMMAND" in
        "$history_sync_prompt"|"$history_sync_prompt; "*|*"; $history_sync_prompt"|*"; $history_sync_prompt; "*) ;;
        *)
            PROMPT_COMMAND="$history_sync_prompt; $PROMPT_COMMAND"
            ;;
    esac
else
    PROMPT_COMMAND="$history_sync_prompt"
fi
export PROMPT_COMMAND
unset history_sync_prompt

# === Bash-specific Functions ===

# Yazi wrapper (bash-specific for cd functionality)
y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    local cwd
    yazi "$@" --cwd-file="$tmp"
    cwd="$(command cat -- "$tmp")"
    if [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
        if [ -n "$TMUX" ]; then
            tmux refresh-client -c "$cwd"
        fi
    fi
    rm -f -- "$tmp"
}

# Logging
if [ "${BASH_VERSINFO[0]:-0}" -ge 5 ]; then
    printf '%(%a %b %e %H:%M:%S %Z %Y)T: Bash shell loaded\n' -1 >>"$LOGFILE" 2>/dev/null || true
else
    printf '%s: Bash shell loaded\n' "$(date)" >>"$LOGFILE" 2>/dev/null || true
fi
