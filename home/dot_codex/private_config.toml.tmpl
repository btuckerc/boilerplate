# Managed by chezmoi. Edit the source tree, not ~/.codex directly.
#
# Keep this file portable. Codex runtime state such as auth, project trust,
# plugin installs, marketplaces, and local model preferences stays on the
# machine and is preserved across broad chezmoi applies.
{{- $localCore := (output "sh" "-c" "config=\"$HOME/.codex/config.toml\"; if [ -f \"$config\" ]; then awk '/^(model|model_reasoning_effort|service_tier|commit_attribution|notify) =/ { print }' \"$config\"; else printf '%s\n' 'model = \"gpt-5.4\"' 'model_reasoning_effort = \"xhigh\"' 'service_tier = \"fast\"' 'commit_attribution = \"\"'; fi") | trim }}
{{- $localTrust := (output "sh" "-c" "config=\"$HOME/.codex/config.toml\"; if [ -f \"$config\" ]; then awk 'BEGIN { printing = 0 } /^\\[projects\\./ { printing = 1 } printing && /^\\[/ && $0 !~ /^\\[projects\\./ { printing = 0 } printing { print }' \"$config\"; fi") | trim }}
{{- $localPlugins := (output "sh" "-c" "config=\"$HOME/.codex/config.toml\"; if [ -f \"$config\" ]; then awk 'BEGIN { printing = 0 } /^\\[plugins\\./ { printing = 1 } printing && /^\\[/ && $0 !~ /^\\[plugins\\./ { printing = 0 } printing { print }' \"$config\"; fi") | trim }}
{{- $localMarketplaces := (output "sh" "-c" "config=\"$HOME/.codex/config.toml\"; if [ -f \"$config\" ]; then awk 'BEGIN { printing = 0 } /^\\[marketplaces\\./ { printing = 1 } printing && /^\\[/ && $0 !~ /^\\[marketplaces\\./ { printing = 0 } printing { print }' \"$config\"; fi") | trim }}

{{ $localCore }}
{{ if ne $localPlugins "" }}

{{ $localPlugins }}
{{ else }}

[plugins."github@openai-curated"]
enabled = true
{{ end }}
{{ if ne $localTrust "" }}

{{ $localTrust }}
{{ end }}
{{ if ne $localMarketplaces "" }}

{{ $localMarketplaces }}
{{ end }}

[tui]
status_line = ["model-name", "five-hour-limit", "weekly-limit", "used-tokens", "fast-mode"]
theme = "dracula"
# Prefer non-intrusive notifications over focus-stealing prompts.
notifications = ["agent-turn-complete", "user-input-requested", "approval-requested", "plan-mode-prompt"]
notification_condition = "unfocused"
