#!/usr/bin/env bash

# Detect an Omarchy upgrade that has outgrown the portable desktop contract.
# Omarchy's hook runner reports failures but intentionally continues updating,
# so persist the result where it survives the terminal and the next reboot.

set -uo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/decent-angl"
marker="$state_dir/omarchy-compatibility-blocked"
validator="$HOME/.local/bin/omarchy-roaming-sync"

mkdir -p "$state_dir"
overlay_bin="$HOME/.local/bin/omarchy-shell-overlay"
if [[ -x "$overlay_bin" ]]; then
  # Rebuild the runtime overlay now so the post-update shell restart keeps
  # matching files and mergeable customizations. Conflicts stay packaged for
  # that path only and are announced separately from the baseline alert.
  "$overlay_bin" sync-runtime >/dev/null 2>&1 || true
  if grep -q '^SKIP ' "$state_dir/omarchy-shell-overlay.drift" 2>/dev/null \
    && [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] \
    && command -v notify-send >/dev/null 2>&1; then
    skipped="$(awk '/^SKIP / { print $2 }' "$state_dir/omarchy-shell-overlay.drift" | paste -sd, -)"
    notify-send --urgency=normal --app-name=Omarchy \
      "Shell overlay partial" \
      "Packaged QML for: ${skipped}. Other overlay files still apply."
  fi
fi

if [[ ! -x "$validator" ]]; then
  output="Missing executable validator: $validator"
  status=127
else
  # Omarchy/package transitions must not leave OpenSSH rejecting its global
  # client config. This is idempotent and requires configured passwordless sudo.
  "$validator" repair-ssh >/dev/null 2>&1 || true
fi

if [[ -x "$validator" ]] && output="$($validator validate 2>&1)"; then
  rm -f "$marker"
  logger -t decent-angl-omarchy "Post-update compatibility validation passed" >/dev/null 2>&1 || true
  exit 0
elif [[ -x "$validator" ]]; then
  status=$?
fi

{
  printf 'Omarchy compatibility validation failed after an update.\n'
  printf 'Do not treat the portable desktop baseline as safe to reapply.\n'
  printf 'Update the generation contract, then run: omarchy-roaming-sync validate --strict\n\n'
  printf '%s\n' "$output"
} >"$marker"

printf '\n*** OMARCHY PORTABLE BASELINE NEEDS ATTENTION ***\n' >&2
printf 'Compatibility validation failed; details are in %s\n' "$marker" >&2
printf '%s\n\n' "$output" >&2
logger -t decent-angl-omarchy -p user.err "Post-update compatibility validation failed; see $marker" >/dev/null 2>&1 || true

if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v notify-send >/dev/null 2>&1; then
  notify-send --urgency=critical --app-name=Omarchy \
    "Portable baseline needs attention" \
    "Compatibility validation failed after the update. See $marker."
fi

exit "$status"
