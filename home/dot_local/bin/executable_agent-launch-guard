#!/usr/bin/env python3
"""Claude Code PreToolUse hook: agent-run launches must notify the session.

A launch only wakes the director when it is its own Bash call with
run_in_background. Detached launches (`&`, nohup, setsid, disown) and
foreground calls finish without a notification, and launches in a loop or
several per call run one after another. Exit 2 rejects the call and shows the
reason to the model. A heuristic over shell text, not a parser: it aims at the
shapes directors write, and ignores quoted text (except $(...) in double quotes),
heredoc bodies and comments, so launches wrapped in `sh -c '...'`, eval, xargs,
`find -exec` or parallel, or behind prefixes with option values (`nice -n 5`),
go unseen.
"""
import json
import re
import sys

# Text that is data, not commands.
HEREDOC = re.compile(r"(?<!<)<<-?(?!<)[ \t]*(['\"]?)([\w.-]+)\1([^\n]*)\n(?:.*?\n)?[ \t]*\2[ \t]*(?=\n|$)", re.S)
QUOTED_OR_COMMENT = re.compile(r"'[^']*'|\"(?:\\.|[^\"\\])*\"|(?:^|(?<=\s))#[^\n]*", re.M)
SUBSTITUTION = re.compile(r"\$\([^()]*\)|`[^`]*`")  # still runs inside double quotes
# Where a command starts: after a separator or keyword, then wrappers and VAR=value assignments in
# any order. Token shapes are disjoint (options start with -, durations with a digit), so no backtracking blowup.
START = (r"(?:^|[;&|(){}`\n!]|\$\()\s*(?:(?:do|then|else|elif|if|while|until|!)\s+)*"
         r"(?:(?:(?:\S*/)?(?:exec|time|nice|nohup|setsid|env)(?:\s+-[^\s\d]\S*)*"
         r"|(?:\S*/)?timeout(?:\s+-\S+)*\s+\d\S*|[A-Za-z_]\w*=\S*)\s+)*")
LAUNCH = re.compile(START + r"(?:\S*/)?agent-run((?:\s+--?[\w-]+)*)\s+(?:sol|ask|audit|local)\b((?:[^;&|\n)`$]|\$(?!\())*)")
LOOP_WORD = re.compile(START + r"(for|while|until|select|done)\b")
HELP = re.compile(r"(?:^|\s)(?:-h|--help)(?=\s|$)")
WRAPPER = re.compile(r"(?<![\w.=-])(?:nohup|setsid)(?![\w.=-])")  # in a launch's own prefix
DISOWN = re.compile(r"(?:^|[;&|\n])\s*disown\b")
# `&` that does not background: &&, >&, &>, |&, <& (fd duplication and redirection).
NOT_BACKGROUND = re.compile(r"&&|[0-9]*[<>]&[0-9-]*|&>>?|\|&")


def unwrap_substitutions(text):
    """Drop the quotes around "$(...)": it runs, and its own quoted arguments must stay balanced."""
    closes, stack = {}, []
    for j, c in enumerate(text):  # one pass: each "(" to its ")"
        if c == "(":
            stack.append(j)
        elif c == ")" and stack:
            closes[stack.pop()] = j
    out = list(text)
    for m in re.finditer(r'"\$\(', text):
        j = closes.get(m.start() + 2)
        if j is not None and text[j + 1:j + 2] == '"':
            out[m.start()] = out[j + 1] = " "
    return "".join(out)


def problem(tool_input):
    def unquote(m):  # one pass, so a quote inside a comment opens nothing
        if m.group().startswith("#"):
            return ""
        if re.fullmatch(r"\S*agent-run", m.group()[1:-1]):  # a quoted executable path
            return "agent-run"
        if m.group().startswith("'"):
            return "''"
        return " ".join(SUBSTITUTION.findall(m.group())) or "''"  # $(...) still runs in double quotes
    command = tool_input.get("command")
    if not isinstance(command, str):
        return None
    text = HEREDOC.sub(r"<<H\3", command.replace("\\\n", " "))
    text = unwrap_substitutions(text)
    text = QUOTED_OR_COMMENT.sub(unquote, text)
    launches = [m for m in LAUNCH.finditer(text) if not HELP.search(m.group(1) + " " + m.group(2))]
    if not launches:
        return None
    depth, looped = 0, False
    events = sorted([(m.start(1), m.group(1)) for m in LOOP_WORD.finditer(text)] + [(text.index("agent-run", m.start()), "launch") for m in launches])
    for _, word in events:
        if word in {"for", "while", "until", "select"}:
            depth += 1
        elif word == "done":
            depth = max(depth - 1, 0)
        elif depth:
            looped = True
    if len(launches) > 1 or looped:
        return "one agent-run launch per Bash call; send several calls in one message so they run in parallel"
    prefix = text[launches[0].start():text.index("agent-run", launches[0].start())]
    if WRAPPER.search(prefix) or DISOWN.search(text) or "&" in NOT_BACKGROUND.sub("", text):
        return "do not detach agent-run (&, nohup, setsid, disown): a detached run never notifies the session"
    if tool_input.get("run_in_background") is not True:
        return "launch agent-run with run_in_background: true so its completion wakes the session"
    return None


def main():
    try:
        event = json.load(sys.stdin)
        reason = problem(event.get("tool_input") or {}) if event.get("tool_name") == "Bash" else None
    except (ValueError, AttributeError):  # not a Bash tool event we understand: allow
        return 0
    if reason:
        print(f"agent-launch-guard: {reason}.", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
