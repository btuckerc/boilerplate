#!/usr/bin/env python3
"""Claude Code PreToolUse hook: agent-run launches must notify the session.

A launch only wakes the director when it is its own Bash call with
run_in_background. Detached launches (`&`, nohup, setsid, disown) and
foreground calls finish without a notification, and launches in a loop or
several per call run one after another. Exit 2 rejects the call and shows the
reason to the model. A heuristic over shell text, not a parser: it aims at the
shapes directors write, and ignores quoted text (except $(...) in double quotes),
heredoc bodies and comments, so launches wrapped in `sh -c '...'`, eval, xargs,
`find -exec` or parallel, or behind prefixes with option values (`nice -n 5`),
go unseen.
"""
import json
import re
import sys

# Text that is data, not commands.
HEREDOC = re.compile(r"(?<!<)<<-?(?!<)[ \t]*(['\"]?)([\w.-]+)\1([^\n]*)\n(?:.*?\n)?[ \t]*\2[ \t]*(?=\n|$)", re.S)
QUOTED_OR_COMMENT = re.compile(r"'[^']*'|\"(?:\\.|[^\"\\])*\"|(?:^|(?<=[\s;&|()]))#[^\n]*", re.M)
SUBSTITUTION = re.compile(r"(?<!\\)\$\((?:[^()]|\([^()]*\))*\)|(?<!\\)`[^`]*`")  # still runs inside double quotes
# Where a command starts: after a separator or keyword, then wrappers and VAR=value assignments in
# any order. Token shapes are disjoint (options start with -, durations with a digit), so no backtracking blowup.
W = r"[^\s;&|()`]*"  # the rest of one shell word
VALUE = r"(?:[^\s;&|()`$]|\$\([^()\n]*\)|\$(?!\())*"  # an assignment value, $(...) included
START = (r"(?:^|[;&|({`\n]|\$\()\s*(?:(?:do|then|else|elif|if|while|until|!)\s+)*"
         r"(?:(?:(?:" + W + r"/)?(?:exec|time|nice|nohup|setsid|env)(?:[ \t]+-[^\s\d;&|()`]" + W + r")*"
         r"|(?:" + W + r"/)?timeout(?:[ \t]+-" + W + r")*[ \t]+\d" + W + r"|[A-Za-z_]\w*=" + VALUE + r")[ \t]+)*")
LAUNCH = re.compile(START + r"(?P<exe>(?:" + W + r"/)?agent-run)((?:[ \t]+-[\w-]+)*)[ \t]+(?:sol|ask|audit|local)\b"
                    r"((?:[^;&|\n)`$]|\$(?!\())*)")
LOOP_WORD = re.compile(START + r"(for|while|until|select|done)\b")
HELP = re.compile(r"(?:^|\s)(?:-h|--help)(?=\s|$)")
DISOWN = re.compile(r"(?:^|[;&|(){}\n!]|\b(?:do|then|else|elif)\s)\s*disown\b")
# `&` that does not background: &&, >&, &>, |&, <& (fd duplication and redirection).
NOT_BACKGROUND = re.compile(r"&&|(?<![0-9])[0-9]*[<>]&[0-9-]*|&>>?|\|&")


def unquote(m):  # one pass over quotes and comments, so a quote inside a comment opens nothing
    if m.group().startswith("#"):
        return ""
    if re.fullmatch(r"(?:[^'\"]*/)?agent-run", m.group()[1:-1]):  # a quoted executable path
        return "agent-run"
    if m.group().startswith("'"):
        return "''"
    return " ".join(SUBSTITUTION.findall(m.group())) or "''"  # $(...) still runs in double quotes


def substitution_spans(text):
    """Outermost $(...) spans, found with shell quoting in mind: single quotes and escapes hide parentheses,
    and a $(...) inside double quotes still runs."""
    spans, stack, i, n = [], [], 0, len(text)
    while i < n:
        c, top = text[i], stack[-1][0] if stack else None
        if c == "\\":
            i += 2
            continue
        if text.startswith("$(", i):
            stack.append(("sub", i + 2))
            i += 2
            continue
        if top == "dq":
            if c == '"':
                stack.pop()
        elif c == "'":
            j = text.find("'", i + 1)
            i = n if j < 0 else j
        elif c == '"':
            stack.append(("dq", i))
        elif c == "(":
            stack.append(("paren", i))
        elif c == ")":
            while stack and stack[-1][0] == "dq":
                stack.pop()
            if stack:
                kind, start = stack.pop()
                if kind == "sub" and not any(k == "sub" for k, _ in stack):
                    spans.append((start, i))
        i += 1
    return spans


def unquote_substitutions(text):
    """Strip quotes and comments inside each outermost $(...) first: it runs even within a double-quoted
    string, and its own quoted arguments would otherwise break that string's quoting."""
    for a, b in reversed(substitution_spans(text)):
        text = text[:a] + QUOTED_OR_COMMENT.sub(unquote, text[a:b]) + text[b:]
    return text


def problem(tool_input):
    command = tool_input.get("command")
    if not isinstance(command, str):
        return None
    text = HEREDOC.sub(r"<<H\3", command.replace("\\\n", ""))
    text = unquote_substitutions(text)
    text = QUOTED_OR_COMMENT.sub(unquote, text)
    def asks_for_help(m):  # -h/--help anywhere in that launch's own arguments, past any $(...)
        rest = re.split(r"[;&|\n`]", SUBSTITUTION.sub(" ", text[m.end():]), maxsplit=1)[0]
        return HELP.search(" ".join((m.group(2), m.group(3), rest)))
    launches = [m for m in LAUNCH.finditer(text) if not asks_for_help(m)]
    if not launches:
        return None
    depth, looped = 0, False
    events = sorted([(m.start(1), m.group(1)) for m in LOOP_WORD.finditer(text)] + [(m.start("exe"), "launch") for m in launches])
    for _, word in events:
        if word in {"for", "while", "until", "select"}:
            depth += 1
        elif word == "done":
            depth = max(depth - 1, 0)
        elif depth:
            looped = True
    if len(launches) > 1 or looped:
        return "one agent-run launch per Bash call; send several calls in one message so they run in parallel"
    prefix = text[launches[0].start():launches[0].start("exe")].split()  # wrappers and assignments
    wrapped = any(word.rsplit("/", 1)[-1] in {"nohup", "setsid"} for word in prefix if "=" not in word)
    if wrapped or DISOWN.search(text) or "&" in NOT_BACKGROUND.sub("", text):
        return "do not detach agent-run (&, nohup, setsid, disown): a detached run never notifies the session"
    if tool_input.get("run_in_background") is not True:
        return "launch agent-run with run_in_background: true so its completion wakes the session"
    return None


def main():
    try:
        event = json.load(sys.stdin)
        reason = problem(event.get("tool_input") or {}) if event.get("tool_name") == "Bash" else None
    except (ValueError, AttributeError, RecursionError):  # not a Bash tool event we understand: allow
        return 0
    if reason:
        print(f"agent-launch-guard: {reason}.", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
