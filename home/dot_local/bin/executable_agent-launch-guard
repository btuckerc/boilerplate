#!/usr/bin/env python3
"""PreToolUse hook (Claude Code and Antigravity CLI): agent-run launches must notify, and agy is Tucker's.

Antigravity's agy runs on Tucker's personal Google sign-in; Google bans agents from wrapping or
driving it. Any command that starts agy or antigravity is rejected unless it only asks for
--version, --help/-h, help or changelog (verified against agy 1.5.13 --help).

An agent-run launch only wakes the director when it is its own tool call (in Claude Code, a Bash
call with run_in_background). Detached launches (`&`, nohup, setsid, disown) and foreground Bash
calls finish without a notification, and launches in a loop or several per call run one after
another. Claude Code reads exit 2 + stderr; Antigravity CLI reads a JSON decision on stdout.
A lightweight near-linear heuristic over shell text, not a Bash parser: it aims at the shapes directors
write, while `~/.local/bin/agy` enforces the hard runtime boundary on agent session markers. It
ignores quoted command strings (except $(...) in double quotes), heredoc bodies and comments, so
launches inside `sh -c '...'`, `mise exec -c '...'`, `env -S '...'`, ANSI-C `$'...'` escapes,
deeply nested `$(...)` option values, eval, xargs, `find -exec`, parallel, prefixes with option
values (`nice -n 5`, `exec -a`), or variable indirection go unseen.
"""
from bisect import bisect_right
from collections import defaultdict
import json
import re
import sys

# Text that is data, not commands.
HEREDOC_HEAD = re.compile(r"(?<!<)<<-?(?!<)[ \t]*(?:'([^'\n]+)'|\"([^\"\n]+)\"|([^\s;&|()<>'\"\\]+))(?=[ \t;&|)<>\n]|$)")
QUOTED_OR_COMMENT = re.compile(r"\\[^\n]#?|'[^']*'|\"(?:\\.|[^\"\\])*\"|(?:^|(?<=[\s;&|()]))#[^\n]*", re.M)
SUBSTITUTION = re.compile(r"(?<!\\)\$\((?:[^()]|\([^()]*\))*\)|(?<!\\)`(?:\\.|[^`\\])*`")  # still runs inside double quotes
# Where a command starts: after a separator or keyword, then wrappers and VAR=value assignments in
# any order. Token shapes are disjoint (options start with -, durations with a digit, wrapper path
# prefixes cannot start with VAR= or - or contain <>), so matching stays linear O(n).
W = r"[^\s;&|()`<>]*"  # the rest of one shell word
P_WRAP = r"(?:(?![A-Za-z_]\w*=|-)[^\s;&|()`<>]*/)?"  # optional wrapper path prefix
P_EXE = r"(?:(?![A-Za-z_]\w*=)[^\s;&|()`<>]*/)?"  # optional target executable path prefix (allows /agy, /tmp/x=y/agy)
SUB_INLINE = r"\$\((?:[^()\n]|\([^()\n]*\))*\)"
VALUE = r"(?:[^\s;&|()`$<>]|" + SUB_INLINE + r"|\$(?!\())*"  # an assignment value, $(...) included
VALUE1 = r"(?:[^\s;&|()`$<>]|" + SUB_INLINE + r"|\$(?!\())+"  # non-empty value (e.g. env -u/--unset target)
START = (r"(?:^|[;({`\n]|(?<!>)\||(?<![<>])&(?!>)|\$\()[ \t]*(?:(?:do|then|else|elif|if|while|until|!)[ \t]+)*"
         r"(?:" + P_WRAP + r"(?:exec|time|nice|nohup|setsid)(?:[ \t]+-[^\s\d;&|()`<>]" + W + r")*(?:[ \t]+|(?=[<>]|&>))"
         r"|" + P_WRAP + r"env(?:[ \t]+(?:-u[ \t]+" + VALUE1 + r"|--unset(?:[ \t]+|=)" + VALUE1
         + r"|-(?=[ \t<>]|&>)|-(?!u(?=[ \t])|-unset(?:[ \t]|=))[^\s\d;&|()`<>]" + W + r"))*(?:[ \t]+|(?=[<>]|&>))"
         r"|command(?:[ \t]+-[pP])*(?:[ \t]+--)?(?:[ \t]+|(?=[<>]|&>))"
         r"|" + P_WRAP + r"mise(?:[ \t]+(?!exec(?=[ \t])|x(?=[ \t]))[^\s;&|()`<>]+)*[ \t]+(?:exec|x)"
         r"(?:[ \t]+(?!-(?:-(?:[ \t<>]|&>)))[^\s;&|()`<>]+)*[ \t]+--(?:[ \t]+|(?=[<>]|&>))"
         r"|" + P_WRAP + r"timeout(?:[ \t]+-" + W + r")*[ \t]+\d" + W + r"(?:[ \t]+|(?=[<>]|&>))"
         r"|[A-Za-z_]\w*=" + VALUE + r"(?:[ \t]+|(?=[<>]|&>))"
         r"|[0-9]*[<>]+(?!\()[&|]?[ \t]*(?:\\[^\n]|[^\s;&|()`<>\\])+(?:[ \t]+|(?=[<>]|&>))"
         r"|&>>?[ \t]*(?:\\[^\n]|[^\s;&|()`<>\\])+(?:[ \t]+|(?=[<>]|&>)))*")
AGY_LOOKUP = r"\$\(\s*(?:" + P_EXE + r"mise[ \t]+which|command[ \t]+-v|" + P_EXE + r"which)[ \t]+(?:agy|antigravity)\s*\)"
AGY = re.compile(START + r"(?P<agy>" + P_EXE + r"(?:agy|antigravity)|" + AGY_LOOKUP + r")(?=[ \t;&|)<>\n`]|$)"
                 r"(?P<args>(?:[<>]&|>\||&>>?|\\[^\n]|[^;&|)\n`\\<>]|>(?![&|])|<(?!&))*)")
AGY_HARMLESS_WORDS = frozenset({"--version", "--help", "-h", "help", "changelog"})
AGY_HARMLESS = re.compile(r"\s*(?:'(?:--version|--help|-h|help|changelog)'|(?:--version|--help|-h|help|changelog))\s*")
REDIR_WORD = r"(?:\\[^\n]|[^\s;&|($`<>\\])+"
REDIR = re.compile(r"(?:(?:(?<=^)|(?<=\s))[0-9]+|(?<![<>]))[<>]+(?!\()[&|]?[ \t]*" + REDIR_WORD + r"|&>>?[ \t]*" + REDIR_WORD)
UNESCAPED_BACKTICK = re.compile(r"(?<!\\)(?:\\\\)*`")
LAUNCH_OPT = (r"(?:[ \t]+-[\w-]+"
              r"|(?:[ \t]+(?=[0-9]*[<>])|(?=[<>]))(?:[0-9]*[<>]+(?!\()[&|]?[ \t]*)" + REDIR_WORD
              + r"|[ \t]*&>>?[ \t]*" + REDIR_WORD + r")")
LAUNCH = re.compile(START + r"(?P<exe>" + P_EXE + r"agent-run)(" + LAUNCH_OPT + r"*)[ \t]+(?:sol|ask|audit|local)\b"
                    r"((?:[<>]&|>\||&>>?|[^;&|\n)`$<>]|>(?![&|])|<(?!&)|\$(?!\())*)")
LOOP_WORD = re.compile(START + r"(for|while|until|select|done)\b")
HELP = re.compile(r"(?:^|\s)(?:-h|--help)(?=\s|$)")
DISOWN = re.compile(r"(?:^|[;&|(){}\n!]|\b(?:do|then|else|elif)\s)\s*disown\b")
# `&` that does not background: &&, >&, &>, |&, <& (fd duplication and redirection).
NOT_BACKGROUND = re.compile(r"&&|(?<![0-9])[0-9]*[<>]&[0-9-]*|&>>?|\|&")


def unquote(m):  # one pass over escapes, quotes and comments, so a quote inside a comment opens nothing
    if m.group().startswith("\\"):
        return m.group()
    if m.group().startswith("#"):
        return ""
    inner = m.group()[1:-1]
    if re.fullmatch(r"(?:[^'\"]*/)?agent-run", inner):  # a quoted executable path
        return "agent-run"
    if re.fullmatch(r"(?:[^'\"]*/)?(?:agy|antigravity|mise)", inner):
        return inner.rsplit("/", 1)[-1]
    if inner.startswith("--unset="):
        rhs = inner[8:]
        if m.group().startswith('"') and SUBSTITUTION.search(rhs):
            return "--unset=" + "_".join(SUBSTITUTION.findall(rhs))
        return "--unset=''"
    if re.fullmatch(r"-(?:i|u|-unset)?", inner):
        return inner
    if inner in AGY_HARMLESS_WORDS:  # keep quoted so HELP does not match quoted '--help' on agent-run
        return f"'{inner}'"
    if m.group().startswith("'"):
        return "''"
    return " ".join(SUBSTITUTION.findall(m.group())) or "''"  # $(...) still runs in double quotes


def substitution_spans(text):
    """Outermost $(...) spans in O(n), found with shell quoting in mind: single quotes and escapes hide
    parentheses, and a $(...) inside double quotes still runs."""
    spans, stack, sub_depth, i, n = [], [], 0, 0, len(text)
    while i < n:
        c, top = text[i], stack[-1][0] if stack else None
        if c == "\\":
            i += 2
            continue
        if text.startswith("$(", i):
            stack.append(("sub", i + 2))
            sub_depth += 1
            i += 2
            continue
        if top == "dq":
            if c == '"':
                stack.pop()
        elif c == "'":
            j = text.find("'", i + 1)
            i = n if j < 0 else j
        elif c == '"':
            stack.append(("dq", i))
        elif c == "(":
            stack.append(("paren", i))
        elif c == ")":
            while stack and stack[-1][0] == "dq":
                stack.pop()
            if stack:
                kind, start = stack.pop()
                if kind == "sub":
                    sub_depth -= 1
                    if sub_depth == 0:
                        spans.append((start, i))
        i += 1
    return spans


def unquote_substitutions(text):
    """Strip quotes and comments inside each outermost $(...) in O(n): it runs even within a double-quoted
    string, and its own quoted arguments would otherwise break that string's quoting."""
    spans = substitution_spans(text)
    if not spans:
        return text
    out, pos = [], 0
    for a, b in spans:
        out.append(text[pos:a])
        out.append(QUOTED_OR_COMMENT.sub(unquote, text[a:b]))
        pos = b
    out.append(text[pos:])
    return "".join(out)


def _find_unquoted_heredocs(line, quote):
    """Find all unquoted heredoc openers on `line`, tracking single/double quote state across lines."""
    found, k, n = [], 0, len(line)
    while k < n:
        c = line[k]
        if quote == "'":
            if c == "'":
                quote = None
            k += 1
        elif quote == '"':
            if c == "\\":
                k += 2
                continue
            if c == '"':
                quote = None
            k += 1
        elif c == "\\":
            k += 2
        elif c in ("'", '"'):
            quote = c
            k += 1
        elif c == "#" and (k == 0 or line[k - 1] in " \t;&|()"):
            break
        elif c == "<" and k + 1 < n and line[k + 1] == "<":
            m = HEREDOC_HEAD.match(line, k)
            if m:
                found.append(m)
                k = m.end()
                continue
            while k < n and line[k] == "<":
                k += 1
        else:
            k += 1
    return found, quote


def strip_heredocs(text):
    """Replace unquoted heredoc bodies in O(n log n) without matching `<<EOF` inside quotes/comments."""
    if "<<" not in text:
        return text
    lines = re.findall(r"[^\n]*\n|[^\n]+", text)
    by_exact = defaultdict(list)
    by_strip_tab = defaultdict(list)
    for idx, line in enumerate(lines):
        stripped = line.rstrip("\n")
        by_exact[stripped].append(idx)
        by_strip_tab[stripped.lstrip("\t")].append(idx)
    out, i, n, quote = [], 0, len(lines), None
    while i < n:
        line = lines[i]
        matches, next_quote = _find_unquoted_heredocs(line, quote)
        if matches:
            cursor = i
            matched = []
            for m in matches:
                delim = m.group(1) or m.group(2) or m.group(3)
                table = by_strip_tab if m.group(0).startswith("<<-") else by_exact
                candidates = table.get(delim)
                if not candidates:
                    break
                pos = bisect_right(candidates, cursor)
                if pos >= len(candidates):
                    break
                cursor = candidates[pos]
                matched.append(m)
            if matched:
                pieces, p = [], 0
                for m in matched:
                    pieces.append(line[p:m.start()])
                    pieces.append("<<H")
                    p = m.end()
                pieces.append(line[p:])
                out.append("".join(pieces))
                i = cursor + 1
                quote = None
                continue
        quote = next_quote
        out.append(line)
        i += 1
    return "".join(out)


def problem(tool_input, *, require_background=True):
    command = tool_input.get("command")
    if not isinstance(command, str):
        return None
    text = strip_heredocs(command.replace("\\\n", ""))
    text = unquote_substitutions(text)
    text = QUOTED_OR_COMMENT.sub(unquote, text)
    def asks_for_help(src, m):  # -h/--help anywhere in that launch's own arguments, past any $(...), in O(cmd)
        parts, pos, n = [m.group(2), m.group(3)], m.end(), len(src)
        while pos < n and src[pos] not in ";)\n`":
            if src[pos] == "|" and (pos == 0 or src[pos - 1] != ">"):
                break
            if src[pos] == "&" and not (pos > 0 and src[pos - 1] in "<>") and not src.startswith("&>", pos):
                break
            sub = SUBSTITUTION.match(src, pos)
            if sub:
                parts.append(" ")
                pos = sub.end()
            elif src.startswith((">|", ">&", "<&", "&>>", "&>"), pos):
                tok = "&>>" if src.startswith("&>>", pos) else src[pos:pos + 2]
                parts.append(tok)
                pos += len(tok)
            else:
                end = pos + 1
                while end < n and src[end] not in ";&|)\n`$<>":
                    end += 1
                parts.append(src[pos:end])
                pos = end
        return HELP.search(REDIR.sub(" ", " ".join(parts)))
    # Check both top-level text and each command substitution slice so an outer START match
    # (e.g. `env --unset=$(...) agy --help` or `VAR=$(agent-run ...) agent-run ...`) cannot hide inner commands.
    slices = [(0, text)]
    for a, b in substitution_spans(text):
        slices.append((a, text[a:b]))
    for _, src in slices:
        bt_pos = bt_parity = 0
        for m in AGY.finditer(src):
            # An unescaped ` stopping args is an opening command substitution (more args may follow)
            # unless an odd number of unescaped ` already opened one before this command.
            if m.end() < len(src) and src[m.end()] == "`":
                bt_parity ^= len(UNESCAPED_BACKTICK.findall(src, bt_pos, m.start("agy"))) & 1
                bt_pos = m.start("agy")
                if bt_parity == 0:
                    return ("agy runs on Tucker's personal Google sign-in, and Google bans agents wrapping or driving it: "
                            "do not launch agy or antigravity from an agent")
            if not AGY_HARMLESS.fullmatch(REDIR.sub(" ", m.group("args"))):
                return ("agy runs on Tucker's personal Google sign-in, and Google bans agents wrapping or driving it: "
                        "do not launch agy or antigravity from an agent")
    launches, seen_exe = [], set()
    for base, src in slices:
        for m in LAUNCH.finditer(src):
            exe_pos = base + m.start("exe")
            if exe_pos not in seen_exe and not asks_for_help(src, m):
                seen_exe.add(exe_pos)
                launches.append((base + m.start(), exe_pos))
    if not launches:
        return None
    depth, looped = 0, False
    events = sorted([(m.start(1), m.group(1)) for m in LOOP_WORD.finditer(text)] + [(exe_pos, "launch") for _, exe_pos in launches])
    for _, word in events:
        if word in {"for", "while", "until", "select"}:
            depth += 1
        elif word == "done":
            depth = max(depth - 1, 0)
        elif depth:
            looped = True
    if len(launches) > 1 or looped:
        return "one agent-run launch per shell call; send several calls in one message so they run in parallel"
    prefix = text[launches[0][0]:launches[0][1]].split()  # wrappers and assignments
    wrapped = any(word.rsplit("/", 1)[-1] in {"nohup", "setsid"} for word in prefix if "=" not in word)
    if wrapped or DISOWN.search(text) or "&" in NOT_BACKGROUND.sub("", text):
        return "do not detach agent-run (&, nohup, setsid, disown): a detached run never notifies the session"
    if require_background and tool_input.get("run_in_background") is not True:
        return "launch agent-run with run_in_background: true so its completion wakes the session"
    return None


def main():
    try:
        event = json.load(sys.stdin)
        if not isinstance(event, dict):
            return 0
    except (ValueError, RecursionError):  # not a tool event we understand: allow
        return 0
    if "toolCall" in event or event.get("hookEventName") == "PreToolUse":  # Antigravity CLI PreToolUse JSON contract
        tool_call = event.get("toolCall") if isinstance(event.get("toolCall"), dict) else {}
        args = tool_call.get("args") if isinstance(tool_call.get("args"), dict) else {}
        reason = (problem({"command": args.get("CommandLine")}, require_background=False)
                  if tool_call.get("name") == "run_command" else None)
        out = {"decision": "deny", "reason": f"agent-launch-guard: {reason}."} if reason else {"decision": "allow"}
        print(json.dumps(out))
        return 0
    tool_input = event.get("tool_input") if isinstance(event.get("tool_input"), dict) else {}
    reason = problem(tool_input, require_background=True) if event.get("tool_name") == "Bash" else None
    if reason:
        print(f"agent-launch-guard: {reason}.", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
