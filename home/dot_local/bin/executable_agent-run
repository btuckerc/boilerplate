    "type": "object", "additionalProperties": False,
    "required": ["verdict", "candidate", "findings", "missing_evidence", "summary"],
    "properties": {
        "verdict": {"type": "string", "enum": ["PASS", "BLOCK", "UNVERIFIED"]},
        "candidate": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
                      "description": "The exact candidate id the packet states (Git tree or commit, or a sha256)."},
        "findings": {"type": "array", "items": {
            "type": "object", "additionalProperties": False,
            "required": ["severity", "location", "claim", "counterexample"],
            "properties": {
                "severity": {"type": "string", "enum": ["blocker", "major", "minor"]},
                "location": {"type": "string", "pattern": r"^\S+:[0-9]+(-[0-9]+)?$",
                             "description": "file:line or file:start-end"},
                "claim": {"type": "string"},
                "counterexample": {"type": "string", "description": "A concrete input or state that breaks the contract."},
            }}},
        "missing_evidence": {"type": "array", "items": {"type": "string"},
                             "description": "Mandatory evidence the packet lacks and read-only inspection cannot supply."},
        "summary": {"type": "string"},
    },
}
AUDIT_CONTRACT = """You are the release auditor. Accept or reject one fixed candidate against the
supplied contract. Do not design, implement, rank alternatives or give general advice.
Read the whole packet first. Audit only the exact candidate stated below.
Evidence is the packet's diffs, hashes and raw command output, and the files it
names. Author plans, summaries and pointers are claims to check, never evidence.
Try to break every acceptance item: changed paths, callers, consumers, rollback,
and what the recorded checks did not exercise. PASS only when every acceptance
item is evidenced. BLOCK when you can state a counterexample at file:line.
UNVERIFIED when mandatory evidence cannot be obtained read-only; name it in
missing_evidence. Severity: blocker breaks the contract; major is a likely defect;
minor changes nothing in the verdict. PASS has no blocker/major findings or
missing evidence. Make no edits and spawn nothing. Return only the schema JSON.
"""
