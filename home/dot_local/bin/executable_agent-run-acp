#!/usr/bin/env python3
"""One text-only Antigravity turn over ACP for agent-run's Neon lane.

Mirrors T3 Code's Antigravity text generation (apps/server/src/textGeneration/
AntigravityTextGeneration.ts): the official, unmodified `agy acp` binary signs
in with its own oauth-personal flow; this client never reads its credentials.
It starts one session in an empty directory, selects the model and thinking
level, sends one prompt with every tool, file, terminal and question request
refused, and fails the turn if the agent starts tool work or writes files.
Nothing is sent to the model until setup is clean and the selection confirmed.

stdin: the prompt. stdout: the JSON-RPC traffic as JSONL ({"dir", "msg"}).
--result receives the agent's reply text. Standard library only.
"""
import argparse
import fcntl
import json
import os
from pathlib import Path
import queue
import re
import shutil
import signal
import subprocess
import sys
import threading
import time

AUTH_PREFIX = "Open the following link to authenticate the ACP server: "
# agentInfo.name: the ACP Registry build and T3's fixture say antigravity-acp; agy 1.5.13 says this.
AGENT_NAMES = {"antigravity-acp", "Antigravity ACP Server"}
PROTOCOLS = {1, 2}
MAX_OUTPUT_CHARS = 128_000
SETUP_SECONDS = 120  # sign-in never waits for a browser
PREAMBLE = ("Use only the input below. Do not use tools, read or write files, run commands, "
            "or ask questions.\nReturn only JSON matching the output schema at the end.\n\n")
CONFIG_SIZE_LIMIT = 64_000
UUID = re.compile(r"[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}")


class Refused(RuntimeError):
    pass


def profile_dir():
    # The agy binary resolves its profile from HOME; it has no GEMINI_HOME override.
    return Path.home() / ".gemini"


def global_config_problem(profile):
    """T3 refuses helper turns when global hooks or MCP servers could run before a denial."""
    for name, key in (("hooks.json", "hooks"), ("mcp_config.json", "mcpServers")):
        path = profile / "config" / name
        if not path.exists():
            continue
        if not path.is_file() or path.stat().st_size > CONFIG_SIZE_LIMIT:
            return f"{path} is not a small regular file"
        text = path.read_text(errors="replace").strip()
        if not text:
            continue
        try:
            value = json.loads(text)
            value = value.get(key, value) if isinstance(value, dict) else value
        except ValueError:
            return f"{path} is not JSON"
        if not isinstance(value, dict) or value:
            return f"{path} configures global {key}; the Neon lane runs only without them"
    plugins = profile / "config" / "plugins"
    if plugins.exists() and (not plugins.is_dir() or any(plugins.iterdir())):
        return f"{plugins} holds global plugins (they can add hooks or MCP servers); the Neon lane runs only without them"
    return None


def select_values(option):
    values = []
    for entry in option.get("options") or []:
        if isinstance(entry, dict) and "value" in entry:
            values.append(entry["value"])
        elif isinstance(entry, dict):
            values.extend(item.get("value") for item in entry.get("options") or [] if isinstance(item, dict))
    return values


class Client:
    def __init__(self, command, cwd, log):
        self.log = log
        self.proc = subprocess.Popen(command, cwd=cwd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=None, bufsize=0)
        self.next_id = 0
        self.replies = {}
        self.incoming = queue.Queue()
        self.text = []
        self.text_chars = 0
        self.config = []
        self.mode = None
        self.problem = None
        self.session_id = None
        self.prompting = False
        self.expected = None  # (model, thinking id, thinking) once setup confirms them
        self.reader = threading.Thread(target=self.read, daemon=True)
        self.reader.start()

    def record(self, direction, msg):
        self.log.write(json.dumps({"dir": direction, "at": time.time(), "msg": msg}) + "\n")
        self.log.flush()

    def send(self, msg):
        self.record("out", msg)
        try:
            self.proc.stdin.write((json.dumps(msg) + "\n").encode())
            self.proc.stdin.flush()
        except (BrokenPipeError, ValueError) as exc:
            raise Refused(f"agy acp closed its input: {exc}") from exc

    def read(self):
        for raw in self.proc.stdout:
            line = raw.decode("utf-8", "replace").rstrip("\r\n")
            if not line.strip():
                continue
            if line.startswith(AUTH_PREFIX):
                self.record("in", {"auth_required": True})
                self.incoming.put(("fatal", "Antigravity is not signed in on this host: Tucker runs agy once himself"))
                return
            try:
                msg = json.loads(line)
            except ValueError:
                self.record("in", {"non_json": line[:2000]})
                continue
            self.record("in", msg)
            if isinstance(msg, dict):
                self.incoming.put(("msg", msg))
        self.incoming.put(("eof", None))

    def fail(self, problem):
        self.problem = self.problem or problem

    def handle(self, msg):
        method = msg.get("method")
        if method is None:
            self.replies[msg.get("id")] = msg
            return
        params = msg.get("params") if isinstance(msg.get("params"), dict) else {}
        if "id" in msg:  # a request from the agent: refuse every one, as T3's helper does
            if method == "session/request_permission":
                self.fail("Antigravity requested a tool permission")
                self.send({"jsonrpc": "2.0", "id": msg["id"], "result": {"outcome": {"outcome": "cancelled"}}})
            elif method in {"elicitation/create", "session/elicitation", "_session/elicitation"}:
                self.fail("Antigravity asked a question")
                self.send({"jsonrpc": "2.0", "id": msg["id"], "result": {"action": "decline"}})
            else:
                self.fail(f"Antigravity requested {method}")
                self.send({"jsonrpc": "2.0", "id": msg["id"],
                           "error": {"code": -32601, "message": "Tools and user input are disabled for this client."}})
            return
        if method != "session/update":
            return
        update = params.get("update") if isinstance(params.get("update"), dict) else {}
        kind = update.get("sessionUpdate")
        if kind in {"tool_call", "tool_call_update"}:
            self.fail("Antigravity started tool work")
            if self.session_id:  # stop the turn rather than let native tools continue
                self.send({"jsonrpc": "2.0", "method": "session/cancel", "params": {"sessionId": self.session_id}})
        elif params.get("sessionId") != self.session_id:
            return
        elif kind == "config_option_update" and isinstance(update.get("configOptions"), list):
            self.config = update["configOptions"]
            if self.expected:
                model, thinking_id, thinking = self.expected
                now = selection(self, thinking_id)
                if (now["model"], now["thinking"]) != (model, thinking):
                    self.fail(f"selection changed during the turn: {now}")
        elif kind == "current_mode_update":
            self.mode = update.get("currentModeId")
            if self.expected and self.mode != "default":
                self.fail(f"mode changed during the turn: {self.mode!r}")
        elif kind == "agent_message_chunk":
            content = update.get("content") if isinstance(update.get("content"), dict) else {}
            if not self.prompting:
                self.fail("Antigravity sent reply text outside the prompt")
            elif content.get("type") != "text":
                self.fail(f"Antigravity sent {content.get('type')!r} content in a text-only turn")
            else:
                self.text_chars += len(content.get("text", ""))
                if self.text_chars > MAX_OUTPUT_CHARS:
                    self.fail("Antigravity exceeded the output limit")
                else:
                    self.text.append(content.get("text", ""))

    def pump(self, deadline, until):
        while not until():
            left = deadline - time.monotonic()
            if left <= 0:
                raise Refused("timed out waiting for Antigravity")
            try:
                kind, value = self.incoming.get(timeout=min(left, 1))
            except queue.Empty:
                continue
            if kind == "fatal":
                raise Refused(value)
            if kind == "eof":
                raise Refused(f"agy acp exited ({self.proc.poll()})")
            self.handle(value)

    def request(self, method, params, deadline):
        self.next_id += 1
        rid = self.next_id
        self.send({"jsonrpc": "2.0", "id": rid, "method": method, "params": params})
        self.pump(deadline, lambda: rid in self.replies)
        reply = self.replies.pop(rid)
        if "error" in reply:
            raise Refused(f"{method} failed: {json.dumps(reply['error'])[:500]}")
        return reply.get("result") if isinstance(reply.get("result"), dict) else {}

    def close(self):
        try:
            self.proc.stdin.close()
        except OSError:
            pass
        try:
            self.proc.wait(2)
        except subprocess.TimeoutExpired:
            self.proc.terminate()
            try:
                self.proc.wait(2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()
        # Account for everything the agent sent before it exited: late requests count too.
        self.reader.join(1)
        while True:
            try:
                kind, value = self.incoming.get_nowait()
            except queue.Empty:
                return
            if kind == "msg" and value.get("method"):
                self.fail(f"Antigravity sent {value['method']} after the turn")
            elif kind == "fatal":
                self.fail(value)


def selection(client, thinking_id):
    return {"model": next((o.get("currentValue") for o in client.config if o.get("id") == "model"), None),
            "thinking": next((o.get("currentValue") for o in client.config if o.get("id") == thinking_id), None),
            "mode": client.mode,
            "options": {o.get("id"): o.get("currentValue") for o in client.config}}


def choose(client, session, config_id, value, deadline):
    result = client.request("session/set_config_option",
                            {"sessionId": session, "configId": config_id, "value": value}, deadline)
    if isinstance(result.get("configOptions"), list):
        client.config = result["configOptions"]


def setup(client, args, cwd, deadline):
    init = client.request("initialize", {
        "protocolVersion": 2,
        "clientCapabilities": {"fs": {"readTextFile": False, "writeTextFile": False}, "terminal": False},
        "clientInfo": {"name": "agent-run", "title": "agent-run (Tucker's council)", "version": "1"},
    }, deadline)
    agent = (init.get("agentInfo") or {}).get("name")
    if agent not in AGENT_NAMES:
        raise Refused(f"unexpected ACP agent {agent!r}")
    if init.get("protocolVersion") not in PROTOCOLS:
        raise Refused(f"unsupported ACP protocol {init.get('protocolVersion')!r}")
    client.request("authenticate", {"methodId": "oauth-personal"}, deadline)
    created = client.request("session/new", {"cwd": str(cwd), "mcpServers": []}, deadline)
    session = created.get("sessionId")
    if not isinstance(session, str) or not UUID.fullmatch(session):
        raise Refused(f"session/new returned an unexpected session id {session!r}")
    client.session_id = session
    client.config = created.get("configOptions") or client.config
    modes = created.get("modes") or {}
    client.mode = modes.get("currentModeId")
    if not any(isinstance(m, dict) and m.get("id") == "default" for m in modes.get("availableModes") or []):
        raise Refused("Antigravity offers no default (ask-first) mode")
    if client.mode != "default":
        client.request("session/set_mode", {"sessionId": session, "modeId": "default"}, deadline)
        client.mode = "default"
    model = next((o for o in client.config if o.get("id") == "model"), None)
    if model is None or args.model not in select_values(model):
        raise Refused(f"model {args.model} is not offered to this account "
                      f"(offered: {select_values(model) if model else []})")
    if model.get("currentValue") != args.model:
        choose(client, session, "model", args.model, deadline)
    thinking = next((o for o in client.config if o.get("category") == "thought_level"), None)
    if thinking is None or args.thinking not in select_values(thinking):
        raise Refused(f"thinking level {args.thinking} is not offered for {args.model} "
                      f"(offered: {select_values(thinking) if thinking else []})")
    if thinking.get("currentValue") != args.thinking:
        choose(client, session, thinking["id"], args.thinking, deadline)
    # Handle whatever setup traffic is already queued before anything counts as the reply.
    while True:
        try:
            kind, value = client.incoming.get_nowait()
        except queue.Empty:
            break
        if kind == "fatal":
            raise Refused(value)
        if kind == "eof":
            raise Refused(f"agy acp exited ({client.proc.poll()})")
        client.handle(value)
    selected = selection(client, thinking["id"])
    if (selected["model"], selected["thinking"], selected["mode"]) != (args.model, args.thinking, "default"):
        raise Refused(f"Antigravity did not apply {args.model}/{args.thinking}/default: {selected}")
    client.expected = (args.model, thinking["id"], args.thinking)
    if client.problem:
        raise Refused(client.problem + " during setup")
    return thinking["id"]


def session_ids(profile):
    found = set()
    for sub, suffix in (("conversations", ".db"), ("annotations", ".pbtxt"), ("brain", "")):
        directory = profile / "antigravity-cli" / sub
        if directory.is_dir():
            found.update(p.name[:len(p.name) - len(suffix)] if suffix else p.name for p in directory.iterdir())
    return found


def remove_session_files(profile, session, existing):
    """As T3 does for helper turns: keep this session out of Tucker's agy history.
    Only this run's own per-session entries, never one that predates it, never through a link."""
    if not isinstance(session, str) or not UUID.fullmatch(session) or session in existing:
        return
    base = profile / "antigravity-cli"
    if base.is_symlink() or not base.is_dir():
        return
    for path, kind in ((base / "conversations" / f"{session}.db", "file"),
                       (base / "annotations" / f"{session}.pbtxt", "file"),
                       (base / "brain" / session, "dir")):
        try:
            if path.parent.is_symlink() or path.is_symlink():
                continue
            if kind == "dir" and path.is_dir():
                shutil.rmtree(path)
            elif kind == "file" and path.is_file():
                path.unlink()
        except OSError as exc:
            print(f"agent-run-acp: could not remove {path}: {exc}", file=sys.stderr)


def run(args, prompt, log):
    cwd = Path.cwd()
    if any(cwd.iterdir()):
        raise Refused(f"working directory {cwd} is not empty")
    profile = profile_dir()
    problem = global_config_problem(profile)
    if problem:
        raise Refused(problem)
    # One Antigravity turn at a time on this host, whoever launches it.
    lock_path = Path.home() / ".local/state/agent-run-acp.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock = open(lock_path, "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        raise Refused("another Neon turn is running on this host")
    existing = session_ids(profile)
    # The managed wrapper: pinned binary, file-stored sign-in, ambient Google keys dropped.
    agy = Path.home() / ".local/bin/agy"
    deadline = time.monotonic() + args.timeout
    stop = None
    try:
        client = Client([str(agy), "acp"], cwd, log)
    except OSError:
        lock.close()
        raise
    try:
        thinking_id = setup(client, args, cwd, min(deadline, time.monotonic() + SETUP_SECONDS))
        client.prompting = True
        reply = client.request("session/prompt", {
            "sessionId": client.session_id, "prompt": [{"type": "text", "text": PREAMBLE + prompt}]}, deadline)
        client.prompting = False
        stop = reply.get("stopReason")
        if stop != "end_turn":
            client.fail(f"turn stopped with {stop!r}")
        selected = selection(client, thinking_id)
        log.write(json.dumps({"dir": "client", "selected": selected}) + "\n")
        if (selected["model"], selected["thinking"], selected["mode"]) != (args.model, args.thinking, "default"):
            client.fail(f"selection changed during the turn: {selected}")
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)  # a cancel arriving now must not cut cleanup short
        if client.session_id:
            try:
                client.request("session/close", {"sessionId": client.session_id},
                               min(deadline, time.monotonic() + 3))
            except Refused as exc:
                print(f"agent-run-acp: session/close: {exc}", file=sys.stderr)
        client.close()
        remove_session_files(profile, client.session_id, existing)
        lock.close()
    for path in cwd.rglob("*"):
        relative = path.relative_to(cwd).as_posix()
        if relative not in {".agents", ".agents/skills", ".gemini", ".gemini/skills"} or \
                path.is_symlink() or not path.is_dir():
            client.fail("Antigravity wrote files in the empty working directory")
    text = "".join(client.text).strip()
    if not text:
        client.fail("Antigravity returned no text")
    return text, client.problem, stop


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--model", required=True)
    parser.add_argument("--thinking", required=True)
    parser.add_argument("--result", required=True)
    parser.add_argument("--timeout", type=float, default=1800)
    args = parser.parse_args(argv)
    if os.environ.get("AGENT_RUN_CHILD") != "1":
        print("agent-run-acp: run Neon through agent-run ask --model neon", file=sys.stderr)
        return 3
    # agent-run cancels and times out with SIGTERM (cancel sends it twice) and kills 10 s later:
    # unwind once, inside that grace, so the session is closed and removed.
    def terminate(signum, frame):
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        sys.exit(143)
    signal.signal(signal.SIGTERM, terminate)
    prompt = sys.stdin.read()
    log = sys.stdout
    try:
        text, problem, stop = run(args, prompt, log)
    except (Refused, OSError) as exc:
        log.write(json.dumps({"dir": "client", "error": str(exc)}) + "\n")
        print(f"agent-run-acp: {exc}", file=sys.stderr)
        return 1
    fd = os.open(args.result, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as out:
        out.write(text)
    log.write(json.dumps({"dir": "client", "stop": stop, "problem": problem, "chars": len(text)}) + "\n")
    if problem:
        print(f"agent-run-acp: {problem}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
