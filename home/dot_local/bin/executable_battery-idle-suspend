#!/bin/bash
# Called by the omarchy-shell idle overlay when the laptop has been idle on
# battery. Suspends (suspend-then-hibernate, so logind's HibernateDelaySec
# applies) only when nothing says to stay up. Never asks for a password: a
# refused request must not leave a polkit dialog behind the lock screen.
#
#   battery-idle-suspend [--require-locked]
#
# Exit codes: 0 suspend requested, 10 not locked, 11 idle/sleep block
# inhibitor held, 12 audio playing, 13 on AC, 14 a safety check could not be
# answered or timed out (deferred to the caller's retry), other = systemctl's
# failure.

set -u

require_locked=0
[[ ${1:-} == --require-locked ]] && require_locked=1

say() { printf 'battery-idle-suspend: %s\n' "$*"; }

# Only an AC reading of exactly 0 counts as battery; a failed read defers.
check_battery() {
  local ac
  ac=$(cat /sys/class/power_supply/AC/online 2>/dev/null) || { say "defer: AC state unreadable"; exit 14; }
  [[ $ac == 0 ]] || { say "skip: on AC (online=$ac)"; exit 13; }
}

check_locked() {
  (( require_locked )) || return 0
  local locked rc
  locked=$(timeout "${1:-10}" omarchy-shell lock isLocked 2>/dev/null); rc=$?
  (( rc == 124 )) && { say "defer: lock query timed out"; exit 14; }
  [[ $locked == true ]] || { say "skip: session not locked"; exit 10; }
}

check_audio() {
  # Audio-only playback (music, podcasts) takes no Wayland idle inhibitor.
  # The probe must answer exactly true or false; anything else defers.
  local streams playing
  streams=$(timeout "${1:-5}" pactl -f json list sink-inputs 2>/dev/null) || { say "defer: audio query failed"; exit 14; }
  # jq can print a value and still fail on trailing garbage: require both.
  playing=$(jq -r 'if type == "array" then any(.[]; .corked == false) else error("unexpected reply") end' <<<"$streams" 2>/dev/null) ||
    { say "defer: audio query gave no answer"; exit 14; }
  case $playing in
    true) say "skip: audio playing"; exit 12 ;;
    false) ;;
    *) say "defer: audio query gave no answer"; exit 14 ;;
  esac
}

check_inhibitors() {
  # Block-mode inhibitors for idle or sleep (systemd-inhibit --what=idle,
  # fwupd...). Delay-mode ones (NetworkManager, lock-before-sleep) do not count.
  # The reply must parse to an explicit answer ("ok:" + list); anything else defers.
  local reply answer
  reply=$(timeout "${1:-5}" busctl --json=short call org.freedesktop.login1 /org/freedesktop/login1 \
      org.freedesktop.login1.Manager ListInhibitors 2>/dev/null) || { say "defer: inhibitor query failed"; exit 14; }
  answer=$(jq -r '.data[0] | if type == "array" then . else error("unexpected reply") end
      | "ok:" + (map(select(.[3] == "block") | select(.[0] | split(":") | any(. == "idle" or . == "sleep")) | "\(.[1]) (\(.[2]))") | join(", "))' \
      <<<"$reply" 2>/dev/null) || { say "defer: inhibitor query gave no answer"; exit 14; }
  [[ $answer == ok:* && $answer != *$'\n'* ]] || { say "defer: inhibitor query gave no answer"; exit 14; }
  [[ -n ${answer#ok:} ]] && { say "skip: inhibited by ${answer#ok:}"; exit 11; }
  return 0
}

# A first pass gives an early, specific answer. Then every check runs again back
# to back right before systemctl, bounded to FINAL_BUDGET_MS (measured ~45 ms:
# lock IPC ~20, pactl ~10, ListInhibitors ~6), so no answer the suspend relies on
# is older than that bound; a slower pass defers. A read-then-act
# check cannot be atomic (logind has no idle-inhibitor-aware sleep call;
# systemctl itself refuses on sleep block inhibitors), so a change inside that
# bound is not caught; if it is an unlock, omarchy's lock-before-sleep inhibitor
# still locks the session as it suspends.
FINAL_BUDGET_MS=300

# Milliseconds of CLOCK_BOOTTIME (/proc/uptime: monotonic, not adjustable by
# NTP or the user, 10 ms resolution). Wall-clock time could step backwards.
uptime_ms() {
  local up
  read -r up _ </proc/uptime || { say "defer: /proc/uptime unreadable"; exit 14; }
  [[ $up =~ ^([0-9]+)\.([0-9]{2})$ ]] || { say "defer: /proc/uptime unparsable"; exit 14; }
  printf '%s' $(( 10#${BASH_REMATCH[1]} * 1000 + 10#${BASH_REMATCH[2]} * 10 ))
}

check_battery
check_locked
check_inhibitors
check_audio

start=$(uptime_ms) || exit 14
check_battery
check_locked 0.3
check_audio 0.3
check_inhibitors 0.3
now=$(uptime_ms) || exit 14
elapsed_ms=$(( now - start ))
(( elapsed_ms <= FINAL_BUDGET_MS )) || { say "defer: final checks took ${elapsed_ms} ms"; exit 14; }

# Once logind accepts the request it cannot be retracted (its Manager API can
# cancel a scheduled shutdown, not a sleep), and delay inhibitors (the lock-
# before-sleep hook, NetworkManager...) postpone it by up to InhibitDelayMaxSec
# (15 s here; measured 0.67 s from request to sleep.target, including the lock).
# Input or a plug-in inside that window does not stop it; the session sleeps
# locked and wakes on the next key press, like a lid close would.
say "suspend-then-hibernate (final checks ${elapsed_ms} ms)"
exec systemctl --no-ask-password suspend-then-hibernate
