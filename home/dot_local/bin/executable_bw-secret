#!/bin/sh
set -eu

# Read Bitwarden values without putting credentials in argv, logs, or Git.
# Interactive authentication remains owned by the calling shell.

usage() {
    cat <<'EOF'
Usage:
  bw-secret status
  bw-secret field ITEM username|password|notes|custom:NAME
  bw-secret write-env ITEM FIELD ENV_KEY FILE
  bw-secret exec ITEM FIELD ENV_KEY -- COMMAND [ARG...]

`field` intentionally writes only the requested value to stdout for trusted
command substitution. `write-env` updates FILE atomically with mode 0600.
`exec` exposes the value only in COMMAND's environment.
EOF
}

find_bw() {
    for candidate in \
        "${BW_BIN:-}" \
        "$HOME/.local/share/mise/shims/bw" \
        "$HOME/.local/bin/bw" \
        /opt/homebrew/bin/bw \
        /usr/local/bin/bw \
        /usr/bin/bw
    do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    command -v bw 2>/dev/null || return 1
}

BW_BIN="$(find_bw || true)"
if [ -z "$BW_BIN" ]; then
    echo "bw CLI not found; install the shared mise baseline first." >&2
    exit 127
fi
if ! command -v jq >/dev/null 2>&1; then
    echo "jq is required." >&2
    exit 127
fi

status_json="$($BW_BIN status 2>/dev/null || true)"
status="$(printf '%s' "$status_json" | jq -r '.status // "unknown"' 2>/dev/null || printf unknown)"
server="$(printf '%s' "$status_json" | jq -r '.serverUrl // "unset"' 2>/dev/null || printf unset)"

require_unlocked() {
    case "$status" in
        unlocked) return 0 ;;
        locked)
            echo "bw is locked; run 'export BW_SESSION=\$(bw unlock --raw)' in this shell." >&2
            ;;
        unauthenticated)
            echo "bw is unauthenticated; run 'bw login' first." >&2
            ;;
        *) echo "Unable to determine bw status." >&2 ;;
    esac
    return 1
}

read_field() {
    item_name="$1"
    field_name="$2"
    item_json="$($BW_BIN get item "$item_name" 2>/dev/null || true)"
    if [ -z "$item_json" ]; then
        echo "Bitwarden item '$item_name' was not found." >&2
        return 1
    fi
    case "$field_name" in
        username) value="$(printf '%s' "$item_json" | jq -r '.login.username // empty')" ;;
        password) value="$(printf '%s' "$item_json" | jq -r '.login.password // empty')" ;;
        notes) value="$(printf '%s' "$item_json" | jq -r '.notes // empty')" ;;
        custom:*)
            custom_name="${field_name#custom:}"
            value="$(printf '%s' "$item_json" | jq -r --arg name "$custom_name" '.fields[]? | select(.name == $name) | .value' | sed -n '1p')"
            ;;
        *) echo "Unsupported field '$field_name'." >&2; return 2 ;;
    esac
    if [ -z "$value" ]; then
        echo "Field '$field_name' is empty or absent on '$item_name'." >&2
        return 1
    fi
    printf '%s' "$value"
}

valid_env_key() {
    case "$1" in
        ''|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;;
        *) return 0 ;;
    esac
}

command_name="${1:-}"
case "$command_name" in
    status)
        printf 'server=%s\nstatus=%s\n' "$server" "$status"
        ;;
    field)
        [ "$#" -eq 3 ] || { usage >&2; exit 2; }
        require_unlocked
        read_field "$2" "$3"
        ;;
    write-env)
        [ "$#" -eq 5 ] || { usage >&2; exit 2; }
        require_unlocked
        valid_env_key "$4" || { echo "Invalid environment key '$4'." >&2; exit 2; }
        value="$(read_field "$2" "$3")"
        case "$value" in *"
"*) echo "Multiline values cannot be written to env files; use exec." >&2; exit 2 ;; esac
        output_file="$5"
        output_dir="$(dirname "$output_file")"
        if [ ! -d "$output_dir" ]; then
            install -d -m 700 "$output_dir"
        fi
        umask 077
        tmp_file="$(mktemp "${output_file}.XXXXXX")"
        trap 'rm -f "$tmp_file"' EXIT HUP INT TERM
        if [ -f "$output_file" ]; then
            awk -F= -v key="$4" '$1 != key { print }' "$output_file" >"$tmp_file"
        fi
        escaped_value="$(printf '%s' "$value" | sed "s/'/'\\\\''/g")"
        printf "%s='%s'\n" "$4" "$escaped_value" >>"$tmp_file"
        chmod 600 "$tmp_file"
        mv "$tmp_file" "$output_file"
        trap - EXIT HUP INT TERM
        printf 'materialized:%s:%s\n' "$4" "$output_file"
        ;;
    exec)
        [ "$#" -ge 6 ] || { usage >&2; exit 2; }
        require_unlocked
        valid_env_key "$4" || { echo "Invalid environment key '$4'." >&2; exit 2; }
        [ "$5" = "--" ] || { usage >&2; exit 2; }
        env_key="$4"
        value="$(read_field "$2" "$3")"
        shift 5
        exec env "$env_key=$value" "$@"
        ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
