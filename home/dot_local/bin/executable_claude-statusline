#!/usr/bin/env python3
"""Claude Code statusLine: fast local rendering and an atomic quota snapshot."""
import datetime as dt
import json
import os
from pathlib import Path
import sys
import tempfile

# Fleet guard markers (as OMP's fleet-status extension shows them): config-drift and
# omp-baseline-drift mean the last guard run failed, config-pending means work held or
# deferred; the guards delete them on success. On nous, llama-watchdog writes
# /run/llama-yield/production-down while production inference is down.
FLEET_MARKERS = (
    ("config-drift", "config drift"),
    ("omp-baseline-drift", "omp drift"),
    ("config-pending", "config pending"),
    ("/run/llama-yield/production-down", "nous inference down"),
)


def fleet():
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "decent-angl"
    found = []
    for name, label in FLEET_MARKERS:
        path = Path(name) if os.path.isabs(name) else state / name
        try:
            if path.stat().st_size > 0:
                found.append(label)
        except OSError:
            pass
    return "fleet: " + ", ".join(found) if found else None


def main():
    try:
        data = json.load(sys.stdin)
        parts = []
        model = (data.get("model") or {}).get("display_name")
        cwd = (data.get("workspace") or {}).get("current_dir")
        if model:
            parts.append(str(model))
        if cwd:
            parts.append(Path(cwd).name or "/")
        limits = data.get("rate_limits")
        if isinstance(limits, dict):
            root = Path(os.environ.get("AGENT_QUOTA_HOME", "~/.local/state/agent-quota")).expanduser()
            tmp = None
            try:
                root.mkdir(parents=True, exist_ok=True)
                snapshot = {"captured_at": dt.datetime.now(dt.timezone.utc).isoformat(),
                            "session_id": data.get("session_id"), "rate_limits": limits}
                fd, tmp = tempfile.mkstemp(prefix=".claude-", dir=root)
                with os.fdopen(fd, "w") as out:
                    json.dump(snapshot, out, allow_nan=False)
                    out.write("\n")
                os.replace(tmp, root / "claude.json")
            except (OSError, ValueError, TypeError):
                pass
            finally:
                if tmp:
                    try:
                        os.unlink(tmp)
                    except OSError:
                        pass
            for period, label in (("five_hour", "5h"), ("seven_day", "7d")):
                value = (limits.get(period) or {}).get("used_percentage")
                if isinstance(value, (int, float)) and not isinstance(value, bool) and 0 <= value <= 100:
                    parts.append(f"{label} {value:g}% used")
        warning = fleet()
        if warning:
            parts.append(warning)
        # Status input should not be able to inject terminal control sequences.
        print(" · ".join("".join(c for c in p if c.isprintable()) for p in parts))
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
