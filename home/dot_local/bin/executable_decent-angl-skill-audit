#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="${DECENT_ANGL_REPO_ROOT:-$HOME/src/boilerplate}"
MANIFEST="${DECENT_ANGL_SKILL_MANIFEST:-$REPO_ROOT/home/dot_config/decent-angl/skill-manifest.tsv}"
SKILL_ROOT="$REPO_ROOT/home/dot_local/share/decent-angl/skills"
failures=0
checked=0

fail() {
  printf 'SKILL  error %s\n' "$*" >&2
  failures=$((failures + 1))
}

checksum() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

[[ -f "$MANIFEST" ]] || { echo "Missing skill manifest: $MANIFEST" >&2; exit 1; }
[[ -d "$SKILL_ROOT" ]] || { echo "Missing shared skill root: $SKILL_ROOT" >&2; exit 1; }

inventory="$(mktemp "${TMPDIR:-/tmp}/decent-angl-skills.XXXXXX")"
trap 'rm -f "$inventory"' EXIT

while IFS=$'\t' read -r name invocation source codex_link omp_link expected_sha expected_license_sha upstream extra; do
  case "$name" in ''|'#'*) continue ;; esac
  checked=$((checked + 1))
  if grep -Fqx "$name" "$inventory"; then
    fail "$name: duplicate manifest entry"
  fi
  printf '%s\n' "$name" >>"$inventory"

  [[ -z "${extra:-}" ]] || fail "$name: extra manifest columns"
  case "$invocation" in model|explicit) ;; *) fail "$name: invalid invocation '$invocation'" ;; esac

  skill="$REPO_ROOT/$source"
  codex="$REPO_ROOT/$codex_link"
  omp="$REPO_ROOT/$omp_link"
  directory="$(dirname "$skill")"
  [[ "$(basename "$directory")" == "$name" ]] || fail "$name: folder/name mismatch"
  [[ -f "$skill" ]] || { fail "$name: missing $source"; continue; }
  [[ -f "$codex" ]] || fail "$name: missing Codex link template"
  [[ -f "$omp" ]] || fail "$name: missing OMP link template"

  expected_target="{{ .chezmoi.homeDir }}/.local/share/decent-angl/skills/$name"
  [[ "$(sed -n '1p' "$codex" 2>/dev/null)" == "$expected_target" ]] || fail "$name: wrong Codex link target"
  [[ "$(sed -n '1p' "$omp" 2>/dev/null)" == "$expected_target" ]] || fail "$name: wrong OMP link target"

  first="$(sed -n '1p' "$skill")"
  declared="$(sed -n '2s/^name: //p' "$skill")"
  description="$(sed -n '3s/^description: //p' "$skill")"
  [[ "$first" == '---' ]] || fail "$name: frontmatter must start on line 1"
  [[ "$declared" == "$name" ]] || fail "$name: frontmatter name mismatch"
  [[ -n "$description" ]] || fail "$name: description must be one non-empty line"

  closed="$(awk 'NR > 1 && $0 == "---" { print NR; exit }' "$skill")"
  [[ -n "$closed" ]] || fail "$name: frontmatter is not closed"
  keys="$(awk 'NR == 1 { next } $0 == "---" { exit } /^[A-Za-z0-9-]+:/ { sub(/:.*/, ""); print }' "$skill")"
  while IFS= read -r key; do
    case "$key" in name|description|argument-hint|disable-model-invocation) ;; '') ;; *) fail "$name: unsupported frontmatter key '$key'" ;; esac
  done <<<"$keys"
  [[ "$(printf '%s\n' "$keys" | grep -cx name)" == 1 ]] || fail "$name: name must appear once"
  [[ "$(printf '%s\n' "$keys" | grep -cx description)" == 1 ]] || fail "$name: description must appear once"
  if [[ "$invocation" == model ]]; then
    ! printf '%s\n' "$keys" | grep -qx disable-model-invocation || fail "$name: model-invoked skill disables model invocation"
  else
    disable_count="$(awk 'NR == 1 { next } $0 == "---" { exit } $0 == "disable-model-invocation: true" { count++ } END { print count + 0 }' "$skill")"
    [[ "$disable_count" == 1 ]] || fail "$name: explicit skill lacks disable-model-invocation"
  fi

  adapter="$directory/agents/openai.yaml"
  [[ -f "$adapter" ]] || { fail "$name: missing agents/openai.yaml"; continue; }
  grep -Eq '^  display_name: "[^"]+"$' "$adapter" || fail "$name: invalid display_name"
  grep -Eq '^  short_description: "[^"]{25,64}"$' "$adapter" || fail "$name: short_description must be quoted and 25-64 characters"
  if [[ "$invocation" == explicit ]]; then
    grep -q '^  allow_implicit_invocation: false$' "$adapter" || fail "$name: Codex explicit policy missing"
  elif grep -q '^  allow_implicit_invocation:' "$adapter"; then
    fail "$name: model invocation is the default; remove redundant Codex policy"
  fi

  if [[ -d "$directory/references" ]]; then
    while IFS= read -r reference; do
      relative="${reference#$directory/}"
      grep -Fq "($relative)" "$skill" || fail "$name: undisclosed reference '$relative'"
    done < <(find "$directory/references" -type f | sort)
  fi

  if [[ "$expected_sha" != '-' ]]; then
    actual_sha="$(checksum "$skill")"
    [[ "$actual_sha" == "$expected_sha" ]] || fail "$name: vendored SKILL.md differs from pinned upstream"
    [[ "$upstream" != '-' ]] || fail "$name: pinned skill lacks upstream provenance"
    if [[ -f "$directory/LICENSE" ]]; then
      actual_license_sha="$(checksum "$directory/LICENSE")"
      [[ "$expected_license_sha" != '-' && "$actual_license_sha" == "$expected_license_sha" ]] || fail "$name: vendored license differs from pinned upstream"
    else
      fail "$name: vendored skill lacks license notice"
    fi
  elif [[ "$upstream" != '-' ]]; then
    fail "$name: upstream provenance lacks a pinned checksum"
  elif [[ "$expected_license_sha" != '-' ]]; then
    fail "$name: license checksum without a pinned skill"
  fi
done <"$MANIFEST"

[[ "$checked" -gt 0 ]] || fail "manifest has no skills"

while IFS= read -r skill_file; do
  skill_name="$(basename "$(dirname "$skill_file")")"
  grep -Fqx "$skill_name" "$inventory" || fail "$skill_name: shared skill is absent from manifest"
done < <(find "$SKILL_ROOT" -mindepth 2 -maxdepth 2 -type f \( -name SKILL.md -o -name SKILL.md.tmpl \) | sort)

while IFS= read -r stale; do
  [[ -z "$stale" ]] || fail "harness-specific SKILL.md remains: ${stale#$REPO_ROOT/}"
done < <(find "$REPO_ROOT/home/dot_codex/skills" "$REPO_ROOT/home/private_dot_omp/private_agent/skills" -type f \( -name SKILL.md -o -name SKILL.md.tmpl \) 2>/dev/null | sort)

if (( failures > 0 )); then
  printf 'SKILL  failed %s issue(s) across %s skill(s)\n' "$failures" "$checked" >&2
  exit 1
fi

printf 'SKILL  ok %s centralized skill(s), invocation policies aligned\n' "$checked"
