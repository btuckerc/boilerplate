#!/usr/bin/env python3
"""fleet-ssh: let this host and another tailnet host SSH to each other by name.

Usage:
  fleet-ssh                      interactive wizard
  fleet-ssh link TARGET [--direction both|to|from] [--user USER] [--yes]
  fleet-ssh unlink TARGET [--local-only]
  fleet-ssh status

Directions, from the host you run it on:
  to    this host -> TARGET: afterwards `ssh TARGET` works here
  from  TARGET -> this host: afterwards `ssh <this host>` works there
  both  both of the above

Design (each choice removes a class of failure):
- Names are tailnet names (MagicDNS resolves them), so fleet-ssh never decides
  which machine a name reaches. It writes only `Match originalhost NAME` /
  `User USER` / `HostKeyAlias FQDN` blocks (so `ssh NAME` must meet the host
  key recorded for the tailnet name) into ~/.ssh/decent-angl-fleet.conf,
  generated from its list in ~/.local/state/decent-angl/fleet-ssh.users and
  included at the end of ~/.ssh/config after "Match all": anything you wrote
  yourself still wins. A name your config sends elsewhere, or whose route
  would change when User is added, gets no block.
- Keys are each account's default ~/.ssh/id_ed25519 (created if missing), so a
  plain `ssh NAME` offers it. The public half is derived from the private key;
  a passphrase-protected key is used only when ssh-agent holds it.
- authorized_keys lines are pinned with from=<source tailnet IPs> and tagged
  decent-angl-fleet:<user>@<fqdn>; only non-comment lines with exactly that
  tag are ever replaced or removed.
- fleet-ssh's own connections use `ssh -F none`: nothing in ~/.ssh/config can
  redirect, wrap or alter them. One connection does all remote work, so the
  target's password is asked at most once.
- Every step reports an explicit result; a missing one is a failure. The final
  check runs the real `ssh NAME` with a random nonce.
- Links are recorded per user@host in ~/.local/state/decent-angl/fleet-ssh.json,
  so status and unlink need neither Tailscale nor guesses, and unlink removes
  only what that link installed. Each host serializes fleet-ssh with an flock.
"""
import argparse
import base64
import contextlib
import fcntl
import ipaddress
import json
import os
import pwd
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

PROG = "fleet-ssh"
TAG = "decent-angl-fleet"
HOME = Path.home()
STATE = HOME / ".local/state/decent-angl"
RECORDS = STATE / "fleet-ssh.json"
LOCK = HOME / ".ssh/.decent-angl-fleet.lock"
FLEET_JSON = HOME / ".config/decent-angl/fleet.json"
NAME_RE = re.compile(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?\Z")
FQDN_RE = re.compile(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+\Z")
USER_RE = re.compile(r"[a-z_][a-z0-9_.-]{0,31}\Z")
KTYPE_RE = re.compile(r"(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-[a-z0-9-]+@openssh\.com)\Z")
BLOB_RE = re.compile(r"[A-Za-z0-9+/]+={0,3}\Z")
TAG_RE = re.compile(r"decent-angl-fleet:[a-z_][a-z0-9_.-]{0,31}@[a-z0-9.-]+\Z")
STEP_TIMEOUT = 120
LOCK_FD = None   # held for a whole operation and inherited by local steps (see host_lock)

# Runs under sh on both ends; arguments are validated in Python and passed with shlex.quote.
# Results are "@@" lines on stdout; messages for the person go to stderr.
OPS = r'''
set -euf
umask 077
D="$HOME/.ssh"; KEY="$D/id_ed25519"; AK="$D/authorized_keys"; CFG="$D/config"
MF="$D/decent-angl-fleet.conf"; SD="$HOME/.local/state/decent-angl"; US="$SD/fleet-ssh.users"
INC="Include ~/.ssh/decent-angl-fleet.conf"; HEADER="# Generated by fleet-ssh; edits are overwritten."
fail() { printf 'fleet-ssh: %s: %s\n' "$(uname -n)" "$*" >&2; exit 1; }
regular() { [ ! -L "$1" ] || fail "$1 is a symlink; fix it by hand"; [ ! -e "$1" ] || [ -f "$1" ] || fail "$1 is not a regular file"; }
dirs() {
  for d in "$D" "$SD"; do [ ! -L "$d" ] || fail "$d is a symlink; fix it by hand"; done
  mkdir -p "$D" "$SD"; chmod 700 "$D" "$SD"
}
newtmp() { mktemp "$(dirname "$1")/.fleet-ssh.XXXXXX"; }
commit() { chmod 600 "$1"; mv -f "$1" "$2"; }   # tmp dest: atomic replace in the same directory

take_lock() {  # flock held by this shell until it exits; the kernel drops it if the shell dies
  dirs; regular "$D/.decent-angl-fleet.lock"
  command -v python3 >/dev/null 2>&1 || fail "python3 is required"
  exec 9>>"$D/.decent-angl-fleet.lock"
  python3 -c 'import fcntl, sys
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(75)' || fail "another fleet-ssh run is changing ssh files here; retry when it ends"
}

ensure_key() {  # comment
  dirs; regular "$KEY"; regular "$KEY.pub"
  if [ ! -e "$KEY" ]; then
    [ ! -e "$KEY.pub" ] || fail "$KEY.pub exists without $KEY; move it away first"
    t=$(mktemp -d "$D/.fleet-ssh-key.XXXXXX")
    ssh-keygen -q -t ed25519 -N '' -C "$1" -f "$t/k" </dev/null >/dev/null || { rm -rf "$t"; fail "ssh-keygen failed"; }
    mv -f "$t/k.pub" "$KEY.pub"; mv -f "$t/k" "$KEY"; rmdir "$t"
    printf '  created %s on %s\n' "$KEY" "$(uname -n)" >&2
  fi
  if pub=$(ssh-keygen -y -P '' -f "$KEY" </dev/null 2>/dev/null); then
    set -- $pub
  else  # passphrase-protected: usable only when the agent holds exactly this .pub's key
    [ -f "$KEY.pub" ] || fail "$KEY is passphrase-protected and has no $KEY.pub"
    set -- $(awk '!/^[ \t]*(#|$)/ { print $1, $2; exit }' "$KEY.pub")
    [ $# -ge 2 ] || fail "$KEY.pub holds no key"
    ssh-add -L 2>/dev/null | awk -v t="$1" -v b="$2" '$1 == t && $2 == b { f=1 } END { exit !f }' \
      || fail "$KEY is passphrase-protected; load it into ssh-agent (ssh-add) and retry"
  fi
  printf '@@PUB %s %s\n' "$1" "$2"
}

# A line is ours for TAG when it is not a comment and its last field, ignoring trailing blanks
# and CR, is exactly TAG.
OURS='function ours(t,  l, a, n) { l=$0; sub(/[ \t\r]+$/, "", l); n=split(l, a, " ")
      return l !~ /^[ \t]*#/ && n > 0 && a[n] == t } '

authorize() {  # tag line
  dirs; regular "$AK"
  t=$(newtmp "$AK")
  if [ -f "$AK" ]; then awk -v t="$1" "$OURS"'!ours(t)' "$AK" >"$t" || { rm -f "$t"; fail "could not read $AK"; }; fi
  printf '%s\n' "$2" >>"$t"
  commit "$t" "$AK"
  printf '@@DONE authorize\n'
}

deauthorize() {  # tag
  regular "$AK"
  if [ -f "$AK" ]; then
    t=$(newtmp "$AK")
    awk -v t="$1" "$OURS"'!ours(t)' "$AK" >"$t" || { rm -f "$t"; fail "could not read $AK"; }
    commit "$t" "$AK"
  fi
  printf '@@DONE deauthorize\n'
}

has_tag() {  # tag: a valid key line carrying the tag is present
  r=no
  if [ -f "$AK" ]; then
    t=$(newtmp "$AK")
    awk -v t="$1" "$OURS"'ours(t)' "$AK" | while IFS= read -r line; do
      printf '%s\n' "$line" >"$t"; ssh-keygen -l -f "$t" >/dev/null 2>&1 && echo yes
    done | grep -q yes && r=yes
    rm -f "$t"
  fi
  printf '@@TAG %s\n' "$r"
}

render() {  # regenerate the managed config from the users list (only valid lines survive)
  regular "$MF"
  if [ -s "$MF" ] && [ "$(head -n 1 "$MF")" != "$HEADER" ]; then fail "$MF was not written by fleet-ssh; move it away"; fi
  t=$(newtmp "$MF")
  printf '%s\n' "$HEADER" >"$t"
  if [ -f "$US" ]; then
    awk 'NF == 3 && $1 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/ && $2 ~ /^[a-z_][a-z0-9_.-]*$/ &&
         $3 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/ {
           printf "Match originalhost %s\n  User %s\n  HostKeyAlias %s\n", $1, $2, $3 }' "$US" >>"$t" \
      || { rm -f "$t"; fail "could not read $US"; }
  fi
  commit "$t" "$MF"
}

ensure_include() {  # "Match all" + Include at the end: hand-written settings are read first
  regular "$CFG"
  if [ -f "$CFG" ] && awk -v inc="$INC" '$0 == inc && prev == "Match all" { f=1 } NF { prev=$0 } END { exit !f }' "$CFG"; then
    return 0
  fi
  t=$(newtmp "$CFG")
  if [ -f "$CFG" ]; then
    cat "$CFG" >"$t" || { rm -f "$t"; fail "could not read $CFG"; }
    if [ -s "$CFG" ] && [ -n "$(tail -c 1 "$CFG")" ]; then echo >>"$t"; fi
  fi
  printf '\nMatch all\n%s\n' "$INC" >>"$t"
  commit "$t" "$CFG"
}

route() {  # name: where `ssh name` goes (hostname, proxy settings), as one comparable string
  ssh -G "$1" </dev/null 2>/dev/null | awk '$1 == "hostname" { h=tolower($2) } $1 == "proxycommand" { c=$0 }
    $1 == "proxyjump" { j=$0 } END { printf "%s|%s|%s", h, c, j }'
}

set_user() {  # name fqdn user: `ssh name` logs in as user, unless that would change where it goes
  dirs; regular "$US"; regular "$MF"; regular "$CFG"
  before=$(route "$1") || before=""
  h=${before%%|*}
  if [ "$h" != "$1" ] && [ "$h" != "$2" ]; then printf '@@SKIP alias %s\n' "${h:-unknown}"; return 0; fi
  old=$(newtmp "$US"); if [ -f "$US" ]; then cat "$US" >"$old" || fail "could not read $US"; fi
  t=$(newtmp "$US")
  if [ -f "$US" ]; then awk -v n="$1" '$1 != n' "$US" >"$t" || { rm -f "$t" "$old"; fail "could not read $US"; }; fi
  printf '%s %s %s\n' "$1" "$3" "$2" >>"$t"
  commit "$t" "$US"; render; ensure_include
  after=$(route "$1") || after=""
  if [ "$after" != "$before" ]; then   # some hand rule reacts to the new User: put everything back
    if [ -s "$old" ]; then commit "$old" "$US"; else rm -f "$old" "$US"; fi
    render; printf '@@SKIP alias %s\n' "changed-by-your-config"; return 0
  fi
  rm -f "$old"
  printf '@@DONE alias\n'
}

unset_user() {  # name user: drop the line only if it is still this user's
  dirs; regular "$US"; regular "$MF"
  if [ -f "$US" ]; then
    t=$(newtmp "$US")
    awk -v n="$1" -v u="$2" '!($1 == n && $2 == u)' "$US" >"$t" || { rm -f "$t"; fail "could not read $US"; }
    commit "$t" "$US"
  fi
  render
  printf '@@DONE unalias\n'
}

verify() {  # dest user nonce: does `ssh dest` log in as user and run exactly our command?
  out=$(ssh -o BatchMode=yes -o ConnectTimeout=10 -o ControlPath=none -o ForwardAgent=no -o AddKeysToAgent=no \
          -o StrictHostKeyChecking=accept-new -o ClearAllForwardings=yes -o RequestTTY=no -o RemoteCommand=none \
          -o PermitLocalCommand=no "$1" "id -un; printf %s $3" </dev/null 2>/dev/null) || out=""
  if [ "$out" = "$2
$3" ]; then printf '@@VERIFY ok\n'; else printf '@@VERIFY fail\n'; fi
}
'''


def die(msg, code=1):
    sys.stderr.write("%s: %s\n" % (PROG, msg))
    raise SystemExit(code)


def say(msg=""):
    sys.stderr.write(msg + "\n")


# --- tailnet -----------------------------------------------------------------

class Node(object):
    def __init__(self, raw):
        self.fqdn = (raw.get("DNSName") or "").rstrip(".").lower()
        self.name = self.fqdn.split(".")[0]
        self.ips = [ip.lower() for ip in (raw.get("TailscaleIPs") or [])]
        self.online = bool(raw.get("Online", True))

    def valid(self):
        return bool(NAME_RE.match(self.name) and FQDN_RE.match(self.fqdn) and self.ips
                    and all(is_ip(ip) for ip in self.ips))


def is_ip(text):
    try:
        ipaddress.ip_address(text)
        return True
    except ValueError:
        return False


def tailnet():
    exe = next((c for c in (shutil.which("tailscale"), "/usr/local/bin/tailscale", "/opt/homebrew/bin/tailscale",
                            "/Applications/Tailscale.app/Contents/MacOS/Tailscale")
                if c and os.access(c, os.X_OK)), None)
    if not exe:
        die("tailscale CLI not found")
    p = subprocess.run([exe, "status", "--json"], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       universal_newlines=True, timeout=30)
    if p.returncode != 0:
        die("tailscale status failed: %s" % p.stderr.strip())
    data = json.loads(p.stdout)
    me = Node(data.get("Self") or {})
    if not me.valid():
        die("this host has no usable tailnet name and IPs (is Tailscale up, with MagicDNS on?)")
    peers = [n for n in (Node(p) for p in (data.get("Peer") or {}).values()) if n.valid()]
    return me, peers


def find_peer(peers, target):
    t = target.lower().rstrip(".")
    hits = [p for p in peers if t in (p.name, p.fqdn)]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        die("no tailnet peer named %r; peers: %s" % (target, ", ".join(sorted(p.name for p in peers)) or "none"))
    die("%r matches several peers: %s; use the full name" % (target, ", ".join(p.fqdn for p in hits)))


def fleet_user(peer):
    """Default user for a peer from fleet.json ("ssh": "user@host"), if listed."""
    try:
        hosts = json.loads(FLEET_JSON.read_text()).get("hosts", [])
        for h in hosts:
            ssh = str(h.get("ssh", ""))
            if "@" in ssh and ssh.split("@", 1)[1].lower().rstrip(".") in (peer.name, peer.fqdn):
                return ssh.split("@", 1)[0]
    except (OSError, ValueError, AttributeError, TypeError):
        pass
    return None


def local_user():
    u = pwd.getpwuid(os.getuid()).pw_name   # the real account, not LOGNAME/USER
    if not USER_RE.match(u):
        die("unsupported local user name %r" % u)
    return u


# --- records and lock -------------------------------------------------------

def load_records():
    if not RECORDS.exists():
        return {"links": {}}
    try:
        data = json.loads(RECORDS.read_text())
    except (OSError, ValueError) as exc:
        die("cannot read %s (%s); fix or move it away" % (RECORDS, exc))
    if not isinstance(data, dict) or not isinstance(data.get("links"), dict):
        die("%s is not a fleet-ssh record file; fix or move it away" % RECORDS)
    return data


def save_records(data):
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(str(STATE), 0o700)
    fd, tmp = tempfile.mkstemp(dir=str(STATE), prefix=".fleet-ssh.")
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh, indent=1, sort_keys=True)
    os.replace(tmp, str(RECORDS))


@contextlib.contextmanager
def host_lock():
    """The same lock the step scripts take, held by this process for the whole operation."""
    LOCK.parent.mkdir(mode=0o700, exist_ok=True)
    if LOCK.is_symlink():
        die("%s is a symlink; fix it by hand" % LOCK)
    fd = os.open(str(LOCK), os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            die("another fleet-ssh run is changing ssh files here; retry when it ends")
        global LOCK_FD
        LOCK_FD = fd
        yield
    finally:
        LOCK_FD = None
        os.close(fd)


# --- running steps ------------------------------------------------------------

def script(calls, lock):
    body = "\n".join(" ".join(shlex.quote(str(a)) for a in c) for c in calls)
    return OPS + ("\ntake_lock" if lock else "") + "\necho @@BEGIN\n" + body + "\necho @@END\n"


def parse(stdout, where):
    res = []
    for line in stdout.splitlines():
        if line.startswith("@@"):
            res.append(line[2:])
        elif line.strip():
            say("  " + line)
    if not res or res[0] != "BEGIN" or res[-1] != "END":
        die("fleet-ssh steps did not run to completion on %s (a forced command= on the key, "
            "or an unusual login shell?)" % where)
    return res[1:-1]


def run_local(*calls):
    # Local steps inherit this process's locked descriptor, so the lock outlives this process
    # until the step itself ends (a killed parent cannot let another run in mid-step).
    p = subprocess.run(["sh", "-s"], input=script(calls, lock=False), stdout=subprocess.PIPE,
                       universal_newlines=True, timeout=STEP_TIMEOUT,
                       pass_fds=(LOCK_FD,) if LOCK_FD is not None else ())
    if p.returncode != 0:
        die("a step failed on this host (exit %d)" % p.returncode)
    return parse(p.stdout, "this host")


# fleet-ssh's own connections read no ssh config at all.
BASE = ["ssh", "-F", "none", "-o", "ForwardAgent=no", "-o", "ClearAllForwardings=yes", "-o", "RequestTTY=no",
        "-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=15", "-o", "StrictHostKeyChecking=accept-new"]


class Remote(object):
    """One multiplexed connection to user@fqdn; the only place a password is asked."""

    def __init__(self, user, fqdn):
        self.dest = "%s@%s" % (user, fqdn)
        self.dir = tempfile.mkdtemp(prefix="fleet-ssh-", dir="/tmp" if os.path.isdir("/tmp") else None)
        self.sock = os.path.join(self.dir, "m")

    def open(self, hint=""):
        say("Connecting to %s (enter its password if asked)..." % self.dest)
        # Every default identity file this account has (not every agent key, which can exhaust
        # the server's MaxAuthTries), then the password.
        ident = ["-o", "IdentitiesOnly=yes"]
        for name in ("id_rsa", "id_ecdsa", "id_ecdsa_sk", "id_ed25519", "id_ed25519_sk"):
            if (HOME / ".ssh" / name).is_file():
                ident += ["-i", str(HOME / ".ssh" / name)]
        rc = subprocess.call(BASE + ident + ["-o", "ControlMaster=yes", "-o", "ControlPath=" + self.sock,
                                             "-o", "ControlPersist=300", "-fN", self.dest])
        if rc != 0:
            die("could not connect to %s%s" % (self.dest, hint))

    def run(self, calls, lock=True):
        # Only through the open master: ProxyCommand=false makes any fallback connection fail.
        p = subprocess.run(BASE + ["-T", "-o", "BatchMode=yes", "-o", "ControlMaster=no",
                                   "-o", "ControlPath=" + self.sock, "-o", "ProxyCommand=false",
                                   self.dest, "sh -s"],
                           input=script(calls, lock), stdout=subprocess.PIPE, universal_newlines=True,
                           timeout=STEP_TIMEOUT)
        if p.returncode != 0:
            die("a step failed on %s (exit %d)" % (self.dest, p.returncode))
        return parse(p.stdout, self.dest)

    def close(self):
        subprocess.call(["ssh", "-F", "none", "-o", "ControlPath=" + self.sock, "-O", "exit", self.dest],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        shutil.rmtree(self.dir, ignore_errors=True)


def need(results, *acks):
    for a in acks:
        if a not in results:
            die("a step did not confirm '%s'; nothing was assumed" % a)


def key_blob_ok(ktype, blob):
    """The blob is SSH wire format whose embedded type string is ktype."""
    if not (KTYPE_RE.match(ktype) and BLOB_RE.match(blob)):
        return False
    try:
        raw = base64.b64decode(blob, validate=True)
    except ValueError:
        return False
    n = int.from_bytes(raw[:4], "big") if len(raw) >= 4 else -1
    return n == len(ktype) and raw[4:4 + n] == ktype.encode() and len(raw) > 4 + n + 4


def pub_line(results, src_ips, tag):
    pubs = [r.split()[1:3] for r in results if r.startswith("PUB ")]
    if len(pubs) != 1 or len(pubs[0]) != 2 or not key_blob_ok(*pubs[0]):
        die("did not get a valid public key")
    if not src_ips or not all(is_ip(ip) for ip in src_ips):
        die("no valid source addresses to pin")
    return 'from="%s" %s %s %s' % (",".join(src_ips), pubs[0][0], pubs[0][1], tag)


def alias_report(results, where, name, user):
    skip = [r for r in results if r.startswith("SKIP alias ")]
    if skip:
        say("  %s: your ssh config sends '%s' to %s, so fleet-ssh left it alone (use ssh %s@<full name>)"
            % (where, name, skip[0].split(" ", 2)[2], user))
        return False
    say("  %s: ssh %s -> %s@%s" % (where, name, user, name))
    return True


def dest(rec, side, name, user, fqdn):
    """What to test: the alias when fleet-ssh wrote it, else user@fqdn explicitly."""
    return name if rec.get("alias_" + side) else "%s@%s" % (user, fqdn)


def check(where, target, user, how):
    good = "VERIFY ok" in how(target, user)
    say("  %sssh %s: %s" % (where, target, "works" if good else "FAILED"))
    return good


# --- commands ----------------------------------------------------------------

def link(me, peer, direction, user, yes):
    lu = local_user()
    if not USER_RE.match(user):
        die("bad user %r" % user)
    if peer.fqdn == me.fqdn:
        die("TARGET is this host")
    to, frm = direction in ("to", "both"), direction in ("from", "both")
    my_tag, peer_tag = "%s:%s@%s" % (TAG, lu, me.fqdn), "%s:%s@%s" % (TAG, user, peer.fqdn)
    say("Plan:")
    if to:
        say("  here:  ssh %s   (as %s@%s)" % (peer.name, user, peer.fqdn))
    if frm:
        say("  there: ssh %s   (as %s@%s, run on %s)" % (me.name, lu, me.fqdn, peer.name))
    if not peer.online:
        say("  note: tailscale reports %s offline" % peer.name)
    if not yes:
        if not sys.stdin.isatty():
            die("not a terminal; pass --yes to proceed")
        try:
            if input("Proceed? [Y/n] ").strip().lower() not in ("", "y", "yes"):
                die("cancelled", 0)
        except EOFError:
            die("cancelled", 0)

    key = "%s@%s" % (user, peer.fqdn)
    with host_lock():
        mine = run_local(("ensure_key", "%s@%s" % (lu, me.name))) if to else []
        rem = Remote(user, peer.fqdn)
        ok = True
        try:
            rem.open()
            # Record first: whatever happens next, `fleet-ssh unlink` can clean up both ends.
            records = load_records()
            prev = records["links"].get(key) or {}
            rec = dict(prev)
            rec.update({"fqdn": peer.fqdn, "name": peer.name, "user": user, "to": to or prev.get("to", False),
                        "from": frm or prev.get("from", False), "tag_there": my_tag,
                        "name_there": me.name, "tag_here": peer_tag})
            records["links"][key] = rec
            save_records(records)
            calls = []
            if frm:
                calls += [("ensure_key", "%s@%s" % (user, peer.name))]
            if to:
                calls += [("authorize", my_tag, pub_line(mine, me.ips, my_tag))]
            if frm:
                calls += [("set_user", me.name, me.fqdn, lu)]
            # This host was renamed since the last link: retire what the old names installed there.
            if prev.get("to") and prev.get("tag_there") not in (None, my_tag) and TAG_RE.match(prev["tag_there"]):
                calls += [("deauthorize", prev["tag_there"])]
            if prev.get("from") and prev.get("name_there") not in (None, me.name) and NAME_RE.match(prev["name_there"]):
                calls += [("unset_user", prev["name_there"], lu)]
            there = rem.run(calls)
            need(there, *(["DONE authorize"] if to else []))
            if frm:
                need(run_local(("authorize", peer_tag, pub_line(there, peer.ips, peer_tag))), "DONE authorize")
                rec["alias_there"] = alias_report(there, peer.name, me.name, lu)
                if rec["alias_there"]:
                    need(there, "DONE alias")
            if to:
                here = run_local(("set_user", peer.name, peer.fqdn, user))
                rec["alias_here"] = alias_report(here, me.name, peer.name, user)
                if rec["alias_here"]:
                    need(here, "DONE alias")
            save_records(records)
            say("Checking with the real ssh command...")
            if to:
                ok &= check("", dest(rec, "here", peer.name, user, peer.fqdn), user,
                            lambda d, u: run_local(("verify", d, u, secrets.token_hex(16))))
            if frm:
                good = check("on %s: " % peer.name, dest(rec, "there", me.name, lu, me.fqdn), lu,
                             lambda d, u: rem.run([("verify", d, u, secrets.token_hex(16))], lock=False))
                ok &= good
                if not good:
                    say("  (is sshd running here? Linux: sudo systemctl enable --now sshd; "
                        "macOS: System Settings > General > Sharing > Remote Login)")
        finally:
            rem.close()
    if not ok:
        raise SystemExit(1)


def find_record(records, target):
    t = target.lower().rstrip(".")
    user, _, host = t.rpartition("@")
    hits = [(k, r) for k, r in records["links"].items()
            if host in (r.get("fqdn"), r.get("name")) and (not user or user == r.get("user"))]
    if len(hits) != 1:
        die("%s recorded link matches %r (recorded: %s); use user@host"
            % ("more than one" if hits else "no", target, ", ".join(sorted(records["links"])) or "none"))
    return hits[0]


def record_ok(key, r, lu):
    fqdn, user = str(r.get("fqdn", "")), str(r.get("user", ""))
    return (FQDN_RE.match(fqdn) and USER_RE.match(user) and key == "%s@%s" % (user, fqdn)
            and NAME_RE.match(str(r.get("name", ""))) and NAME_RE.match(str(r.get("name_there", "")))
            and r.get("tag_here") == "%s:%s@%s" % (TAG, user, fqdn)
            and TAG_RE.match(str(r.get("tag_there", "")))
            and str(r.get("tag_there", "")).startswith("%s:%s@" % (TAG, lu)))


def unlink(target, local_only):
    lu = local_user()
    with host_lock():
        records = load_records()
        key, r = find_record(records, target)
        if not record_ok(key, r, lu):
            die("the record for %s is damaged; fix or remove it in %s" % (key, RECORDS))
        if not local_only:
            calls = []
            if r.get("from"):
                calls += [("unset_user", r["name_there"], lu)]
            if r.get("to"):
                calls += [("deauthorize", r["tag_there"])]   # last: it may be what lets us back in
            if calls:
                rem = Remote(r["user"], r["fqdn"])
                try:
                    rem.open(hint="; nothing was changed. If %s is gone for good: fleet-ssh unlink %s --local-only"
                             % (r["name"], key))
                    need(rem.run(calls), *(["DONE unalias"] if r.get("from") else []) +
                         (["DONE deauthorize"] if r.get("to") else []))
                finally:
                    rem.close()
            say("  %s: removed what this link installed there" % r["name"])
        calls = []
        if r.get("from"):
            calls += [("deauthorize", r["tag_here"])]
        if r.get("to"):
            calls += [("unset_user", r["name"], r["user"])]
        if calls:
            need(run_local(*calls), *(["DONE deauthorize"] if r.get("from") else []) +
                 (["DONE unalias"] if r.get("to") else []))
        del records["links"][key]
        save_records(records)
        say("  this host: removed what this link installed here")


def status():
    records = load_records()
    if not records["links"]:
        say("No recorded links.")
        return
    bad = False
    for key, r in sorted(records["links"].items()):
        parts = []
        if r.get("to"):
            target = dest(r, "here", r.get("name"), r.get("user"), r.get("fqdn"))
            good = "VERIFY ok" in run_local(("verify", target, r.get("user"), secrets.token_hex(16)))
            bad |= not good
            parts.append("ssh %s %s" % (target, "works" if good else "FAILED"))
        if r.get("from"):
            present = "TAG yes" in run_local(("has_tag", r["tag_here"]))
            bad |= not present
            parts.append("its key %s here" % ("accepted" if present else "MISSING"))
        say("  %-36s %s" % (key, "; ".join(parts)))
    if bad:
        raise SystemExit(1)


def wizard(me, peers):
    if not sys.stdin.isatty():
        die("no terminal for the wizard; use: fleet-ssh link TARGET ...")

    def ask(prompt, default=None, choices=None):
        while True:
            hint = (" (%s)" % "/".join(choices) if choices else "") + (" [%s]" % default if default else "")
            try:
                v = input("%s%s: " % (prompt, hint)).strip() or (default or "")
            except EOFError:
                die("cancelled", 0)
            if v and (not choices or v in choices):
                return v

    online = sorted(p.name for p in peers if p.online)
    say("This host: %s (%s). Online peers: %s" % (me.name, local_user(), ", ".join(online) or "none"))
    default = "nous" if any(p.name == "nous" for p in peers) else None
    peer = find_peer(peers, ask("Link with which host", default))
    say("Directions: to = ssh %s from here; from = ssh %s from there; both" % (peer.name, me.name))
    direction = ask("Direction", "both", ["both", "to", "from"])
    user = ask("Your user on %s" % peer.name, fleet_user(peer) or local_user())
    link(me, peer, direction, user, yes=False)


def main(argv):
    ap = argparse.ArgumentParser(prog=PROG, description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    lk = sub.add_parser("link", help="link with TARGET")
    lk.add_argument("target")
    lk.add_argument("--direction", choices=["both", "to", "from"], default="both")
    lk.add_argument("--user", help="your user on TARGET (default: fleet.json, else this user)")
    lk.add_argument("--yes", action="store_true", help="skip the confirmation")
    ul = sub.add_parser("unlink", help="remove a recorded link on both ends")
    ul.add_argument("target")
    ul.add_argument("--local-only", action="store_true", help="only this host's side (TARGET is gone)")
    sub.add_parser("status", help="check recorded links")
    args = ap.parse_args(argv)
    if args.cmd == "status":
        status()
    elif args.cmd == "unlink":
        unlink(args.target, args.local_only)
    else:
        me, peers = tailnet()
        if args.cmd is None:
            wizard(me, peers)
        else:
            peer = find_peer(peers, args.target)
            link(me, peer, args.direction, args.user or fleet_user(peer) or local_user(), args.yes)


def _terminate(signum, frame):
    raise SystemExit(128 + signum)   # unwind like Ctrl-C: close the master, release the lock


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGHUP, _terminate)
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        die("interrupted", 130)
    except subprocess.TimeoutExpired:
        die("a step took too long and was stopped")
