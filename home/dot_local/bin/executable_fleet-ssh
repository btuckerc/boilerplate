#!/usr/bin/env python3
"""fleet-ssh: let this host and another tailnet host SSH to each other by name.

Usage:
  fleet-ssh                      interactive wizard
  fleet-ssh link TARGET [--direction both|to|from] [--user USER] [--yes]
  fleet-ssh unlink TARGET [--local-only]
  fleet-ssh status

Directions, from the host you run it on:
  to    this host -> TARGET: afterwards `ssh TARGET` works here
  from  TARGET -> this host: afterwards `ssh <this host>` works there
  both  both of the above

Design (each choice removes a class of failure):
- Names are tailnet names (MagicDNS resolves them), so fleet-ssh never decides
  which machine a name reaches. It adds only `Match originalhost NAME` /
  `User USER` / `HostKeyAlias FQDN` blocks (so `ssh NAME` must meet the same
  host key as the tailnet name), in a file it regenerates from its own list
  (~/.ssh/config.d/decent-angl-fleet.users), included at the end of
  ~/.ssh/config: anything you wrote yourself still wins. If your config sends
  NAME to another machine, no block is written for it.
- Keys are each account's default ~/.ssh/id_ed25519 (created if missing), so a
  plain `ssh NAME` offers it. The public half is derived from the private key
  (or, for a passphrase-protected key, read from a regular, parseable .pub).
- authorized_keys lines are pinned with from=<source tailnet IPs> and tagged
  decent-angl-fleet:<user>@<fqdn>; only non-comment lines with exactly that
  tag are ever replaced or removed.
- fleet-ssh's own connections use `ssh -F none`: nothing in ~/.ssh/config can
  redirect, wrap or alter them. One connection does all remote work, so the
  target's password is asked at most once.
- Every step reports an explicit result; a missing one is a failure. The final
  check runs the real `ssh NAME` with a random nonce.
- Links are recorded in ~/.local/state/decent-angl/fleet-ssh.json, so status
  and unlink need neither Tailscale nor guesses. Each host serializes fleet-ssh
  changes with an flock.
"""
import argparse
import contextlib
import fcntl
import getpass
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

PROG = "fleet-ssh"
TAG = "decent-angl-fleet"
HOME = Path.home()
STATE = HOME / ".local/state/decent-angl"
RECORDS = STATE / "fleet-ssh.json"
LOCK = HOME / ".ssh/.decent-angl-fleet.lock"
FLEET_JSON = HOME / ".config/decent-angl/fleet.json"
NAME_RE = re.compile(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?\Z")
FQDN_RE = re.compile(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+\Z")
USER_RE = re.compile(r"[a-z_][a-z0-9_.-]{0,31}\Z")
IP_RE = re.compile(r"[0-9a-f:.]{2,39}\Z")
KTYPE_RE = re.compile(r"(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-[a-z0-9-]+@openssh\.com)\Z")
BLOB_RE = re.compile(r"[A-Za-z0-9+/]+={0,3}\Z")
TAG_RE = re.compile(r"decent-angl-fleet:[a-z_][a-z0-9_.-]{0,31}@[a-z0-9.-]+\Z")
STEP_TIMEOUT = 120

# Runs under sh on both ends; arguments are validated in Python and passed with shlex.quote.
# Results are "@@" lines on stdout; messages for the person go to stderr.
OPS = r'''
set -euf
umask 077
D="$HOME/.ssh"; KEY="$D/id_ed25519"; AK="$D/authorized_keys"; CFG="$D/config"
CD="$D/config.d"; US="$CD/decent-angl-fleet.users"; MF="$CD/decent-angl-fleet.conf"
INC="Include ~/.ssh/config.d/decent-angl-fleet.conf"
fail() { printf 'fleet-ssh: %s: %s\n' "$(uname -n)" "$*" >&2; exit 1; }
regular() { [ ! -L "$1" ] || fail "$1 is a symlink; fix it by hand"; [ ! -e "$1" ] || [ -f "$1" ] || fail "$1 is not a regular file"; }
prep() { mkdir -p "$CD"; chmod 700 "$D" "$CD"; }
put() {  # file: replace it atomically with stdin (temp file in the same directory)
  t=$(mktemp "$(dirname "$1")/.fleet-ssh.XXXXXX"); cat >"$t"; chmod 600 "$t"; mv -f "$t" "$1"
}

take_lock() {  # flock held by this shell until it exits; the kernel drops it if the shell dies
  prep; regular "$D/.decent-angl-fleet.lock"
  command -v python3 >/dev/null 2>&1 || fail "python3 is required"
  exec 9>>"$D/.decent-angl-fleet.lock"
  python3 -c 'import fcntl, sys
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(75)' || fail "another fleet-ssh run is changing ssh files here; retry when it ends"
}

ensure_key() {  # comment
  prep; regular "$KEY"; regular "$KEY.pub"
  if [ ! -e "$KEY" ]; then
    t=$(mktemp -d "$D/.fleet-ssh-key.XXXXXX")
    ssh-keygen -q -t ed25519 -N '' -C "$1" -f "$t/k" </dev/null >/dev/null || { rm -rf "$t"; fail "ssh-keygen failed"; }
    mv -f "$t/k.pub" "$KEY.pub"; mv -f "$t/k" "$KEY"; rmdir "$t"
    printf '  created %s on %s\n' "$KEY" "$(uname -n)" >&2
  fi
  if pub=$(ssh-keygen -y -P '' -f "$KEY" </dev/null 2>/dev/null); then :
  elif [ -f "$KEY.pub" ] && ssh-keygen -l -f "$KEY.pub" >/dev/null 2>&1; then pub=$(head -n 1 "$KEY.pub")
  else fail "$KEY is passphrase-protected and has no usable $KEY.pub"; fi
  set -- $pub
  printf '@@PUB %s %s\n' "$1" "$2"
}

# akeep TAG: authorized_keys without our lines for TAG. Ours = not a comment and the last
# field, ignoring trailing blanks and CR, is exactly TAG.
akeep() {
  awk -v t="$1" '{ l=$0; sub(/[ \t\r]+$/, "", l); n=split(l, a, " ")
                   if (l !~ /^[ \t]*#/ && n > 0 && a[n] == t) next; print }' "$AK"
}

authorize() {  # tag line
  prep; regular "$AK"; [ -e "$AK" ] || : >"$AK"
  kept=$(akeep "$1") || fail "could not read $AK"
  { if [ -n "$kept" ]; then printf '%s\n' "$kept"; fi; printf '%s\n' "$2"; } | put "$AK"
  printf '@@DONE authorize\n'
}

deauthorize() {  # tag
  if [ -e "$AK" ]; then
    regular "$AK"
    kept=$(akeep "$1") || fail "could not read $AK"
    { if [ -n "$kept" ]; then printf '%s\n' "$kept"; fi; } | put "$AK"
  fi
  printf '@@DONE deauthorize\n'
}

render() {  # regenerate the managed config from the users list (only valid lines survive)
  { printf '# Generated by fleet-ssh from %s; edits are overwritten.\n' "$US"
    if [ -f "$US" ]; then
      awk 'NF == 3 && $1 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/ && $2 ~ /^[a-z_][a-z0-9_.-]*$/ &&
           $3 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/ {
             printf "Match originalhost %s\n  User %s\n  HostKeyAlias %s\n", $1, $2, $3 }' "$US"
    fi; } | put "$MF"
}

ensure_include() {  # once, at the end, after "Match all": hand-written settings are read first
  regular "$CFG"; [ -e "$CFG" ] || : >"$CFG"
  grep -qxF "$INC" "$CFG" && return 0
  { cat "$CFG"
    if [ -s "$CFG" ] && [ -n "$(tail -c 1 "$CFG")" ]; then echo; fi
    printf '\nMatch all\n%s\n' "$INC"; } | put "$CFG"
}

set_user() {  # name fqdn user: make `ssh name` log in as user, unless the name goes elsewhere
  prep; regular "$US"; regular "$MF"; regular "$CFG"
  h=$(ssh -G "$1" </dev/null 2>/dev/null | awk '$1 == "hostname" { print tolower($2); exit }') || h=""
  if [ "$h" != "$1" ] && [ "$h" != "$2" ]; then
    printf '@@SKIP alias %s\n' "${h:-unknown}"; return 0
  fi
  { if [ -f "$US" ]; then awk -v n="$1" '$1 != n' "$US"; fi; printf '%s %s %s\n' "$1" "$3" "$2"; } | put "$US"
  render; ensure_include
  printf '@@DONE alias\n'
}

unset_user() {  # name
  prep; regular "$US"; regular "$MF"
  if [ -f "$US" ]; then awk -v n="$1" '$1 != n' "$US" | put "$US"; render; fi
  printf '@@DONE unalias\n'
}

verify() {  # dest nonce: does the real `ssh dest` log in and run exactly our command?
  out=$(ssh -o BatchMode=yes -o ConnectTimeout=10 -o ControlPath=none -o ForwardAgent=no -o StrictHostKeyChecking=accept-new \
          -o ClearAllForwardings=yes -o RequestTTY=no -o RemoteCommand=none -o PermitLocalCommand=no \
          "$1" "printf %s $2" </dev/null 2>/dev/null) || out=""
  if [ "$out" = "$2" ]; then printf '@@VERIFY ok\n'; else printf '@@VERIFY fail\n'; fi
}

has_tag() {  # tag
  if [ -f "$AK" ] && awk -v t="$1" '{ l=$0; sub(/[ \t\r]+$/, "", l); n=split(l, a, " ")
       if (l !~ /^[ \t]*#/ && n > 0 && a[n] == t) f=1 } END { exit !f }' "$AK"; then
    printf '@@TAG yes\n'
  else printf '@@TAG no\n'; fi
}
'''


def die(msg, code=1):
    sys.stderr.write("%s: %s\n" % (PROG, msg))
    raise SystemExit(code)


def say(msg=""):
    sys.stderr.write(msg + "\n")


# --- tailnet -----------------------------------------------------------------

class Node(object):
    def __init__(self, raw):
        self.fqdn = (raw.get("DNSName") or "").rstrip(".").lower()
        self.name = self.fqdn.split(".")[0]
        self.ips = [ip.lower() for ip in (raw.get("TailscaleIPs") or [])]
        self.online = bool(raw.get("Online", True))

    def valid(self):
        return (NAME_RE.match(self.name) and FQDN_RE.match(self.fqdn) and self.ips
                and all(IP_RE.match(ip) for ip in self.ips))


def tailnet():
    exe = next((c for c in (shutil.which("tailscale"), "/usr/local/bin/tailscale", "/opt/homebrew/bin/tailscale",
                            "/Applications/Tailscale.app/Contents/MacOS/Tailscale")
                if c and os.access(c, os.X_OK)), None)
    if not exe:
        die("tailscale CLI not found")
    p = subprocess.run([exe, "status", "--json"], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       universal_newlines=True, timeout=30)
    if p.returncode != 0:
        die("tailscale status failed: %s" % p.stderr.strip())
    data = json.loads(p.stdout)
    me = Node(data.get("Self") or {})
    if not me.valid():
        die("this host has no usable tailnet name and IPs (is Tailscale up, with MagicDNS on?)")
    peers = [n for n in (Node(p) for p in (data.get("Peer") or {}).values()) if n.valid()]
    return me, peers


def find_peer(peers, target):
    t = target.lower().rstrip(".")
    hits = [p for p in peers if t in (p.name, p.fqdn)]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        die("no tailnet peer named %r; peers: %s" % (target, ", ".join(sorted(p.name for p in peers)) or "none"))
    die("%r matches several peers: %s; use the full name" % (target, ", ".join(p.fqdn for p in hits)))


def fleet_user(peer):
    """Default user for a peer from fleet.json ("ssh": "user@host"), if listed."""
    try:
        hosts = json.loads(FLEET_JSON.read_text()).get("hosts", [])
        for h in hosts:
            ssh = str(h.get("ssh", ""))
            if "@" in ssh and ssh.split("@", 1)[1].lower().rstrip(".") in (peer.name, peer.fqdn):
                return ssh.split("@", 1)[0]
    except (OSError, ValueError, AttributeError, TypeError):
        pass
    return None


def local_user():
    u = getpass.getuser()
    if not USER_RE.match(u):
        die("unsupported local user name %r" % u)
    return u


# --- records and lock -------------------------------------------------------

def load_records():
    try:
        data = json.loads(RECORDS.read_text())
        return data if isinstance(data, dict) and isinstance(data.get("links"), dict) else {"links": {}}
    except (OSError, ValueError):
        return {"links": {}}


def save_records(data):
    STATE.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(STATE), prefix=".fleet-ssh.")
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh, indent=1, sort_keys=True)
    os.replace(tmp, str(RECORDS))


@contextlib.contextmanager
def host_lock():
    """The same lock the step scripts take, held by this process for the whole operation."""
    LOCK.parent.mkdir(mode=0o700, exist_ok=True)
    if LOCK.is_symlink():
        die("%s is a symlink; fix it by hand" % LOCK)
    fd = os.open(str(LOCK), os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            die("another fleet-ssh run is changing ssh files here; retry when it ends")
        yield
    finally:
        os.close(fd)


# --- running steps ------------------------------------------------------------

def script(calls, lock):
    body = "\n".join(" ".join(shlex.quote(str(a)) for a in c) for c in calls)
    return OPS + ("\ntake_lock" if lock else "") + "\necho @@BEGIN\n" + body + "\necho @@END\n"


def parse(stdout, where):
    res = []
    for line in stdout.splitlines():
        if line.startswith("@@"):
            res.append(line[2:])
        elif line.strip():
            say("  " + line)
    if not res or res[0] != "BEGIN" or res[-1] != "END":
        die("fleet-ssh steps did not run to completion on %s (a forced command= on the key, "
            "or an unusual login shell?)" % where)
    return res[1:-1]


def run_local(*calls):
    # This process already holds the host lock, so local steps do not take it again.
    p = subprocess.run(["sh", "-s"], input=script(calls, lock=False), stdout=subprocess.PIPE,
                       universal_newlines=True, timeout=STEP_TIMEOUT)
    if p.returncode != 0:
        die("a step failed on this host (exit %d)" % p.returncode)
    return parse(p.stdout, "this host")


# fleet-ssh's own connections read no ssh config at all.
BASE = ["ssh", "-F", "none", "-o", "ForwardAgent=no", "-o", "ClearAllForwardings=yes", "-o", "RequestTTY=no",
        "-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=15", "-o", "StrictHostKeyChecking=accept-new"]


class Remote(object):
    """One multiplexed connection to user@fqdn; the only place a password is asked."""

    def __init__(self, user, fqdn):
        self.dest = "%s@%s" % (user, fqdn)
        self.dir = tempfile.mkdtemp(prefix="fleet-ssh-", dir="/tmp" if os.path.isdir("/tmp") else None)
        self.sock = os.path.join(self.dir, "m")

    def open(self, hint=""):
        say("Connecting to %s (enter its password if asked)..." % self.dest)
        key = HOME / ".ssh/id_ed25519"
        ident = ["-o", "IdentitiesOnly=yes"] + (["-i", str(key)] if key.is_file() else [])
        rc = subprocess.call(BASE + ident + ["-o", "ControlMaster=yes", "-o", "ControlPath=" + self.sock,
                                             "-o", "ControlPersist=300", "-fN", self.dest])
        if rc != 0:
            die("could not connect to %s%s" % (self.dest, hint))

    def run(self, calls, lock=True):
        # Only through the open master: ProxyCommand=false makes any fallback connection fail.
        p = subprocess.run(BASE + ["-T", "-o", "BatchMode=yes", "-o", "ControlMaster=no",
                                   "-o", "ControlPath=" + self.sock, "-o", "ProxyCommand=false",
                                   self.dest, "sh -s"],
                           input=script(calls, lock), stdout=subprocess.PIPE, universal_newlines=True,
                           timeout=STEP_TIMEOUT)
        if p.returncode != 0:
            die("a step failed on %s (exit %d)" % (self.dest, p.returncode))
        return parse(p.stdout, self.dest)

    def close(self):
        subprocess.call(["ssh", "-F", "none", "-o", "ControlPath=" + self.sock, "-O", "exit", self.dest],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        shutil.rmtree(self.dir, ignore_errors=True)


def need(results, *acks):
    for a in acks:
        if a not in results:
            die("a step did not confirm '%s'; nothing was assumed" % a)


def pub_line(results, src_ips, tag):
    pubs = [r.split()[1:3] for r in results if r.startswith("PUB ")]
    if len(pubs) != 1 or len(pubs[0]) != 2 or not KTYPE_RE.match(pubs[0][0]) or not BLOB_RE.match(pubs[0][1]):
        die("did not get a valid public key")
    return 'from="%s" %s %s %s' % (",".join(src_ips), pubs[0][0], pubs[0][1], tag)


def alias_report(results, where, name, user):
    skip = [r for r in results if r.startswith("SKIP alias ")]
    if skip:
        say("  %s: your ssh config sends '%s' to %s, so fleet-ssh left it alone (use ssh %s@<full name>)"
            % (where, name, skip[0].split(" ", 2)[2], user))
        return False
    say("  %s: ssh %s -> %s@%s" % (where, name, user, name))
    return True


def dest(rec, side, name, user, fqdn):
    """What to test: the alias when fleet-ssh wrote it, else user@fqdn explicitly."""
    return name if rec.get("alias_" + side) else "%s@%s" % (user, fqdn)


# --- commands ----------------------------------------------------------------

def link(me, peer, direction, user, yes):
    lu = local_user()
    if not USER_RE.match(user):
        die("bad user %r" % user)
    if peer.fqdn == me.fqdn:
        die("TARGET is this host")
    to, frm = direction in ("to", "both"), direction in ("from", "both")
    my_tag, peer_tag = "%s:%s@%s" % (TAG, lu, me.fqdn), "%s:%s@%s" % (TAG, user, peer.fqdn)
    say("Plan:")
    if to:
        say("  here:  ssh %s   (as %s@%s)" % (peer.name, user, peer.fqdn))
    if frm:
        say("  there: ssh %s   (as %s@%s, run on %s)" % (me.name, lu, me.fqdn, peer.name))
    if not peer.online:
        say("  note: tailscale reports %s offline" % peer.name)
    if not yes:
        if not sys.stdin.isatty():
            die("not a terminal; pass --yes to proceed")
        try:
            if input("Proceed? [Y/n] ").strip().lower() not in ("", "y", "yes"):
                die("cancelled", 0)
        except EOFError:
            die("cancelled", 0)

    with host_lock():
        mine = run_local(("ensure_key", "%s@%s" % (lu, me.name))) if to else []
        rem = Remote(user, peer.fqdn)
        ok = True
        try:
            rem.open()
            # Record first: whatever happens next, `fleet-ssh unlink` can clean up both ends.
            records = load_records()
            rec = records["links"].get(peer.fqdn) or {}
            rec.update({"name": peer.name, "user": user, "to": to or rec.get("to", False),
                        "from": frm or rec.get("from", False), "tag_there": my_tag,
                        "name_there": me.name, "tag_here": peer_tag})
            records["links"][peer.fqdn] = rec
            save_records(records)
            calls = []
            if frm:
                calls += [("ensure_key", "%s@%s" % (user, peer.name))]
            if to:
                calls += [("authorize", my_tag, pub_line(mine, me.ips, my_tag))]
            if frm:
                calls += [("set_user", me.name, me.fqdn, lu)]
            there = rem.run(calls)
            need(there, *(["DONE authorize"] if to else []))
            if frm:
                need(run_local(("authorize", peer_tag, pub_line(there, peer.ips, peer_tag))), "DONE authorize")
                rec["alias_there"] = alias_report(there, peer.name, me.name, lu)
                if rec["alias_there"]:
                    need(there, "DONE alias")
            if to:
                here = run_local(("set_user", peer.name, peer.fqdn, user))
                rec["alias_here"] = alias_report(here, me.name, peer.name, user)
                if rec["alias_here"]:
                    need(here, "DONE alias")
            save_records(records)
            say("Checking with the real ssh command...")
            if to:
                good = "VERIFY ok" in run_local(("verify", dest(rec, "here", peer.name, user, peer.fqdn),
                                                 secrets.token_hex(16)))
                ok &= good
                say("  ssh %s: %s" % (peer.name, "works" if good else "FAILED"))
            if frm:
                good = "VERIFY ok" in rem.run([("verify", dest(rec, "there", me.name, lu, me.fqdn),
                                                secrets.token_hex(16))], lock=False)
                ok &= good
                say("  ssh %s on %s: %s" % (me.name, peer.name, "works" if good else "FAILED"))
                if not good:
                    say("  (is sshd running here? Linux: sudo systemctl enable --now sshd; "
                        "macOS: System Settings > General > Sharing > Remote Login)")
        finally:
            rem.close()
    if not ok:
        raise SystemExit(1)


def find_record(records, target):
    t = target.lower().rstrip(".")
    hits = [(f, r) for f, r in records["links"].items() if t in (f, r.get("name"))]
    if len(hits) != 1:
        die("no single recorded link matches %r (recorded: %s)"
            % (target, ", ".join(sorted(records["links"])) or "none"))
    return hits[0]


def unlink(target, local_only):
    with host_lock():
        records = load_records()
        fqdn, r = find_record(records, target)
        if not (FQDN_RE.match(fqdn) and NAME_RE.match(str(r.get("name", ""))) and USER_RE.match(str(r.get("user", "")))
                and NAME_RE.match(str(r.get("name_there", ""))) and TAG_RE.match(str(r.get("tag_there", "")))
                and TAG_RE.match(str(r.get("tag_here", "")))):
            die("the record for %s is damaged; remove it from %s by hand" % (fqdn, RECORDS))
        if not local_only:
            rem = Remote(r["user"], fqdn)
            try:
                rem.open(hint="; nothing was changed. If %s is gone for good: fleet-ssh unlink %s --local-only"
                         % (r["name"], r["name"]))
                there = rem.run([("deauthorize", r["tag_there"]), ("unset_user", r["name_there"])])
                need(there, "DONE deauthorize", "DONE unalias")
            finally:
                rem.close()
            say("  %s: removed this host's key and name" % r["name"])
        here = run_local(("deauthorize", r["tag_here"]), ("unset_user", r["name"]))
        need(here, "DONE deauthorize", "DONE unalias")
        del records["links"][fqdn]
        save_records(records)
        say("  this host: removed %s's key and name" % r["name"])


def status():
    records = load_records()
    if not records["links"]:
        say("No recorded links.")
        return
    bad = False
    for fqdn, r in sorted(records["links"].items()):
        parts = []
        if r.get("to"):
            good = "VERIFY ok" in run_local(("verify", dest(r, "here", r["name"], r["user"], fqdn),
                                             secrets.token_hex(16)))
            bad |= not good
            parts.append("ssh %s %s" % (r["name"], "works" if good else "FAILED"))
        if r.get("from"):
            present = "TAG yes" in run_local(("has_tag", r["tag_here"]))
            bad |= not present
            parts.append("its key %s here" % ("accepted" if present else "MISSING"))
        say("  %-28s %s" % (fqdn, "; ".join(parts)))
    if bad:
        raise SystemExit(1)


def wizard(me, peers):
    if not sys.stdin.isatty():
        die("no terminal for the wizard; use: fleet-ssh link TARGET ...")

    def ask(prompt, default=None, choices=None):
        while True:
            hint = (" (%s)" % "/".join(choices) if choices else "") + (" [%s]" % default if default else "")
            try:
                v = input("%s%s: " % (prompt, hint)).strip() or (default or "")
            except EOFError:
                die("cancelled", 0)
            if v and (not choices or v in choices):
                return v

    online = sorted(p.name for p in peers if p.online)
    say("This host: %s (%s). Online peers: %s" % (me.name, local_user(), ", ".join(online) or "none"))
    default = "nous" if any(p.name == "nous" for p in peers) else None
    peer = find_peer(peers, ask("Link with which host", default))
    say("Directions: to = ssh %s from here; from = ssh %s from there; both" % (peer.name, me.name))
    direction = ask("Direction", "both", ["both", "to", "from"])
    user = ask("Your user on %s" % peer.name, fleet_user(peer) or local_user())
    link(me, peer, direction, user, yes=False)


def main(argv):
    ap = argparse.ArgumentParser(prog=PROG, description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    lk = sub.add_parser("link", help="link with TARGET")
    lk.add_argument("target")
    lk.add_argument("--direction", choices=["both", "to", "from"], default="both")
    lk.add_argument("--user", help="your user on TARGET (default: fleet.json, else this user)")
    lk.add_argument("--yes", action="store_true", help="skip the confirmation")
    ul = sub.add_parser("unlink", help="remove a recorded link on both ends")
    ul.add_argument("target")
    ul.add_argument("--local-only", action="store_true", help="only this host's side (TARGET is gone)")
    sub.add_parser("status", help="check recorded links")
    args = ap.parse_args(argv)
    if args.cmd == "status":
        status()
    elif args.cmd == "unlink":
        unlink(args.target, args.local_only)
    else:
        me, peers = tailnet()
        if args.cmd is None:
            wizard(me, peers)
        else:
            peer = find_peer(peers, args.target)
            link(me, peer, args.direction, args.user or fleet_user(peer) or local_user(), args.yes)


def _terminate(signum, frame):
    raise SystemExit(128 + signum)   # unwind like Ctrl-C: close the master, release the lock


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGHUP, _terminate)
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        die("interrupted", 130)
    except subprocess.TimeoutExpired:
        die("a step took too long and was stopped")
