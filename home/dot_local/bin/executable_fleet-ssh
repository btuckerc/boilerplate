#!/usr/bin/env python3
"""fleet-ssh: let this host and another tailnet host SSH to each other by name.

Usage:
  fleet-ssh                      interactive wizard
  fleet-ssh link TARGET [--direction both|to|from] [--user USER] [--yes]
  fleet-ssh unlink TARGET [--local-only]
  fleet-ssh status

Directions, from the host you run it on:
  to    this host -> TARGET: afterwards `ssh TARGET` works here
  from  TARGET -> this host: afterwards `ssh <this host>` works there
  both  both of the above

Design (each choice removes a class of failure):
- Names are tailnet names. For a linked NAME, fleet-ssh keeps one marked section
  at the top of ~/.ssh/config: `Match originalhost NAME` pinning HostName to
  the tailnet FQDN, User, Port 22, ProxyCommand/ProxyJump none, HostKeyAlias
  and ForwardAgent no, then `Match all`. OpenSSH keeps the first value it
  reads, so nothing later (Match final, includes, hand rules) can reroute
  `ssh NAME`; other names are untouched. A NAME is claimed only if your config
  already sends it to that host on port 22 without a proxy, and never if
  fleet-ssh already maps it to another user. Once linked, `ssh NAME` belongs to
  fleet-ssh until `fleet-ssh unlink`, which gives it back to your own config.
  The section is generated from ~/.local/state/decent-angl/fleet-ssh.users.
- Keys are each account's default ~/.ssh/id_ed25519 (created if missing), so a
  plain `ssh NAME` offers it. The public half is derived from the private key
  (a stale .pub is rewritten); a passphrase-protected key is used only when
  ssh-agent holds it.
- authorized_keys lines are pinned with from=<source tailnet IPs> and tagged
  decent-angl-fleet:<user>@<fqdn>; only non-comment lines with exactly that
  tag are ever replaced or removed.
- fleet-ssh's own connections use `ssh -F none`: nothing in ~/.ssh/config can
  redirect, wrap or alter them. Setup offers at most four key attempts from this
  account's key files, then the password, in one connection (within the default
  MaxAuthTries, and without tripping per-source penalties). One connection does
  all remote work.
- Host keys: the peer's key is learned on first use over the tailnet (peers are
  WireGuard-authenticated); this host gives the peer its own host keys from
  /etc/ssh, so the reverse direction needs no first-use trust.
- Each step script refuses to run unless it runs as the expected account, and
  reports an explicit result for every change; a missing one is a failure. The
  final check runs the real `ssh NAME` (or a direct key login when NAME is not
  fleet-ssh's) with a random nonce; a name this run set up that fails is
  taken back.
- Scope: checks are non-interactive, so config that branches on a terminal is
  outside what fleet-ssh can confirm. Renaming a local account invalidates
  its records (they are refused, not guessed).
- Links are recorded per user@host in ~/.local/state/decent-angl/fleet-ssh.json,
  so status and unlink need neither Tailscale nor guesses, and unlink removes
  only what that link installed. Each host serializes fleet-ssh with an flock.
"""
import argparse
import base64
import contextlib
import fcntl
import ipaddress
import json
import os
import pwd
import re
import secrets
import shlex
import shutil
import socket
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

PROG = "fleet-ssh"
TAG = "decent-angl-fleet"
HOME = Path.home()
STATE = HOME / ".local/state/decent-angl"
RECORDS = STATE / "fleet-ssh.json"
LOCK = HOME / ".ssh/.decent-angl-fleet.lock"
FLEET_JSON = HOME / ".config/decent-angl/fleet.json"
NAME_RE = re.compile(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?\Z")
FQDN_RE = re.compile(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+\Z")
USER_RE = re.compile(r"[a-z_][a-z0-9_.-]{0,31}\Z")
KTYPE_RE = re.compile(r"(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-[a-z0-9-]+@openssh\.com)\Z")
BLOB_RE = re.compile(r"[A-Za-z0-9+/]+={0,3}\Z")
TAG_RE = re.compile(r"decent-angl-fleet:[a-z_][a-z0-9_.-]{0,31}@[a-z0-9.-]+\Z")
STEP_TIMEOUT = 120
LOCK_FD = None   # held for a whole operation and inherited by local steps (see host_lock)

# Runs under sh on both ends; arguments are validated in Python and passed with shlex.quote.
# Results are "@@" lines on stdout; messages for the person go to stderr.
OPS = r'''
set -euf
umask 077
D="$HOME/.ssh"; KEY="$D/id_ed25519"; AK="$D/authorized_keys"; CFG="$D/config"; KH="$D/known_hosts"
SD="$HOME/.local/state/decent-angl"; US="$SD/fleet-ssh.users"
BEGIN="# BEGIN fleet-ssh: generated, edits here are overwritten"; END="# END fleet-ssh"
fail() { printf 'fleet-ssh: %s: %s\n' "$(uname -n)" "$*" >&2; exit 1; }
regular() { [ ! -L "$1" ] || fail "$1 is a symlink; fix it by hand"; [ ! -e "$1" ] || [ -f "$1" ] || fail "$1 is not a regular file"; }
dirs() {
  for d in "$D" "$SD"; do [ ! -L "$d" ] || fail "$d is a symlink; fix it by hand"; done
  mkdir -p "$D" "$SD"; chmod 700 "$D" "$SD"
}
newtmp() { mktemp "$(dirname "$1")/.fleet-ssh.XXXXXX"; }
commit() { chmod 600 "$1"; mv -f "$1" "$2"; }   # tmp dest: atomic replace in the same directory

take_lock() {  # flock held by this shell until it exits; the kernel drops it if the shell dies
  dirs; regular "$D/.decent-angl-fleet.lock"
  command -v python3 >/dev/null 2>&1 || fail "python3 is required"
  exec 9>>"$D/.decent-angl-fleet.lock"
  python3 -c 'import fcntl, sys
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(75)' || fail "another fleet-ssh run is changing ssh files here; retry when it ends"
}

ensure_key() {  # comment
  dirs; regular "$KEY"; regular "$KEY.pub"
  if [ ! -e "$KEY" ]; then
    [ ! -e "$KEY.pub" ] || fail "$KEY.pub exists without $KEY; move it away first"
    t=$(mktemp -d "$D/.fleet-ssh-key.XXXXXX")
    ssh-keygen -q -t ed25519 -N '' -C "$1" -f "$t/k" </dev/null >/dev/null || { rm -rf "$t"; fail "ssh-keygen failed"; }
    mv -f "$t/k" "$KEY"; mv -f "$t/k.pub" "$KEY.pub"; rmdir "$t"   # key first: a lone key is repairable
    printf '  created %s on %s\n' "$KEY" "$(uname -n)" >&2
  fi
  if pub=$(ssh-keygen -y -P '' -f "$KEY" </dev/null 2>/dev/null); then
    set -- $pub
    # ssh offers the .pub's key; a stale .pub would offer a key the private file cannot sign for.
    cur=$(awk '{ sub(/\r$/, "") } !/^[ \t]*(#|$)/ { print $1, $2; exit }' "$KEY.pub" 2>/dev/null) || cur=""
    if [ "$cur" != "$1 $2" ]; then
      t=$(newtmp "$KEY.pub"); printf '%s %s %s\n' "$1" "$2" "${3:-fleet-ssh}" >"$t"; chmod 644 "$t"; mv -f "$t" "$KEY.pub"
      printf '  rewrote %s from %s\n' "$KEY.pub" "$KEY" >&2
    fi
  else  # passphrase-protected: usable only when the agent holds exactly this .pub's key
    ssh-keygen -y -P '' -f "$KEY" </dev/null 2>&1 | grep -qi passphrase || fail "$KEY is not a readable private key"
    [ -f "$KEY.pub" ] || fail "$KEY is passphrase-protected and has no $KEY.pub"
    set -- $(awk '{ sub(/\r$/, "") } !/^[ \t]*(#|$)/ { print $1, $2; exit }' "$KEY.pub")
    [ $# -ge 2 ] || fail "$KEY.pub holds no key"
    ssh-add -L 2>/dev/null | awk -v t="$1" -v b="$2" '$1 == t && $2 == b { f=1 } END { exit !f }' \
      || fail "$KEY is passphrase-protected; load it into ssh-agent (ssh-add) and retry"
  fi
  printf '@@PUB %s %s\n' "$1" "$2"
}

# A line is ours for TAG when it is not a comment and its last field, ignoring trailing blanks
# and CR, is exactly TAG.
OURS='function ours(t,  l, a, n) { l=$0; sub(/[ \t\r]+$/, "", l); n=split(l, a, " ")
      return l !~ /^[ \t]*#/ && n > 0 && a[n] == t } '

count_ours() {  # tag: number of our lines; a read error is a failure, never "none"
  n=$(awk -v t="$1" "$OURS"'ours(t) { c++ } END { print c + 0 }' "$AK") || fail "could not read $AK"
  printf '%s' "$n"
}

authorize() {  # tag line
  dirs; regular "$AK"
  t=$(newtmp "$AK")
  if [ -f "$AK" ]; then awk -v t="$1" "$OURS"'!ours(t)' "$AK" >"$t" || { rm -f "$t"; fail "could not read $AK"; }; fi
  printf '%s\n' "$2" >>"$t"
  commit "$t" "$AK"
  printf '@@DONE authorize\n'
}

deauthorize() {  # tag
  regular "$AK"
  if [ -f "$AK" ] && [ "$(count_ours "$1")" != 0 ]; then
    t=$(newtmp "$AK")
    awk -v t="$1" "$OURS"'!ours(t)' "$AK" >"$t" || { rm -f "$t"; fail "could not read $AK"; }
    commit "$t" "$AK"
  fi
  printf '@@DONE deauthorize\n'
}

has_key() {  # tag type blob: a line with the tag whose actual key (as ssh-keygen reads it) is this one
  r=no
  if [ -f "$AK" ]; then
    t=$(newtmp "$AK"); printf '%s %s\n' "$2" "$3" >"$t"
    want=$(ssh-keygen -l -f "$t" 2>/dev/null | awk '{ print $2 }') || want=""
    awk -v t="$1" "$OURS"'ours(t)' "$AK" >"$t.l" || { rm -f "$t" "$t.l"; fail "could not read $AK"; }
    while IFS= read -r line; do
      printf '%s\n' "$line" >"$t"
      [ -n "$want" ] && [ "$(ssh-keygen -l -f "$t" 2>/dev/null | awk '{ print $2 }')" = "$want" ] && r=yes
    done <"$t.l"
    rm -f "$t" "$t.l"
  fi
  printf '@@KEY %s\n' "$r"
}

known_host() {  # fqdn keylines...: record this host's own keys for fqdn (no trust on first use there)
  dirs; regular "$KH"; h="$1"; shift
  t=$(newtmp "$KH")
  if [ -f "$KH" ]; then
    cat "$KH" >"$t" || { rm -f "$t"; fail "could not read $KH"; }
    if [ -s "$KH" ] && [ -n "$(tail -c 1 "$KH")" ]; then echo >>"$t"; fi
  fi
  for k in "$@"; do
    grep -qxF "$h $k" "$t" || printf '%s %s\n' "$h" "$k" >>"$t"
  done
  chmod 600 "$t"; mv -f "$t" "$KH"
  printf '@@DONE known_host\n'
}

render() {  # the fleet-ssh section, first in ~/.ssh/config, pins each linked name's route
  regular "$CFG"; regular "$US"
  end=0
  if [ -f "$CFG" ]; then
    # Markers must be exact: BEGIN on line 1 and one END after it; anything else is refused.
    end=$(awk -v b="$BEGIN" -v e="$END" '
      index($0, "# BEGIN fleet-ssh") || index($0, "# END fleet-ssh") {
        if ($0 == b && NR == 1 && !seen) { seen = 1; next }
        if ($0 == e && seen && !endl) { endl = NR; next }
        bad = 1 }
      END { if (bad || (seen && !endl)) print "bad"; else print endl + 0 }' "$CFG") || fail "could not read $CFG"
    [ "$end" != bad ] || fail "$CFG has fleet-ssh markers that are not a single section at the top; fix them by hand"
  fi
  t=$(newtmp "$CFG")
  if [ -f "$US" ] && [ -s "$US" ]; then
    printf '%s\n' "$BEGIN" >"$t"
    awk 'NF == 3 && $1 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/ && $2 ~ /^[a-z_][a-z0-9_.-]*$/ &&
         $3 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/ {
           printf "Match originalhost %s\n  HostName %s\n  User %s\n  Port 22\n", $1, $3, $2
           printf "  ProxyCommand none\n  ProxyJump none\n  CanonicalizeHostname no\n", $3
           printf "  ControlMaster no\n  ControlPath none\n  HostKeyAlias %s\n  ForwardAgent no\n", $3 }' "$US" >>"$t" \
      || { rm -f "$t"; fail "could not read $US"; }
    printf 'Match all\n%s\n' "$END" >>"$t"
  else : >"$t"; fi
  if [ -f "$CFG" ]; then   # everything after our section, byte for byte
    tail -n "+$((end + 1))" "$CFG" >>"$t" || { rm -f "$t"; fail "could not read $CFG"; }
  fi
  commit "$t" "$CFG"
}

route_ok() {  # name fqdn: does `ssh name` reach the tailnet host on port 22 with no proxy (before we pin it)?
  g=$(ssh -G "$1" </dev/null 2>/dev/null) || { printf ' (ssh -G failed)'; return 0; }
  printf '%s\n' "$g" | awk -v n="$1" -v f="$2" '
    { k = $1; v = $0; sub(/^[^ ]+ /, "", v) }
    k == "hostname" { h = tolower(v) } k == "port" { p = v }
    (k == "proxycommand" || k == "proxyjump") && v != "none" { px = px " " k }
    END { if (h != n && h != f) printf " HostName %s", h; if (p != "22") printf " Port %s", p; printf "%s", px }'
}

set_user() {  # name fqdn user: pin `ssh name` to user@fqdn, unless the name is already someone else's
  dirs; regular "$US"
  cur=""; if [ -f "$US" ]; then cur=$(awk -v n="$1" 'NF == 3 && $1 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/ && $2 ~ /^[a-z_][a-z0-9_.-]*$/ && $3 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/ && $1 == n { print $2 " " $3; exit }' "$US") || fail "could not read $US"; fi
  if [ "$cur" = "$3 $2" ]; then render; printf '@@DONE alias existing\n'; return 0; fi
  if [ -n "$cur" ]; then printf '@@SKIP alias already maps to %s via fleet-ssh; unlink that first\n' "$cur"; return 0; fi
  why=$(route_ok "$1" "$2") || why=" (ssh -G failed)"
  if [ -n "$why" ]; then printf '@@SKIP alias your config sends it to%s\n' "$why"; return 0; fi
  t=$(newtmp "$US")
  if [ -f "$US" ]; then awk 'NF == 3 && $1 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/ && $2 ~ /^[a-z_][a-z0-9_.-]*$/ && $3 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/ { print $1, $2, $3 }' "$US" >"$t" || { rm -f "$t"; fail "could not read $US"; }; fi
  printf '%s %s %s\n' "$1" "$3" "$2" >>"$t"; commit "$t" "$US"; render
  printf '@@DONE alias new\n'
}

unset_user() {  # name user fqdn: drop the line only if it is still exactly this link's
  dirs; regular "$US"
  if [ -f "$US" ]; then
    t=$(newtmp "$US")
    awk -v n="$1" -v u="$2" -v f="$3" 'NF == 3 && $1 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/ && $2 ~ /^[a-z_][a-z0-9_.-]*$/ && $3 ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/ && !($1 == n && $2 == u && $3 == f) { print $1, $2, $3 }' "$US" >"$t" || { rm -f "$t"; fail "could not read $US"; }
    commit "$t" "$US"
  fi
  render
  printf '@@DONE unalias\n'
}

verify() {  # dest user nonce: does `ssh dest` log in as user and run exactly our command?
  case "$1" in *@*)   # no alias: prove the key login itself, untouched by ssh config
    out=$(ssh -F none -o IdentitiesOnly=yes -i "$KEY" -o BatchMode=yes -o ConnectTimeout=10 -o ForwardAgent=no \
            -o StrictHostKeyChecking=yes -o RequestTTY=no "$1" "id -un; printf %s $3" </dev/null 2>/dev/null) || out="" ;;
  *)                  # the real `ssh name`, with only what a non-interactive check needs
    out=$(ssh -o BatchMode=yes -o ConnectTimeout=10 -o ControlPath=none -o AddKeysToAgent=no -o ForwardAgent=no \
            -o ClearAllForwardings=yes -o RequestTTY=no -o RemoteCommand=none "$1" "id -un; printf %s $3" </dev/null 2>/dev/null) || out="" ;;
  esac
  if [ "$out" = "$2
$3" ]; then printf '@@VERIFY ok\n'; else printf '@@VERIFY fail\n'; fi
}
'''


def die(msg, code=1):
    sys.stderr.write("%s: %s\n" % (PROG, msg))
    raise SystemExit(code)


def say(msg=""):
    sys.stderr.write(msg + "\n")


# --- tailnet -----------------------------------------------------------------

class Node(object):
    def __init__(self, raw):
        self.fqdn = str(raw.get("DNSName") or "").rstrip(".").lower()
        self.name = self.fqdn.split(".")[0]
        self.ips = [str(ip).lower() for ip in (raw.get("TailscaleIPs") or [])]
        self.online = bool(raw.get("Online", True))

    def valid(self):
        return bool(NAME_RE.match(self.name) and not numeric_name(self.name) and FQDN_RE.match(self.fqdn) and self.ips
                    and all(is_ip(ip) for ip in self.ips))


def numeric_name(name):
    """inet_aton reads names like 123 or 0x7f000001 as addresses; such names cannot be aliases."""
    try:
        socket.inet_aton(name)
        return True
    except OSError:
        return False


def is_ip(text):
    """A plain, canonical IPv4/IPv6 address (no scope IDs or other text)."""
    try:
        return "%" not in text and str(ipaddress.ip_address(text)) == text
    except ValueError:
        return False


def tailnet():
    exe = next((c for c in (shutil.which("tailscale"), "/usr/local/bin/tailscale", "/opt/homebrew/bin/tailscale",
                            "/Applications/Tailscale.app/Contents/MacOS/Tailscale")
                if c and os.access(c, os.X_OK)), None)
    if not exe:
        die("tailscale CLI not found")
    p = subprocess.run([exe, "status", "--json"], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       universal_newlines=True, timeout=30)
    if p.returncode != 0:
        die("tailscale status failed: %s" % p.stderr.strip())
    try:
        data = json.loads(p.stdout)
        me = Node(data.get("Self") or {})
        peers = [Node(x) for x in (data.get("Peer") or {}).values()]
    except (ValueError, AttributeError, TypeError) as exc:
        die("unexpected tailscale status output (%s)" % exc)
    if not me.valid():
        die("this host has no usable tailnet name and IPs (is Tailscale up, with MagicDNS on?)")
    peers = [n for n in peers if n.valid()]
    return me, peers


def find_peer(peers, target):
    t = target.lower().rstrip(".")
    hits = [p for p in peers if t in (p.name, p.fqdn)]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        die("no tailnet peer named %r; peers: %s" % (target, ", ".join(sorted(p.name for p in peers)) or "none"))
    die("%r matches several peers: %s; use the full name" % (target, ", ".join(p.fqdn for p in hits)))


def fleet_user(peer):
    """Default user for a peer from fleet.json ("ssh": "user@host"), if listed."""
    try:
        hosts = json.loads(FLEET_JSON.read_text()).get("hosts", [])
        for h in hosts:
            ssh = str(h.get("ssh", ""))
            if "@" in ssh and ssh.split("@", 1)[1].lower().rstrip(".") in (peer.name, peer.fqdn):
                return ssh.split("@", 1)[0]
    except (OSError, ValueError, AttributeError, TypeError):
        pass
    return None


def local_user():
    u = pwd.getpwuid(os.getuid()).pw_name   # the real account, not LOGNAME/USER
    if not USER_RE.match(u):
        die("unsupported local user name %r" % u)
    return u


# --- records and lock -------------------------------------------------------

def state_dir_ok():
    for d in (STATE, STATE.parent):
        if d.is_symlink():
            die("%s is a symlink; fix it by hand" % d)


def load_records():
    state_dir_ok()
    if not RECORDS.exists():
        return {"links": {}}
    try:
        data = json.loads(RECORDS.read_text())
    except (OSError, ValueError) as exc:
        die("cannot read %s (%s); fix or move it away" % (RECORDS, exc))
    if not isinstance(data, dict) or not isinstance(data.get("links"), dict):
        die("%s is not a fleet-ssh record file; fix or move it away" % RECORDS)
    return data


def save_records(data):
    state_dir_ok()
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(str(STATE), 0o700)
    fd, tmp = tempfile.mkstemp(dir=str(STATE), prefix=".fleet-ssh.")
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh, indent=1, sort_keys=True)
    os.replace(tmp, str(RECORDS))


@contextlib.contextmanager
def host_lock():
    """The same lock the step scripts take, held by this process for the whole operation."""
    LOCK.parent.mkdir(mode=0o700, exist_ok=True)
    if LOCK.is_symlink():
        die("%s is a symlink; fix it by hand" % LOCK)
    fd = os.open(str(LOCK), os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            die("another fleet-ssh run is changing ssh files here; retry when it ends")
        global LOCK_FD
        LOCK_FD = fd
        yield
    finally:
        LOCK_FD = None
        os.close(fd)


# --- running steps ------------------------------------------------------------

def script(calls, lock, user):
    """The step script: refuse to touch anything unless it runs as `user`, then the calls."""
    body = "\n".join(" ".join(shlex.quote(str(a)) for a in c) for c in calls)
    guard = ('[ "$(id -un)" = %s ] || fail "this step runs as $(id -un), not %s; nothing was changed"\n'
             % (shlex.quote(user), user) +
             'python3 -c \'import os, pwd, sys; sys.exit(os.path.realpath(os.environ["HOME"]) != '
             'os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir))\' '
             '|| fail "HOME is not this account\'s home directory; nothing was changed"\n')
    return OPS + "\n" + guard + ("take_lock\n" if lock else "") + "echo @@BEGIN\n" + body + "\necho @@END\n"


def run_step(argv, script_text):
    """Run one step in its own process group; on timeout the whole group goes (no orphan ssh)."""
    p = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, universal_newlines=True,
                         start_new_session=True, pass_fds=(LOCK_FD,) if LOCK_FD is not None else ())
    try:
        out, _ = p.communicate(script_text, timeout=STEP_TIMEOUT)
    except BaseException:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(p.pid, signal.SIGKILL)
        p.wait()
        raise
    return p.returncode, out


def parse(stdout, where):
    res = []
    for line in stdout.splitlines():
        if line.startswith("@@"):
            res.append(line[2:])
        elif line.strip():
            say("  " + line)
    if not res or res[0] != "BEGIN" or res[-1] != "END":
        die("fleet-ssh steps did not run to completion on %s (a forced command= on the key, "
            "or an unusual login shell?)" % where)
    return res[1:-1]


def run_local(*calls):
    # Local steps inherit this process's locked descriptor, so the lock outlives this process
    # until the step itself ends (a killed parent cannot let another run in mid-step).
    rc, out = run_step(["sh", "-s"], script(calls, False, local_user()))
    if rc != 0:
        die("a step failed on this host (exit %d)" % rc)
    return parse(out, "this host")


# fleet-ssh's own connections read no ssh config at all.
BASE = ["ssh", "-F", "none", "-o", "ForwardAgent=no", "-o", "ClearAllForwardings=yes", "-o", "RequestTTY=no",
        "-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=15", "-o", "StrictHostKeyChecking=accept-new"]


class Remote(object):
    """One multiplexed connection to user@fqdn; the only place a password is asked."""

    def __init__(self, user, fqdn):
        self.user = user
        self.dest = "%s@%s" % (user, fqdn)
        self.dir = tempfile.mkdtemp(prefix="fleet-ssh-", dir="/tmp" if os.path.isdir("/tmp") else None)
        self.sock = os.path.join(self.dir, "m")

    def open(self, hint=""):
        say("Connecting to %s (enter its password if asked)..." % self.dest)
        master = ["-o", "ControlMaster=yes", "-o", "ControlPath=" + self.sock, "-o", "ControlPersist=300", "-fN"]
        # One connection: this account's default key files first, then the password. Separate
        # attempts would trip sshd's per-source penalties after the first failure; one connection
        # stays within the default MaxAuthTries (6) because key attempts are capped at 4, counting
        # a key's -cert.pub as a second attempt. The agent is not used.
        # IdentitiesOnly keeps the agent to the listed keys (an agent-held encrypted key still works).
        ident, budget = ["-o", "IdentitiesOnly=yes"], 4
        for n in ("id_ed25519", "id_ecdsa", "id_rsa", "id_ed25519_sk", "id_ecdsa_sk"):
            k = HOME / ".ssh" / n
            cost = 1 + (HOME / ".ssh" / (n + "-cert.pub")).is_file()
            if (k.is_file() or Path(str(k) + ".pub").is_file()) and cost <= budget:
                ident += ["-i", str(k)]
                budget -= cost
        if len(ident) == 2:
            ident += ["-o", "PubkeyAuthentication=no"]
        rc = subprocess.call(BASE + ident + master + [self.dest])
        if rc != 0:
            die("could not connect to %s%s" % (self.dest, hint))

    def run(self, calls, lock=True):
        # Only through the open master: ProxyCommand=false makes any fallback connection fail.
        rc, out = run_step(BASE + ["-T", "-o", "BatchMode=yes", "-o", "ControlMaster=no",
                                   "-o", "ControlPath=" + self.sock, "-o", "ProxyCommand=false",
                                   self.dest, "sh -s"], script(calls, lock, self.user))
        if rc != 0:
            die("a step failed on %s (exit %d)" % (self.dest, rc))
        return parse(out, self.dest)

    def close(self):
        subprocess.call(["ssh", "-F", "none", "-o", "ControlPath=" + self.sock, "-O", "exit", self.dest],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        shutil.rmtree(self.dir, ignore_errors=True)


def need(results, *acks):
    for a in acks:
        if a not in results:
            die("a step did not confirm '%s'; nothing was assumed" % a)


def key_blob_ok(ktype, blob):
    """The blob is SSH wire format whose embedded type string is ktype."""
    if not (KTYPE_RE.match(ktype) and BLOB_RE.match(blob)):
        return False
    try:
        raw = base64.b64decode(blob, validate=True)
    except ValueError:
        return False
    n = int.from_bytes(raw[:4], "big") if len(raw) >= 4 else -1
    if not (n == len(ktype) and raw[4:4 + n] == ktype.encode()):
        return False
    with tempfile.NamedTemporaryFile("w", suffix=".pub") as fh:   # OpenSSH's own parser decides
        fh.write("%s %s\n" % (ktype, blob))
        fh.flush()
        return subprocess.call(["ssh-keygen", "-l", "-f", fh.name], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL) == 0


def pub_line(results, src_ips, tag):
    pubs = [r.split()[1:3] for r in results if r.startswith("PUB ")]
    if len(pubs) != 1 or len(pubs[0]) != 2 or not key_blob_ok(*pubs[0]):
        die("did not get a valid public key")
    if not src_ips or not all(is_ip(ip) for ip in src_ips):
        die("no valid source addresses to pin")
    return 'from="%s" %s %s %s' % (",".join(src_ips), pubs[0][0], pubs[0][1], tag)


def alias_report(results, where, name, user, fqdn):
    """True when `ssh NAME` is fleet-ssh's for this link; 'new' when this run created it."""
    skip = [r for r in results if r.startswith("SKIP alias ")]
    if skip:
        say("  %s: 'ssh %s' %s, so fleet-ssh left it alone (%s@%s has the key)"
            % (where, name, skip[0].split(" ", 2)[2].strip(), user, fqdn))
        return False, False
    if not any(r.startswith("DONE alias") for r in results):
        die("a step did not confirm the alias; nothing was assumed")
    say("  %s: ssh %s -> %s@%s" % (where, name, user, fqdn))
    return True, "DONE alias new" in results


def dest(rec, side, name, user, fqdn):
    """What to test: the alias when fleet-ssh wrote it, else user@fqdn explicitly."""
    return name if rec.get("alias_" + side) else "%s@%s" % (user, fqdn)


def check(where, target, user, how):
    good = "VERIFY ok" in how(target, user)
    what = ("ssh %s" % target) if "@" not in target else ("key login %s (checked directly)" % target)
    say("  %s%s: %s" % (where, what, "works" if good else "FAILED"))
    return good


def host_keys():
    """This host's own SSH host keys, to give a peer instead of trust on first use."""
    out = []
    for path in sorted(Path("/etc/ssh").glob("ssh_host_*_key.pub")):
        try:
            parts = path.read_text().split()
        except OSError:
            continue
        if len(parts) >= 2 and key_blob_ok(parts[0], parts[1]):
            out.append("%s %s" % (parts[0], parts[1]))
    return out


# --- commands ----------------------------------------------------------------

def link(me, peer, direction, user, yes):
    lu = local_user()
    if not USER_RE.match(user):
        die("bad user %r" % user)
    if peer.fqdn == me.fqdn:
        die("TARGET is this host")
    to, frm = direction in ("to", "both"), direction in ("from", "both")
    my_tag, peer_tag = "%s:%s@%s" % (TAG, lu, me.fqdn), "%s:%s@%s" % (TAG, user, peer.fqdn)
    say("Plan:")
    if to:
        say("  here:  ssh %s   (as %s@%s)" % (peer.name, user, peer.fqdn))
    if frm:
        say("  there: ssh %s   (as %s@%s, run on %s)" % (me.name, lu, me.fqdn, peer.name))
    if not peer.online:
        say("  note: tailscale reports %s offline" % peer.name)
    if not yes:
        if not sys.stdin.isatty():
            die("not a terminal; pass --yes to proceed")
        try:
            if input("Proceed? [Y/n] ").strip().lower() not in ("", "y", "yes"):
                die("cancelled", 0)
        except EOFError:
            die("cancelled", 0)

    key = "%s@%s" % (user, peer.fqdn)
    mine_there = {"tag": my_tag, "name": me.name, "fqdn": me.fqdn}
    with host_lock():
        mine = run_local(("ensure_key", "%s@%s" % (lu, me.name))) if to else []
        rem = Remote(user, peer.fqdn)
        ok = True
        try:
            rem.open()
            # Record first: whatever happens next, `fleet-ssh unlink` can clean up both ends.
            # Every identity ever installed on the peer stays listed until unlink removes it.
            records = load_records()
            prev = records["links"].get(key)
            if prev is not None and not record_ok(key, prev, lu):
                die("the record for %s is damaged; fix or remove it in %s" % (key, RECORDS))
            prev = prev or {}
            there = [e for e in prev.get("there", []) if e != mine_there] + [mine_there]
            rec = dict(prev, fqdn=peer.fqdn, name=peer.name, user=user, tag_here=peer_tag, there=there,
                       to=to or prev.get("to", False), **{"from": frm or prev.get("from", False)})
            records["links"][key] = rec
            save_records(records)
            calls, hk = [], host_keys() if frm else []
            if frm:
                calls += [("ensure_key", "%s@%s" % (user, peer.name))]
                if hk:
                    calls += [("known_host", me.fqdn) + tuple(hk)]
            if to:
                calls += [("authorize", my_tag, pub_line(mine, me.ips, my_tag))]
            if frm:
                calls += [("set_user", me.name, me.fqdn, lu)]
            out = rem.run(calls)
            need(out, *(["DONE authorize"] if to else []) + (["DONE known_host"] if hk else []))
            new_there = new_here = False
            if frm:
                line = pub_line(out, peer.ips, peer_tag)
                rec["key_here"] = " ".join(line.split()[1:3])
                need(run_local(("authorize", peer_tag, line)), "DONE authorize")
                rec["alias_there"], new_there = alias_report(out, peer.name, me.name, lu, me.fqdn)
            if to:
                here = run_local(("set_user", peer.name, peer.fqdn, user))
                rec["alias_here"], new_here = alias_report(here, me.name, peer.name, user, peer.fqdn)
            save_records(records)
            say("Checking with the real ssh command...")
            if to:
                good = check("", dest(rec, "here", peer.name, user, peer.fqdn), user,
                             lambda d, u: run_local(("verify", d, u, secrets.token_hex(16))))
                if not good and new_here:   # a name this run set up that does not work: take it back
                    need(run_local(("unset_user", peer.name, user, peer.fqdn)), "DONE unalias")
                    rec["alias_here"] = False
                    say("  removed the 'ssh %s' setting again; ssh %s@%s still has the key" % (peer.name, user, peer.fqdn))
                ok &= good
            if frm:
                good = check("on %s: " % peer.name, dest(rec, "there", me.name, lu, me.fqdn), lu,
                             lambda d, u: rem.run([("verify", d, u, secrets.token_hex(16))], lock=False))
                if not good and new_there:
                    need(rem.run([("unset_user", me.name, lu, me.fqdn)]), "DONE unalias")
                    rec["alias_there"] = False
                ok &= good
                if not good:
                    say("  (is sshd running here? Linux: sudo systemctl enable --now sshd; "
                        "macOS: System Settings > General > Sharing > Remote Login)")
                    if not hk:
                        say("  (no readable /etc/ssh/ssh_host_*_key.pub here, so %s could not learn this host's key)"
                            % peer.name)
            save_records(records)
        finally:
            rem.close()
    if not ok:
        raise SystemExit(1)


def find_record(records, target):
    t = target.lower().rstrip(".")
    user, _, host = t.rpartition("@")
    hits = [(k, r) for k, r in records["links"].items() if isinstance(r, dict)
            and host in (r.get("fqdn"), r.get("name")) and (not user or user == r.get("user"))]
    if len(hits) != 1:
        die("%s recorded link matches %r (recorded: %s); use user@host"
            % ("more than one" if hits else "no", target, ", ".join(sorted(records["links"])) or "none"))
    return hits[0]


def record_ok(key, r, lu):
    """A record is used only when every value is well-formed and bound to its key and owner."""
    if not isinstance(r, dict):
        return False
    if not all(isinstance(r.get(k), str) for k in ("fqdn", "user", "name", "tag_here")):
        return False
    fqdn, user, name = r["fqdn"], r["user"], r["name"]
    if not (FQDN_RE.match(fqdn) and USER_RE.match(user) and key == "%s@%s" % (user, fqdn)
            and name == fqdn.split(".")[0] and r.get("tag_here") == "%s:%s@%s" % (TAG, user, fqdn)):
        return False
    if not (isinstance(r.get("to"), bool) and isinstance(r.get("from"), bool) and (r["to"] or r["from"])):
        return False
    if any(k in r and not isinstance(r[k], bool) for k in ("alias_here", "alias_there")):
        return False
    if "key_here" in r and not (isinstance(r["key_here"], str) and len(r["key_here"].split()) == 2
                                and key_blob_ok(*r["key_here"].split())):
        return False
    there = r.get("there")
    if not isinstance(there, list) or not there:
        return False
    for e in there:
        if not (isinstance(e, dict) and all(isinstance(e.get(k), str) for k in ("fqdn", "name", "tag"))
                and FQDN_RE.match(e["fqdn"]) and e["name"] == e["fqdn"].split(".")[0]
                and e.get("tag") == "%s:%s@%s" % (TAG, lu, e.get("fqdn"))):
            return False
    return True


def unlink(target, local_only):
    lu = local_user()
    with host_lock():
        records = load_records()
        key, r = find_record(records, target)
        if not record_ok(key, r, lu):
            die("the record for %s is damaged; fix or remove it in %s" % (key, RECORDS))
        if not local_only:
            calls, acks = [], []
            if r.get("from"):
                calls += [("unset_user", e["name"], lu, e["fqdn"]) for e in r["there"]]
                acks += ["DONE unalias"]
            if r.get("to"):   # last: our key may be what lets this connection back in
                calls += [("deauthorize", e["tag"]) for e in r["there"]]
                acks += ["DONE deauthorize"]
            if calls:
                rem = Remote(r["user"], r["fqdn"])
                try:
                    rem.open(hint="; nothing was changed. If %s is gone for good: fleet-ssh unlink %s --local-only"
                             % (r["name"], key))
                    need(rem.run(calls), *acks)
                finally:
                    rem.close()
            say("  %s: removed what this link installed there" % r["name"])
        calls, acks = [], []
        if r.get("from"):
            calls, acks = calls + [("deauthorize", r["tag_here"])], acks + ["DONE deauthorize"]
        if r.get("to"):
            calls, acks = calls + [("unset_user", r["name"], r["user"], r["fqdn"])], acks + ["DONE unalias"]
        if calls:
            need(run_local(*calls), *acks)
        del records["links"][key]
        save_records(records)
        say("  this host: removed what this link installed here")


def status():
    records = load_records()
    if not records["links"]:
        say("No recorded links.")
        return
    bad = False
    lu = local_user()
    for key, r in sorted(records["links"].items()):
        if not record_ok(key, r, lu):
            say("  %-36s DAMAGED record; fix or remove it in %s" % (key, RECORDS))
            bad = True
            continue
        parts = []
        if r.get("to"):
            target = dest(r, "here", r.get("name"), r.get("user"), r.get("fqdn"))
            good = "VERIFY ok" in run_local(("verify", target, r.get("user"), secrets.token_hex(16)))
            bad |= not good
            parts.append("ssh %s %s" % (target, "works" if good else "FAILED"))
        if r.get("from"):
            if "key_here" not in r:
                bad = True
                parts.append("its key UNKNOWN here (rerun the link)")
            else:
                present = "KEY yes" in run_local(("has_key", r["tag_here"]) + tuple(r["key_here"].split()))
                bad |= not present
                parts.append("its key %s here" % ("installed" if present else "MISSING"))
        say("  %-36s %s" % (key, "; ".join(parts)))
    if bad:
        raise SystemExit(1)


def wizard(me, peers):
    if not sys.stdin.isatty():
        die("no terminal for the wizard; use: fleet-ssh link TARGET ...")

    def ask(prompt, default=None, choices=None):
        while True:
            hint = (" (%s)" % "/".join(choices) if choices else "") + (" [%s]" % default if default else "")
            try:
                v = input("%s%s: " % (prompt, hint)).strip() or (default or "")
            except EOFError:
                die("cancelled", 0)
            if v and (not choices or v in choices):
                return v

    online = sorted(p.name for p in peers if p.online)
    say("This host: %s (%s). Online peers: %s" % (me.name, local_user(), ", ".join(online) or "none"))
    default = "nous" if any(p.name == "nous" for p in peers) else None
    peer = find_peer(peers, ask("Link with which host", default))
    say("Directions: to = ssh %s from here; from = ssh %s from there; both" % (peer.name, me.name))
    direction = ask("Direction", "both", ["both", "to", "from"])
    user = ask("Your user on %s" % peer.name, fleet_user(peer) or local_user())
    link(me, peer, direction, user, yes=False)


def main(argv):
    if os.path.realpath(str(HOME)) != os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir):
        die("HOME is not this account's home directory")
    ap = argparse.ArgumentParser(prog=PROG, description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    lk = sub.add_parser("link", help="link with TARGET")
    lk.add_argument("target")
    lk.add_argument("--direction", choices=["both", "to", "from"], default="both")
    lk.add_argument("--user", help="your user on TARGET (default: fleet.json, else this user)")
    lk.add_argument("--yes", action="store_true", help="skip the confirmation")
    ul = sub.add_parser("unlink", help="remove a recorded link on both ends")
    ul.add_argument("target")
    ul.add_argument("--local-only", action="store_true", help="only this host's side (TARGET is gone)")
    sub.add_parser("status", help="check recorded links")
    args = ap.parse_args(argv)
    if args.cmd == "status":
        status()
    elif args.cmd == "unlink":
        unlink(args.target, args.local_only)
    else:
        me, peers = tailnet()
        if args.cmd is None:
            wizard(me, peers)
        else:
            peer = find_peer(peers, args.target)
            link(me, peer, args.direction, args.user or fleet_user(peer) or local_user(), args.yes)


def _terminate(signum, frame):
    raise SystemExit(128 + signum)   # unwind like Ctrl-C: close the master, release the lock


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGHUP, _terminate)
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        die("interrupted", 130)
    except subprocess.TimeoutExpired:
        die("a step took too long and was stopped")
