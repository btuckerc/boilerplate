#!/usr/bin/env python3

import argparse
import fcntl
import json
import os
import select
import socket
import subprocess
import sys
import time
from pathlib import Path


DEBOUNCE_SECONDS = 0.08
IGNORE_SECONDS = 0.75
ANIMATION_SECONDS = 1.8
ANIMATION_CLEAR_BUFFER_SECONDS = 0.35
STYLE_PRIME_SECONDS = 0.05
RUNTIME_CSS_NAME = "hyprland-workspace-compact.runtime.css"
_INSTANCE_SIGNATURE_CACHE: str | None = None


def eprint(*parts: object) -> None:
    print(*parts, file=sys.stderr)


def atomic_write_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_name(f"{path.name}.tmp")
    tmp_path.write_text(content, encoding="utf-8")
    os.replace(tmp_path, path)


def hyprctl_env(*, for_instances: bool = False) -> dict[str, str]:
    env = os.environ.copy()
    if not for_instances and not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        env["HYPRLAND_INSTANCE_SIGNATURE"] = resolve_instance_signature()
    return env


def run_hyprctl(*args: str, json_output: bool = False) -> object:
    cmd = ["hyprctl"]
    if json_output:
        cmd.append("-j")
    cmd.extend(args)
    result = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        env=hyprctl_env(for_instances=(len(args) == 1 and args[0] == "instances")),
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or f"hyprctl failed: {' '.join(cmd)}")
    if json_output:
        return json.loads(result.stdout)
    return result.stdout.strip()


def run_hyprctl_batch(commands: list[str]) -> None:
    if not commands:
        return
    batch = " ; ".join(commands)
    result = subprocess.run(
        ["hyprctl", "--batch", batch],
        capture_output=True,
        text=True,
        env=hyprctl_env(),
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "hyprctl --batch failed")


def resolve_instance_signature() -> str:
    global _INSTANCE_SIGNATURE_CACHE

    if _INSTANCE_SIGNATURE_CACHE:
        return _INSTANCE_SIGNATURE_CACHE

    env_sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if env_sig:
        _INSTANCE_SIGNATURE_CACHE = env_sig
        return env_sig

    instances = run_hyprctl("instances")
    for line in str(instances).splitlines():
        line = line.strip()
        if line.startswith("instance ") and line.endswith(":"):
            _INSTANCE_SIGNATURE_CACHE = line[len("instance ") : -1]
            return _INSTANCE_SIGNATURE_CACHE

    raise RuntimeError("could not resolve HYPRLAND_INSTANCE_SIGNATURE")


def socket2_path() -> Path:
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    return Path(runtime_dir) / "hypr" / resolve_instance_signature() / ".socket2.sock"


def runtime_css_path() -> Path:
    return Path.home() / ".config" / "waybar" / RUNTIME_CSS_NAME


def numeric_workspace_ids(workspaces: list[dict]) -> list[int]:
    ids: list[int] = []
    for workspace in workspaces:
        wid = workspace.get("id")
        name = workspace.get("name")
        if not isinstance(wid, int) or wid <= 0:
            continue
        if str(wid) != str(name):
            continue
        ids.append(wid)
    return sorted(set(ids))


def workspace_ids_by_output(workspaces: list[dict]) -> dict[str, list[int]]:
    ids_by_output: dict[str, list[int]] = {}
    for workspace in workspaces:
        wid = workspace.get("id")
        name = workspace.get("name")
        output = str(workspace.get("monitor", ""))
        if not isinstance(wid, int) or wid <= 0:
            continue
        if str(wid) != str(name):
            continue
        if not output:
            continue
        ids_by_output.setdefault(output, []).append(wid)

    return {
        output: sorted(set(ids))
        for output, ids in ids_by_output.items()
        if ids
    }


def build_shift_map(workspaces: list[dict]) -> dict[int, int]:
    shift_map: dict[int, int] = {}
    for expected, wid in enumerate(numeric_workspace_ids(workspaces), start=1):
        if wid != expected:
            shift_map[wid] = expected
    return shift_map


def build_compaction_commands(workspaces: list[dict]) -> tuple[list[str], dict[int, int]]:
    shift_map = build_shift_map(workspaces)
    if not shift_map:
        return [], {}

    clients = run_hyprctl("clients", json_output=True)
    monitors = run_hyprctl("monitors", json_output=True)

    commands: list[str] = []

    # Move windows from the highest shifted workspace down first.
    for client in sorted(
        clients,
        key=lambda item: int(item.get("workspace", {}).get("id", 0)),
        reverse=True,
    ):
        workspace = client.get("workspace") or {}
        source_id = workspace.get("id")
        if source_id not in shift_map:
            continue
        if not client.get("mapped", False):
            continue
        if client.get("pinned", False):
            continue

        address = client.get("address")
        target_id = shift_map[source_id]
        commands.append(f"dispatch movetoworkspacesilent {target_id},address:{address}")

    focused_monitor = next((monitor for monitor in monitors if monitor.get("focused")), None)
    focused_monitor_name = focused_monitor.get("name") if focused_monitor else None

    shifted_monitors: list[tuple[str, int, bool]] = []
    for monitor in monitors:
        active_workspace = monitor.get("activeWorkspace") or {}
        active_id = active_workspace.get("id")
        if active_id in shift_map:
            shifted_monitors.append((monitor["name"], shift_map[active_id], bool(monitor.get("focused"))))

    for monitor_name, target_id, is_focused in shifted_monitors:
        if is_focused:
            continue
        commands.append(f"dispatch focusmonitor {monitor_name}")
        commands.append(f"dispatch focusworkspaceoncurrentmonitor {target_id}")

    if focused_monitor_name:
        commands.append(f"dispatch focusmonitor {focused_monitor_name}")
        if focused_monitor:
            active_id = (focused_monitor.get("activeWorkspace") or {}).get("id")
            if active_id in shift_map:
                commands.append(f"dispatch focusworkspaceoncurrentmonitor {shift_map[active_id]}")

    return commands, shift_map


def css_escape_ident(value: str) -> str:
    escaped: list[str] = []
    for index, ch in enumerate(value):
        if ch == "\0":
            escaped.append("\\fffd ")
            continue
        if ch.isalnum() or ch in {"-", "_"}:
            if index == 0 and ch.isdigit():
                escaped.append(f"\\{ord(ch):x} ")
            else:
                escaped.append(ch)
            continue
        escaped.append(f"\\{ord(ch):x} ")
    return "".join(escaped)


def clear_runtime_css(css_path: Path) -> None:
    atomic_write_text(css_path, "/* Managed at runtime by hyprland-workspace-compactd. */\n")


def append_button_selectors(
    selectors: list[str],
    output: str,
    position: int,
    single_output: bool,
) -> None:
    selectors.append(f"window#waybar.{css_escape_ident(output)} #workspaces button:nth-child({position})")
    if single_output:
        selectors.append(f"#workspaces button:nth-child({position})")


def collect_compaction_selector_groups(
    workspaces: list[dict],
    shift_map: dict[int, int],
    final_active_by_output: dict[str, int],
) -> list[tuple[str, list[str], list[str], list[str]]]:
    ids_by_output = workspace_ids_by_output(workspaces)
    single_output = len(ids_by_output) == 1
    selector_groups: list[tuple[str, list[str], list[str], list[str]]] = []

    for output in sorted(ids_by_output):
        pre_ids = ids_by_output[output]
        shifted_pairs = [(wid, shift_map[wid]) for wid in pre_ids if wid in shift_map]
        if not shifted_pairs:
            continue

        pre_positions = {wid: index for index, wid in enumerate(pre_ids, start=1)}
        post_ids = sorted(set(shift_map.get(wid, wid) for wid in pre_ids))
        post_positions = {wid: index for index, wid in enumerate(post_ids, start=1)}

        source_selectors: list[str] = []
        inactive_target_selectors: list[str] = []
        active_target_selectors: list[str] = []
        for source_id, target_id in shifted_pairs:
            source_position = pre_positions.get(source_id)
            if source_position is not None:
                append_button_selectors(source_selectors, output, source_position, single_output)

            target_position = post_positions.get(target_id)
            if target_position is not None:
                if final_active_by_output.get(output) == target_id:
                    append_button_selectors(active_target_selectors, output, target_position, single_output)
                else:
                    append_button_selectors(inactive_target_selectors, output, target_position, single_output)

        if not source_selectors or (not inactive_target_selectors and not active_target_selectors):
            continue

        summary = ", ".join(f"{source_id}->{target_id}" for source_id, target_id in shifted_pairs)
        selector_groups.append(
            (
                f"{output}: {summary}",
                source_selectors,
                inactive_target_selectors,
                active_target_selectors,
            )
        )

    return selector_groups


def render_pre_compaction_css(selector_groups: list[tuple[str, list[str], list[str], list[str]]]) -> str:
    lines = ["/* Managed at runtime by hyprland-workspace-compactd. */"]
    if not selector_groups:
        return lines[0] + "\n"

    for summary, selectors, _, _ in selector_groups:
        lines.extend(
            [
                "",
                f"/* pre: {summary} */",
                f"{', '.join(selectors)} {{",
                "  opacity: 0.22;",
                "  color: alpha(@foreground, 0.18);",
                "  text-shadow: 0 0 10px alpha(@foreground, 0.92), 0 0 4px alpha(@foreground, 0.82);",
                "}",
            ]
        )

    return "\n".join(lines) + "\n"


def render_post_compaction_css(selector_groups: list[tuple[str, list[str], list[str], list[str]]], token: int) -> str:
    lines = ["/* Managed at runtime by hyprland-workspace-compactd. */"]

    if not selector_groups:
        return lines[0] + "\n"

    inactive_animation_name = f"workspace-renumber-blend-inactive-{token}"
    active_animation_name = f"workspace-renumber-blend-active-{token}"
    lines.extend(
        [
            "",
            f"@keyframes {inactive_animation_name} {{",
            "  0% {",
            "    opacity: 0.22;",
            "    color: alpha(@foreground, 0.18);",
            "    text-shadow: 0 0 10px alpha(@foreground, 0.92), 0 0 4px alpha(@foreground, 0.82);",
            "  }",
            "  38% {",
            "    opacity: 0.6;",
            "    color: alpha(@foreground, 0.56);",
            "    text-shadow: 0 0 5px alpha(@foreground, 0.62), 0 0 2px alpha(@foreground, 0.52);",
            "  }",
            "  100% {",
            "    opacity: 0.5;",
            "    color: @foreground;",
            "    text-shadow: none;",
            "  }",
            "}",
            "",
            f"@keyframes {active_animation_name} {{",
            "  0% {",
            "    opacity: 0.22;",
            "    color: alpha(@foreground, 0.18);",
            "    text-shadow: 0 0 10px alpha(@foreground, 0.92), 0 0 4px alpha(@foreground, 0.82);",
            "  }",
            "  38% {",
            "    opacity: 0.6;",
            "    color: alpha(@foreground, 0.56);",
            "    text-shadow: 0 0 5px alpha(@foreground, 0.62), 0 0 2px alpha(@foreground, 0.52);",
            "  }",
            "  100% {",
            "    opacity: 1;",
            "    color: @foreground;",
            "    text-shadow: none;",
            "  }",
            "}",
        ]
    )

    for summary, _, inactive_selectors, active_selectors in selector_groups:
        if inactive_selectors:
            lines.extend(
                [
                    "",
                    f"/* post inactive: {summary} */",
                    f"{', '.join(inactive_selectors)} {{",
                    f"  animation: {inactive_animation_name} {ANIMATION_SECONDS:.1f}s cubic-bezier(0.16, 0.85, 0.22, 1) 1;",
                    "  animation-fill-mode: both;",
                    "}",
                ]
            )

        if active_selectors:
            lines.extend(
                [
                    "",
                    f"/* post active: {summary} */",
                    f"{', '.join(active_selectors)} {{",
                    f"  animation: {active_animation_name} {ANIMATION_SECONDS:.1f}s cubic-bezier(0.16, 0.85, 0.22, 1) 1;",
                    "  animation-fill-mode: both;",
                    "}",
                ]
            )

    return "\n".join(lines) + "\n"


def compact_workspaces(css_path: Path, verbose: bool = False) -> float | None:
    workspaces = run_hyprctl("workspaces", json_output=True)
    monitors = run_hyprctl("monitors", json_output=True)
    commands, shift_map = build_compaction_commands(workspaces)
    if not commands:
        if verbose:
            eprint("hyprland-workspace-compactd: no compaction needed")
        return None

    final_active_by_output = {
        str(monitor.get("name", "")): shift_map.get(active_id, active_id)
        for monitor in monitors
        for active_id in [(monitor.get("activeWorkspace") or {}).get("id")]
        if isinstance(active_id, int) and active_id > 0
    }

    selector_groups = collect_compaction_selector_groups(workspaces, shift_map, final_active_by_output)
    if not selector_groups:
        if verbose:
            eprint("hyprland-workspace-compactd: no selector groups for compaction", shift_map)
        return None

    if verbose:
        eprint("hyprland-workspace-compactd: compacting", shift_map)
    atomic_write_text(css_path, render_pre_compaction_css(selector_groups))
    time.sleep(STYLE_PRIME_SECONDS)
    run_hyprctl_batch(commands)
    atomic_write_text(css_path, render_post_compaction_css(selector_groups, time.monotonic_ns()))
    return time.monotonic() + ANIMATION_SECONDS + ANIMATION_CLEAR_BUFFER_SECONDS


def acquire_lock() -> object:
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    lock_path = Path(runtime_dir) / "hyprland-workspace-compactd.lock"
    lock_file = open(lock_path, "w", encoding="utf-8")
    try:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)
    lock_file.write(f"{os.getpid()}\n")
    lock_file.flush()
    return lock_file


def daemon_loop(verbose: bool = False) -> None:
    acquire_lock()
    css_path = runtime_css_path()
    clear_runtime_css(css_path)
    ignore_until = 0.0
    clear_css_at = 0.0

    while True:
        try:
            path = socket2_path()
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(str(path))
                stream = sock.makefile("r", encoding="utf-8", errors="replace")
                while True:
                    timeout = None
                    if clear_css_at > 0.0:
                        timeout = max(clear_css_at - time.monotonic(), 0.0)

                    ready, _, _ = select.select([sock], [], [], timeout)
                    if ready:
                        raw_line = stream.readline()
                        if not raw_line:
                            raise RuntimeError("Hyprland event socket closed")

                        line = raw_line.strip()
                        if not line or not line.startswith("destroyworkspacev2>>"):
                            continue

                        now = time.monotonic()
                        if now < ignore_until:
                            continue

                        time.sleep(DEBOUNCE_SECONDS)
                        next_clear_css_at = compact_workspaces(css_path, verbose=verbose)
                        if next_clear_css_at is not None:
                            ignore_until = time.monotonic() + IGNORE_SECONDS
                            clear_css_at = next_clear_css_at
                        continue

                    if clear_css_at > 0.0 and time.monotonic() >= clear_css_at:
                        clear_runtime_css(css_path)
                        clear_css_at = 0.0
        except KeyboardInterrupt:
            clear_runtime_css(css_path)
            return
        except Exception as exc:
            clear_runtime_css(css_path)
            if verbose:
                eprint(f"hyprland-workspace-compactd: {exc}")
            time.sleep(1.0)


def main() -> int:
    parser = argparse.ArgumentParser(description="Compact Hyprland numeric workspaces when gaps appear.")
    parser.add_argument("--compact-now", action="store_true", help="Run one compaction pass immediately and exit.")
    parser.add_argument("--verbose", action="store_true", help="Log actions to stderr.")
    args = parser.parse_args()

    if args.compact_now:
        css_path = runtime_css_path()
        clear_runtime_css(css_path)
        clear_at = compact_workspaces(css_path, verbose=args.verbose)
        if clear_at is not None:
            time.sleep(max(clear_at - time.monotonic(), 0.0))
        clear_runtime_css(css_path)
        return 0

    daemon_loop(verbose=args.verbose)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
