#!/usr/bin/env python3
"""Explicit local OpenCode worker. No global model policy or service switching."""
import argparse
import json
import os
from pathlib import Path
import shutil
import sys

MODELS = {
    "ornith": "nous/Ornith-1.5-9B-Q5_K_M",
    "nemotron": "nous/Nemotron-9B-OpenCode.Q6_K",
    "gemma": "nous/gemma-4-12B-it-Q4_0",
    "bonsai": "nous-bonsai/bonsai-2-27b",
}

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--model", choices=MODELS, required=True, help="Explicit model choice; Nemotron tool use remains experimental")
parser.add_argument("--dir", type=Path, required=True)
parser.add_argument("--session", help="Resume the exact worker session ID")
parser.add_argument("--read-only", action="store_true")
parser.add_argument("prompt", nargs="?", help="Task text; omit to read stdin")
args = parser.parse_args()
if not args.dir.is_dir():
    parser.error("--dir must be an existing task directory")
prompt = args.prompt if args.prompt is not None else sys.stdin.read()
if not prompt.strip():
    parser.error("a nonempty task is required")
binary = shutil.which("opencode-baseline")
if not binary:
    parser.error("opencode-baseline is required")
permissions = {"*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "list": "allow"}
if not args.read_only:
    permissions["edit"] = "allow"
config = json.loads(os.environ.get("OPENCODE_CONFIG_CONTENT", "{}"))
config["permission"] = permissions
config.setdefault("agent", {})["nous-worker"] = {
    "description": "Explicitly launched bounded local worker",
    "mode": "primary",
    "model": MODELS[args.model],
    "temperature": 0.6,
    "top_p": 0.95,
    "permission": permissions,
}
config["compaction"] = {"auto": True, "prune": True, "reserved": 4096}
env = os.environ.copy()
env["OPENCODE_CONFIG_CONTENT"] = json.dumps(config)
command = [binary, "run", "--pure", "--dir", str(args.dir.resolve()),
           "--agent", "nous-worker", "--model", MODELS[args.model], "--format", "json"]
if args.session:
    command += ["--session", args.session]
command += ["--", prompt]
os.execve(binary, command, env)
