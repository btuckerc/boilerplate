#!/usr/bin/python3
# omarchy:summary=Print the Oh My Pi / SuperGrok usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Oh My Pi SuperGrok usage into one display-ready JSON record.

Local stats come from OMP (and compatible pi) session files that ran on
xai-oauth or the xAI API key. Rate limits come from `omp usage --json`.
The agents panel only ever reads the JSON this prints.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

AGENT_ID = "omp"
AGENT_NAME = "Oh My Pi"
AUTH_HELP = "Run `omp auth-broker login xai-oauth` to restore SuperGrok usage."
XAI_PROVIDERS = {"xai-oauth", "xai"}
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900
PROBE_MIN_INTERVAL_SECONDS = 15


def number(value: Any) -> int:
  try:
    n = float(value or 0)
    return round(n) if n == n else 0
  except Exception:
    return 0


def usage_token(usage: dict[str, Any], snake_key: str, camel_key: str) -> int:
  value = usage.get(snake_key, usage.get(camel_key, 0))
  return number(value)


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def empty_stats() -> dict[str, Any]:
  today = local_date_string()
  recent_dates = recent_date_strings()
  return {
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": day, "messageCount": 0} for day in recent_dates],
    "modelUsage": {},
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "scanDate": today,
  }


def date_string(value: dt.date) -> str:
  return value.strftime("%Y-%m-%d")


def local_date_string() -> str:
  return date_string(dt.datetime.now().date())


def recent_date_strings() -> list[str]:
  today = dt.datetime.now().date()
  return [date_string(today - dt.timedelta(days=offset)) for offset in range(6, -1, -1)]


def local_date_from_timestamp(value: Any) -> str:
  if value is None:
    return local_date_string()
  if isinstance(value, (int, float)):
    try:
      seconds = float(value) / 1000.0 if float(value) > 10_000_000_000 else float(value)
      return date_string(dt.datetime.fromtimestamp(seconds).date())
    except Exception:
      return local_date_string()
  raw = str(value).strip()
  if not raw:
    return local_date_string()
  try:
    parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    if parsed.tzinfo is not None:
      parsed = parsed.astimezone()
    return date_string(parsed.date())
  except Exception:
    return local_date_string()


def runtime_env() -> dict[str, str]:
  home = str(Path.home())
  path_parts = [
    os.environ.get("PATH", ""),
    f"{home}/.local/bin",
    f"{home}/.local/share/mise/shims",
    f"{home}/shims",
  ]
  env = os.environ.copy()
  env["PATH"] = os.pathsep.join(part for part in path_parts if part)
  return env


ENV = runtime_env()


def find_command(name: str) -> str | None:
  return shutil.which(name, path=ENV.get("PATH"))


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def session_roots() -> list[Path]:
  configured = os.environ.get("PI_CODING_AGENT_DIR")
  roots = []
  if configured:
    roots.append(Path(configured) / "sessions")
  roots.extend(
    [
      Path.home() / ".omp" / "agent" / "sessions",
      Path.home() / ".pi" / "agent" / "sessions",
    ]
  )
  seen: set[Path] = set()
  out: list[Path] = []
  for root in roots:
    try:
      resolved = root.resolve()
    except OSError:
      continue
    if resolved in seen or not resolved.is_dir():
      continue
    seen.add(resolved)
    out.append(resolved)
  return out


def write_json(path: Path, payload: dict[str, Any]) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    age = time.time() - path.stat().st_mtime
    if 0 <= age <= max_age_seconds:
      return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  return None


def scan_sessions() -> dict[str, Any]:
  today = local_date_string()
  recent_dates = recent_date_strings()
  recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}
  seen: set[str] = set()
  sessions: set[str] = set()
  active_days: set[str] = set()
  today_sessions: set[str] = set()
  today_tokens: dict[str, int] = {}
  usage_by_model: dict[str, dict[str, int]] = {}
  prompts = 0
  today_prompt_count = 0
  today_token_total = 0

  for root in session_roots():
    for path in root.rglob("*.jsonl"):
      try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
          for line_number, line in enumerate(handle, 1):
            if '"usage"' not in line or '"assistant"' not in line:
              continue
            try:
              entry = json.loads(line)
              message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
              if entry.get("type") != "message" or message.get("role") != "assistant":
                continue
              provider = str(message.get("provider") or "")
              if provider not in XAI_PROVIDERS:
                continue
              unique_key = f"{path}:{entry.get('id') or line_number}"
              if unique_key in seen:
                continue
              seen.add(unique_key)
              usage = message.get("usage") or {}
              if not isinstance(usage, dict):
                continue
              input_tokens = usage_token(usage, "input", "inputTokens")
              output_tokens = usage_token(usage, "output", "outputTokens")
              cache_read = usage_token(usage, "cacheRead", "cacheReadInputTokens")
              cache_write = usage_token(usage, "cacheWrite", "cacheCreationInputTokens")
              total = input_tokens + output_tokens + cache_read + cache_write
              if total <= 0:
                total = number(usage.get("totalTokens"))
                input_tokens = total
              if total <= 0:
                continue
              model = str(message.get("model") or "grok")
              day = local_date_from_timestamp(entry.get("timestamp") or message.get("timestamp"))
            except Exception:
              continue

            session_key = str(path)
            sessions.add(session_key)
            active_days.add(day)
            prompts += 1
            bucket = usage_by_model.setdefault(model, empty_bucket())
            bucket["inputTokens"] += input_tokens
            bucket["outputTokens"] += output_tokens
            bucket["cacheReadInputTokens"] += cache_read
            bucket["cacheCreationInputTokens"] += cache_write
            if day in recent:
              recent[day]["messageCount"] += total
            if day == today:
              today_prompt_count += 1
              today_sessions.add(session_key)
              today_token_total += total
              today_tokens[model] = today_tokens.get(model, 0) + total
      except OSError:
        continue

  return {
    "todayPrompts": today_prompt_count,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_token_total,
    "todayTokensByModel": today_tokens,
    "recentDays": [recent[day] for day in recent_dates],
    "modelUsage": usage_by_model,
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "scanDate": today,
  }


def scan_cache_paths() -> tuple[Path, Path]:
  digest_parts = [str(root) for root in session_roots()]
  digest = hashlib.sha1("\n".join(digest_parts).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  return root / f"omp-scan-{digest}.json", root / f"omp-scan-{digest}.lock"


def cached_scan(max_age_seconds: float) -> dict[str, Any]:
  cache_file, lock_file = scan_cache_paths()
  cached = read_fresh_json(cache_file, max_age_seconds)
  if isinstance(cached, dict) and cached.get("scanDate") == local_date_string():
    return cached
  with lock_file.open("w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    cached = read_fresh_json(cache_file, max_age_seconds)
    if isinstance(cached, dict) and cached.get("scanDate") == local_date_string():
      return cached
    stats = scan_sessions()
    try:
      write_json(cache_file, stats)
    except Exception as exc:
      print(f"omarchy-agent-usage-omp: could not write usage cache ({exc})", file=sys.stderr)
    return stats


def iso_from_ms(value: Any) -> str:
  ms = number(value)
  if ms <= 0:
    return ""
  try:
    return dt.datetime.fromtimestamp(ms / 1000, dt.timezone.utc).isoformat()
  except Exception:
    return ""


def limit_percent(amount: dict[str, Any]) -> float:
  if "usedFraction" in amount:
    try:
      value = float(amount.get("usedFraction"))
      return value if value == value else -1.0
    except Exception:
      return -1.0
  used = number(amount.get("used"))
  limit = number(amount.get("limit"))
  if limit > 0:
    return used / limit
  return -1.0


def limits_from_payload(payload: dict[str, Any]) -> tuple[list[dict[str, Any]], str]:
  limits: list[dict[str, Any]] = []
  tier = ""
  for report in payload.get("reports") or []:
    if not isinstance(report, dict):
      continue
    provider = str(report.get("provider") or "")
    if provider not in XAI_PROVIDERS:
      continue
    for entry in report.get("limits") or []:
      if not isinstance(entry, dict):
        continue
      amount = entry.get("amount") if isinstance(entry.get("amount"), dict) else {}
      percent = limit_percent(amount)
      if percent < 0:
        continue
      label = str(entry.get("label") or "Limit")
      window = entry.get("window") if isinstance(entry.get("window"), dict) else {}
      resets_at = iso_from_ms(window.get("resetsAt") or entry.get("resetsAt"))
      if "supergrok" in label.lower():
        tier = "SuperGrok"
      limits.append({
        "label": label,
        "title": label,
        "percent": percent,
        "resetsAt": resets_at,
      })
  return limits, tier or ("SuperGrok" if limits else "")


def probe_limits(force: bool) -> dict[str, Any]:
  omp = find_command("omp")
  if not omp:
    return {
      "ok": False,
      "helpText": "omp not found in PATH. Install Oh My Pi, then run `omp auth-broker login xai-oauth`.",
    }

  if force:
    try:
      subprocess.run(
        [omp, "usage", "invalidate", "--provider", "xai-oauth"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=ENV,
        timeout=20,
      )
    except Exception:
      pass

  try:
    completed = subprocess.run(
      [omp, "usage", "--json", "--provider", "xai-oauth"],
      check=False,
      capture_output=True,
      text=True,
      env=ENV,
      timeout=30,
    )
  except subprocess.TimeoutExpired:
    return {
      "ok": False,
      "transport": True,
      "helpText": "omp usage timed out. Retrying shortly. Local SuperGrok stats are still shown.",
    }
  except Exception as exc:
    return {"ok": False, "helpText": f"Could not run omp usage ({exc}). Local SuperGrok stats are still shown."}

  if completed.returncode != 0:
    return {
      "ok": False,
      "helpText": "omp usage failed. Run `omp auth-broker login xai-oauth`. Local SuperGrok stats are still shown.",
    }

  try:
    payload = json.loads(completed.stdout)
  except Exception:
    return {"ok": False, "helpText": "omp usage returned unreadable JSON. Local SuperGrok stats are still shown."}

  if not isinstance(payload, dict):
    return {"ok": False, "helpText": "omp usage returned no SuperGrok report."}

  limits, tier = limits_from_payload(payload)
  if not limits:
    if payload.get("accountsWithoutUsage"):
      return {"ok": False, "helpText": AUTH_HELP}
    return {"ok": False, "helpText": "omp usage returned no SuperGrok limits. Local SuperGrok stats are still shown."}
  return {"ok": True, "limits": limits, "tierLabel": tier}


def usable_cached_limits(cached: dict[str, Any]) -> list[dict[str, Any]]:
  entries = cached.get("limits")
  if not isinstance(entries, list):
    return []
  now = dt.datetime.now(dt.timezone.utc)
  kept = []
  for entry in entries:
    if not isinstance(entry, dict):
      continue
    raw = str(entry.get("resetsAt") or "")
    if raw == "":
      kept.append(entry)
      continue
    try:
      resets_at = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except Exception:
      kept.append(entry)
      continue
    if resets_at.tzinfo is None:
      resets_at = resets_at.replace(tzinfo=dt.timezone.utc)
    if resets_at > now:
      kept.append(entry)
  return kept


def collect_limits(force: bool) -> dict[str, Any]:
  result = {"limits": [], "tierLabel": "", "usageStatusText": "", "authHelpText": AUTH_HELP}
  probe_cache = cache_root() / "omp-limits.json"
  cached = read_fresh_json(probe_cache, float("inf")) or {}
  fallback = usable_cached_limits(cached)

  fetched_at = number(cached.get("fetchedAtMs")) / 1000
  if fallback and not force and time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
    result["limits"] = fallback
    result["tierLabel"] = str(cached.get("tierLabel") or "SuperGrok")
    return result

  probe = probe_limits(force)
  if probe.get("ok"):
    result["limits"] = probe["limits"]
    result["tierLabel"] = str(probe.get("tierLabel") or "SuperGrok")
    try:
      write_json(
        probe_cache,
        {
          "fetchedAtMs": round(time.time() * 1000),
          "limits": probe["limits"],
          "tierLabel": result["tierLabel"],
        },
      )
    except Exception:
      pass
    return result

  if probe.get("transport"):
    result["retryAdvised"] = True
  if fallback:
    result["limits"] = fallback
    result["tierLabel"] = str(cached.get("tierLabel") or "SuperGrok")
  else:
    result["usageStatusText"] = "SuperGrok limits unavailable"
    result["authHelpText"] = str(probe.get("helpText") or AUTH_HELP)
  return result


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
  try:
    stats = cached_scan(max_age)
  except Exception as exc:
    print(f"omarchy-agent-usage-omp: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    stats = scan_sessions()

  limits = collect_limits(args.force)
  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": number(stats.get("totalPrompts")) > 0 or len(limits["limits"]) > 0,
    "hasLocalStats": True,
    "tierLabel": limits["tierLabel"],
    "usageStatusText": limits["usageStatusText"],
    "authHelpText": limits["authHelpText"],
    "limits": limits["limits"],
  }
  if limits.get("retryAdvised"):
    record["retryAdvised"] = True
  record.update({key: stats[key] for key in empty_stats() if key != "scanDate"})
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
