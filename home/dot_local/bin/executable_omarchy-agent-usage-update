#!/usr/bin/env bash

# omarchy:summary=Regenerate the AI agent usage data files
# omarchy:args=[--force] [--limits-only] [--except <agent>] [agent...]
# omarchy:examples=omarchy agent usage-update | omarchy agent usage-update claude | omarchy agent usage-update --except codex

# Shadows the packaged command on PATH only to add two things, so everything
# the package does (account refresh, autoswitch, new collectors) still comes
# from the package after every Omarchy update:
# - user collectors in ~/.local/bin whose id the package doesn't ship;
# - the OpenRouter key omp-env keeps in ~/.omp/agent/.env, which the packaged
#   collector doesn't read.

OMARCHY_ROOT="${OMARCHY_PATH:-/usr/share/omarchy}"
USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"

if [[ -z ${OPENROUTER_API_KEY:-} && -r ${OMP_ENV_FILE:-$HOME/.omp/agent/.env} ]]; then
  key=$(sed -n 's/^OPENROUTER_API_KEY=//p' "${OMP_ENV_FILE:-$HOME/.omp/agent/.env}" | tail -n 1)
  key=${key%\"}; key=${key#\"}; key=${key%\'}; key=${key#\'}
  [[ -n $key ]] && export OPENROUTER_API_KEY="$key"
  unset key
fi

"$OMARCHY_ROOT/bin/omarchy-agent-usage-update" "$@" &
packaged=$!

flags=()
only=()
declare -A excluded
while (($# > 0)); do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  [[ -n ${excluded[$1]:-} ]] && return 1
  ((${#only[@]} == 0)) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$1" ]] && return 0
  done
  return 1
}

collect() {
  local record tmp
  if ! record=$("$1" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "omarchy-agent-usage-update: $2 collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$2.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$2.json"
}

mkdir -p "$USAGE_DIR"
pids=()
for collector in "$HOME"/.local/bin/omarchy-agent-usage-*; do
  [[ -x $collector ]] || continue
  agent="${collector##*/omarchy-agent-usage-}"
  [[ $agent == "update" || -e $OMARCHY_ROOT/bin/omarchy-agent-usage-$agent ]] && continue
  wanted "$agent" || continue
  collect "$collector" "$agent" &
  pids+=($!)
done

status=0
wait "$packaged" || status=1
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit $status
