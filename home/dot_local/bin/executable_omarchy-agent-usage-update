#!/usr/bin/env bash

# omarchy:summary=Regenerate the AI agent usage data files
# omarchy:args=[--force] [--limits-only] [--except <agent>] [agent...]
# omarchy:examples=omarchy agent usage-update | omarchy agent usage-update claude | omarchy agent usage-update --except codex

# Packaged Omarchy only walks $OMARCHY_PATH/bin. This wrapper also picks up
# user collectors in ~/.local/bin so a new agent is still just a collector.
# Packaged collectors win when both sides ship the same agent id.

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
mkdir -p "$USAGE_DIR"

OMARCHY_ROOT="${OMARCHY_PATH:-/usr/share/omarchy}"

flags=()
only=()
declare -A excluded

while [[ $# -gt 0 ]]; do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local collector="$1" agent="$2"
  local record tmp
  if ! record=$("$collector" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "omarchy-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

declare -A collectors
for dir in "${OMARCHY_ROOT}/bin" "${HOME}/.local/bin"; do
  [[ -d $dir ]] || continue
  for collector in "$dir"/omarchy-agent-usage-*; do
    [[ -x $collector ]] || continue
    agent="${collector##*/omarchy-agent-usage-}"
    [[ $agent == "update" ]] && continue
    [[ -n ${collectors[$agent]:-} ]] && continue
    collectors[$agent]="$collector"
  done
done

pids=()
for agent in "${!collectors[@]}"; do
  wanted "$agent" || continue
  collect "${collectors[$agent]}" "$agent" &
  pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit $status
