#!/usr/bin/env bash
set -euo pipefail

# Toggle the bar-popup overlay without touching packaged Omarchy files.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/decent-angl"
DISABLE_FLAG="${STATE_DIR}/omarchy-shell-overlay.off"
DRIFT_FLAG="${STATE_DIR}/omarchy-shell-overlay.drift"
OVERLAY_DIR="${OMARCHY_SHELL_OVERLAY_DIR:-$HOME/.local/share/omarchy-shell-overlay}"
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
SHELL_DIR="${OMARCHY_PATH}/shell"
HASH_FILE="${OVERLAY_DIR}/upstream.sha256"

usage() {
  cat <<'EOF'
Usage: omarchy-shell-overlay <status|enable|disable|reset>

  status   Show whether the overlay would apply on the next shell launch
  enable   Use overlay popups and restart the shell
  disable  Use packaged popups and restart the shell
  reset    Copy packaged overlay targets into the overlay tree and
           refresh upstream hashes. Local edits are discarded.
EOF
}

overlay_rels() {
  [[ -f ${HASH_FILE} ]] || return 1
  awk 'NF >= 2 { print $2 }' "${HASH_FILE}"
}

need_overlay_dir() {
  [[ -d ${OVERLAY_DIR} ]] || {
    echo "overlay directory missing: ${OVERLAY_DIR}" >&2
    exit 1
  }
}

hashes_match() {
  [[ -f ${HASH_FILE} ]] || return 1
  (cd "${SHELL_DIR}" && sha256sum --strict -c "${HASH_FILE}" >/dev/null 2>&1)
}

files_present() {
  local rel
  [[ -f ${HASH_FILE} ]] || return 1
  while IFS= read -r rel; do
    [[ -f ${OVERLAY_DIR}/${rel} ]] || return 1
  done < <(overlay_rels)
}

restart_shell() {
  if command -v omarchy-restart-shell >/dev/null 2>&1; then
    omarchy-restart-shell
  else
    echo "omarchy-restart-shell not on PATH; restart the shell yourself" >&2
    return 1
  fi
}

cmd_status() {
  local state="enabled"
  local count=0
  [[ -e ${DISABLE_FLAG} ]] && state="disabled"
  if [[ -f ${HASH_FILE} ]]; then
    count="$(overlay_rels | wc -l)"
  fi

  printf 'STATE   %s\n' "${state}"
  printf 'OVERLAY %s\n' "${OVERLAY_DIR}"
  printf 'PACKAGE %s\n' "${SHELL_DIR}"
  printf 'TARGETS %s\n' "${count}"

  if files_present; then
    printf 'FILES   present\n'
  else
    printf 'FILES   missing\n'
  fi

  if hashes_match; then
    printf 'UPSTREAM match\n'
    rm -f "${DRIFT_FLAG}"
  else
    printf 'UPSTREAM drifted (packaged overlay targets changed)\n'
    [[ -e ${DRIFT_FLAG} ]] && printf 'DRIFT   %s\n' "${DRIFT_FLAG}"
  fi

  if [[ ${state} == enabled ]] && hashes_match && files_present; then
    printf 'NEXT    overlay\n'
  else
    printf 'NEXT    packaged\n'
  fi
}

cmd_enable() {
  mkdir -p "${STATE_DIR}"
  rm -f "${DISABLE_FLAG}"
  cmd_status
  restart_shell
}

cmd_disable() {
  mkdir -p "${STATE_DIR}"
  : >"${DISABLE_FLAG}"
  cmd_status
  restart_shell
}

cmd_reset() {
  local rel
  need_overlay_dir
  [[ -f ${HASH_FILE} ]] || {
    echo "overlay hash list missing: ${HASH_FILE}" >&2
    exit 1
  }
  while IFS= read -r rel; do
    [[ -f ${SHELL_DIR}/${rel} ]] || {
      echo "packaged QML missing: ${SHELL_DIR}/${rel}" >&2
      exit 1
    }
    mkdir -p "$(dirname "${OVERLAY_DIR}/${rel}")"
    cp -a "${SHELL_DIR}/${rel}" "${OVERLAY_DIR}/${rel}"
  done < <(overlay_rels)
  (
    cd "${SHELL_DIR}"
    sha256sum -- $(overlay_rels)
  ) >"${HASH_FILE}"
  rm -f "${DRIFT_FLAG}"
  echo "Overlay reset to packaged targets."
  cmd_status
}

case "${1:-status}" in
  status) cmd_status ;;
  enable) cmd_enable ;;
  disable) cmd_disable ;;
  reset) cmd_reset ;;
  -h | --help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
