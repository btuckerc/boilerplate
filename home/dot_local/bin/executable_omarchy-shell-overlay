#!/usr/bin/env bash
set -euo pipefail

# Toggle and apply the bar-popup overlay without touching packaged Omarchy files.
# Overlay QML is applied per path. A matching upstream hash copies the overlay
# file. A changed hash 3-way-merges onto the new packaged file using a base
# snapshot; a conflict uses packaged QML for that path only.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/decent-angl"
DISABLE_FLAG="${STATE_DIR}/omarchy-shell-overlay.off"
DRIFT_FLAG="${STATE_DIR}/omarchy-shell-overlay.drift"
RUNTIME_STAMP="${STATE_DIR}/omarchy-shell-runtime.path"
RUNTIME_DIR="${STATE_DIR}/omarchy-shell-runtime"
RUNTIME_SHELL="${RUNTIME_DIR}/shell"
BASE_DIR="${OMARCHY_SHELL_OVERLAY_BASE:-$STATE_DIR/omarchy-shell-overlay-base}"
OVERLAY_DIR="${OMARCHY_SHELL_OVERLAY_DIR:-$HOME/.local/share/omarchy-shell-overlay}"
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
SHELL_DIR="${OMARCHY_PATH}/shell"
HASH_FILE="${OVERLAY_DIR}/upstream.sha256"
# The tree is assembled here and then published, so a running shell never sees
# a half-built runtime (packaged QML briefly standing in for an overlay path).
BUILD_SHELL="${STATE_DIR}/omarchy-shell-build/shell"
# Records which packaged shell the runtime was built from; its mtime is when
# that build started. omarchy-shell (the ~/.local/bin wrapper) reads it too.
SYNCED_MARK="${STATE_DIR}/omarchy-shell-runtime.synced"
LOCK_FILE="${STATE_DIR}/omarchy-shell-runtime.lock"
# Every pacman install, upgrade or removal changes this directory's entries.
PACKAGE_DB="${OMARCHY_SHELL_OVERLAY_PACKAGE_DB:-/var/lib/pacman/local}"

usage() {
  cat <<'EOF'
Usage: omarchy-shell-overlay <status|enable|disable|reset|sync-runtime|refresh>

  status       Per-file match/merge/skip and whether the next launch overlays
  enable       Use overlay popups and restart the shell
  disable      Use packaged popups and restart the shell
  reset        Copy packaged overlay targets into the overlay tree and
               refresh upstream hashes and merge bases. Local edits are discarded.
  sync-runtime Build the runtime tree (called by omarchy-launch-shell)
  refresh      Rebuild the runtime tree under a running overlay shell when
               packages changed since it was built (called by omarchy-shell)
EOF
}

log() {
  logger -t omarchy-shell-overlay "$@" || true
}

overlay_entries() {
  [[ -f ${HASH_FILE} ]] || return 1
  awk 'NF >= 2 { printf "%s\t%s\n", $1, $2 }' "${HASH_FILE}"
}

need_overlay_dir() {
  [[ -d ${OVERLAY_DIR} ]] || {
    echo "overlay directory missing: ${OVERLAY_DIR}" >&2
    exit 1
  }
}

file_hash() {
  sha256sum -- "$1" | awk '{ print $1 }'
}

snapshot_base() {
  local rel="$1"
  mkdir -p "$(dirname "${BASE_DIR}/${rel}")"
  cp -a "${SHELL_DIR}/${rel}" "${BASE_DIR}/${rel}"
}

# Prints MATCH, MERGE, or SKIP <reason>.
classify_rel() {
  local expected="$1"
  local rel="$2"
  local overlay="${OVERLAY_DIR}/${rel}"
  local packaged="${SHELL_DIR}/${rel}"
  local base="${BASE_DIR}/${rel}"
  local actual

  if [[ ! -f ${overlay} ]]; then
    printf 'SKIP missing-overlay\n'
    return
  fi
  if [[ ! -f ${packaged} ]]; then
    printf 'SKIP missing-packaged\n'
    return
  fi

  actual="$(file_hash "${packaged}")"
  if [[ ${actual} == "${expected}" ]]; then
    printf 'MATCH\n'
    return
  fi

  if [[ ! -f ${base} ]]; then
    printf 'SKIP no-base\n'
    return
  fi
  if ! command -v git >/dev/null 2>&1; then
    printf 'SKIP no-git\n'
    return
  fi
  if git merge-file -p -q "${overlay}" "${base}" "${packaged}" >/dev/null; then
    printf 'MERGE\n'
    return
  fi
  printf 'SKIP conflict\n'
}

rewrite_first_party_plugins_dir() {
  python3 - "${BUILD_SHELL}/shell.qml" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
old = 'readonly property string firstPartyPluginsDir: shellPath + "/plugins"'
new = 'readonly property string firstPartyPluginsDir: Quickshell.shellDir + "/plugins"'
text = path.read_text()
if old not in text:
    raise SystemExit(1)
path.write_text(text.replace(old, new, 1))
PY
}

copy_packaged_shell() {
  mkdir -p "${BUILD_SHELL}"
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete --checksum "${SHELL_DIR}/" "${BUILD_SHELL}/"
  else
    rm -rf "${BUILD_SHELL}"
    mkdir -p "${BUILD_SHELL}"
    cp -a "${SHELL_DIR}/." "${BUILD_SHELL}/"
  fi
}

# Only files whose content changed are rewritten, each by rename, so a shell
# already running from the runtime tree reads either the old or the new file.
publish_runtime() {
  mkdir -p "${RUNTIME_SHELL}"
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete --checksum "${BUILD_SHELL}/" "${RUNTIME_SHELL}/"
  else
    rm -rf "${RUNTIME_SHELL}"
    mkdir -p "${RUNTIME_SHELL}"
    cp -a "${BUILD_SHELL}/." "${RUNTIME_SHELL}/"
  fi
}

# The runtime shell discovers plugins from this tree (firstPartyPluginsDir is
# rewritten to it), so a package update that adds or changes shell files is
# invisible to it until the tree is rebuilt. Stale when never built here, built
# from another OMARCHY_PATH, or any package changed since the build started.
runtime_stale() {
  local built_from=""

  [[ -f ${SYNCED_MARK} ]] || return 0
  read -r built_from <"${SYNCED_MARK}" || true
  [[ ${built_from} == "${SHELL_DIR}" ]] || return 0
  [[ ${PACKAGE_DB} -nt ${SYNCED_MARK} ]] && return 0
  return 1
}

take_lock() {
  mkdir -p "${STATE_DIR}"
  exec {lock_fd}>"${LOCK_FILE}"
  flock -w 120 "${lock_fd}"
}

apply_rel() {
  local kind="$1"
  local rel="$2"
  local dest="${BUILD_SHELL}/${rel}"
  local tmp

  mkdir -p "$(dirname "${dest}")"
  case "${kind}" in
    MATCH)
      cp -a "${OVERLAY_DIR}/${rel}" "${dest}"
      snapshot_base "${rel}"
      ;;
    MERGE)
      tmp="$(mktemp)"
      if git merge-file -p -q "${OVERLAY_DIR}/${rel}" "${BASE_DIR}/${rel}" "${SHELL_DIR}/${rel}" >"${tmp}"; then
        mv "${tmp}" "${dest}"
        log "${rel}: merged onto new packaged QML"
      else
        rm -f "${tmp}"
        return 1
      fi
      ;;
    SKIP)
      ;;
    *)
      return 1
      ;;
  esac
}

restart_shell() {
  if command -v omarchy-restart-shell >/dev/null 2>&1; then
    omarchy-restart-shell
  else
    echo "omarchy-restart-shell not on PATH; restart the shell yourself" >&2
    return 1
  fi
}

write_drift_flag() {
  mkdir -p "${STATE_DIR}"
  if ((${#drift_lines[@]} > 0)); then
    printf '%s\n' "${drift_lines[@]}" >"${DRIFT_FLAG}"
  else
    rm -f "${DRIFT_FLAG}"
  fi
}

cmd_status() {
  local state="enabled"
  local count=0
  local expected rel kind rest
  local match=0 merge=0 skip=0
  local next="packaged"

  [[ -e ${DISABLE_FLAG} ]] && state="disabled"
  if [[ -f ${HASH_FILE} ]]; then
    count="$(overlay_entries | wc -l)"
  fi

  printf 'STATE   %s\n' "${state}"
  printf 'OVERLAY %s\n' "${OVERLAY_DIR}"
  printf 'PACKAGE %s\n' "${SHELL_DIR}"
  printf 'BASE    %s\n' "${BASE_DIR}"
  printf 'TARGETS %s\n' "${count}"

  if [[ -f ${HASH_FILE} ]]; then
    while IFS=$'\t' read -r expected rel; do
      [[ -n ${rel} ]] || continue
      rest="$(classify_rel "${expected}" "${rel}")"
      kind="${rest%% *}"
      printf '%-7s %s' "${kind}" "${rel}"
      if [[ ${kind} == SKIP ]]; then
        printf ' %s' "${rest#SKIP }"
        skip=$((skip + 1))
      elif [[ ${kind} == MERGE ]]; then
        merge=$((merge + 1))
      else
        match=$((match + 1))
      fi
      printf '\n'
    done < <(overlay_entries)
  fi

  if ((skip + merge == 0)) && ((count > 0)); then
    printf 'UPSTREAM match\n'
  elif ((merge + match > 0)); then
    printf 'UPSTREAM %s match, %s merge, %s skip\n' "${match}" "${merge}" "${skip}"
  else
    printf 'UPSTREAM drifted\n'
  fi

  if [[ ${state} == enabled ]] && ((match + merge > 0)); then
    next="overlay"
  fi
  printf 'NEXT    %s\n' "${next}"
}

# launch: the shell is about to start. Return 1 when nothing overlays, so the
#   launcher runs packaged QML and drops the runtime stamp.
# live: a shell may already be running from the runtime tree, and the qs and
#   quickshell wrappers find it only through the stamp. Always publish and
#   keep the stamp; a path that no longer applies falls back to packaged QML.
sync_tree() {
  local mode="$1"
  local expected rel kind rest started
  local applied=0
  local -a drift_lines=()

  # When the build starts, less 10ms for coarse filesystem timestamps: a package
  # change during the build still reads newer than the mark, so the next call
  # rebuilds again. bash's -nt compares nanoseconds.
  started=$(($(date +%s%N) - 10000000))
  started="${started:0:-9}.${started: -9}"
  copy_packaged_shell

  while IFS=$'\t' read -r expected rel; do
    [[ -n ${rel} ]] || continue
    rest="$(classify_rel "${expected}" "${rel}")"
    kind="${rest%% *}"
    apply_rel "${kind}" "${rel}"
    case "${kind}" in
      MATCH | MERGE)
        applied=$((applied + 1))
        ;;
    esac
    if [[ ${kind} == SKIP ]]; then
      drift_lines+=("SKIP ${rel} ${rest#SKIP }")
      log "${rel}: ${rest#SKIP }; using packaged QML"
    elif [[ ${kind} == MERGE ]]; then
      drift_lines+=("MERGE ${rel}")
    fi
  done < <(overlay_entries)

  if ((applied == 0)); then
    log "no overlay files applied; using packaged popups"
    if [[ ${mode} == launch ]]; then
      rm -f "${RUNTIME_STAMP}" "${SYNCED_MARK}"
      write_drift_flag
      return 1
    fi
  fi

  if ! rewrite_first_party_plugins_dir; then
    log "firstPartyPluginsDir rewrite failed; overlay widgets would be ignored"
    if [[ ${mode} == launch ]]; then
      rm -f "${RUNTIME_STAMP}" "${SYNCED_MARK}"
      return 1
    fi
  fi

  publish_runtime
  mkdir -p "${STATE_DIR}"
  printf '%s\n' "${SHELL_DIR}" >"${SYNCED_MARK}"
  touch -d "@${started}" "${SYNCED_MARK}"
  if [[ ${mode} == launch ]]; then
    printf '%s\n' "${RUNTIME_SHELL}" >"${RUNTIME_STAMP}"
  fi
  write_drift_flag
}

cmd_sync_runtime() {
  if [[ -e ${DISABLE_FLAG} ]]; then
    return 1
  fi
  if [[ ! -f ${HASH_FILE} ]]; then
    log "overlay hash list missing; using packaged popups"
    return 1
  fi
  if [[ ! -d ${SHELL_DIR} ]]; then
    log "packaged shell missing: ${SHELL_DIR}"
    return 1
  fi
  if ! take_lock; then
    log "runtime lock busy; using packaged popups"
    return 1
  fi

  sync_tree launch
}

# Keep a running overlay shell's tree current with the packages, as a stock
# shell reads /usr/share/omarchy/shell after an upgrade. Without this, a
# migration that adds a plugin and then places it on the bar fails with
# "not a known widget". A shell running packaged QML (no stamp) needs nothing.
cmd_refresh() {
  if [[ -e ${DISABLE_FLAG} || ! -s ${RUNTIME_STAMP} ]]; then
    return 0
  fi
  if [[ ! -f ${HASH_FILE} || ! -d ${SHELL_DIR} ]]; then
    return 0
  fi
  runtime_stale || return 0
  if ! take_lock; then
    log "runtime lock busy; refresh skipped"
    return 1
  fi
  # Another caller may have rebuilt it while this one waited.
  runtime_stale || return 0

  sync_tree live
  log "runtime tree refreshed from ${SHELL_DIR}"
}

cmd_enable() {
  mkdir -p "${STATE_DIR}"
  rm -f "${DISABLE_FLAG}"
  cmd_status
  restart_shell
}

cmd_disable() {
  mkdir -p "${STATE_DIR}"
  : >"${DISABLE_FLAG}"
  rm -f "${RUNTIME_STAMP}" "${SYNCED_MARK}"
  cmd_status
  restart_shell
}

cmd_reset() {
  local expected rel
  need_overlay_dir
  [[ -f ${HASH_FILE} ]] || {
    echo "overlay hash list missing: ${HASH_FILE}" >&2
    exit 1
  }
  while IFS=$'\t' read -r expected rel; do
    [[ -n ${rel} ]] || continue
    [[ -f ${SHELL_DIR}/${rel} ]] || {
      echo "packaged QML missing: ${SHELL_DIR}/${rel}" >&2
      exit 1
    }
    mkdir -p "$(dirname "${OVERLAY_DIR}/${rel}")"
    cp -a "${SHELL_DIR}/${rel}" "${OVERLAY_DIR}/${rel}"
    snapshot_base "${rel}"
  done < <(overlay_entries)
  (
    cd "${SHELL_DIR}"
    sha256sum -- $(overlay_entries | awk -F '\t' '{ print $2 }')
  ) >"${HASH_FILE}"
  rm -f "${DRIFT_FLAG}"
  echo "Overlay reset to packaged targets."
  cmd_status
}

case "${1:-status}" in
  status) cmd_status ;;
  enable) cmd_enable ;;
  disable) cmd_disable ;;
  reset) cmd_reset ;;
  sync-runtime) cmd_sync_runtime ;;
  refresh) cmd_refresh ;;
  -h | --help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
