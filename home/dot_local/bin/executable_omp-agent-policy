#!/usr/bin/env bun
// omp-agent-policy: offline, version-pinned mirror of how OMP dispatches task agents.
//
// Resolves every agent's effective definition, model, thinking level and tools exactly as the pinned OMP
// release would, then checks the default-profile contracts. Cited paths are in the upstream tree
// packages/ at the pinned tag (coding-agent/src unless another package is named). Anything the mirror
// cannot reproduce fails closed (UNSUPPORTED/MODEL/VERSION) instead of being guessed. Real dispatch is
// confirmed separately by omp-agent-smoke.
import { createHash } from "node:crypto";
import { parseEnv } from "node:util";
import type { Dirent } from "node:fs";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";

const MIRRORED_OMP = ["18.12.1"];
const USAGE = `usage: omp-agent-policy (--root REPO | --live AGENT_DIR --omp-version VER) [options]
  --root REPO            chezmoi source tree; no HOME or cwd reads
  --live AGENT_DIR       deployed agent dir (e.g. ~/.omp/agent)
  --omp-version VER      runtime version (live mode)
  --cwd DIR              live mode: project discovery start (default: process cwd)
  --project-agents DIR   root mode: project agents dir to test shadowing
  --config FILE          settings overlay, repeatable, later wins
  --catalog FILE         native evidence from omp-baseline: \`omp models --json\` (availability, disabled
                         providers, thinking ladders) with its stderr, omp version, profile and models.yml;
                         without it models.yml defaults are unused and contract clamping is UNVERIFIED
  --profile default|local  contracts apply to default only (root mode)
  --parent PATTERN       parent session model pattern (default: the default role)
  --effort lo|med|hi     simulate caller effort (needs --catalog)
  --dispatch default|restricted  predict runtime tool grants (default) or declared tools only
  --json                 one JSON report on stdout`;

