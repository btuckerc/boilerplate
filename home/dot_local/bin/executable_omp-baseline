#!/usr/bin/env bash

# Keep the portable OMP baseline identical across the fleet. Published Git
# history is authoritative and any machine may author reviewed commits.

set -euo pipefail

REPO_ROOT="${OMP_BASELINE_REPO_ROOT:-$HOME/src/boilerplate}"
CHEZMOI_ROOT="${OMP_BASELINE_CHEZMOI_ROOT:-$HOME/.local/share/chezmoi}"
MANIFEST="${OMP_BASELINE_MANIFEST:-$HOME/.config/decent-angl/omp-baseline-manifest.tsv}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/decent-angl"
MARKER="$STATE_DIR/omp-baseline-drift"
UPSTREAM_MARKER="$STATE_DIR/omp-upstream"
LOG_FILE="$STATE_DIR/omp-baseline.log"
LOCK_DIR="$STATE_DIR/omp-baseline.lock"
STRICT=false
OMP_GITHUB_REPO="can1357/oh-my-pi"

usage() {
  cat <<'EOF'
Usage: omp-baseline <status|validate|apply|pull|check-upstream|upgrade|guard|install-guard|fleet> [options]

  status          Compare repo, chezmoi source, rendered live files, and version.
  validate        Run status plus coverage, secret-boundary, and OMP parser checks.
  apply           Apply the local published source, install its exact pin, validate.
  pull            Reconcile the complete published baseline, then validate OMP.
  check-upstream  Compare the published pin to GitHub latest. Write omp-upstream.
  upgrade [VER]   Move the three pin sites to VER or GitHub latest, install, validate.
                  Does not commit or reconcile. --dry-run prints the plan only.
  guard           Validate local OMP state without overwriting source.
  install-guard   Install the hourly launchd/systemd user guard.
  fleet           SSH to t14, macbook, and macmini and report pin, gh, and validate.
  --strict        Also require every portable source file to be tracked by Git.
EOF
}

cm() {
  local candidate mise_bin chezmoi_bin
  mise_bin=""
  for candidate in \
    "$(command -v mise 2>/dev/null || true)" \
    "$HOME/.local/bin/mise" \
    "$HOME/.local/share/mise/bin/mise" \
    /opt/homebrew/bin/mise \
    /usr/local/bin/mise \
    /usr/bin/mise; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then mise_bin="$candidate"; break; fi
  done
  if [ -n "$mise_bin" ]; then
    "$mise_bin" exec -- chezmoi "$@"
    return
  fi
  chezmoi_bin=""
  for candidate in \
    "$(command -v chezmoi 2>/dev/null || true)" \
    "$HOME/.local/share/mise/shims/chezmoi" \
    "$HOME/.local/bin/chezmoi" \
    /opt/homebrew/bin/chezmoi \
    /usr/local/bin/chezmoi \
    /usr/bin/chezmoi; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then chezmoi_bin="$candidate"; break; fi
  done
  if [ -n "$chezmoi_bin" ]; then
    "$chezmoi_bin" "$@"
  else
    printf 'chezmoi is unavailable in the unattended environment\n' >&2
    return 127
  fi
}

expand_home() {
  case "$1" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

os_in_scope() {
  case "${1:-all}" in
    ""|all) return 0 ;;
    linux) [ "$(uname -s)" = Linux ] ;;
    darwin) [ "$(uname -s)" = Darwin ] ;;
    *)
      printf 'MANIFEST unknown os scope %s\n' "$1" >&2
      return 1
      ;;
  esac
}

iter_manifest() {
  local kind live_path repo_rel os_scope
  while IFS=$'\t' read -r kind live_path repo_rel os_scope; do
    [ -n "${kind:-}" ] || continue
    case "$kind" in \#*) continue ;; esac
    printf '%s\t%s\t%s\t%s\n' "$kind" "$(expand_home "$live_path")" "$repo_rel" "${os_scope:-all}"
  done <"$MANIFEST"
}

manifest_value() {
  sed -n "s/^# $1[[:space:]]*//p" "$MANIFEST" | head -n 1
}

machine_id() {
  local value host
  value="$(cm data --format json 2>/dev/null | jq -r '.decentangl.machine_id // empty' 2>/dev/null || true)"
  if [ -n "$value" ]; then
    printf '%s\n' "$value"
    return
  fi
  host="$(hostname -s 2>/dev/null || hostname)"
  case "$host" in
    BTC-MBP14*|MacBook*|macbook*) printf '%s\n' macbook ;;
    mc|mc.*|macmini*|Macmini*) printf '%s\n' macmini ;;
    btct14|T14|t14) printf '%s\n' omarchy ;;
    *) printf '%s\n' "$host" ;;
  esac
}

expected_version() {
  manifest_value omp-version
}

portable_support_paths() {
  cat <<'EOF'
home/dot_config/decent-angl/omp-baseline-manifest.tsv
home/.chezmoidata/decentangl.yaml
home/dot_config/decent-angl/opnsense.env.tmpl
home/dot_config/mise/config.toml
home/dot_local/bin/executable_omp-baseline
home/dot_local/bin/executable_decent-angl-skills
home/dot_local/bin/executable_omp-openrouter-env
home/dot_local/bin/executable_opnsense-api
home/dot_local/bin/executable_opnsense-store-secret
home/run_onchange_after_04-setup-omp.sh.tmpl
home/run_onchange_after_05-apply-omp-baseline.sh.tmpl
EOF
}

portable_paths() {
  iter_manifest | while IFS=$'\t' read -r _kind _live repo_rel _os_scope; do
    printf '%s\n' "$repo_rel"
  done
  printf '%s\n' home/private_dot_omp/private_agent/.chezmoiignore
  portable_support_paths
}

git_tracked() {
  git -C "$REPO_ROOT" ls-files --error-unmatch "$1" >/dev/null 2>&1
}

check_manifest_status() {
  local failures=0 kind live_path repo_rel repo_path mirror_path diff_output pin actual

  if [ ! -r "$MANIFEST" ]; then
    printf 'MANIFEST missing %s\n' "$MANIFEST" >&2
    return 1
  fi

  pin="$(expected_version)"
  actual="$(omp --version 2>/dev/null || true)"
  if [ "$actual" = "omp/$pin" ]; then
    printf 'VERSION %s\n' "$actual"
  else
    printf 'VERSION expected omp/%s, found %s\n' "$pin" "${actual:-missing}" >&2
    failures=1
  fi
  if [ -s "$UPSTREAM_MARKER" ]; then
    printf 'UPSTREAM %s\n' "$(tr '\n' ' ' <"$UPSTREAM_MARKER")"
  fi


  while IFS=$'\t' read -r kind live_path repo_rel os_scope; do
    repo_path="$REPO_ROOT/$repo_rel"
    mirror_path="$CHEZMOI_ROOT/$repo_rel"

    if [ ! -f "$repo_path" ]; then
      printf 'REPO    missing %s\n' "$repo_rel" >&2
      failures=1
      continue
    fi
    if [ ! -f "$mirror_path" ]; then
      printf 'SOURCE  missing %s\n' "$repo_rel" >&2
      failures=1
      continue
    fi
    if ! cmp -s "$repo_path" "$mirror_path"; then
      printf 'SOURCE  drift %s\n' "$repo_rel" >&2
      failures=1
      continue
    fi
    if ! os_in_scope "$os_scope"; then
      printf 'SKIP    %s (%s-only)\n' "$live_path" "$os_scope"
      continue
    fi
    case "$kind" in
      link)
        if [ ! -L "$live_path" ]; then
          printf 'LIVE    missing symlink %s\n' "$live_path" >&2
          failures=1
          continue
        fi
        ;;
      *)
        if [ ! -f "$live_path" ]; then
          printf 'LIVE    missing %s\n' "$live_path" >&2
          failures=1
          continue
        fi
        ;;
    esac

    diff_output="$(cm diff "$live_path" 2>/dev/null || true)"
    if [ -n "$diff_output" ]; then
      printf 'LIVE    drift %s\n' "$live_path" >&2
      failures=1
    else
      printf 'OK      %s\n' "$live_path"
    fi

    if [ "$kind" = exec ] && [ ! -x "$live_path" ]; then
      printf 'MODE    not executable %s\n' "$live_path" >&2
      failures=1
    fi
  done < <(iter_manifest)

  return "$failures"
}

check_source_coverage() {
  local failures=0 tmp_dir expected actual file rel
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/omp-baseline-coverage.XXXXXX")"
  expected="$tmp_dir/expected"
  actual="$tmp_dir/actual"
  trap 'rm -rf "$tmp_dir"' RETURN

  iter_manifest | while IFS=$'\t' read -r _kind _live repo_rel _os_scope; do
    case "$repo_rel" in home/private_dot_omp/private_agent/*) printf '%s\n' "$repo_rel" ;; esac
  done | sort >"$expected"

  find "$REPO_ROOT/home/private_dot_omp/private_agent" -type f ! -name .chezmoiignore -print 2>/dev/null |
    while IFS= read -r file; do
      rel="${file#"$REPO_ROOT/"}"
      printf '%s\n' "$rel"
    done | sort >"$actual"

  if ! diff -u "$expected" "$actual"; then
    printf 'COVERAGE portable OMP source and manifest disagree\n' >&2
    failures=1
  else
    printf 'COVERAGE complete\n'
  fi

  trap - RETURN
  rm -rf "$tmp_dir"
  return "$failures"
}

check_tracking_and_secrets() {
  local failures=0 repo_rel tracked runtime_managed

  while IFS= read -r repo_rel; do
    [ -n "$repo_rel" ] || continue
    if git_tracked "$repo_rel"; then
      printf 'TRACKED %s\n' "$repo_rel"
    elif [ "$STRICT" = true ]; then
      printf 'PENDING %s\n' "$repo_rel" >&2
      failures=1
    else
      printf 'PENDING %s\n' "$repo_rel"
    fi
  done < <(portable_paths | sort -u)

  tracked="$(git -C "$REPO_ROOT" ls-files home/private_dot_omp/private_agent 2>/dev/null || true)"
  if printf '%s\n' "$tracked" | grep -Eq '(^|/)(agent\.db|history\.db|models\.db|auth-.*\.token|secret-placeholder\.key|\.env)(-|$|\.)|/(sessions|cache|logs|state|terminal-sessions|managed-skills)/'; then
    printf 'SECRET  runtime or credential path is tracked\n' >&2
    printf '%s\n' "$tracked" | grep -E '(^|/)(agent\.db|history\.db|models\.db|auth-.*\.token|secret-placeholder\.key|\.env)(-|$|\.)|/(sessions|cache|logs|state|terminal-sessions|managed-skills)/' >&2
    failures=1
  else
    printf 'SECRET  Git boundary clean\n'
  fi

  runtime_managed="$(cm managed 2>/dev/null | grep -E '^\.omp/agent/(agent\.db|history\.db|models\.db|auth-|secret-placeholder\.key|\.env|sessions/|cache/|logs/|state/|terminal-sessions/|managed-skills/)' || true)"
  if [ -n "$runtime_managed" ]; then
    printf 'SECRET  chezmoi owns runtime paths\n%s\n' "$runtime_managed" >&2
    failures=1
  else
    printf 'SECRET  chezmoi boundary clean\n'
  fi

  return "$failures"
}

check_runtime_permissions() {
  local failures=0 file mode fstype attrs
  for file in \
    "$HOME/.omp/agent/.env" \
    "$HOME/.omp/agent"/agent.db* \
    "$HOME/.omp/agent"/history.db* \
    "$HOME/.omp/agent"/models.db* \
    "$HOME/.omp/agent"/auth-*.token \
    "$HOME/.omp/agent/secret-placeholder.key"; do
    [ -e "$file" ] || continue
    if [ "$(uname -s)" = Darwin ]; then
      mode="$(stat -f '%Lp' "$file")"
    else
      mode="$(stat -c '%a' "$file")"
    fi
    case "$mode" in
      600) ;;
      *) printf 'MODE    expected 600 on %s, found %s\n' "$file" "$mode" >&2; failures=1 ;;
    esac
  done
  [ "$failures" -eq 0 ] && printf 'MODE    local credentials private\n'
  if [ "$(uname -s)" = Linux ] && command -v lsattr >/dev/null 2>&1; then
    fstype="$(findmnt -n -o FSTYPE -T "$HOME/.omp/agent" 2>/dev/null || true)"
    if [ "$fstype" = btrfs ]; then
      attrs="$(lsattr -d "$HOME/.omp/agent" 2>/dev/null || true)"
      case "$attrs" in
        *C*) printf 'NOCOW   ~/.omp/agent\n' ;;
        *) printf 'NOCOW   expected chattr +C on ~/.omp/agent\n' >&2; failures=1 ;;
      esac
    fi
  fi
  return "$failures"
}

harden_runtime_permissions() {
  local file fstype
  install -d -m 700 "$HOME/.omp" "$HOME/.omp/agent"
  # btrfs CoW + sqlite page writes can displace pages (Firefox/Chrome
  # guidance; OMP #8082 saw the same cache-autoindex damage). Directory
  # +C is inherited by new files. Existing non-empty files stay CoW
  # until rewritten idle. APFS has no equivalent.
  if [ "$(uname -s)" = Linux ] && command -v chattr >/dev/null 2>&1; then
    fstype="$(findmnt -n -o FSTYPE -T "$HOME/.omp/agent" 2>/dev/null || true)"
    if [ "$fstype" = btrfs ]; then
      chattr +C "$HOME/.omp/agent" 2>/dev/null || true
    fi
  fi
  for file in \
    "$HOME/.omp/agent/.env" \
    "$HOME/.omp/agent"/agent.db* \
    "$HOME/.omp/agent"/history.db* \
    "$HOME/.omp/agent"/models.db* \
    "$HOME/.omp/agent"/auth-*.token \
    "$HOME/.omp/agent/secret-placeholder.key"; do
    [ -e "$file" ] || continue
    chmod 600 "$file"
  done
}


yaml_indented_scalar() {
  local file="$1" section="$2" key="$3"
  awk -v section="$section" -v key="$key" '
    $0 ~ "^[[:space:]]*" section ":" { in_sec=1; next }
    in_sec && /^[^[:space:]#]/ { in_sec=0 }
    in_sec && $1 == key ":" { print $2; exit }
  ' "$file"
}


yaml_top_scalar() {
  awk -v key="$2" '$0 ~ "^" key ":" { print $2; exit }' "$1"
}

require_scalar() {
  local label="$1" actual="$2" expected="$3"
  if [ "$actual" = "$expected" ]; then
    printf 'CONFIG  %s %s\n' "$label" "$actual"
    return 0
  fi
  printf 'CONFIG  %s expected %s, found %s\n' "$label" "$expected" "${actual:-missing}" >&2
  return 1
}

check_thinking_and_loop_policy() {
  local failures=0
  local source_config source_models live_config live_models
  local source_global live_global effective_global
  local source_model_level live_model_level
  local source_retries live_retries
  local source_fallback live_fallback
  local source_advisor live_advisor
  local source_stop live_stop
  local source_chain live_chain
  local source_search_first live_search_first
  local source_bash_bg live_bash_bg

  source_config="$REPO_ROOT/home/private_dot_omp/private_agent/config.yml"
  source_models="$REPO_ROOT/home/private_dot_omp/private_agent/models.yml"
  live_config="$HOME/.omp/agent/config.yml"
  live_models="$HOME/.omp/agent/models.yml"

  source_global="$(yaml_top_scalar "$source_config" defaultThinkingLevel)"
  live_global="$(yaml_top_scalar "$live_config" defaultThinkingLevel)"
  effective_global="$(omp config get defaultThinkingLevel --json 2>/dev/null | jq -r '.value // empty')"
  source_model_level="$(yaml_indented_scalar "$source_models" thinking defaultLevel)"
  live_model_level="$(yaml_indented_scalar "$live_models" thinking defaultLevel)"
  source_retries="$(yaml_indented_scalar "$source_config" retry maxRetries)"
  live_retries="$(yaml_indented_scalar "$live_config" retry maxRetries)"
  source_fallback="$(yaml_indented_scalar "$source_config" retry modelFallback)"
  live_fallback="$(yaml_indented_scalar "$live_config" retry modelFallback)"
  source_advisor="$(yaml_indented_scalar "$source_config" advisor enabled)"
  live_advisor="$(yaml_indented_scalar "$live_config" advisor enabled)"
  source_stop="$(yaml_indented_scalar "$source_config" features unexpectedStopDetection)"
  live_stop="$(yaml_indented_scalar "$live_config" features unexpectedStopDetection)"
  source_title_replan="$(yaml_indented_scalar "$source_config" title refreshOnReplan)"
  live_title_replan="$(yaml_indented_scalar "$live_config" title refreshOnReplan)"
  source_midturn="$(yaml_indented_scalar "$source_config" compaction midTurnEnabled)"
  live_midturn="$(yaml_indented_scalar "$live_config" compaction midTurnEnabled)"
  source_idle_compact="$(yaml_indented_scalar "$source_config" compaction idleEnabled)"
  live_idle_compact="$(yaml_indented_scalar "$live_config" compaction idleEnabled)"
  source_compact_threshold="$(yaml_indented_scalar "$source_config" compaction thresholdTokens)"
  live_compact_threshold="$(yaml_indented_scalar "$live_config" compaction thresholdTokens)"
  source_async_compact="$(yaml_indented_scalar "$source_config" compaction asyncEnabled)"
  live_async_compact="$(yaml_indented_scalar "$live_config" compaction asyncEnabled)"
  source_method_first="$(awk '
    $0 ~ /^[[:space:]]*methodOrder:[[:space:]]*$/ { in_list=1; next }
    in_list && $1 == "-" { print $2; exit }
  ' "$source_config")"
  live_method_first="$(awk '
    $0 ~ /^[[:space:]]*methodOrder:[[:space:]]*$/ { in_list=1; next }
    in_list && $1 == "-" { print $2; exit }
  ' "$live_config")"
  source_recap="$(yaml_indented_scalar "$source_config" recap enabled)"
  live_recap="$(yaml_indented_scalar "$live_config" recap enabled)"

  require_scalar "source defaultThinkingLevel" "$source_global" medium || failures=1
  require_scalar "live defaultThinkingLevel" "$live_global" medium || failures=1
  require_scalar "effective defaultThinkingLevel" "$effective_global" medium || failures=1
  require_scalar "source grok-4.6 defaultLevel" "$source_model_level" medium || failures=1
  require_scalar "live grok-4.6 defaultLevel" "$live_model_level" medium || failures=1

  if [ "$source_global" = "$live_global" ] && [ "$source_model_level" = "$live_model_level" ]; then
    printf 'CONFIG  thinking defaults agree\n'
  else
    printf 'CONFIG  canonical and live thinking defaults disagree\n' >&2
    failures=1
  fi

  require_scalar "source retry.maxRetries" "$source_retries" 1 || failures=1
  require_scalar "live retry.maxRetries" "$live_retries" 1 || failures=1
  require_scalar "source retry.modelFallback" "$source_fallback" true || failures=1
  require_scalar "live retry.modelFallback" "$live_fallback" true || failures=1
  require_scalar "source advisor.enabled" "$source_advisor" false || failures=1
  require_scalar "live advisor.enabled" "$live_advisor" false || failures=1
  require_scalar "source unexpectedStopDetection" "$source_stop" false || failures=1
  require_scalar "live unexpectedStopDetection" "$live_stop" false || failures=1
  require_scalar "source title.refreshOnReplan" "$source_title_replan" false || failures=1
  require_scalar "live title.refreshOnReplan" "$live_title_replan" false || failures=1
  require_scalar "source compaction.midTurnEnabled" "$source_midturn" false || failures=1
  require_scalar "live compaction.midTurnEnabled" "$live_midturn" false || failures=1
  require_scalar "source compaction.idleEnabled" "$source_idle_compact" false || failures=1
  require_scalar "live compaction.idleEnabled" "$live_idle_compact" false || failures=1
  require_scalar "source compaction.thresholdTokens" "$source_compact_threshold" 180000 || failures=1
  require_scalar "live compaction.thresholdTokens" "$live_compact_threshold" 180000 || failures=1
  require_scalar "source compaction.asyncEnabled" "$source_async_compact" false || failures=1
  require_scalar "live compaction.asyncEnabled" "$live_async_compact" false || failures=1
  require_scalar "source compaction.methodOrder[0]" "$source_method_first" snapcompact || failures=1
  require_scalar "live compaction.methodOrder[0]" "$live_method_first" snapcompact || failures=1
  if awk '
    $0 ~ /^[[:space:]]*methodOrder:[[:space:]]*$/ { in_list=1; next }
    in_list && /^[^[:space:]#]/ { in_list=0 }
    in_list && $1 == "-" { n++ }
    END { exit !(n == 1) }
  ' "$source_config" && awk '
    $0 ~ /^[[:space:]]*methodOrder:[[:space:]]*$/ { in_list=1; next }
    in_list && /^[^[:space:]#]/ { in_list=0 }
    in_list && $1 == "-" { n++ }
    END { exit !(n == 1) }
  ' "$live_config"; then
    printf 'CONFIG  compaction.methodOrder is snapcompact only\n'
  else
    printf 'CONFIG  compaction.methodOrder expected snapcompact only\n' >&2
    failures=1
  fi
  require_scalar "source recap.enabled" "$source_recap" false || failures=1
  require_scalar "live recap.enabled" "$live_recap" false || failures=1


  source_search_first="$(awk '
    $0 ~ /^[[:space:]]*webSearchOrder:[[:space:]]*$/ { in_list=1; next }
    in_list && $1 == "-" { print $2; exit }
  ' "$source_config")"
  live_search_first="$(awk '
    $0 ~ /^[[:space:]]*webSearchOrder:[[:space:]]*$/ { in_list=1; next }
    in_list && $1 == "-" { print $2; exit }
  ' "$live_config")"
  require_scalar "source webSearchOrder[0]" "$source_search_first" public || failures=1
  require_scalar "live webSearchOrder[0]" "$live_search_first" public || failures=1
  if awk '
    $0 ~ /^[[:space:]]*webSearchExclude:[[:space:]]*$/ { in_list=1; next }
    in_list && /^[^[:space:]#]/ { in_list=0 }
    in_list && $2 == "google" { google=1 }
    in_list && $2 == "ecosia" { ecosia=1 }
    in_list && $2 == "mojeek" { mojeek=1 }
    END { exit !(google && ecosia && mojeek) }
  ' "$source_config" && awk '
    $0 ~ /^[[:space:]]*webSearchExclude:[[:space:]]*$/ { in_list=1; next }
    in_list && /^[^[:space:]#]/ { in_list=0 }
    in_list && $2 == "google" { google=1 }
    in_list && $2 == "ecosia" { ecosia=1 }
    in_list && $2 == "mojeek" { mojeek=1 }
    END { exit !(google && ecosia && mojeek) }
  ' "$live_config"; then
    printf 'CONFIG  webSearchExclude blocks chromium scrapers\n'
  else
    printf 'CONFIG  webSearchExclude missing google/ecosia/mojeek\n' >&2
    failures=1
  fi

  source_bash_bg="$(yaml_indented_scalar "$source_config" autoBackground thresholdMs)"
  live_bash_bg="$(yaml_indented_scalar "$live_config" autoBackground thresholdMs)"
  require_scalar "source bash.autoBackground.thresholdMs" "$source_bash_bg" 15000 || failures=1
  require_scalar "live bash.autoBackground.thresholdMs" "$live_bash_bg" 15000 || failures=1

  source_chain="$(awk '
    $0 ~ /^[[:space:]]*xai-oauth\/grok-4\.6:[[:space:]]*$/ { in_chain=1; next }
    in_chain && $1 == "-" { print $2; exit }
  ' "$source_config")"
  live_chain="$(awk '
    $0 ~ /^[[:space:]]*xai-oauth\/grok-4\.6:[[:space:]]*$/ { in_chain=1; next }
    in_chain && $1 == "-" { print $2; exit }
  ' "$live_config")"
  require_scalar "source grok fallback" "$source_chain" "openrouter/x-ai/grok-4.6" || failures=1
  require_scalar "live grok fallback" "$live_chain" "openrouter/x-ai/grok-4.6" || failures=1

  if awk '
    $0 ~ /^[[:space:]]*-[[:space:]]*low[[:space:]]*$/ { low=1 }
    $0 ~ /^[[:space:]]*-[[:space:]]*medium[[:space:]]*$/ { medium=1 }
    $0 ~ /^[[:space:]]*-[[:space:]]*high[[:space:]]*$/ { high=1 }
    $0 ~ /^[[:space:]]*-[[:space:]]*xhigh[[:space:]]*$/ { xhigh=1 }
    END { exit !(low && medium && high && xhigh) }
  ' "$source_models"; then
    printf 'CONFIG  grok efforts include low medium high xhigh\n'
  else
    printf 'CONFIG  grok efforts missing low/medium/high/xhigh\n' >&2
    failures=1
  fi

  return "$failures"
}

check_omp_config() {
  local failures=0 pin source_pin setup_pin output omp_path
  pin="$(expected_version)"
  source_pin="$(sed -n 's/^"github:can1357\/oh-my-pi"[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$REPO_ROOT/home/dot_config/mise/config.toml" | head -n 1)"
  setup_pin="$(sed -n 's/^OMP_VERSION="\([^"]*\)".*/\1/p' "$REPO_ROOT/home/run_onchange_after_04-setup-omp.sh.tmpl" | head -n 1)"
  if [ "$pin" = "$source_pin" ] && [ "$pin" = "$setup_pin" ]; then
    printf 'PIN     %s everywhere\n' "$pin"
  else
    printf 'PIN     manifest=%s mise=%s setup=%s\n' "$pin" "$source_pin" "$setup_pin" >&2
    failures=1
  fi

  omp_path="$(command -v omp 2>/dev/null || true)"
  case "$omp_path" in
    "$HOME/.local/share/mise/shims/omp"|"$HOME/.local/share/mise/installs/"*/omp)
      printf 'BINARY  mise-managed %s\n' "$omp_path"
      ;;
    *)
      printf 'BINARY  unmanaged or shadowed %s\n' "${omp_path:-missing}" >&2
      failures=1
      ;;
  esac

  if output="$(omp config get modelRoles --json 2>/dev/null)" \
    && printf '%s' "$output" | jq -e '.value.default == "xai-oauth/grok-4.6" and .value.task == "openrouter/openai/gpt-5.6-luna"' >/dev/null; then
    printf 'CONFIG  model roles parse\n'
  else
    printf 'CONFIG  model roles invalid\n' >&2
    failures=1
  fi

  if output="$(omp config get skills.enablePiUser --json 2>/dev/null)" \
    && printf '%s' "$output" | jq -e '.value == true' >/dev/null \
    && output="$(omp config get skills.enablePiProject --json 2>/dev/null)" \
    && printf '%s' "$output" | jq -e '.value == true' >/dev/null; then
    printf 'CONFIG  native skills enabled\n'
  else
    printf 'CONFIG  native skills gate invalid\n' >&2
    failures=1
  fi

  if omp auth-broker list --json 2>/dev/null | grep -q '"id":"xai-oauth"'; then
    printf 'PROVIDER xai-oauth available\n'
  else
    printf 'PROVIDER xai-oauth missing\n' >&2
    failures=1
  fi

  if omp models xai-oauth --json 2>/dev/null | grep -q 'grok-4.6'; then
    printf 'MODEL   grok-4.6 discoverable\n'
  elif grep -q 'grok-4.6' "$HOME/.omp/agent/models.yml" 2>/dev/null; then
    printf 'MODEL   grok-4.6 configured; discovery awaits machine-local OAuth\n'
  else
    printf 'MODEL   grok-4.6 absent from discovery and portable catalog\n' >&2
    failures=1
  fi

  if omp setup python --check --json >/dev/null 2>&1; then
    printf 'PYTHON  available\n'
  else
    printf 'PYTHON  unavailable\n' >&2
    failures=1
  fi
  check_thinking_and_loop_policy || failures=1

  return "$failures"
}


quarantine_legacy_wrapper() {
  local wrapper backup
  wrapper="$HOME/.local/bin/omp"
  [ -f "$wrapper" ] || return 0
  if grep -Fq 'mise use -g' "$wrapper" && grep -Fq 'oh-my-pi' "$wrapper"; then
    mkdir -p "$STATE_DIR/backups"
    backup="$STATE_DIR/backups/omp-legacy-wrapper.$(date -u +%Y%m%dT%H%M%SZ)"
    mv "$wrapper" "$backup"
    printf 'BINARY  quarantined mutable wrapper at %s\n' "$backup"
    hash -r
  fi
}

validate() {
  local failures=0 skill_manager
  check_manifest_status || failures=1
  check_source_coverage || failures=1
  check_tracking_and_secrets || failures=1
  check_omp_config || failures=1
  harden_runtime_permissions
  check_runtime_permissions || failures=1
  skill_manager="$HOME/.local/bin/decent-angl-skills"
  [ -x "$skill_manager" ] || skill_manager="$REPO_ROOT/home/dot_local/bin/executable_decent-angl-skills"
  if DECENT_ANGL_REPO_ROOT="$REPO_ROOT" bash "$skill_manager" validate; then
    :
  else
    failures=1
  fi
  if git -C "$REPO_ROOT" diff --check -- $(portable_paths | sort -u) >/dev/null; then
    printf 'FORMAT  clean\n'
  else
    printf 'FORMAT  whitespace errors\n' >&2
    failures=1
  fi
  return "$failures"
}

apply_local() {
  local pin kind live_path repo_rel os_scope skill_manager
  local paths=()
  while IFS=$'\t' read -r kind live_path repo_rel os_scope; do
    if ! os_in_scope "$os_scope"; then
      continue
    fi
    paths+=("$live_path")
    case "$live_path" in
      "$HOME/.omp/agent/"*) install -d -m 700 "$(dirname "$live_path")" ;;
      *) mkdir -p "$(dirname "$live_path")" ;;
    esac
  done < <(iter_manifest)

  install -d -m 700 "$HOME/.omp" "$HOME/.omp/agent"
  if [ "${OMP_BASELINE_IN_CHEZMOI:-0}" != 1 ] && [ "${#paths[@]}" -gt 0 ]; then
    cm apply --force "${paths[@]}"
  fi
  skill_manager="$HOME/.local/bin/decent-angl-skills"
  [ -x "$skill_manager" ] || skill_manager="$REPO_ROOT/home/dot_local/bin/executable_decent-angl-skills"
  DECENT_ANGL_REPO_ROOT="$REPO_ROOT" bash "$skill_manager" sync
  quarantine_legacy_wrapper
  pin="$(expected_version)"
  if command -v mise >/dev/null 2>&1; then
    if [ "$(omp --version 2>/dev/null || true)" != "omp/$pin" ]; then
      mise install "github:can1357/oh-my-pi@$pin"
    fi
    # Companion pins live in the same mise file (gh, etc.).
    mise install
    mise reshim
  fi
  printf '%s' "$pin" >"$HOME/.omp/agent/last-changelog-version"
  if [ "${OMP_BASELINE_IN_GUARD:-0}" != 1 ]; then
    install_guard
  fi
  validate
}

pull_published() {
  local fleet_sync="$HOME/.local/bin/decent-angl-sync"
  if [ ! -x "$fleet_sync" ]; then
    printf 'decent-angl-sync is unavailable; apply the complete shared baseline first.\n' >&2
    return 127
  fi
  "$fleet_sync" reconcile --with-scripts
  # A pre-upgrade `pull` still has the old validator in memory. Re-exec
  # the applied binary so new pin, OS-scope, and policy checks run.
  # Do not expand an empty array under `set -u`; macOS bash 3.2 treats that
  # as unbound.
  if [ -x "$HOME/.local/bin/omp-baseline" ]; then
    if [ "$STRICT" = true ]; then
      exec "$HOME/.local/bin/omp-baseline" validate --strict
    fi
    exec "$HOME/.local/bin/omp-baseline" validate
  fi
  validate
}

normalize_omp_version() {
  local raw="$1"
  raw="${raw#omp/}"
  raw="${raw#v}"
  case "$raw" in
    [0-9]*.[0-9]*.[0-9]*) printf '%s\n' "$raw" ;;
    *) return 1 ;;
  esac
}

fetch_github_release_tag() {
  local path="$1"
  local tag=""
  if command -v gh >/dev/null 2>&1; then
    tag="$(gh api "repos/${OMP_GITHUB_REPO}/${path}" --jq .tag_name 2>/dev/null || true)"
  fi
  if [ -z "$tag" ]; then
    tag="$(curl -fsSL -A omp-baseline \
      "https://api.github.com/repos/${OMP_GITHUB_REPO}/${path}" \
      | jq -r '.tag_name // empty')" || return 1
  fi
  [ -n "$tag" ] || return 1
  normalize_omp_version "$tag"
}

fetch_latest_omp_version() {
  fetch_github_release_tag releases/latest
}

verify_omp_release() {
  local version="$1"
  fetch_github_release_tag "releases/tags/v${version}" >/dev/null
}

rewrite_one_pin_line() {
  local file="$1"
  local pattern="$2"
  local replacement="$3"
  local tmp count
  tmp="$(mktemp "${TMPDIR:-/tmp}/omp-pin.XXXXXX")"
  count="$(awk -v pat="$pattern" ' $0 ~ pat { n++ } END { print n+0 }' "$file")"
  if [ "$count" != 1 ]; then
    rm -f "$tmp"
    printf 'UPGRADE expected one pin line matching %s in %s, found %s\n' \
      "$pattern" "$file" "$count" >&2
    return 1
  fi
  awk -v pat="$pattern" -v repl="$replacement" '
    $0 ~ pat { print repl; next }
    { print }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

set_pin_sites() {
  local version="$1"
  rewrite_one_pin_line \
    "$REPO_ROOT/home/dot_config/decent-angl/omp-baseline-manifest.tsv" \
    '^# omp-version[[:space:]]' \
    "# omp-version	${version}" || return 1
  rewrite_one_pin_line \
    "$REPO_ROOT/home/dot_config/mise/config.toml" \
    '^"github:can1357/oh-my-pi"[[:space:]]*=' \
    "\"github:can1357/oh-my-pi\" = \"${version}\"" || return 1
  rewrite_one_pin_line \
    "$REPO_ROOT/home/run_onchange_after_04-setup-omp.sh.tmpl" \
    '^OMP_VERSION=' \
    "OMP_VERSION=\"${version}\"" || return 1
}

restore_pin_sites() {
  git -C "$REPO_ROOT" checkout -- \
    home/dot_config/decent-angl/omp-baseline-manifest.tsv \
    home/dot_config/mise/config.toml \
    home/run_onchange_after_04-setup-omp.sh.tmpl
}

require_clean_pin_files() {
  local dirty
  dirty="$(git -C "$REPO_ROOT" status --porcelain=v1 -- \
    home/dot_config/decent-angl/omp-baseline-manifest.tsv \
    home/dot_config/mise/config.toml \
    home/run_onchange_after_04-setup-omp.sh.tmpl)"
  if [ -n "$dirty" ]; then
    printf 'UPGRADE pin files are dirty; commit or discard them first.\n%s\n' "$dirty" >&2
    return 1
  fi
}

apply_pin_files_live() {
  [ "${OMP_BASELINE_IN_CHEZMOI:-0}" = 1 ] && return 0
  cm apply --force \
    "$HOME/.config/decent-angl/omp-baseline-manifest.tsv" \
    "$HOME/.config/mise/config.toml"
}

check_upstream() {
  local pin latest
  pin="$(expected_version)"
  if ! latest="$(fetch_latest_omp_version)"; then
    printf 'UPSTREAM unreachable\n' >&2
    return 1
  fi
  if [ "$pin" = "$latest" ]; then
    rm -f "$UPSTREAM_MARKER"
    printf 'UPSTREAM pin=%s latest=%s current\n' "$pin" "$latest"
    return 0
  fi
  mkdir -p "$STATE_DIR"
  printf 'pin=%s\nlatest=%s\nnext=omp-baseline upgrade %s\n' \
    "$pin" "$latest" "$latest" >"$UPSTREAM_MARKER"
  printf 'UPSTREAM pin=%s latest=%s available\n' "$pin" "$latest"
  printf 'NEXT    omp-baseline upgrade %s\n' "$latest"
}

upgrade() {
  local pin target="" dry=false raw
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) dry=true ;;
      --strict) STRICT=true ;;
      -h|--help) usage; return 0 ;;
      -*)
        printf 'Unknown option: %s\n' "$1" >&2
        usage >&2
        return 1
        ;;
      *)
        if [ -n "$target" ]; then
          printf 'upgrade accepts one VERSION\n' >&2
          return 1
        fi
        target="$1"
        ;;
    esac
    shift
  done

  pin="$(expected_version)"
  if [ -z "$target" ]; then
    target="$(fetch_latest_omp_version)" || {
      printf 'UPGRADE could not resolve GitHub latest\n' >&2
      return 1
    }
  else
    raw="$target"
    if ! target="$(normalize_omp_version "$raw")"; then
      printf 'UPGRADE invalid version: %s\n' "$raw" >&2
      return 1
    fi
  fi

  if [ "$dry" = true ]; then
    printf 'PIN     %s -> %s\n' "$pin" "$target"
    printf 'FILES   manifest mise setup-omp\n'
    if [ "$pin" = "$target" ]; then
      printf 'UPGRADE already on %s\n' "$target"
    else
      printf 'NEXT    would install github:can1357/oh-my-pi@%s then validate\n' "$target"
    fi
    return 0
  fi

  if [ "$pin" = "$target" ]; then
    printf 'UPGRADE already on %s\n' "$target"
    apply_local
    return
  fi

  require_clean_pin_files || return 1
  verify_omp_release "$target" || {
    printf 'UPGRADE GitHub has no release v%s\n' "$target" >&2
    return 1
  }

  set_pin_sites "$target" || {
    printf 'UPGRADE failed to rewrite pin sites; restoring\n' >&2
    restore_pin_sites
    return 1
  }
  apply_pin_files_live || {
    printf 'UPGRADE failed to apply pin files; restoring\n' >&2
    restore_pin_sites
    return 1
  }
  if ! apply_local; then
    printf 'UPGRADE apply/validate failed; restoring pin %s\n' "$pin" >&2
    restore_pin_sites
    apply_pin_files_live || true
    mise install "github:can1357/oh-my-pi@$pin" || true
    mise reshim || true
    return 1
  fi

  rm -f "$UPSTREAM_MARKER"
  printf 'UPGRADE %s -> %s\n' "$pin" "$target"
  printf 'NEXT    review, commit the three pin files, then decent-angl-sync reconcile --with-scripts\n'
}

install_guard() {
  local os uid plist unit_dir
  os="$(uname -s)"
  mkdir -p "$STATE_DIR"
  case "$os" in
    Darwin)
      uid="$(id -u)"
      plist="$HOME/Library/LaunchAgents/gg.angl.omp-baseline.plist"
      mkdir -p "$(dirname "$plist")"
      cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>gg.angl.omp-baseline</string>
  <key>ProgramArguments</key><array><string>$HOME/.local/bin/omp-baseline</string><string>guard</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>$HOME</string>
    <key>PATH</key><string>$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict></plist>
EOF
      chmod 600 "$plist"
      launchctl bootout "gui/$uid/gg.angl.omp-baseline" >/dev/null 2>&1 || true
      launchctl bootstrap "gui/$uid" "$plist" >/dev/null 2>&1 || \
        printf 'GUARD   launchd will load at the next login\n'
      ;;
    Linux)
      unit_dir="$HOME/.config/systemd/user"
      mkdir -p "$unit_dir"
      cat >"$unit_dir/omp-baseline-guard.service" <<'EOF'
[Unit]
Description=Validate and reconcile the shared OMP baseline
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/omp-baseline guard
EOF
      cat >"$unit_dir/omp-baseline-guard.timer" <<'EOF'
[Unit]
Description=Hourly OMP baseline drift guard

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF
      systemctl --user daemon-reload
      systemctl --user enable --now omp-baseline-guard.timer >/dev/null
      ;;
  esac
  printf 'GUARD   installed for %s\n' "$os"
}

guard() {
  local current_machine status output
  mkdir -p "$STATE_DIR"
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    printf 'GUARD   another run is active\n'
    return 0
  fi
  trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
  current_machine="$(machine_id)"

  if output="$(validate 2>&1)"; then status=0; else status=$?; fi

  printf '%s %s\n%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$current_machine" "$output" >>"$LOG_FILE"
  if [ "$status" -eq 0 ]; then
    rm -f "$MARKER"
    logger -t omp-baseline "OMP baseline guard passed on $current_machine" >/dev/null 2>&1 || true
  else
    printf '%s\n' "$output" >"$MARKER"
    logger -t omp-baseline -p user.err "OMP baseline drift on $current_machine; see $MARKER" >/dev/null 2>&1 || true
  fi
  check_upstream >>"$LOG_FILE" 2>&1 || true
  if [ -s "$UPSTREAM_MARKER" ]; then
    logger -t omp-baseline "OMP upstream available; see $UPSTREAM_MARKER" >/dev/null 2>&1 || true
  fi
  return "$status"
}
fleet_probe() {
  local git_rev omp_ver gh_ver pin val oauth
  git_rev="$(git -C "$HOME/src/boilerplate" rev-parse --short HEAD 2>/dev/null || printf missing)"
  omp_ver="$(omp --version 2>/dev/null || printf missing)"
  omp_ver="${omp_ver#omp/}"
  gh_ver="$(gh --version 2>/dev/null | awk 'NR==1 { print $3 }')"
  [ -n "$gh_ver" ] || gh_ver=missing
  pin="$(sed -n 's/^# omp-version[[:space:]]*//p' "$HOME/.config/decent-angl/omp-baseline-manifest.tsv" | awk 'NR==1 { print; exit }')"
  [ -n "$pin" ] || pin=missing
  if omp-baseline validate --strict >/dev/null 2>&1; then val=ok; else val=fail; fi
  if omp models xai-oauth --json 2>/dev/null | grep -q 'grok-4.6'; then oauth=yes; else oauth=no; fi
  printf '%s %s %s %s %s %s\n' "$git_rev" "$omp_ver" "$gh_ver" "$pin" "$val" "$oauth"
}

fleet() {
  local host self line rc=0
  case "$(machine_id)" in
    omarchy) self=t14 ;;
    *) self="$(machine_id)" ;;
  esac
  printf '%-8s %-8s %-8s %-8s %-8s %-8s %s\n' HOST GIT OMP GH PIN VALIDATE OAUTH
  for host in t14 macbook macmini; do
    if [ "$host" = "$self" ]; then
      if line="$(fleet_probe)"; then
        :
      else
        line="error error error error fail no"
        rc=1
      fi
    elif line="$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$host" 'omp-baseline fleet-probe' 2>/dev/null)"; then
      :
    else
      line="unreachable - - - fail no"
      rc=1
    fi
    printf '%-8s %-8s %-8s %-8s %-8s %-8s %s\n' "$host" $line
    case "$line" in
      *fail*|unreachable*) rc=1 ;;
    esac
  done
  return "$rc"
}

main() {
  local command="${1:-status}"
  [ "$#" -gt 0 ] && shift
  case "$command" in
    check-upstream)
      check_upstream
      return
      ;;
    upgrade)
      upgrade "$@"
      return
      ;;
  esac
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --strict) STRICT=true ;;
      -h|--help) usage; return 0 ;;
      *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; return 1 ;;
    esac
    shift
  done

  case "$command" in
    status) check_manifest_status ;;
    validate) validate ;;
    apply) apply_local ;;
    pull) pull_published ;;
    guard) guard ;;
    install-guard) install_guard ;;
    fleet) fleet ;;
    fleet-probe) fleet_probe ;;
    -h|--help) usage ;;
    *) printf 'Unknown command: %s\n' "$command" >&2; usage >&2; return 1 ;;
  esac
}

main "$@"
