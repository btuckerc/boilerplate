#!/usr/bin/env bash

# Keep the portable OMP baseline identical across the fleet. Published Git
# history is authoritative and any machine may author reviewed commits.

set -euo pipefail

REPO_ROOT="${OMP_BASELINE_REPO_ROOT:-$HOME/src/boilerplate}"
CHEZMOI_ROOT="${OMP_BASELINE_CHEZMOI_ROOT:-$HOME/.local/share/chezmoi}"
MANIFEST="${OMP_BASELINE_MANIFEST:-$HOME/.config/decent-angl/omp-baseline-manifest.tsv}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/decent-angl"
MARKER="$STATE_DIR/omp-baseline-drift"
UPSTREAM_MARKER="$STATE_DIR/omp-upstream"
LOG_FILE="$STATE_DIR/omp-baseline.log"
LOCK_DIR="$STATE_DIR/omp-baseline.lock"
STRICT=false
OMP_GITHUB_REPO="can1357/oh-my-pi"
# Probed once at startup: errexit aborts the run if uname fails.
HOST_OS="$(uname -s)"

usage() {
  cat <<'EOF'
Usage: omp-baseline <status|validate|check-source ROOT|repair|apply|pull|check-upstream|upgrade|guard|install-guard|fleet> [options]

  status          Compare repo, chezmoi source, rendered live files, and version.
  validate        Run status plus coverage, secret-boundary, agent-policy, and OMP parser
                  checks. Observational: never changes files or modes.
  check-source ROOT
                  Agent-policy source checks for the exported tree ROOT with its own
                  checker; the installed omp must equal ROOT's pin. No live settings.
  repair          Restore private runtime modes (and btrfs NOCOW), then validate.
  apply           Apply the local published source, install its exact pin, repair, validate.
  pull            Reconcile the complete published baseline, then validate OMP.
  check-upstream  Compare the published pin to GitHub latest. Write omp-upstream.
  upgrade [VER]   Move the two pin sites to VER or GitHub latest, install, check OMP.
                  Does not commit, reconcile, or fail closed on unrelated skill audits.
                  --dry-run prints the plan only.
  guard           Validate local OMP state without overwriting source.
  install-guard   Install the hourly launchd/systemd user guard.
  fleet           SSH to t14, macbook, and macmini and report pin, gh, and validate.
  --strict        Also require every portable source file to be tracked by Git.
EOF
}

cm() {
  local candidate mise_bin chezmoi_bin
  mise_bin=""
  for candidate in \
    "$(command -v mise 2>/dev/null || true)" \
    "$HOME/.local/bin/mise" \
    "$HOME/.local/share/mise/bin/mise" \
    /opt/homebrew/bin/mise \
    /usr/local/bin/mise \
    /usr/bin/mise; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then mise_bin="$candidate"; break; fi
  done
  if [ -n "$mise_bin" ]; then
    "$mise_bin" exec -- chezmoi "$@"
    return
  fi
  chezmoi_bin=""
  for candidate in \
    "$(command -v chezmoi 2>/dev/null || true)" \
    "$HOME/.local/share/mise/shims/chezmoi" \
    "$HOME/.local/bin/chezmoi" \
    /opt/homebrew/bin/chezmoi \
    /usr/local/bin/chezmoi \
    /usr/bin/chezmoi; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then chezmoi_bin="$candidate"; break; fi
  done
  if [ -n "$chezmoi_bin" ]; then
    "$chezmoi_bin" "$@"
  else
    printf 'chezmoi is unavailable in the unattended environment\n' >&2
    return 127
  fi
}

# Bun runs the agent-policy checker. Unattended guards lack the interactive
# PATH, so resolve it through mise first, like cm().
bun_run() {
  local candidate
  for candidate in \
    "$(command -v mise 2>/dev/null || true)" \
    "$HOME/.local/bin/mise" \
    "$HOME/.local/share/mise/bin/mise" \
    /opt/homebrew/bin/mise \
    /usr/local/bin/mise \
    /usr/bin/mise; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      "$candidate" exec -- bun "$@"
      return
    fi
  done
  if command -v bun >/dev/null 2>&1; then
    bun "$@"
  else
    printf 'bun is unavailable in the unattended environment\n' >&2
    return 127
  fi
}

expand_home() {
  case "$1" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Native omp probes (config get, models, setup) run Settings.init, which hardens
# agent-dir modes, opens agent.db and quarantines a malformed project
# .omp/config.yml in its cwd; every run writes logs and natives under ~/.omp.
# validate must not change live state, so probes run from an empty scratch cwd
# with HOME moved to a private scratch copy of the files they read. The copy
# can hold credentials: validate removes it on exit.
PROBE_ROOT=""
PROBE_HOME=""
PROBE_JAIL=()
# Variables that relocate OMP state (utils/src/dirs.ts; env.ts also maps OMP_*
# to PI_* when it loads a dotenv file). Probes drop them from the environment,
# and a copied dotenv file that sets one would point a probe back at live state.
PROBE_DIR_KEYS='(OMP|PI)_[A-Z0-9_]*(DIR|PROFILE|DB|CACHE)|XDG_[A-Z]+_HOME'
# check-source probes (probe_home source): credentials and model caches only,
# never live settings, overlays or policy-changing PI_*/OMP_* variables. The
# auth broker address is where credentials live, so it is kept.
PROBE_SOURCE_ONLY=false
PROBE_CREDENTIAL_KEYS='(OMP|PI)_AUTH_BROKER_(URL|TOKEN)|[A-Za-z_][A-Za-z0-9_]*(_API_KEY|_TOKEN|_KEY)'

# Print the lines of $1 that match the ERE $2, without a filter process.
match_lines() {
  local line
  while IFS= read -r line; do
    if [[ $line =~ $2 ]]; then
      printf '%s\n' "$line"
    fi
  done <<<"$1"
}

probe_copy_env() {
  [ -f "$1" ] || return 0
  local rc=0
  grep -Eq "^[[:space:]]*(export[[:space:]]+)?($PROBE_DIR_KEYS)[[:space:]]*=" "$1" || rc=$?
  case "$rc" in
    0)
      printf 'PROBE   %s sets an OMP directory or profile variable; isolated probes cannot honour it\n' "$1" >&2
      return 1
      ;;
    1) ;;
    *)
      printf 'PROBE   probe failed (grep exit %s) on %s\n' "$rc" "$1" >&2
      return 1
      ;;
  esac
  cp -p "$1" "$2"
}

# The credential lines (PROBE_CREDENTIAL_KEYS, other PI_*/OMP_* keys excluded)
# of dotenv file $1, written to $2. Everything else may change settings.
probe_copy_credentials_env() {
  [ -f "$1" ] || return 0
  (umask 077 && awk -v keys="^($PROBE_CREDENTIAL_KEYS)\$" '
    /^[[:space:]]*(#|$)/ { next }
    {
      key = $0
      sub(/^[[:space:]]*(export[[:space:]]+)?/, "", key)
      sub(/[[:space:]]*=.*/, "", key)
      if (key ~ keys && (key !~ /^(PI|OMP)_/ || key ~ /^(PI|OMP)_AUTH_BROKER_/)) print
    }' "$1" >"$2")
}

# A scratch copy of agent.db $1 drops OAuth logins: a probe that refreshed one would rotate the
# refresh token server-side and strand the live store's copy. API-key rows stay.
probe_clear_oauth() {
  python3 - "$1" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
try:
    if db.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'auth_credentials'").fetchone():
        db.execute("DELETE FROM auth_credentials WHERE credential_type = 'oauth'")
        db.commit()
finally:
    db.close()
PY
}

# omp 18.12.1 AgentStorage.getSettings() reads agent.db's `settings` table (session/agent-storage.ts:484-491), so
# a source-only copy of agent.db $1 drops its rows too.
probe_clear_settings() {
  python3 - "$1" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
try:
    if db.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'settings'").fetchone():
        db.execute("DELETE FROM settings")
        db.commit()
finally:
    db.close()
PY
}

probe_copy_dotenv() {
  if [ "$PROBE_SOURCE_ONLY" = true ]; then
    probe_copy_credentials_env "$1" "$2"
  else
    probe_copy_env "$1" "$2"
  fi
}

# Native omp runs a config value starting with "!" as a shell command and uses its stdout
# (config/resolve-config-value.ts:22-24,104-107,116-145): models.yml
# apiKey and headers, auth.broker.url/token in config.yml and stored api_key
# credentials, including broker-held ones. validate must run none of them, so
# every probe runs where /bin/sh cannot start: bwrap with a stub bound over the
# shell on Linux, a sandbox-exec profile denying it on macOS. The jail is
# proven before use: /bin/sh must fail inside it and true must run.
probe_jail() {
  local sh_real bash_path bash_real
  case "$HOST_OS" in
    Linux)
      sh_real="$(readlink -f /bin/sh)" || return 1
      bash_path="$(command -v bash)" || return 1
      bash_real="$(readlink -f "$bash_path")" || return 1
      if ! command -v bwrap >/dev/null 2>&1 || [ "$bash_real" = "$sh_real" ]; then
        printf 'PROBE   no shell jail: bwrap missing or /bin/sh is bash\n' >&2
        return 1
      fi
      printf '#!%s\nexit 126\n' "$bash_path" >"$PROBE_ROOT/noshell" && chmod 700 "$PROBE_ROOT/noshell" || return 1
      PROBE_JAIL=(bwrap --dev-bind / / --ro-bind "$PROBE_ROOT/noshell" "$sh_real" --die-with-parent --)
      ;;
    Darwin)
      PROBE_JAIL=(sandbox-exec -p '(version 1)(allow default)(deny process-exec (literal "/bin/sh"))')
      ;;
    *)
      printf 'PROBE   no shell jail for %s\n' "$HOST_OS" >&2
      return 1
      ;;
  esac
  if ! "${PROBE_JAIL[@]}" true >/dev/null 2>&1 ||
    "${PROBE_JAIL[@]}" /bin/sh -c : >/dev/null 2>&1; then
    printf 'PROBE   shell jail failed its self-test (%s)\n' "${PROBE_JAIL[0]}" >&2
    PROBE_JAIL=()
    return 1
  fi
}

# The jail turns a command-backed value into a missing one, so a probe of a
# config holding one would report results computed without it. The models and
# config files copied for a probe that hold such a value fail closed instead
# (parsed as native does, Bun YAML and JSONC; an unparsable file holding "!"
# fails too); omp-agent-policy fails closed the same way on every settings
# layer it mirrors (project files and PI_CONFIG_FILES/--config overlays).
# Stored credentials are not screened: the jail alone covers them.
probe_screen() {
  local rc=0
  bun_run -e '
    let bad = 0;
    const walk = (file, v, at) => {
      if (typeof v === "string" && v.startsWith("!")) {
        console.error(`PROBE   ${file}: ${at || "(root)"} is command-backed; validate runs no config command`);
        bad = 1;
      } else if (v && typeof v === "object") for (const [k, x] of Object.entries(v)) walk(file, x, at ? `${at}.${k}` : k);
    };
    for (const file of process.argv.slice(1)) {
      let text;
      try { text = require("fs").readFileSync(file, "utf8"); } catch { continue; }
      let data;
      try { data = file.endsWith(".json") ? Bun.JSONC.parse(text) : Bun.YAML.parse(text); }
      catch {
        if (text.includes("!")) { console.error(`PROBE   ${file}: unparsable and holds "!"; validate runs no config command`); bad = 1; }
        continue;
      }
      walk(file, data, "");
    }
    process.exit(bad);
  ' "$@" || rc=$?
  [ "$rc" -le 1 ] || printf 'PROBE   config screen failed (bun exit %s)\n' "$rc" >&2
  return "$rc"
}

probe_home() {
  [ -z "$PROBE_HOME" ] || return 0
  local live="$HOME/.omp" xdg file rel dir
  for xdg in "${XDG_DATA_HOME:-}" "${XDG_STATE_HOME:-}" "${XDG_CACHE_HOME:-}"; do
    if [ -n "$xdg" ] && [ -e "$xdg/omp" ]; then
      printf 'PROBE   %s/omp holds OMP state; isolated probes do not cover XDG layouts\n' "$xdg" >&2
      return 1
    fi
  done
  PROBE_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/omp-baseline-probe.XXXXXX")" || return 1
  case "$PROBE_ROOT" in
    /*) ;;
    *)
      printf 'PROBE   scratch root %s is not absolute\n' "$PROBE_ROOT" >&2
      cleanup_probe_home
      return 1
      ;;
  esac
  # Project discovery walks every ancestor of the probe cwd.
  dir="$PROBE_ROOT"
  while [ "$dir" != / ]; do
    dir="${dir%/*}"
    dir="${dir:-/}"
    if [ -e "$dir/.omp" ]; then
      printf 'PROBE   %s/.omp would act as project config for isolated probes\n' "${dir%/}" >&2
      cleanup_probe_home
      return 1
    fi
  done
  PROBE_HOME="$PROBE_ROOT/home"
  if ! mkdir -m 700 "$PROBE_ROOT/cwd" "$PROBE_HOME" "$PROBE_HOME/.omp" "$PROBE_HOME/.omp/agent" ||
    { [ -f "$live/auth-broker.token" ] && ! cp -p "$live/auth-broker.token" "$PROBE_HOME/.omp/"; } ||
    ! probe_copy_dotenv "$HOME/.env" "$PROBE_HOME/.env" ||
    ! probe_copy_dotenv "$live/.env" "$PROBE_HOME/.omp/.env" ||
    ! probe_copy_dotenv "$live/agent/.env" "$PROBE_HOME/.omp/agent/.env"; then
    printf 'PROBE   scratch HOME setup failed\n' >&2
    cleanup_probe_home
    return 1
  fi
  local -a copies=("$live/agent"/agent.db* "$live/agent"/models.db*)
  [ "$PROBE_SOURCE_ONLY" = true ] ||
    copies+=("$live/agent"/*.yml "$live/agent"/*.yaml "$live/agent"/*.json)
  for file in "${copies[@]}"; do
    [ -f "$file" ] || continue
    if ! cp -p "$file" "$PROBE_HOME/.omp/agent/"; then
      printf 'PROBE   copy failed %s\n' "$file" >&2
      cleanup_probe_home
      return 1
    fi
  done
  if [ -f "$PROBE_HOME/.omp/agent/agent.db" ] && ! probe_clear_oauth "$PROBE_HOME/.omp/agent/agent.db"; then
    printf 'PROBE   could not clear OAuth logins from the agent.db copy\n' >&2
    cleanup_probe_home
    return 1
  fi
  if [ "$PROBE_SOURCE_ONLY" = true ]; then
    if [ -f "$PROBE_HOME/.omp/agent/agent.db" ] && ! probe_clear_settings "$PROBE_HOME/.omp/agent/agent.db"; then
      printf 'PROBE   could not clear settings from the agent.db copy\n' >&2
      cleanup_probe_home
      return 1
    fi
    probe_jail || { cleanup_probe_home; return 1; }
  elif ! probe_jail || ! probe_screen "$live/agent"/models.{yml,yaml,json} "$live/agent"/config.{yml,yaml}; then
    cleanup_probe_home
    return 1
  fi
  if [ -d "$live/python-env" ] && ! ln -s "$live/python-env" "$PROBE_HOME/.omp/python-env"; then
    printf 'PROBE   scratch HOME setup failed (python-env)\n' >&2
    cleanup_probe_home
    return 1
  fi
  # mise shims (python, omp) find their tools through HOME.
  for rel in .config/mise .local/share/mise .local/state/mise; do
    [ -e "$HOME/$rel" ] || continue
    if ! mkdir -p "$PROBE_HOME/${rel%/*}" || ! ln -s "$HOME/$rel" "$PROBE_HOME/$rel"; then
      printf 'PROBE   scratch HOME setup failed (%s)\n' "$rel" >&2
      cleanup_probe_home
      return 1
    fi
  done
}

cleanup_probe_home() {
  local tries=0
  case "$PROBE_ROOT" in
    "${TMPDIR:-/tmp}"/omp-baseline-probe.?*)
      # An interrupted probe's omp (argv under the scratch HOME) can outlive
      # this shell and write into it; wait up to 5 s for it before removing.
      while [ "$tries" -lt 50 ] && pgrep -f -- "$PROBE_ROOT/" >/dev/null 2>&1; do
        sleep 0.1
        tries=$((tries + 1))
      done
      rm -rf "$PROBE_ROOT"
      ;;
  esac
  PROBE_ROOT=""
  PROBE_HOME=""
  PROBE_JAIL=()
  PROBE_SOURCE_ONLY=false
}

# omp in the shell jail (probe_jail) from the scratch cwd (PROBE_CWD if set)
# against the scratch HOME, default profile, with PI_CONFIG_FILES resolved
# against the real HOME and cwd. A set PI_CONFIG_FILES that names no file (":")
# is passed as ":", which keeps a copied dotenv file from filling it
# (utils/src/env.ts:300-306 fills only unset or empty keys). Callers run it in
# command substitutions, so validate prepares PROBE_HOME first.
omp_probe() {
  if [ -z "$PROBE_HOME" ] || [ "${#PROBE_JAIL[@]}" -eq 0 ]; then
    printf 'PROBE   scratch HOME or shell jail not prepared\n' >&2
    return 1
  fi
  local overlays="" entry name
  local -a vars=(HOME="$PROBE_HOME") unset=()
  for name in $(compgen -e); do
    if [[ $name =~ ^($PROBE_DIR_KEYS)$ ]] || { [ "$PROBE_SOURCE_ONLY" = true ] &&
      [[ $name =~ ^(PI|OMP)_ ]] && ! [[ $name =~ ^(OMP|PI)_AUTH_BROKER_(URL|TOKEN)$ ]]; }; then
      unset+=(-u "$name")
    fi
  done
  if [ "$PROBE_SOURCE_ONLY" = true ]; then
    vars+=(PI_CONFIG_FILES=:)
  elif [ -n "${PI_CONFIG_FILES:-}" ]; then
    while IFS= read -r -d : entry; do
      [ -n "$entry" ] || continue
      entry="$(expand_home "$entry")"
      case "$entry" in /*) ;; *) entry="$PWD/$entry" ;; esac
      overlays="${overlays:+$overlays:}$entry"
    done <<<"$PI_CONFIG_FILES:"
    vars+=(PI_CONFIG_FILES="${overlays:-:}")
  fi
  (cd "${PROBE_CWD:-$PROBE_ROOT/cwd}" && env ${unset[@]+"${unset[@]}"} "${vars[@]}" "${PROBE_JAIL[@]}" omp "$@")
}

# 0 in scope, 1 out of scope, 2 unknown scope.
os_in_scope() {
  case "${1:-all}" in
    ""|all) return 0 ;;
    linux) [ "$HOST_OS" = Linux ] ;;
    darwin) [ "$HOST_OS" = Darwin ] ;;
    *)
      printf 'MANIFEST unknown os scope %s\n' "$1" >&2
      return 2
      ;;
  esac
}

iter_manifest() {
  local kind live_path repo_rel os_scope
  # || -n: an unterminated final row is still a row.
  while IFS=$'\t' read -r kind live_path repo_rel os_scope || [ -n "${kind:-}" ]; do
    [ -n "${kind:-}" ] || continue
    case "$kind" in \#*) continue ;; esac
    printf '%s\t%s\t%s\t%s\n' "$kind" "$(expand_home "$live_path")" "$repo_rel" "${os_scope:-all}"
  done <"$MANIFEST"
}

# The first value only; reading all of it (no `| head`) keeps sed's status.
manifest_value() {
  local out
  out="$(sed -n "s/^# $1[[:space:]]*//p" "$MANIFEST")" || return 1
  printf '%s\n' "${out%%$'\n'*}"
}

machine_id() {
  local value host
  value="$(cm data --format json 2>/dev/null | jq -r '.decentangl.machine_id // empty' 2>/dev/null || true)"
  if [ -n "$value" ]; then
    printf '%s\n' "$value"
    return
  fi
  host="$(hostname -s 2>/dev/null || hostname)"
  case "$host" in
    BTC-MBP14*|MacBook*|macbook*) printf '%s\n' macbook ;;
    mc|mc.*|macmini*|Macmini*) printf '%s\n' macmini ;;
    btct14|T14|t14) printf '%s\n' omarchy ;;
    *) printf '%s\n' "$host" ;;
  esac
}

machine_role() {
  cm data --format json 2>/dev/null |
    jq -r --arg id "$(machine_id)" '.decentangl.machines[$id].role // empty' 2>/dev/null || true
}

# Headless agent hosts install only the agent toolchain (OMP, the Claude Code
# director and the Codex worker), not the workstation's runtimes, LSPs and editors.
AGENT_HOST_TOOLS=(github:can1357/oh-my-pi npm:@anthropic-ai/claude-code codex herdr chezmoi gh bun node python uv jq ripgrep fd)

expected_version() {
  manifest_value omp-version
}

portable_support_paths() {
  cat <<'EOF'
home/dot_config/decent-angl/omp-baseline-manifest.tsv
home/.chezmoidata/decentangl.yaml
home/dot_config/decent-angl/opnsense.env.tmpl
home/dot_local/bin/executable_decent-angl-launchd.tmpl
home/dot_config/mise/config.toml
home/dot_local/bin/executable_omp-baseline
home/dot_local/bin/executable_decent-angl-skills
home/dot_local/bin/executable_omp-env
home/dot_local/bin/executable_opnsense-api
home/dot_local/bin/executable_opnsense-store-secret
EOF
}

portable_paths() {
  iter_manifest | while IFS=$'\t' read -r _kind _live repo_rel _os_scope; do
    printf '%s\n' "$repo_rel"
  done || return 1
  printf '%s\n' home/private_dot_omp/private_agent/.chezmoiignore
  portable_support_paths
}

git_tracked() {
  git -C "$REPO_ROOT" ls-files --error-unmatch "$1" >/dev/null 2>&1
}

check_manifest_status() {
  local failures=0 kind live_path repo_rel repo_path mirror_path diff_output pin actual rows upstream version_rc=0

  if [ ! -r "$MANIFEST" ] || ! rows="$(iter_manifest)"; then
    printf 'MANIFEST missing or unreadable %s\n' "$MANIFEST" >&2
    return 1
  fi

  # Every probe's own status counts, not just its stdout: a failing omp that
  # prints the pinned version is still a failed probe.
  if ! pin="$(expected_version)" || [ -z "$pin" ]; then
    printf 'VERSION manifest omp-version unreadable %s\n' "$MANIFEST" >&2
    failures=1
  fi
  actual="$(omp --version 2>/dev/null)" || version_rc=$?
  if [ "$version_rc" -ne 0 ]; then
    printf 'VERSION probe failed (omp --version exit %s)\n' "$version_rc" >&2
    failures=1
  elif [ "$actual" = "omp/$pin" ]; then
    printf 'VERSION %s\n' "$actual"
  else
    printf 'VERSION expected omp/%s, found %s\n' "$pin" "${actual:-missing}" >&2
    failures=1
  fi
  if [ -s "$UPSTREAM_MARKER" ]; then
    if upstream="$(<"$UPSTREAM_MARKER")"; then
      printf 'UPSTREAM %s\n' "${upstream//$'\n'/ }"
    else
      printf 'UPSTREAM probe failed (read %s)\n' "$UPSTREAM_MARKER" >&2
      failures=1
    fi
  fi

  while IFS=$'\t' read -r kind live_path repo_rel os_scope; do
    [ -n "$kind" ] || continue
    repo_path="$REPO_ROOT/$repo_rel"
    mirror_path="$CHEZMOI_ROOT/$repo_rel"

    if [ ! -f "$repo_path" ]; then
      printf 'REPO    missing %s\n' "$repo_rel" >&2
      failures=1
      continue
    fi
    if [ ! -f "$mirror_path" ]; then
      printf 'SOURCE  missing %s\n' "$repo_rel" >&2
      failures=1
      continue
    fi
    local cmp_rc=0 scope_rc=0
    cmp -s "$repo_path" "$mirror_path" || cmp_rc=$?
    if [ "$cmp_rc" -gt 1 ]; then
      printf 'SOURCE  probe failed (cmp exit %s) %s\n' "$cmp_rc" "$repo_rel" >&2
      failures=1
      continue
    elif [ "$cmp_rc" -ne 0 ]; then
      printf 'SOURCE  drift %s\n' "$repo_rel" >&2
      failures=1
      continue
    fi
    os_in_scope "$os_scope" || scope_rc=$?
    if [ "$scope_rc" -gt 1 ]; then
      failures=1
      continue
    elif [ "$scope_rc" -ne 0 ]; then
      printf 'SKIP    %s (%s-only)\n' "$live_path" "$os_scope"
      continue
    fi
    case "$kind" in
      link)
        if [ ! -L "$live_path" ]; then
          printf 'LIVE    missing symlink %s\n' "$live_path" >&2
          failures=1
          continue
        fi
        ;;
      *)
        if [ ! -f "$live_path" ]; then
          printf 'LIVE    missing %s\n' "$live_path" >&2
          failures=1
          continue
        fi
        ;;
    esac

    # A failed probe is not a clean diff: empty stdout from a failed chezmoi
    # must never print OK.
    local diff_rc=0
    diff_output="$(cm diff "$live_path" 2>/dev/null)" || diff_rc=$?
    if [ "$diff_rc" -ne 0 ]; then
      printf 'LIVE    probe failed (chezmoi diff exit %s) %s\n' "$diff_rc" "$live_path" >&2
      failures=1
    elif [ -n "$diff_output" ]; then
      printf 'LIVE    drift %s\n' "$live_path" >&2
      failures=1
    else
      printf 'OK      %s\n' "$live_path"
    fi

    if [ "$kind" = exec ] && [ ! -x "$live_path" ]; then
      printf 'MODE    not executable %s\n' "$live_path" >&2
      failures=1
    fi
  done <<<"$rows"

  return "$failures"
}

check_source_coverage() {
  local failures=0 tmp_dir expected actual file rel
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/omp-baseline-coverage.XXXXXX")" || return 1
  expected="$tmp_dir/expected"
  actual="$tmp_dir/actual"
  trap 'rm -rf "$tmp_dir"' RETURN

  if ! iter_manifest | while IFS=$'\t' read -r _kind _live repo_rel _os_scope; do
    case "$repo_rel" in home/private_dot_omp/private_agent/*) printf '%s\n' "$repo_rel" ;; esac
  done | sort >"$expected" ||
    ! find "$REPO_ROOT/home/private_dot_omp/private_agent" -type f ! -name .chezmoiignore -print 2>/dev/null |
    while IFS= read -r file; do
      rel="${file#"$REPO_ROOT/"}"
      printf '%s\n' "$rel"
    done | sort >"$actual"; then
    printf 'COVERAGE probe failed (manifest or find)\n' >&2
    failures=1
  elif ! diff -u "$expected" "$actual"; then
    printf 'COVERAGE portable OMP source and manifest disagree\n' >&2
    failures=1
  else
    printf 'COVERAGE complete\n'
  fi

  trap - RETURN
  rm -rf "$tmp_dir"
  return "$failures"
}

check_tracking_and_secrets() {
  local failures=0 repo_rel tracked managed runtime_tracked runtime_managed paths tracked_rc

  if ! paths="$(portable_paths | sort -u)"; then
    printf 'TRACKED probe failed (manifest unreadable)\n' >&2
    failures=1
  fi
  while IFS= read -r repo_rel; do
    [ -n "$repo_rel" ] || continue
    tracked_rc=0
    git_tracked "$repo_rel" || tracked_rc=$?
    # ls-files --error-unmatch exits 1 for an untracked path; anything else is a failed probe.
    if [ "$tracked_rc" -eq 0 ]; then
      printf 'TRACKED %s\n' "$repo_rel"
    elif [ "$tracked_rc" -ne 1 ]; then
      printf 'TRACKED probe failed (git ls-files exit %s) %s\n' "$tracked_rc" "$repo_rel" >&2
      failures=1
    elif [ "$STRICT" = true ]; then
      printf 'PENDING %s\n' "$repo_rel" >&2
      failures=1
    else
      printf 'PENDING %s\n' "$repo_rel"
    fi
  done <<<"${paths:-}"

  # Capture each probe's own status before filtering: a failed git or chezmoi
  # probe yields empty output, which must not read as a clean boundary. The
  # filters are Bash regex matches (match_lines), so no filter process can fail.
  if tracked="$(git -C "$REPO_ROOT" ls-files home/private_dot_omp/private_agent 2>/dev/null)"; then
    runtime_tracked="$(match_lines "$tracked" '(^|/)(agent\.db|history\.db|models\.db|auth-.*\.token|secret-placeholder\.key|gpu_cache\.json|last-changelog-version|\.env)(-|$|\.)|/(sessions|cache|logs|state|terminal-sessions|managed-skills)/|\.log$')"
    if [ -n "$runtime_tracked" ]; then
      printf 'SECRET  runtime or credential path is tracked\n' >&2
      printf '%s\n' "$runtime_tracked" >&2
      failures=1
    else
      printf 'SECRET  Git boundary clean\n'
    fi
  else
    printf 'SECRET  probe failed (git ls-files exit %s)\n' "$?" >&2
    failures=1
  fi

  if managed="$(cm managed 2>/dev/null)"; then
    runtime_managed="$(match_lines "$managed" '^\.omp/agent/(agent\.db|history\.db|models\.db|auth-|secret-placeholder\.key|gpu_cache\.json|last-changelog-version|\.env|sessions/|cache/|logs/|state/|terminal-sessions/|managed-skills/|.*\.log$)')"
    if [ -n "$runtime_managed" ]; then
      printf 'SECRET  chezmoi owns runtime paths\n%s\n' "$runtime_managed" >&2
      failures=1
    else
      printf 'SECRET  chezmoi boundary clean\n'
    fi
  else
    printf 'SECRET  probe failed (chezmoi managed exit %s)\n' "$?" >&2
    failures=1
  fi

  return "$failures"
}

# Observational only; `omp-baseline repair` restores what this reports.
check_runtime_permissions() {
  local failures=0 os="$HOST_OS" mode fstype attrs path want
  # Directories 700, then credential and database files 600; absent paths are skipped.
  for path in "d:$HOME/.omp" "d:$HOME/.omp/agent" \
    "f:$HOME/.omp/agent/.env" \
    "$HOME/.omp/agent"/agent.db* \
    "$HOME/.omp/agent"/history.db* \
    "$HOME/.omp/agent"/models.db* \
    "$HOME/.omp/agent"/auth-*.token \
    "f:$HOME/.omp/agent/secret-placeholder.key"; do
    case "$path" in
      d:*) path="${path#d:}"; want=700; [ -d "$path" ] || continue ;;
      f:*) path="${path#f:}"; want=600; [ -e "$path" ] || continue ;;
      *) want=600; [ -e "$path" ] || continue ;;
    esac
    if [ "$os" = Darwin ]; then
      mode="$(stat -f '%Lp' "$path")" || mode=""
    else
      mode="$(stat -c '%a' "$path")" || mode=""
    fi
    if [ -z "$mode" ]; then
      printf 'MODE    probe failed (stat) on %s\n' "$path" >&2
      failures=1
    elif [ "$mode" != "$want" ]; then
      printf 'MODE    expected %s on %s, found %s (run omp-baseline repair)\n' "$want" "$path" "$mode" >&2
      failures=1
    fi
  done
  [ "$failures" -eq 0 ] && printf 'MODE    runtime directories and local credentials private\n'
  if [ "$os" = Linux ] && command -v lsattr >/dev/null 2>&1; then
    if ! fstype="$(findmnt -n -o FSTYPE -T "$HOME/.omp/agent" 2>/dev/null)"; then
      printf 'NOCOW   probe failed (findmnt) on ~/.omp/agent\n' >&2
      failures=1
    elif [ "$fstype" != btrfs ]; then
      :
    elif ! attrs="$(lsattr -d "$HOME/.omp/agent" 2>/dev/null)"; then
      printf 'NOCOW   probe failed (lsattr) on ~/.omp/agent\n' >&2
      failures=1
    else
      # Only the attribute field: the path itself may contain a C.
      case "${attrs%% *}" in
        *C*) printf 'NOCOW   ~/.omp/agent\n' ;;
        *) printf 'NOCOW   expected chattr +C on ~/.omp/agent (run omp-baseline repair)\n' >&2; failures=1 ;;
      esac
    fi
  fi
  return "$failures"
}

harden_runtime_permissions() {
  local file fstype
  install -d -m 700 "$HOME/.omp" "$HOME/.omp/agent"
  # btrfs CoW + sqlite page writes can displace pages (Firefox/Chrome
  # guidance; OMP #8082 saw the same cache-autoindex damage). Directory
  # +C is inherited by new files. Existing non-empty files stay CoW
  # until rewritten idle. APFS has no equivalent.
  if [ "$HOST_OS" = Linux ] && command -v chattr >/dev/null 2>&1; then
    fstype="$(findmnt -n -o FSTYPE -T "$HOME/.omp/agent" 2>/dev/null || true)"
    if [ "$fstype" = btrfs ]; then
      chattr +C "$HOME/.omp/agent" 2>/dev/null || true
    fi
  fi
  for file in \
    "$HOME/.omp/agent/.env" \
    "$HOME/.omp/agent"/agent.db* \
    "$HOME/.omp/agent"/history.db* \
    "$HOME/.omp/agent"/models.db* \
    "$HOME/.omp/agent"/auth-*.token \
    "$HOME/.omp/agent/secret-placeholder.key"; do
    [ -e "$file" ] || continue
    chmod 600 "$file"
  done
}


yaml_indented_scalar() {
  local file="$1" section="$2" key="$3"
  awk -v section="$section" -v key="$key" '
    $0 ~ "^[[:space:]]*" section ":" { in_sec=1; next }
    in_sec && /^[^[:space:]#]/ { in_sec=0 }
    in_sec && $1 == key ":" { print $2; exit }
  ' "$file"
}


yaml_top_scalar() {
  awk -v key="$2" '$0 ~ "^" key ":" { print $2; exit }' "$1"
}

require_scalar() {
  local label="$1" actual="$2" expected="$3"
  if [ "$actual" = "$expected" ]; then
    printf 'CONFIG  %s %s\n' "$label" "$actual"
    return 0
  fi
  printf 'CONFIG  %s expected %s, found %s\n' "$label" "$expected" "${actual:-missing}" >&2
  return 1
}

omp_value() {
  omp_probe config get "$1" --json 2>/dev/null | jq -r 'if has("value") then .value else empty end'
}

check_policy_scalar() {
  local path="$1" expected="$2" source_config="$3" live_value source_value section key read_rc=0
  if [[ "$path" == *.* ]]; then
    section="${path%%.*}"
    key="${path#*.}"
    source_value="$(yaml_indented_scalar "$source_config" "$section" "$key")" || read_rc=$?
  else
    source_value="$(yaml_top_scalar "$source_config" "$path")" || read_rc=$?
  fi
  if [ "$read_rc" -ne 0 ]; then
    printf 'CONFIG  source %s probe failed (read %s)\n' "$path" "$source_config" >&2
    return 1
  fi
  require_scalar "source $path" "$source_value" "$expected" || return 1
  # A failed probe is an error even when its stdout held the expected value.
  if ! live_value="$(omp_value "$path")"; then
    printf 'CONFIG  effective %s probe failed (omp config get)\n' "$path" >&2
    return 1
  fi
  require_scalar "effective $path" "$live_value" "$expected" || return 1
  return 0
}

check_effective_list() {
  local path="$1" expected_json="$2" output
  if output="$(omp_probe config get "$path" --json 2>/dev/null)" &&
    printf '%s' "$output" | jq -e --argjson expected "$expected_json" '.value == $expected' >/dev/null; then
    printf 'CONFIG  effective %s %s\n' "$path" "$expected_json"
    return 0
  fi
  printf 'CONFIG  effective %s expected %s\n' "$path" "$expected_json" >&2
  return 1
}

check_thinking_and_loop_policy() {
  local failures=0 source_config live_config source_models
  source_config="$REPO_ROOT/home/private_dot_omp/private_agent/private_config.yml"
  live_config="$HOME/.omp/agent/config.yml"
  source_models="$REPO_ROOT/home/private_dot_omp/private_agent/private_models.yml"

  check_policy_scalar defaultThinkingLevel high "$source_config" || failures=1
  check_policy_scalar retry.modelFallback false "$source_config" || failures=1
  check_policy_scalar task.maxConcurrency 3 "$source_config" || failures=1
  check_policy_scalar task.maxRecursionDepth 1 "$source_config" || failures=1
  check_policy_scalar task.eager default "$source_config" || failures=1
  check_policy_scalar task.softRequestBudget 100 "$source_config" || failures=1
  check_policy_scalar task.maxRuntimeMs 1800000 "$source_config" || failures=1
  check_policy_scalar compaction.thresholdTokens -1 "$source_config" || failures=1
  check_policy_scalar compaction.thresholdPercent -1 "$source_config" || failures=1
  check_policy_scalar compaction.midTurnEnabled true "$source_config" || failures=1
  check_policy_scalar compaction.idleEnabled false "$source_config" || failures=1
  check_policy_scalar compaction.asyncEnabled false "$source_config" || failures=1
  check_policy_scalar recap.enabled false "$source_config" || failures=1
  check_policy_scalar extendedContext false "$source_config" || failures=1

  local source_roles
  if ! source_roles="$(awk '
    /^modelRoles:/ { in_roles=1; next }
    in_roles && /^[^[:space:]#]/ { exit }
    in_roles && $1 ~ /^(default|slow|plan|vision|commit|smol|tiny|task):$/ { print $1 }
  ' "$source_config")"; then
    printf 'CONFIG  source model roles probe failed (read %s)\n' "$source_config" >&2
    failures=1
  elif printf '%s\n' "$source_roles" | grep -q '^default:' &&
    printf '%s\n' "$source_roles" | grep -q '^slow:' &&
    printf '%s\n' "$source_roles" | grep -q '^plan:' &&
    printf '%s\n' "$source_roles" | grep -q '^task:'; then
    printf 'CONFIG  canonical model roles present\n'
  else
    printf 'CONFIG  canonical model roles incomplete\n' >&2
    failures=1
  fi

  local source_provider
  if ! source_provider="$(awk '
    /^providers:/ { in_providers=1; next }
    in_providers && /^[^[:space:]#]/ { exit }
    in_providers && $1 ~ /^vllm:$/ { print $1 }
  ' "$source_models")"; then
    printf 'CONFIG  source providers probe failed (read %s)\n' "$source_models" >&2
    failures=1
  elif printf '%s\n' "$source_provider" | grep -q '^vllm:'; then
    printf 'CONFIG  local inference provider present\n'
  else
    printf 'CONFIG  local inference provider missing\n' >&2
    failures=1
  fi

  return "$failures"
}

check_omp_config() {
  local failures=0 pin source_pin output omp_path
  # Read whole sed outputs so each read keeps its own status.
  if ! pin="$(expected_version)" ||
    ! source_pin="$(sed -n 's/^"github:can1357\/oh-my-pi"[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$REPO_ROOT/home/dot_config/mise/config.toml")"; then
    printf 'PIN     probe failed (manifest or mise config unreadable)\n' >&2
    failures=1
  else
    source_pin="${source_pin%%$'\n'*}"
    if [ -n "$pin" ] && [ "$pin" = "$source_pin" ]; then
      printf 'PIN     %s everywhere\n' "$pin"
    else
      printf 'PIN     manifest=%s mise=%s\n' "$pin" "$source_pin" >&2
      failures=1
    fi
  fi

  omp_path="$(command -v omp 2>/dev/null || true)"
  case "$omp_path" in
    "$HOME/.local/share/mise/shims/omp"|"$HOME/.local/share/mise/installs/"*/omp)
      printf 'BINARY  mise-managed %s\n' "$omp_path"
      ;;
    *)
      printf 'BINARY  unmanaged or shadowed %s\n' "${omp_path:-missing}" >&2
      failures=1
      ;;
  esac

  if output="$(omp_probe config get modelRoles --json 2>/dev/null)" \
    && printf '%s' "$output" | jq -e '
      (.value.default | test("^openai-codex/gpt-[0-9]+(\\.[0-9]+)?-sol:high$")) and
      (.value.astra | test("^openai-codex/gpt-[0-9]+(\\.[0-9]+)?-astra:high$")) and
      (.value.slow == .value.default) and
      (.value.plan | test("^openai-codex/gpt-[0-9]+(\\.[0-9]+)?-sol:high$")) and
      (.value.task | test("^openai-codex/gpt-[0-9]+(\\.[0-9]+)?-luna:medium$")) and
      (.value.vision == .value.task) and
      (.value.smol | test("^vllm/Qwen[^:]+:low$")) and
      (.value.commit == .value.smol) and
      (.value.tiny == .value.smol) and
      (.value | all(.[]; test("^(openai-codex|vllm|web)/")))
    ' >/dev/null; then
    printf 'CONFIG  model roles parse\n'
  else
    printf 'CONFIG  model roles invalid\n' >&2
    failures=1
  fi

  # Every Codex role model must resolve in live discovery.
  # The catalog can exceed ARG_MAX: feed it on stdin.
  if roles="$(omp_probe config get modelRoles --json 2>/dev/null)" \
    && omp_probe models --json --no-extensions 2>/dev/null | jq -e --argjson roles "$roles" '
      [.. | objects | select(.provider? and .id?) | {key: "\(.provider)/\(.id)", value: .contextWindow}] | from_entries as $windows
      | [$roles.value | to_entries[] | .value | select(startswith("openai-codex/")) | sub(":[a-z]+$"; "")] | unique
      | all(. as $m | $windows[$m] != null)
    ' >/dev/null; then
    printf 'MODEL   role models discovered\n'
  else
    printf 'MODEL   role model missing\n' >&2
    failures=1
  fi

  check_effective_list cycleOrder '["default","task"]' || failures=1

  if output="$(omp_probe config get skills.enablePiUser --json 2>/dev/null)" \
    && printf '%s' "$output" | jq -e '.value == true' >/dev/null \
    && output="$(omp_probe config get skills.enablePiProject --json 2>/dev/null)" \
    && printf '%s' "$output" | jq -e '.value == true' >/dev/null; then
    printf 'CONFIG  native skills enabled\n'
  else
    printf 'CONFIG  native skills gate invalid\n' >&2
    failures=1
  fi

  local source_models="$REPO_ROOT/home/private_dot_omp/private_agent/private_models.yml" catalog catalog_rc
  if grep -q '^  vllm:' "$source_models" && grep -q 'Qwen3.8-27B-Swift-Heretic-MXFP4' "$source_models"; then
    printf 'CONFIG  promoted local catalog configured\n'
  else
    printf 'CONFIG  promoted local catalog missing\n' >&2
    failures=1
  fi
  # A failed or empty probe is an error; only a working probe without the entry
  # is the nonfatal readiness gap.
  catalog_rc=0
  if ! catalog="$(omp_probe models vllm --json --no-extensions 2>/dev/null)"; then
    catalog_rc=probe
  else
    # jq -e exits 1 only for an absent entry; any other nonzero status is a failed probe.
    printf '%s' "$catalog" | jq -e '.models | if type == "array" then map(.id) | index("Qwen3.8-27B-Swift-Heretic-MXFP4") else error("no models array") end' >/dev/null 2>&1 || catalog_rc=$?
  fi
  if [ "$catalog_rc" != 0 ] && [ "$catalog_rc" != 1 ]; then
    printf 'MODEL   probe failed (omp models vllm --json)\n' >&2
    failures=1
  elif [ "$catalog_rc" = 0 ]; then
    printf 'MODEL   Swift Heretic Qwen local catalog entry\n'
  elif grep -q 'Qwen3.8-27B-Swift-Heretic-MXFP4' "$source_models"; then
    # Nonfatal: the server may be down or remote, but say what is unproven.
    printf 'READY   vLLM discovery unavailable (Qwen3.8 configured; runtime readiness unverified)\n'
  else
    printf 'MODEL   Qwen3.8 absent from local catalog and source\n' >&2
    failures=1
  fi
  if omp_probe setup python --check --json >/dev/null 2>&1; then
    printf 'PYTHON  available\n'
  else
    printf 'PYTHON  unavailable\n' >&2
    failures=1
  fi
  check_thinking_and_loop_policy || failures=1
  return "$failures"
}

# A scratch profile NAME in the probe HOME holding CONFIG and MODELS (either may
# be absent) plus the credentials and model caches of the live agent dir CREDS,
# so `omp --profile NAME` loads what that config would on this host. Profiles
# read their own auth-broker token.
probe_profile() {
  local root="$PROBE_HOME/.omp/profiles/$1" file
  if ! mkdir -p "$root/agent" ||
    { [ -f "$PROBE_HOME/.omp/auth-broker.token" ] && ! cp -p "$PROBE_HOME/.omp/auth-broker.token" "$root/"; } ||
    { [ -f "$2" ] && ! cp "$2" "$root/agent/config.yml"; } ||
    { [ -f "$3" ] && ! cp "$3" "$root/agent/models.yml"; } ||
    ! probe_copy_dotenv "$4/.env" "$root/agent/.env" ||
    ! probe_screen "$2" "$3"; then
    rm -rf "$root"
    return 1
  fi
  for file in "$4"/agent.db* "$4"/models.db*; do
    [ -f "$file" ] || continue
    if ! cp -p "$file" "$root/agent/"; then
      rm -rf "$root"
      return 1
    fi
  done
  if [ -f "$root/agent/agent.db" ] && ! probe_clear_oauth "$root/agent/agent.db"; then
    printf 'PROBE   could not clear OAuth logins from the profile agent.db copy\n' >&2
    rm -rf "$root"
    return 1
  fi
}

# omp-agent-policy --catalog evidence from native runs in probe profile PROBE
# (default: the probe HOME's copy of the live agent dir): `omp models --json`
# with extensions off (no unreviewed module runs; the checker fails closed on
# those) and its stderr, where native loading reports a rejected models.yml;
# `omp config list --json`, every setting's effective value, which the checker
# compares with its own merge; and the omp version, policy profile and
# models.yml covered.
agent_catalog() {
  local out="$1" agent_dir="$PROBE_HOME/.omp/agent" version models=null
  local -a args=()
  if [ "$3" != default ]; then
    agent_dir="$PROBE_HOME/.omp/profiles/$3/agent"
    [ -d "$agent_dir" ] || return 1
    args=(--profile "$3")
  fi
  version="$(omp_probe --version)" || return 1
  omp_probe ${args[@]+"${args[@]}"} models --json --no-extensions >"$out.stdout" 2>"$out.stderr" || return 1
  omp_probe ${args[@]+"${args[@]}"} config list --json >"$out.settings" 2>>"$out.stderr" || return 1
  [ ! -f "$agent_dir/models.yml" ] || models="$(jq -Rs . "$agent_dir/models.yml")" || return 1
  jq -n --arg version "${version#omp/}" --arg profile "$2" --argjson modelsYml "$models" \
    --rawfile stderr "$out.stderr" --slurpfile catalog "$out.stdout" --slurpfile settings "$out.settings" '
    if ($catalog | length) == 1 and ($catalog[0].models | type) == "array"
      and ($settings | length) == 1 and ($settings[0] | type) == "object"
    then $catalog[0] + {settings: $settings[0], ompVersion: $version, profile: $profile, modelsYml: $modelsYml, stderr: $stderr}
    else error("no models array or settings object") end' >"$out"
}

# The checker with native catalog evidence (see agent_catalog). A failed
# capture is reported and the checker still runs, so it also reports what it
# cannot verify without evidence. The checker screens the environment an
# ordinary launch would see, which never holds this script's own
# OMP_BASELINE_* settings (no OMP code reads them), so they are dropped.
agent_policy_run() {
  local label="$1" profile="$2" probe="$3" out
  shift 3
  out="${PROBE_ROOT:-/nonexistent}/catalog-$probe.json"
  if [ -n "$PROBE_HOME" ] && agent_catalog "$out" "$profile" "$probe"; then
    policy_checker "$@" --catalog "$out"
    return
  fi
  printf 'AGENT   probe failed (omp models --json, %s)\n' "$label" >&2
  [ ! -s "$out.stderr" ] || sed -n '1,3p' "$out.stderr" >&2
  policy_checker "$@" || true
  return 1
}

policy_checker() {
  (
    for name in $(compgen -e); do
      if [[ $name == OMP_BASELINE_* ]] ||
        { [ "$PROBE_SOURCE_ONLY" = true ] && [[ $name =~ ^(PI|OMP)_ ]]; }; then
        unset "$name"
      fi
    done
    if [ "$PROBE_SOURCE_ONLY" = true ]; then
      cd "$PROBE_ROOT/cwd" || exit 1
      export PI_CONFIG_FILES=:
    fi
    bun_run "$checker" "$@"
  )
}

# Effective subagent model, thinking, tools and provenance, from the shared
# offline checker (also used by publish), for the source and live default and
# local profiles. Every run gets native evidence for its own config and
# models.yml. Source runs use scratch profiles holding the source files with
# this host's credentials and no host overlay: PI_CONFIG_FILES=":" names no
# file and keeps a copied dotenv file from supplying one. Live probes run from a
# scratch cwd holding copies of this cwd's project settings files.
# check_source_agent_policy ROOT runs the source half with $checker; under
# check-source the probe HOME is source-only, so its credentials stand in for
# both profiles.
check_source_agent_policy() {
  local failures=0 src="$1/home/private_dot_omp"
  local default_creds="$HOME/.omp/agent" local_creds="$HOME/.omp/agent"
  [ ! -d "$HOME/.omp/profiles/local/agent" ] || local_creds="$HOME/.omp/profiles/local/agent"
  if [ "$PROBE_SOURCE_ONLY" = true ]; then
    default_creds="$PROBE_HOME/.omp/agent"
    local_creds="$PROBE_HOME/.omp/agent"
  fi
  if [ -n "$PROBE_HOME" ]; then
    # A profile that cannot be prepared fails here and again in agent_policy_run,
    # whose catalog capture finds no profile.
    if ! probe_profile src-default "$src/private_agent/private_config.yml" \
      "$src/private_agent/private_models.yml" "$default_creds"; then
      printf 'AGENT   probe profile failed (source default)\n' >&2
      failures=1
    fi
    if ! probe_profile src-local "$src/private_profiles/local/private_agent/private_config.yml" \
      "$src/private_profiles/local/private_agent/private_models.yml" "$local_creds"; then
      printf 'AGENT   probe profile failed (source local)\n' >&2
      failures=1
    fi
  fi
  PI_CONFIG_FILES=: agent_policy_run "source default" default src-default --root "$1" || failures=1
  PI_CONFIG_FILES=: agent_policy_run "source local" local src-local --root "$1" --profile local || failures=1
  return "$failures"
}

check_agent_policy() {
  local failures=0 checker version live_local="$HOME/.omp/profiles/local/agent"
  local live_cwd="${PROBE_ROOT:-/nonexistent}/live-cwd" file
  checker="$HOME/.local/bin/omp-agent-policy"
  [ -x "$checker" ] || checker="$REPO_ROOT/home/dot_local/bin/executable_omp-agent-policy"
  if [ ! -f "$checker" ]; then
    printf 'AGENT   checker missing %s\n' "$checker" >&2
    return 1
  fi
  check_source_agent_policy "$REPO_ROOT" || failures=1
  if [ -n "$PROBE_HOME" ]; then
    if [ -d "$live_local" ] &&
      ! probe_profile local "$live_local/config.yml" "$live_local/models.yml" "$live_local"; then
      printf 'AGENT   probe profile failed (live local)\n' >&2
      failures=1
    fi
    mkdir -m 700 "$live_cwd" || return 1
    for file in settings.json config.yml; do
      [ -f "$PWD/.omp/$file" ] || continue
      mkdir -p "$live_cwd/.omp" && cp -p "$PWD/.omp/$file" "$live_cwd/.omp/" || return 1
    done
  fi

  if [ -z "$PROBE_HOME" ] || ! version="$(omp_probe --version)"; then
    printf 'AGENT   omp --version probe failed; live agent checks skipped\n' >&2
    return 1
  fi
  PROBE_CWD="$live_cwd" agent_policy_run "live default" default default --live "$HOME/.omp/agent" \
    --omp-version "${version#omp/}" --cwd "$PWD" || failures=1
  if [ -d "$live_local" ]; then
    PROBE_CWD="$live_cwd" agent_policy_run "live local" local local --live "$live_local" \
      --omp-version "${version#omp/}" --cwd "$PWD" || failures=1
  fi
  return "$failures"
}

# check-source ROOT: the agent-policy source runs for an exported tree ROOT
# (decent-angl-sync publish runs it on the archived revision), with ROOT's own
# checker and native evidence from the installed omp, which must be ROOT's pin.
# Nothing live but credentials and model caches enters the probe HOME.
check_source() {
  local root pin actual checker pin_dir
  # Absolute: policy_checker runs from the scratch cwd.
  root="$(cd "$1" 2>/dev/null && pwd -P)" || {
    printf 'AGENT   source root %s not found\n' "$1" >&2
    return 1
  }
  checker="$root/home/dot_local/bin/executable_omp-agent-policy"
  if [ ! -f "$checker" ]; then
    printf 'AGENT   checker missing %s\n' "$checker" >&2
    return 1
  fi
  pin="$(MANIFEST="$root/home/dot_config/decent-angl/omp-baseline-manifest.tsv" manifest_value omp-version)" || pin=""
  if [ -z "$pin" ]; then
    printf 'VERSION no omp-version pin in %s\n' "$root" >&2
    return 1
  fi
  actual="$(omp --version 2>/dev/null)" || actual=""
  # A publisher may still run the previous release: check the candidate with its own pinned one.
  if [ "$actual" != "omp/$pin" ] && command -v mise >/dev/null 2>&1 &&
    mise -C "$HOME" install "github:can1357/oh-my-pi@$pin" >&2 &&
    pin_dir="$(mise -C "$HOME" where "github:can1357/oh-my-pi@$pin")" && [ -x "$pin_dir/omp" ]; then
    PATH="$pin_dir:$PATH"
    actual="$(omp --version 2>/dev/null)" || actual=""
  fi
  if [ "$actual" != "omp/$pin" ]; then
    printf 'VERSION installed %s, source pin omp/%s; install the pin first\n' "${actual:-missing}" "$pin" >&2
    return 1
  fi
  printf 'VERSION %s matches the source pin\n' "$actual"
  (
    trap cleanup_probe_home EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    PROBE_SOURCE_ONLY=true
    # An inherited PROBE_CWD would let a live project's .omp settings into the probe.
    unset PROBE_CWD
    probe_home || { printf 'PROBE   scratch HOME unavailable; source check cannot run\n' >&2; exit 1; }
    check_source_agent_policy "$root"
  )
}

quarantine_legacy_wrapper() {
  local wrapper backup
  wrapper="$HOME/.local/bin/omp"
  [ -f "$wrapper" ] || return 0
  if grep -Fq 'mise use -g' "$wrapper" && grep -Fq 'oh-my-pi' "$wrapper"; then
    mkdir -p "$STATE_DIR/backups"
    backup="$STATE_DIR/backups/omp-legacy-wrapper.$(date -u +%Y%m%dT%H%M%SZ)"
    mv "$wrapper" "$backup"
    printf 'BINARY  quarantined mutable wrapper at %s\n' "$backup"
    hash -r
  fi
}

# Only these live agent dirs supply credentials to the scratch probes.
check_local_oauth() {
  python3 - "$HOME/.omp/agent/agent.db" "$HOME/.omp/profiles/local/agent/agent.db" <<'PY'
from pathlib import Path
import os, shutil, sqlite3, sys, tempfile

def state(path):
    """Identity of a live file; a WAL reset rewrites its header salts."""
    try:
        st = os.stat(path)
        with open(path, "rb") as f:
            return st.st_ino, st.st_size, st.st_mtime_ns, f.read(32)
    except FileNotFoundError:
        return None

failures = 0
for name in sys.argv[1:]:
    path = Path(name)
    wal = Path(str(path) + "-wal")
    if not path.is_file():
        continue
    try:
        # Even mode=ro may create a WAL shared-memory file. Inspect a copy so
        # live files stay untouched; immutable=1 would miss committed WAL rows.
        with tempfile.TemporaryDirectory(prefix="omp-baseline-auth-") as scratch:
            copied = Path(scratch) / "agent.db"
            # A checkpoint between the two copies could hide a WAL-only row:
            # accept the pair only when neither live file changed meanwhile.
            for _ in range(5):
                before = state(path), state(wal)
                shutil.copyfile(path, copied)
                Path(str(copied) + "-wal").unlink(missing_ok=True)
                if before[1] is not None:
                    try:
                        shutil.copyfile(wal, str(copied) + "-wal")
                    except FileNotFoundError:
                        continue
                if (state(path), state(wal)) == before:
                    break
            else:
                raise OSError("agent.db kept changing while copied")
            db = sqlite3.connect(copied.as_uri() + "?mode=ro", uri=True)
            try:
                count = 0
                if db.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'auth_credentials'").fetchone():
                    count = db.execute("SELECT count(*) FROM auth_credentials WHERE credential_type = 'oauth'").fetchone()[0]
            finally:
                db.close()
    except (OSError, sqlite3.Error):
        print(f"AUTH    probe failed in {path}", file=sys.stderr)
        failures = 1
        continue
    if count:
        print(f"AUTH    {count} local OAuth login(s) in {path}; logins belong on the nous broker", file=sys.stderr)
        failures = 1
    else:
        print(f"AUTH    no local OAuth logins in {path}")
sys.exit(failures)
PY
}

# Observational: native omp probes run against a scratch HOME (omp_probe) that
# is removed when the subshell exits.
validate() {
  local status=0
  (
    trap cleanup_probe_home EXIT
    # Without the scratch HOME every native probe fails (omp_probe); say why once.
    probe_rc=0
    probe_home || { probe_rc=1; printf 'PROBE   scratch HOME unavailable; native probes cannot run\n' >&2; }
    validate_checks || exit 1
    exit "$probe_rc"
  ) || status=$?
  return "$status"
}

validate_checks() {
  local failures=0 skill_manager paths format_rc=0
  check_manifest_status || failures=1
  check_source_coverage || failures=1
  check_tracking_and_secrets || failures=1
  check_omp_config || failures=1
  check_agent_policy || failures=1
  check_runtime_permissions || failures=1
  check_local_oauth || failures=1
  skill_manager="$HOME/.local/bin/decent-angl-skills"
  [ -x "$skill_manager" ] || skill_manager="$REPO_ROOT/home/dot_local/bin/executable_decent-angl-skills"
  if DECENT_ANGL_REPO_ROOT="$REPO_ROOT" bash "$skill_manager" validate; then
    :
  else
    failures=1
  fi
  # git diff --check exits 2 for whitespace errors; any other nonzero status is a failed probe.
  if ! paths="$(portable_paths | sort -u)"; then
    printf 'FORMAT  probe failed (manifest unreadable)\n' >&2
    failures=1
  else
    # shellcheck disable=SC2086 # repo-relative paths without whitespace
    git -C "$REPO_ROOT" diff --check -- $paths >/dev/null || format_rc=$?
    case "$format_rc" in
      0) printf 'FORMAT  clean\n' ;;
      2) printf 'FORMAT  whitespace errors\n' >&2; failures=1 ;;
      *) printf 'FORMAT  probe failed (git diff --check exit %s)\n' "$format_rc" >&2; failures=1 ;;
    esac
  fi
  return "$failures"
}

repair() {
  harden_runtime_permissions
  validate
}

apply_local() {
  local pin kind live_path repo_rel os_scope skill_manager
  local paths=()
  while IFS=$'\t' read -r kind live_path repo_rel os_scope; do
    if ! os_in_scope "$os_scope"; then
      continue
    fi
    paths+=("$live_path")
    case "$live_path" in
      "$HOME/.omp/agent/"*) install -d -m 700 "$(dirname "$live_path")" ;;
      *) mkdir -p "$(dirname "$live_path")" ;;
    esac
  done < <(iter_manifest)

  harden_runtime_permissions
  if [ "${OMP_BASELINE_SOURCE_APPLIED:-0}" != 1 ] && [ "${#paths[@]}" -gt 0 ]; then
    cm apply --force "${paths[@]}"
  fi
  skill_manager="$HOME/.local/bin/decent-angl-skills"
  [ -x "$skill_manager" ] || skill_manager="$REPO_ROOT/home/dot_local/bin/executable_decent-angl-skills"
  DECENT_ANGL_REPO_ROOT="$REPO_ROOT" bash "$skill_manager" sync
  quarantine_legacy_wrapper
  pin="$(expected_version)"
  if command -v mise >/dev/null 2>&1; then
    if [ "$(omp --version 2>/dev/null || true)" != "omp/$pin" ]; then
      mise install "github:can1357/oh-my-pi@$pin"
    fi
    # Companion pins live in the same global mise file (gh, etc.); resolve them from HOME, not the
    # caller's project, whose own pins would shadow the fleet's.
    if [ "$(machine_role)" = agent-host ]; then
      mise -C "$HOME" install "${AGENT_HOST_TOOLS[@]}"
    else
      mise -C "$HOME" install
    fi
    mise reshim
  fi
  printf '%s' "$pin" >"$HOME/.omp/agent/last-changelog-version"
  if [ "${OMP_BASELINE_IN_GUARD:-0}" != 1 ]; then
    install_guard
  fi
  harden_runtime_permissions
  if [ "${OMP_BASELINE_SKIP_VALIDATE:-0}" = 1 ]; then
    return 0
  fi
  # The hourly guard runs this same validate; a pass here clears its stale drift marker.
  validate || return
  rm -f "$MARKER"
}

pull_published() {
  local fleet_sync="$HOME/.local/bin/decent-angl-sync"
  if [ ! -x "$fleet_sync" ]; then
    printf 'decent-angl-sync is unavailable; apply the complete shared baseline first.\n' >&2
    return 127
  fi
  "$fleet_sync" reconcile
  # A pre-upgrade `pull` still has the old validator in memory. Re-exec
  # the applied binary so new pin, OS-scope, and policy checks run.
  # Do not expand an empty array under `set -u`; macOS bash 3.2 treats that
  # as unbound.
  if [ -x "$HOME/.local/bin/omp-baseline" ]; then
    if [ "$STRICT" = true ]; then
      exec "$HOME/.local/bin/omp-baseline" validate --strict
    fi
    exec "$HOME/.local/bin/omp-baseline" validate
  fi
  validate
}

normalize_omp_version() {
  local raw="$1"
  raw="${raw#omp/}"
  raw="${raw#v}"
  case "$raw" in
    [0-9]*.[0-9]*.[0-9]*) printf '%s\n' "$raw" ;;
    *) return 1 ;;
  esac
}

fetch_github_release_tag() {
  local path="$1"
  local tag=""
  if command -v gh >/dev/null 2>&1; then
    tag="$(gh api "repos/${OMP_GITHUB_REPO}/${path}" --jq .tag_name 2>/dev/null || true)"
  fi
  if [ -z "$tag" ]; then
    tag="$(curl -fsSL -A omp-baseline \
      "https://api.github.com/repos/${OMP_GITHUB_REPO}/${path}" \
      | jq -r '.tag_name // empty')" || return 1
  fi
  [ -n "$tag" ] || return 1
  normalize_omp_version "$tag"
}

fetch_latest_omp_version() {
  fetch_github_release_tag releases/latest
}

verify_omp_release() {
  local version="$1"
  fetch_github_release_tag "releases/tags/v${version}" >/dev/null
}

rewrite_one_pin_line() {
  local file="$1"
  local pattern="$2"
  local replacement="$3"
  local tmp count
  tmp="$(mktemp "${TMPDIR:-/tmp}/omp-pin.XXXXXX")"
  count="$(awk -v pat="$pattern" ' $0 ~ pat { n++ } END { print n+0 }' "$file")"
  if [ "$count" != 1 ]; then
    rm -f "$tmp"
    printf 'UPGRADE expected one pin line matching %s in %s, found %s\n' \
      "$pattern" "$file" "$count" >&2
    return 1
  fi
  awk -v pat="$pattern" -v repl="$replacement" '
    $0 ~ pat { print repl; next }
    { print }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

set_pin_sites() {
  local version="$1"
  rewrite_one_pin_line \
    "$REPO_ROOT/home/dot_config/decent-angl/omp-baseline-manifest.tsv" \
    '^# omp-version[[:space:]]' \
    "# omp-version	${version}" || return 1
  rewrite_one_pin_line \
    "$REPO_ROOT/home/dot_config/mise/config.toml" \
    '^"github:can1357/oh-my-pi"[[:space:]]*=' \
    "\"github:can1357/oh-my-pi\" = \"${version}\"" || return 1
}

restore_pin_sites() {
  git -C "$REPO_ROOT" checkout -- \
    home/dot_config/decent-angl/omp-baseline-manifest.tsv \
    home/dot_config/mise/config.toml
}

require_clean_pin_files() {
  local dirty
  dirty="$(git -C "$REPO_ROOT" status --porcelain=v1 -- \
    home/dot_config/decent-angl/omp-baseline-manifest.tsv \
    home/dot_config/mise/config.toml)"
  if [ -n "$dirty" ]; then
    printf 'UPGRADE pin files are dirty; commit or discard them first.\n%s\n' "$dirty" >&2
    return 1
  fi
}

apply_pin_files_live() {
  [ "${OMP_BASELINE_SOURCE_APPLIED:-0}" = 1 ] && return 0
  cm apply --force \
    "$HOME/.config/decent-angl/omp-baseline-manifest.tsv" \
    "$HOME/.config/mise/config.toml"
}

check_upstream() {
  local pin latest
  pin="$(expected_version)"
  if ! latest="$(fetch_latest_omp_version)"; then
    printf 'UPSTREAM unreachable\n' >&2
    return 1
  fi
  if [ "$pin" = "$latest" ]; then
    rm -f "$UPSTREAM_MARKER"
    printf 'UPSTREAM pin=%s latest=%s current\n' "$pin" "$latest"
    return 0
  fi
  mkdir -p "$STATE_DIR"
  printf 'pin=%s\nlatest=%s\nnext=omp-baseline upgrade %s\n' \
    "$pin" "$latest" "$latest" >"$UPSTREAM_MARKER"
  printf 'UPSTREAM pin=%s latest=%s available\n' "$pin" "$latest"
  printf 'NEXT    omp-baseline upgrade %s\n' "$latest"
}

upgrade() {
  local pin target="" dry=false raw
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) dry=true ;;
      --strict) STRICT=true ;;
      -h|--help) usage; return 0 ;;
      -*)
        printf 'Unknown option: %s\n' "$1" >&2
        usage >&2
        return 1
        ;;
      *)
        if [ -n "$target" ]; then
          printf 'upgrade accepts one VERSION\n' >&2
          return 1
        fi
        target="$1"
        ;;
    esac
    shift
  done

  pin="$(expected_version)"
  if [ -z "$target" ]; then
    target="$(fetch_latest_omp_version)" || {
      printf 'UPGRADE could not resolve GitHub latest\n' >&2
      return 1
    }
  else
    raw="$target"
    if ! target="$(normalize_omp_version "$raw")"; then
      printf 'UPGRADE invalid version: %s\n' "$raw" >&2
      return 1
    fi
  fi

  if [ "$dry" = true ]; then
    printf 'PIN     %s -> %s\n' "$pin" "$target"
    printf 'FILES   manifest mise\n'
    if [ "$pin" = "$target" ]; then
      printf 'UPGRADE already on %s\n' "$target"
    else
      printf 'NEXT    would install github:can1357/oh-my-pi@%s then validate\n' "$target"
    fi
    return 0
  fi

  if [ "$pin" = "$target" ]; then
    printf 'UPGRADE already on %s\n' "$target"
    apply_local
    return
  fi

  require_clean_pin_files || return 1
  verify_omp_release "$target" || {
    printf 'UPGRADE GitHub has no release v%s\n' "$target" >&2
    return 1
  }

  set_pin_sites "$target" || {
    printf 'UPGRADE failed to rewrite pin sites; restoring\n' >&2
    restore_pin_sites
    return 1
  }
  apply_pin_files_live || {
    printf 'UPGRADE failed to apply pin files; restoring\n' >&2
    restore_pin_sites
    return 1
  }
  OMP_BASELINE_SKIP_VALIDATE=1
  if ! apply_local; then
    printf 'UPGRADE apply/install failed; restoring pin %s\n' "$pin" >&2
    restore_pin_sites
    apply_pin_files_live || true
    mise install "github:can1357/oh-my-pi@$pin" || true
    mise reshim || true
    return 1
  fi
  if [ "$(omp --version 2>/dev/null || true)" != "omp/$target" ]; then
    printf 'UPGRADE omp/%s not installed; restoring pin %s\n' "$target" "$pin" >&2
    restore_pin_sites
    apply_pin_files_live || true
    mise install "github:can1357/oh-my-pi@$pin" || true
    mise reshim || true
    return 1
  fi
  # Native config probes need the scratch HOME that validate prepares (omp_probe).
  if ! (trap cleanup_probe_home EXIT; probe_home && check_omp_config); then
    printf 'UPGRADE OMP config checks failed; restoring pin %s\n' "$pin" >&2
    restore_pin_sites
    apply_pin_files_live || true
    mise install "github:can1357/oh-my-pi@$pin" || true
    mise reshim || true
    return 1
  fi

  rm -f "$UPSTREAM_MARKER"
  printf 'UPGRADE %s -> %s\n' "$pin" "$target"
  printf 'NEXT    omp-baseline validate --strict, commit the two pin files, then decent-angl-sync reconcile\n'
  printf 'NEXT    other hosts converge through their own 15-minute guard. This process stays on the old binary until a new session.\n'
}

install_guard() {
  local os plist unit_dir
  os="$HOST_OS"
  mkdir -p "$STATE_DIR"
  case "$os" in
    Darwin)
      # decent-angl-launchd installs it as a LaunchAgent or, on a server, a LaunchDaemon.
      plist="$STATE_DIR/gg.angl.omp-baseline.plist"
      cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>gg.angl.omp-baseline</string>
  <key>ProgramArguments</key><array><string>$HOME/.local/bin/omp-baseline</string><string>guard</string></array>
  <key>UserName</key><string>$(id -un)</string>
  <key>WorkingDirectory</key><string>$HOME</string>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>$HOME</string>
    <key>PATH</key><string>$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict></plist>
EOF
      "$HOME/.local/bin/decent-angl-launchd" install "$plist" || return 1
      ;;
    Linux)
      unit_dir="$HOME/.config/systemd/user"
      mkdir -p "$unit_dir"
      cat >"$unit_dir/omp-baseline-guard.service" <<'EOF'
[Unit]
Description=Validate and reconcile the shared OMP baseline
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=%h/.local/bin/omp-baseline guard
EOF
      cat >"$unit_dir/omp-baseline-guard.timer" <<'EOF'
[Unit]
Description=Hourly OMP baseline drift guard

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF
      systemctl --user daemon-reload
      systemctl --user enable --now omp-baseline-guard.timer >/dev/null
      ;;
  esac
  printf 'GUARD   installed for %s\n' "$os"
}

guard() {
  local current_machine status output
  mkdir -p "$STATE_DIR"
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    printf 'GUARD   another run is active\n'
    return 0
  fi
  trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
  current_machine="$(machine_id)"

  if output="$(validate 2>&1)"; then status=0; else status=$?; fi

  printf '%s %s\n%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$current_machine" "$output" >>"$LOG_FILE"
  if [ "$status" -eq 0 ]; then
    rm -f "$MARKER"
    logger -t omp-baseline "OMP baseline guard passed on $current_machine" >/dev/null 2>&1 || true
  else
    printf '%s\n' "$output" >"$MARKER"
    logger -t omp-baseline -p user.err "OMP baseline drift on $current_machine; see $MARKER" >/dev/null 2>&1 || true
  fi
  check_upstream >>"$LOG_FILE" 2>&1 || true
  if [ -s "$UPSTREAM_MARKER" ]; then
    logger -t omp-baseline "OMP upstream available; see $UPSTREAM_MARKER" >/dev/null 2>&1 || true
  fi
  return "$status"
}
fleet_probe() {
  local git_rev omp_ver gh_ver pin val provider
  git_rev="$(git -C "$HOME/src/boilerplate" rev-parse --short HEAD 2>/dev/null || printf missing)"
  omp_ver="$(omp --version 2>/dev/null || printf missing)"
  omp_ver="${omp_ver#omp/}"
  gh_ver="$(gh --version 2>/dev/null | awk 'NR==1 { print $3 }')"
  [ -n "$gh_ver" ] || gh_ver=missing
  pin="$(sed -n 's/^# omp-version[[:space:]]*//p' "$HOME/.config/decent-angl/omp-baseline-manifest.tsv" | awk 'NR==1 { print; exit }')"
  [ -n "$pin" ] || pin=missing
  if omp-baseline validate --strict >/dev/null 2>&1; then val=ok; else val=fail; fi
  provider="$(omp auth-broker list --json 2>/dev/null |
    jq -r 'map(select(.id == "openai-codex"))[0].id // "missing"' 2>/dev/null || printf missing)"
  printf '%s %s %s %s %s %s\n' "$git_rev" "$omp_ver" "$gh_ver" "$pin" "$val" "$provider"
}

fleet() {
  local host self line rc=0
  case "$(machine_id)" in
    omarchy) self=t14 ;;
    *) self="$(machine_id)" ;;
  esac
  printf '%-8s %-8s %-8s %-8s %-8s %-8s %s\n' HOST GIT OMP GH PIN VALIDATE PROVIDER
  for host in t14 macbook macmini; do
    if [ "$host" = "$self" ]; then
      if line="$(fleet_probe)"; then
        :
      else
        line="error error error error fail no"
        rc=1
      fi
    elif line="$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$host" 'omp-baseline fleet-probe' 2>/dev/null)"; then
      :
    else
      line="unreachable - - - fail no"
      rc=1
    fi
    printf '%-8s %-8s %-8s %-8s %-8s %-8s %s\n' "$host" $line
    case "$line" in
      *fail*|unreachable*) rc=1 ;;
    esac
  done
  return "$rc"
}

main() {
  local command="${1:-status}"
  [ "$#" -gt 0 ] && shift
  case "$command" in
    check-source)
      [ "$#" -eq 1 ] && [ -n "$1" ] || { printf 'Usage: omp-baseline check-source ROOT\n' >&2; return 2; }
      check_source "$1"
      return
      ;;
    check-upstream)
      check_upstream
      return
      ;;
    upgrade)
      upgrade "$@"
      return
      ;;
  esac
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --strict) STRICT=true ;;
      -h|--help) usage; return 0 ;;
      *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; return 1 ;;
    esac
    shift
  done

  case "$command" in
    status) check_manifest_status ;;
    validate) validate ;;
    repair) repair ;;
    apply) apply_local ;;
    pull) pull_published ;;
    guard) guard ;;
    install-guard) install_guard ;;
    fleet) fleet ;;
    fleet-probe) fleet_probe ;;
    -h|--help) usage ;;
    *) printf 'Unknown command: %s\n' "$command" >&2; usage >&2; return 1 ;;
  esac
}

main "$@"
