#!/bin/sh
set -eu

# OMP's headless launcher strips Puppeteer's --disable-extensions (bundled
# with --enable-automation in the stealth ignore list). Combined with Omarchy
# unpacked extensions persisted in the shared profile, Chromium 151 renderers
# abort while installing extensions::SafeBuiltins (v8_initializer Empty
# MaybeLocal). Force the extensions flags back on and never go through
# /usr/bin/chromium (that wrapper injects chromium-flags.conf --load-extension).

BIN="${OMP_CHROMIUM_BIN:-/usr/lib/chromium/chromium}"
if [ ! -x "$BIN" ]; then
    echo "omp-chromium: missing $BIN" >&2
    exit 127
fi

inject=1
for arg in "$@"; do
    case "$arg" in
        --disable-extensions|--disable-extensions=*)
            inject=0
            break
            ;;
    esac
done

if [ "$inject" -eq 1 ]; then
    exec "$BIN" --disable-extensions --disable-component-extensions-with-background-pages "$@"
fi
exec "$BIN" "$@"
