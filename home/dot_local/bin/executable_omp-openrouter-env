#!/bin/sh
set -eu

# Inject Bitwarden item omp-openrouter into the machine-local OMP env file.
# Never prints the key. Re-run after rotating the vault item.

ITEM_NAME="${OPENROUTER_BW_ITEM:-omp-openrouter}"
ENV_FILE="${OMP_OPENROUTER_ENV:-$HOME/.omp/agent/.env}"
KEY_NAME="OPENROUTER_API_KEY"

BW_BIN=""
for candidate in \
    "${BW_BIN:-}" \
    "$HOME/.local/share/mise/shims/bw" \
    "$HOME/.local/bin/bw" \
    "/opt/homebrew/bin/bw" \
    "/usr/local/bin/bw"
do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        BW_BIN="$candidate"
        break
    fi
done

if [ -z "$BW_BIN" ] && command -v bw >/dev/null 2>&1; then
    BW_BIN="$(command -v bw)"
fi

if [ -z "$BW_BIN" ]; then
    echo "bw CLI not found." >&2
    exit 1
fi

status="$("$BW_BIN" status 2>/dev/null | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')"
status="$(printf '%s\n' "$status" | sed -n '1p')"
status="${status:-unknown}"
case "$status" in
    unlocked)
        ;;
    unauthenticated)
        echo "bw is unauthenticated; run 'bw login' first." >&2
        exit 1
        ;;
    locked)
        echo "bw is locked; run 'export BW_SESSION=\$(bw unlock --raw)' first." >&2
        exit 1
        ;;
    *)
        echo "Unable to determine bw status." >&2
        exit 1
        ;;
esac

password="$("$BW_BIN" get password "$ITEM_NAME" 2>/dev/null || true)"
if [ -z "$password" ]; then
    echo "Vaultwarden item '$ITEM_NAME' was not found." >&2
    exit 1
fi

install -d -m 700 "$(dirname "$ENV_FILE")"
tmp="$(mktemp "${ENV_FILE}.XXXXXX")"
cleanup() {
    rm -f "$tmp"
}
trap cleanup EXIT HUP INT TERM

umask 077
if [ -f "$ENV_FILE" ]; then
    awk -F= -v key="$KEY_NAME" '$1 != key { print }' "$ENV_FILE" >"$tmp"
else
    : >"$tmp"
fi
printf '%s=%s\n' "$KEY_NAME" "$password" >>"$tmp"
chmod 600 "$tmp"
mv "$tmp" "$ENV_FILE"
trap - EXIT HUP INT TERM

echo "injected:$KEY_NAME:$ENV_FILE"
