#!/usr/bin/env python3
"""op-secret: machine secrets from 1Password, read with a service account.

Usage:
  op-secret status
  op-secret field ITEM FIELD
  op-secret write-env ITEM FIELD ENV_KEY FILE
  op-secret exec ITEM FIELD ENV_KEY -- COMMAND [ARG...]
  op-secret ref ITEM FIELD
  op-secret add [--scope general|backup] [--replace] [--url URL] ITEM FIELD[=SOURCE]...
  op-secret enroll HOST --scope general [--scope backup] [--ssh DEST]

FIELD is username, password, notes or custom:NAME. An add SOURCE is omitted
(hidden prompt), @PATH (file), env:NAME (environment variable) or - (stdin).

Reads use only the read-only service account token in the owner-only (0600)
file OP_SECRET_ENV (default ~/.local/share/decent-angl/secrets/op-machine.env);
an OP_SERVICE_ACCOUNT_TOKEN in the environment is ignored. Never the 1Password app,
Touch ID or a human session. OP_SECRET_VAULTS (comma list) narrows the vaults
searched. `field` prints the value for trusted command substitution only;
write-env writes FILE atomically with mode 0600; exec puts the value only in
COMMAND's environment.

add and enroll are the only commands that need a human 1Password session.
They prompt for the account password in this terminal and sign out after.
Scopes: general = "Machine Secrets" (every enrolled host),
backup = "Machine Secrets - Backup" (backup hosts only).
"""
import getpass
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path.home()
SCOPES = {"general": "Machine Secrets", "backup": "Machine Secrets - Backup"}
DEFAULT_ENV_FILE = HOME / ".local/share/decent-angl/secrets/op-machine.env"
TOKEN_REL = ".local/share/decent-angl/secrets/op-machine.env"
SA_PREFIX = "machine-secrets-"
OP_ADDRESS = os.environ.get("OP_SECRET_ADDRESS", "my.1password.com")
ENV_KEY_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
LABEL_RE = re.compile(r"[A-Za-z0-9 ._-]+\Z")
HOST_RE = re.compile(r"[a-z0-9][a-z0-9-]*\Z")
PROG = "op-secret"


def die(msg, code=1):
    sys.stderr.write("%s: %s\n" % (PROG, msg))
    raise SystemExit(code)


def find_op():
    for candidate in (
        os.environ.get("OP_BIN", ""),
        "/usr/bin/op",
        "/opt/homebrew/bin/op",
        "/usr/local/bin/op",
        str(HOME / ".local/bin/op"),
    ):
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    die("1Password CLI (op) not found.", 127)


def last_line(text, rc):
    lines = (text or "").strip().splitlines()
    return lines[-1] if lines else "rc=%d" % rc


def run_op(args, env, input_text="", check=True):
    # stderr from op names objects, never values.
    proc = subprocess.run([find_op()] + args, env=env, input=input_text,
                          capture_output=True, text=True)
    if check and proc.returncode != 0:
        die("op %s failed: %s" % (" ".join(args[:2]), last_line(proc.stderr, proc.returncode)))
    return proc


def op_json(args, env):
    out = run_op(args + ["--format", "json"], env).stdout
    try:
        return json.loads(out or "null")
    except ValueError:
        die("op %s returned non-JSON." % " ".join(args[:2]))


def clean_env():
    env = os.environ.copy()
    # Never route op to the desktop app (Touch ID) or Connect.
    for key in list(env):
        if key.startswith("OP_SESSION") or key in (
                "OP_ACCOUNT", "OP_CONNECT_HOST", "OP_CONNECT_TOKEN", "OP_SERVICE_ACCOUNT_TOKEN"):
            del env[key]
    env["OP_BIOMETRIC_UNLOCK_ENABLED"] = "false"
    return env


# ---- service-account reads -------------------------------------------------

def env_file():
    return Path(os.environ.get("OP_SECRET_ENV") or DEFAULT_ENV_FILE)


def token_from_file(path):
    """The token from an owner-only env file, or "" if the file is absent."""
    if not path.is_file():
        return ""
    st = path.stat()
    if st.st_uid != os.geteuid() or st.st_mode & 0o077:
        die("%s must be owned by this user with mode 0600; refusing to use it." % path)
    for line in path.read_text().splitlines():
        key, sep, value = line.partition("=")
        if sep and key.strip() == "OP_SERVICE_ACCOUNT_TOKEN":
            return value.strip().strip("'\"")
    return ""


def load_token():
    path = env_file()
    token = token_from_file(path)
    if token:
        return token
    if not path.is_file():
        die("missing %s; enroll this host (see the machine-secrets skill)." % path)
    die("%s has no OP_SERVICE_ACCOUNT_TOKEN." % path)


def sa_env(token=None):
    env = clean_env()
    env["OP_SERVICE_ACCOUNT_TOKEN"] = token or load_token()
    return env


def vault_filter():
    raw = os.environ.get("OP_SECRET_VAULTS", "")
    return [v.strip() for v in raw.split(",") if v.strip()]


def field_label(field):
    if field in ("username", "password"):
        label = field
    elif field == "notes":
        label = "notesPlain"
    elif field.startswith("custom:") and len(field) > len("custom:"):
        label = field[len("custom:"):]
    else:
        die("unsupported field '%s' (username, password, notes, custom:NAME)." % field, 2)
    if not LABEL_RE.match(label):
        die("unsupported characters in field '%s'." % field, 2)
    return label


def find_item(item, env):
    wanted = vault_filter()
    args = ["item", "list"]
    if len(wanted) == 1:
        args += ["--vault", wanted[0]]
    hits = [i for i in op_json(args, env) or []
            if i.get("title") == item and (not wanted or i["vault"]["name"] in wanted)]
    if not hits:
        die("item '%s' not found in the vaults this service account can read." % item)
    if len(hits) > 1:
        die("item '%s' is ambiguous across vaults: %s." % (
            item, ", ".join(sorted(h["vault"]["name"] for h in hits))))
    return hits[0]


def read_field(item, field, env=None):
    label = field_label(field)
    env = env or sa_env()
    hit = find_item(item, env)
    ref = "op://%s/%s/%s" % (hit["vault"]["id"], hit["id"], label)
    proc = run_op(["read", "--no-newline", ref], env, check=False)
    if proc.returncode != 0:
        die("cannot read %s %s from vault '%s': %s" % (
            item, field, hit["vault"]["name"], last_line(proc.stderr, proc.returncode)))
    if proc.stdout == "":
        die("field '%s' is empty on '%s'." % (field, item))
    return proc.stdout


def check_env_key(key):
    if not ENV_KEY_RE.match(key):
        die("invalid environment key '%s'." % key, 2)


def write_private(path, content, mode=0o600):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w") as fh:
            fh.write(content)
        os.replace(tmp, str(path))
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def cmd_write_env(item, field, key, path):
    check_env_key(key)
    value = read_field(item, field)
    if "\n" in value:
        die("multiline values cannot be written to env files; use exec.", 2)
    target = Path(path)
    kept = []
    if target.is_file():
        kept = [l for l in target.read_text().splitlines() if l.partition("=")[0] != key]
    escaped = value.replace("'", "'\\''")
    write_private(target, "".join(l + "\n" for l in kept) + "%s='%s'\n" % (key, escaped))
    print("materialized:%s:%s" % (key, target))


def cmd_status():
    print("backend=1password")
    print("token_source=%s" % env_file())
    token = token_from_file(env_file())
    if not token:
        print("status=no-token")
        return 1
    proc = run_op(["vault", "list", "--format", "json"], sa_env(token), check=False)
    if proc.returncode != 0:
        print("status=error")
        sys.stderr.write("%s: op vault list failed: %s\n" % (PROG, last_line(proc.stderr, proc.returncode)))
        return 1
    names = sorted(v["name"] for v in json.loads(proc.stdout or "[]"))
    wanted = vault_filter()
    for name in names:
        if not wanted or name in wanted:
            print("vault=%s" % name)
    missing = [w for w in wanted if w not in names]
    if missing or not names:
        print("status=error")
        return 1
    print("status=ok")
    return 0


def cmd_ref(item, field):
    label = field_label(field)
    hit = find_item(item, sa_env())
    print("op://%s/%s/%s" % (hit["vault"]["name"], hit["title"], label))


# ---- human session (add, enroll) -------------------------------------------

class Human:
    """A human 1Password session for writes; signed out on close."""

    def __init__(self):
        self.env = clean_env()
        self.account = None
        inherited = {k: v for k, v in os.environ.items() if k.startswith("OP_SESSION_")}
        if inherited:
            self.env.update(inherited)
            if os.environ.get("OP_ACCOUNT"):
                self.env["OP_ACCOUNT"] = os.environ["OP_ACCOUNT"]
            if self.is_human():
                return
            for key in inherited:
                del self.env[key]
        # The controlling terminal, not stdin: `add ITEM FIELD=-` has already read stdin.
        try:
            tty = open("/dev/tty")
        except OSError:
            die("adding or enrolling needs a terminal for the 1Password sign-in.")
        accounts = op_json(["account", "list"], self.env) or []
        wanted = os.environ.get("OP_SECRET_ACCOUNT", "")
        if wanted:
            cmd = ["signin", "--account", wanted]
            self.account = wanted
        elif len(accounts) == 1:
            self.account = accounts[0].get("shorthand") or accounts[0]["user_uuid"]
            cmd = ["signin", "--account", self.account]
        elif not accounts:
            cmd = ["account", "add", "--address", OP_ADDRESS, "--signin"]
        else:
            die("several 1Password accounts are configured; set OP_SECRET_ACCOUNT.")
        sys.stderr.write("%s: 1Password sign-in (account password; no app, no Touch ID)\n" % PROG)
        # Prompts go to the terminal; stdout carries only `export OP_SESSION_...`.
        with tty:
            proc = subprocess.run([find_op()] + cmd, env=self.env, stdin=tty, stdout=subprocess.PIPE, text=True)
        found = re.findall(r'export (OP_SESSION_\w+)="([^"]+)"', proc.stdout or "")
        if not found:
            die("1Password sign-in failed.")
        for key, value in found:
            self.env[key] = value
        if self.account is None:
            self.account = found[0][0][len("OP_SESSION_"):]
        self.env["OP_ACCOUNT"] = self.account
        self.signed_in = True
        if proc.returncode != 0 or not self.is_human():
            self.close()
            die("sign-in did not produce a human session.")

    signed_in = False

    def is_human(self):
        proc = run_op(["whoami", "--format", "json"], self.env, check=False)
        try:
            return proc.returncode == 0 and json.loads(proc.stdout).get("user_type") != "SERVICE_ACCOUNT"
        except ValueError:
            return False

    def close(self):
        if not self.signed_in:
            return
        self.signed_in = False
        proc = run_op(["signout", "--account", self.account], self.env, check=False)
        if proc.returncode == 0:
            sys.stderr.write("%s: 1Password human session signed out\n" % PROG)
        else:
            sys.stderr.write("%s: WARNING: signout failed (%s); run: op signout --account %s\n" % (
                PROG, last_line(proc.stderr, proc.returncode), self.account))


def scope_vault(scope):
    if scope not in SCOPES:
        die("unknown scope '%s' (%s)." % (scope, ", ".join(SCOPES)), 2)
    return SCOPES[scope]


def read_source(field, source, stdin_used):
    if source is None:
        value = getpass.getpass("%s %s (hidden): " % (PROG, field))
    elif source == "-":
        if stdin_used[0]:
            die("only one field may read stdin.", 2)
        stdin_used[0] = True
        value = sys.stdin.read()
    elif source.startswith("@"):
        value = Path(source[1:]).expanduser().read_text()
    elif source.startswith("env:"):
        value = os.environ.get(source[4:], "")
    else:
        die("field source must be omitted, @PATH, env:NAME or - (got '%s')." % field, 2)
    if field != "notes":
        value = value.rstrip("\r\n")
    if value == "":
        die("empty value for %s." % field)
    return value


FIELD_SPECS = {
    "username": {"id": "username", "type": "STRING", "purpose": "USERNAME", "label": "username"},
    "password": {"id": "password", "type": "CONCEALED", "purpose": "PASSWORD", "label": "password"},
    "notes": {"id": "notesPlain", "type": "STRING", "purpose": "NOTES", "label": "notesPlain"},
}


def template_field(field, value):
    if field in FIELD_SPECS:
        spec = dict(FIELD_SPECS[field])
    else:
        label = field_label(field)
        spec = {"id": label, "type": "CONCEALED", "label": label}
    spec["value"] = value
    return spec


def same_field(existing, field):
    if field in FIELD_SPECS:
        spec = FIELD_SPECS[field]
        return existing.get("purpose") == spec["purpose"] or (
            not existing.get("purpose") and existing.get("label") == spec["label"])
    return existing.get("label") == field_label(field) and not existing.get("purpose")


def store_item(human, vault, item, values, replace=False, url=None, tags=("op-secret",)):
    """Create ITEM in VAULT, or with replace=True update only the given fields.

    Item names are unique across all scope vaults, so reads never see two."""
    for other in SCOPES.values():
        if other == vault:
            continue
        proc = run_op(["item", "list", "--vault", other, "--format", "json"], human.env, check=False)
        if proc.returncode == 0 and any(i.get("title") == item for i in json.loads(proc.stdout or "[]")):
            die("item '%s' already lives in '%s'; use that scope or remove it there first." % (item, other))
    listed = op_json(["item", "list", "--vault", vault], human.env) or []
    hits = [i for i in listed if i.get("title") == item]
    if len(hits) > 1:
        die("item '%s' appears %d times in '%s'; fix that first." % (item, len(hits), vault))
    if hits and not replace:
        die("item '%s' already exists in '%s'; pass --replace to update it." % (item, vault))
    if hits:
        current = op_json(["item", "get", hits[0]["id"], "--vault", vault], human.env)
        fields = current.get("fields") or []
        for field, value in values:
            match = [f for f in fields if same_field(f, field)]
            if len(match) > 1:
                die("item '%s' has several '%s' fields." % (item, field))
            if match:
                match[0]["value"] = value
            else:
                fields.append(template_field(field, value))
        current["fields"] = fields
        if url:
            current["urls"] = [{"href": url, "primary": True}]
        run_op(["item", "edit", hits[0]["id"], "--vault", vault], human.env, input_text=json.dumps(current))
        return "updated"
    login = any(f in ("username", "password") for f, _ in values)
    tmpl = {
        "title": item,
        "category": "LOGIN" if login else "SECURE_NOTE",
        "fields": [template_field(f, v) for f, v in values],
        "tags": list(tags),
    }
    if url:
        tmpl["urls"] = [{"href": url, "primary": True}]
    run_op(["item", "create", "-", "--vault", vault], human.env, input_text=json.dumps(tmpl))
    return "created"


def verify_with_service_account(item, vault, values):
    """Read back through this host's service account; never prints values."""
    token = token_from_file(env_file())
    if not token:
        return "unverified: this host has no service account token"
    env = sa_env(token)
    visible = {v["name"] for v in op_json(["vault", "list"], env) or []}
    if vault not in visible:
        return "unverified here: this host's service account cannot read '%s' (by design)" % vault
    for field, want in values:
        got = read_field(item, field, env)
        if got.replace("\r\n", "\n").rstrip("\n") != want.replace("\r\n", "\n").rstrip("\n"):
            die("service-account read of %s %s does not match what was stored." % (item, field))
    return "verified via service account"


def parse_field_args(raw):
    out = []
    for arg in raw:
        field, sep, source = arg.partition("=")
        field_label(field)
        out.append((field, source if sep else None))
    if not out:
        die("add needs at least one FIELD.", 2)
    if len({f for f, _ in out}) != len(out):
        die("a field is repeated.", 2)
    return out


def cmd_add(argv):
    scope, replace, url, rest = "general", False, None, []
    it = iter(argv)
    for arg in it:
        if arg == "--scope":
            scope = next(it, "")
        elif arg == "--replace":
            replace = True
        elif arg == "--url":
            url = next(it, "")
        else:
            rest.append(arg)
    if len(rest) < 2:
        die("usage: op-secret add [--scope general|backup] [--replace] [--url URL] ITEM FIELD[=SOURCE]...", 2)
    item, specs = rest[0], parse_field_args(rest[1:])
    if not LABEL_RE.match(item):
        die("item names use letters, digits, space, '.', '_' or '-'.", 2)
    vault = scope_vault(scope)
    stdin_used = [False]
    values = [(f, read_source(f, s, stdin_used)) for f, s in specs]
    human = Human()
    try:
        if run_op(["vault", "get", vault], human.env, check=False).returncode != 0:
            die("vault '%s' does not exist; enroll a host first (machine-secrets skill)." % vault)
        action = store_item(human, vault, item, values, replace=replace, url=url)
    finally:
        human.close()
    print("%s:%s vault=%s fields=%s" % (action, item, vault, ",".join(f for f, _ in values)))
    print(verify_with_service_account(item, vault, values))
    return 0


def ensure_vault(human, vault):
    if run_op(["vault", "get", vault], human.env, check=False).returncode == 0:
        return False
    run_op(["vault", "create", vault, "--description",
            "Machine secrets read by op-secret through read-only %s* service accounts. "
            "Add items with `op-secret add`." % SA_PREFIX], human.env)
    return True


def remote(dest, script, input_text=""):
    return subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=30", dest, script],
                          input=input_text, capture_output=True, text=True)


def visible_vaults(host_token=None, ssh=None):
    """Vault names this host's service account sees, or None if it has no working token."""
    if ssh:
        proc = remote(ssh, '"$HOME/.local/bin/op-secret" status')
        names = [l[len("vault="):] for l in proc.stdout.splitlines() if l.startswith("vault=")]
        return set(names) if proc.returncode == 0 else None
    if not host_token:
        return None
    proc = run_op(["vault", "list", "--format", "json"], sa_env(host_token), check=False)
    return {v["name"] for v in json.loads(proc.stdout)} if proc.returncode == 0 else None


def backup_token(human, name, token, vaults):
    item = {
        "title": "Service account token: %s" % name,
        "category": "API_CREDENTIAL",
        "fields": [
            {"id": "credential", "type": "CONCEALED", "label": "credential", "value": token},
            {"id": "notesPlain", "type": "STRING", "purpose": "NOTES", "label": "notesPlain",
             "value": "OP_SERVICE_ACCOUNT_TOKEN for op-secret; read_items on: %s. Installed at ~/%s "
                      "(0600). Reinstall from here after a host rebuild." % (", ".join(vaults), TOKEN_REL)},
        ],
    }
    for personal in ("Personal", "Private"):
        if run_op(["item", "create", "-", "--vault", personal], human.env,
                  input_text=json.dumps(item), check=False).returncode == 0:
            return personal
    return None


def enroll(human, host, scopes, ssh=None):
    """Create (or reuse) the read-only service account for HOST and install its token."""
    if not HOST_RE.match(host):
        die("host names are lowercase letters, digits and '-'.", 2)
    vaults = sorted({scope_vault(s) for s in scopes})
    for vault in vaults:
        if ensure_vault(human, vault):
            print("created vault '%s'" % vault)
    local_token = None if ssh else token_from_file(DEFAULT_ENV_FILE)
    if visible_vaults(local_token, ssh) == set(vaults):
        print("%s: existing service account token already reads exactly %s" % (host, ", ".join(vaults)))
        return
    name = SA_PREFIX + host
    grants = []
    for vault in vaults:
        grants += ["--vault", vault + ":read_items"]
    proc = run_op(["service-account", "create", name] + grants + ["--raw"], human.env, check=False)
    if proc.returncode != 0:
        name = "%s-%s" % (name, time.strftime("%Y%m%d%H%M"))
        proc = run_op(["service-account", "create", name] + grants + ["--raw"], human.env)
    token = proc.stdout.strip()
    if not token.startswith("ops_"):
        die("service-account create returned no token.")
    content = "OP_SERVICE_ACCOUNT_TOKEN=%s\n" % token
    if ssh:
        script = ('umask 077; f="$HOME/%s"; mkdir -p "$(dirname "$f")" && chmod 700 "$(dirname "$f")" && '
                  'cat > "$f.tmp" && chmod 600 "$f.tmp" && mv "$f.tmp" "$f"') % TOKEN_REL
        if remote(ssh, script, content).returncode != 0:
            die("could not install the token on %s." % ssh)
    else:
        write_private(DEFAULT_ENV_FILE, content)
    saved = backup_token(human, name, token, vaults)
    print("created service account '%s' (read_items: %s); token installed on %s; backup copy %s" % (
        name, ", ".join(vaults), ssh or "this host",
        "in vault '%s'" % saved if saved else "NOT saved (save it in 1Password by hand)"))
    seen = visible_vaults(None if ssh else token, ssh)
    if seen != set(vaults):
        die("%s's service account sees %s, expected %s." % (host, sorted(seen or []), vaults))


def cmd_enroll(argv):
    host, scopes, ssh = None, [], None
    it = iter(argv)
    for arg in it:
        if arg == "--scope":
            scopes.append(next(it, ""))
        elif arg == "--ssh":
            ssh = next(it, "")
        elif host is None:
            host = arg
        else:
            die("unexpected argument '%s'." % arg, 2)
    if not host or not scopes:
        die("usage: op-secret enroll HOST --scope general [--scope backup] [--ssh DEST]", 2)
    human = Human()
    try:
        enroll(human, host, scopes, ssh)
    finally:
        human.close()
    return 0


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "status" and len(argv) == 1:
        return cmd_status()
    if cmd == "field" and len(argv) == 3:
        sys.stdout.write(read_field(argv[1], argv[2]))
        return 0
    if cmd == "ref" and len(argv) == 3:
        cmd_ref(argv[1], argv[2])
        return 0
    if cmd == "write-env" and len(argv) == 5:
        cmd_write_env(*argv[1:])
        return 0
    if cmd == "exec" and len(argv) >= 6 and argv[4] == "--":
        check_env_key(argv[3])
        env = os.environ.copy()
        env[argv[3]] = read_field(argv[1], argv[2])
        os.execvpe(argv[5], argv[5:], env)
    if cmd == "add":
        return cmd_add(argv[1:])
    if cmd == "enroll":
        return cmd_enroll(argv[1:])
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    sys.stderr.write(__doc__.strip() + "\n")
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
