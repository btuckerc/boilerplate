#!/bin/sh
set -eu

# Store or materialize the fleet SSH key for agent@10.77.77.1.
# Never prints key material.

find_bin() {
    for candidate in "$@"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

usage() {
    cat <<'EOF'
Usage: opnsense-agent-key [sync|status|store --from KEYFILE]

  sync              Write ~/.ssh/opnsense_agent from Bitwarden (default)
  status            Local key mode and public fingerprint only
  store --from KEY  Create or replace vault item opnsense-agent-ssh

Private key stays in item notes. Public key is custom field "public".
bw must already be unlocked.
EOF
}

CONFIG_FILE="${OPNSENSE_CONFIG_FILE:-$HOME/.config/decent-angl/opnsense.env}"
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi

ITEM_NAME="${OPNSENSE_SSH_BW_ITEM:-opnsense-agent-ssh}"
KEY_FILE="${OPNSENSE_SSH_KEY_FILE:-$HOME/.ssh/opnsense_agent}"
PUB_FILE="${KEY_FILE}.pub"
SSH_USER="${OPNSENSE_SSH_USER:-agent}"

command_name="${1:-sync}"
FROM_FILE=""
if [ "$#" -gt 0 ]; then
    shift
fi
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help|help)
            usage
            exit 0
            ;;
        --from)
            FROM_FILE="${2:-}"
            if [ -z "$FROM_FILE" ]; then
                echo "--from requires a file path." >&2
                exit 1
            fi
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

BW_BIN="$(find_bin \
    "${BW_BIN:-}" \
    "$HOME/.local/share/mise/shims/bw" \
    "$HOME/.local/bin/bw" \
    /opt/homebrew/bin/bw \
    /usr/local/bin/bw \
    "$(command -v bw 2>/dev/null || true)")"

require_tools() {
    if [ -z "${BW_BIN:-}" ]; then
        echo "bw CLI not found." >&2
        exit 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        echo "python3 is required." >&2
        exit 1
    fi
    if ! command -v ssh-keygen >/dev/null 2>&1; then
        echo "ssh-keygen is required." >&2
        exit 1
    fi
}

bw_status() {
    "$BW_BIN" status 2>/dev/null | sed -n 's/.*"status":"\([^"]*\)".*/\1/p' | sed -n '1p'
}

require_unlocked() {
    status="$(bw_status)"
    status="${status:-unknown}"
    case "$status" in
        unlocked) ;;
        locked)
            echo "bw is locked; run 'export BW_SESSION=\$(bw unlock --raw)' first." >&2
            exit 1
            ;;
        unauthenticated)
            echo "bw is unauthenticated; run 'bw login' first." >&2
            exit 1
            ;;
        *)
            echo "Unable to determine bw status." >&2
            exit 1
            ;;
    esac
}

bw_sync() {
    attempt=1
    max=4
    while [ "$attempt" -le "$max" ]; do
        if "$BW_BIN" sync >/dev/null 2>/dev/null; then
            return 0
        fi
        if [ "$attempt" -eq "$max" ]; then
            echo "bw sync failed after $max attempts. vault.weavedweb.com unreachable; retry later." >&2
            exit 1
        fi
        echo "bw sync failed (attempt $attempt/$max); retrying..." >&2
        sleep $((attempt * 15))
        attempt=$((attempt + 1))
    done
}


cmd_status() {
    if [ -f "$KEY_FILE" ]; then
        mode="-"
        if stat -c '%a' "$KEY_FILE" >/dev/null 2>&1; then
            mode="$(stat -c '%a' "$KEY_FILE")"
        else
            mode="$(stat -f '%Lp' "$KEY_FILE")"
        fi
        printf 'key_file=%s\n' "$KEY_FILE"
        printf 'key_exists=true\n'
        printf 'key_mode=%s\n' "$mode"
        if [ -f "$PUB_FILE" ]; then
            printf 'pub_exists=true\n'
            ssh-keygen -l -f "$PUB_FILE"
        else
            printf 'pub_exists=false\n'
        fi
    else
        printf 'key_file=%s\n' "$KEY_FILE"
        printf 'key_exists=false\n'
    fi
    printf 'vault_item=%s\n' "$ITEM_NAME"
    printf 'ssh_user=%s\n' "$SSH_USER"
}

cmd_store() {
    require_tools
    require_unlocked
    if [ -z "$FROM_FILE" ]; then
        echo "store requires --from KEYFILE." >&2
        exit 1
    fi
    if [ ! -f "$FROM_FILE" ]; then
        echo "File not found: $FROM_FILE" >&2
        exit 1
    fi
    pub_src="${FROM_FILE}.pub"
    if [ ! -f "$pub_src" ]; then
        echo "Public key not found: $pub_src" >&2
        exit 1
    fi
    ssh-keygen -y -f "$FROM_FILE" >/dev/null

    export ITEM_NAME

    EXISTING="$("$BW_BIN" list items --search "$ITEM_NAME" | python3 -c '
import json, os, sys
name = os.environ["ITEM_NAME"]
items = json.load(sys.stdin)
hit = next((i for i in items if i.get("name") == name), None)
print(hit["id"] if hit else "")
')"

    PAYLOAD="$(ITEM_NAME="$ITEM_NAME" SSH_USER="$SSH_USER" KEY_FILE="$FROM_FILE" PUB_FILE="$pub_src" python3 -c '
import json, os, base64
priv = open(os.environ["KEY_FILE"], encoding="utf-8").read()
pub = open(os.environ["PUB_FILE"], encoding="utf-8").read().strip()
obj = {
    "type": 1,
    "name": os.environ["ITEM_NAME"],
    "notes": priv,
    "favorite": False,
    "reprompt": 0,
    "login": {
        "username": os.environ["SSH_USER"],
        "password": "",
        "uris": [{"uri": "ssh://10.77.77.1"}],
    },
    "fields": [
        {"name": "public", "type": 1, "value": pub},
    ],
}
print(base64.b64encode(json.dumps(obj).encode()).decode())
')"

    export ITEM_NAME
    if [ -n "$EXISTING" ]; then
        echo "Updating existing item $ITEM_NAME"
        "$BW_BIN" edit item "$EXISTING" "$PAYLOAD" >/dev/null
    else
        echo "Creating item $ITEM_NAME"
        "$BW_BIN" create item "$PAYLOAD" >/dev/null
    fi
    unset PAYLOAD
    bw_sync
    echo "stored:$ITEM_NAME"
}

cmd_sync() {
    require_tools
    require_unlocked
    bw_sync
    export ITEM_NAME
    existing="$(ITEM_NAME="$ITEM_NAME" "$BW_BIN" list items --search "$ITEM_NAME" | python3 -c '
import json, os, sys
name = os.environ["ITEM_NAME"]
try:
    items = json.load(sys.stdin)
except json.JSONDecodeError:
    sys.stderr.write("bw list items returned non-JSON.\n")
    sys.exit(1)
hit = next((i for i in items if i.get("name") == name), None)
print(hit["id"] if hit else "")
')"
    if [ -z "$existing" ]; then
        echo "Vault item $ITEM_NAME not found after bw sync." >&2
        echo "On a machine that already has the private key, run:" >&2
        echo "  opnsense-agent-key store --from ~/.ssh/opnsense_agent" >&2
        echo "Then run opnsense-agent-key here again." >&2
        exit 1
    fi
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    umask 077
    tmp="$(mktemp "$HOME/.ssh/opnsense_agent.XXXXXX")"
    tmp_pub="$(mktemp "$HOME/.ssh/opnsense_agent.pub.XXXXXX")"
    cleanup() {
        rm -f "$tmp" "$tmp_pub"
    }
    trap cleanup EXIT INT TERM
    # Env prefix on a pipeline applies only to the left-hand command.
    "$BW_BIN" get item "$ITEM_NAME" | TMP_PRIV="$tmp" TMP_PUB="$tmp_pub" python3 -c '
import json, os, sys
try:
    item = json.load(sys.stdin)
except json.JSONDecodeError:
    sys.stderr.write("Vault item was not JSON.\n")
    sys.exit(1)
priv = item.get("notes") or ""
pub = ""
for field in item.get("fields") or []:
    if field.get("name") == "public":
        pub = field.get("value") or ""
        break
if "BEGIN OPENSSH PRIVATE KEY" not in priv and "BEGIN " not in priv:
    sys.stderr.write("Vault item is missing a private key in notes.\n")
    sys.exit(1)
if not pub.startswith("ssh-"):
    sys.stderr.write("Vault item is missing custom field public.\n")
    sys.exit(1)
open(os.environ["TMP_PRIV"], "w", encoding="utf-8").write(priv if priv.endswith("\n") else priv + "\n")
open(os.environ["TMP_PUB"], "w", encoding="utf-8").write(pub if pub.endswith("\n") else pub + "\n")
' || {
        echo "Failed to read vault item $ITEM_NAME." >&2
        exit 1
    }
    chmod 600 "$tmp"
    chmod 644 "$tmp_pub"
    ssh-keygen -y -f "$tmp" >/dev/null
    mv "$tmp" "$KEY_FILE"
    mv "$tmp_pub" "$PUB_FILE"
    trap - EXIT INT TERM
    chmod 600 "$KEY_FILE"
    chmod 644 "$PUB_FILE"
    printf 'materialized:%s\n' "$KEY_FILE"
}

case "$command_name" in
    status)
        cmd_status
        ;;
    store)
        cmd_store
        ;;
    sync)
        cmd_sync
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "Unknown subcommand: $command_name" >&2
        usage >&2
        exit 1
        ;;
esac
