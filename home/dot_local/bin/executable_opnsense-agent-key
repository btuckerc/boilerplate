#!/bin/sh
set -eu

# Store or materialize the fleet SSH key for agent@10.77.77.1.
# Never prints key material.

usage() {
    cat <<'EOF'
Usage: opnsense-agent-key [sync|status|store --from KEYFILE]

  sync              Write ~/.ssh/opnsense_agent from 1Password (default)
  status            Local key mode and public fingerprint only
  store --from KEY  Create or replace 1Password item opnsense-agent-ssh

Private key stays in item notes. Public key is custom field "public".
EOF
}

CONFIG_FILE="${OPNSENSE_CONFIG_FILE:-$HOME/.config/decent-angl/opnsense.env}"
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi

ITEM_NAME="${OPNSENSE_SSH_VAULT_ITEM:-opnsense-agent-ssh}"
KEY_FILE="${OPNSENSE_SSH_KEY_FILE:-$HOME/.ssh/opnsense_agent}"
PUB_FILE="${KEY_FILE}.pub"
SSH_USER="${OPNSENSE_SSH_USER:-agent}"
OP_SECRET="${OP_SECRET_BIN:-$HOME/.local/bin/op-secret}"

command_name="${1:-sync}"
FROM_FILE=""
if [ "$#" -gt 0 ]; then
    shift
fi
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help|help)
            usage
            exit 0
            ;;
        --from)
            FROM_FILE="${2:-}"
            if [ -z "$FROM_FILE" ]; then
                echo "--from requires a file path." >&2
                exit 1
            fi
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

require_tools() {
    if [ ! -x "$OP_SECRET" ]; then
        echo "op-secret is unavailable." >&2
        exit 127
    fi
    if ! command -v ssh-keygen >/dev/null 2>&1; then
        echo "ssh-keygen is required." >&2
        exit 1
    fi
}

cmd_status() {
    if [ -f "$KEY_FILE" ]; then
        mode="-"
        if stat -c '%a' "$KEY_FILE" >/dev/null 2>&1; then
            mode="$(stat -c '%a' "$KEY_FILE")"
        else
            mode="$(stat -f '%Lp' "$KEY_FILE")"
        fi
        printf 'key_file=%s\n' "$KEY_FILE"
        printf 'key_exists=true\n'
        printf 'key_mode=%s\n' "$mode"
        if [ -f "$PUB_FILE" ]; then
            printf 'pub_exists=true\n'
            ssh-keygen -l -f "$PUB_FILE"
        else
            printf 'pub_exists=false\n'
        fi
    else
        printf 'key_file=%s\n' "$KEY_FILE"
        printf 'key_exists=false\n'
    fi
    printf 'vault_item=%s\n' "$ITEM_NAME"
    printf 'ssh_user=%s\n' "$SSH_USER"
}

cmd_store() {
    require_tools
    if [ -z "$FROM_FILE" ]; then
        echo "store requires --from KEYFILE." >&2
        exit 1
    fi
    if [ ! -f "$FROM_FILE" ]; then
        echo "File not found: $FROM_FILE" >&2
        exit 1
    fi
    pub_src="${FROM_FILE}.pub"
    if [ ! -f "$pub_src" ]; then
        echo "Public key not found: $pub_src" >&2
        exit 1
    fi
    ssh-keygen -y -f "$FROM_FILE" >/dev/null

    export SSH_USER
    "$OP_SECRET" add --scope general --replace --url ssh://10.77.77.1 \
        "$ITEM_NAME" username=env:SSH_USER "notes=@$FROM_FILE" "custom:public=@$pub_src"
    echo "stored:$ITEM_NAME"
}

cmd_sync() {
    require_tools
    if ! priv="$("$OP_SECRET" field "$ITEM_NAME" notes)"; then
        echo "On a machine that already has the private key, run:" >&2
        echo "  opnsense-agent-key store --from ~/.ssh/opnsense_agent" >&2
        echo "Then run opnsense-agent-key here again." >&2
        exit 1
    fi
    if ! pub="$("$OP_SECRET" field "$ITEM_NAME" custom:public)"; then
        echo "Failed to read 1Password item $ITEM_NAME." >&2
        exit 1
    fi
    case "$priv" in
        *"BEGIN OPENSSH PRIVATE KEY"*|*"BEGIN "*) ;;
        *)
            echo "1Password item is missing a private key in notes." >&2
            exit 1
            ;;
    esac
    case "$pub" in
        ssh-*) ;;
        *)
            echo "1Password item is missing custom field public." >&2
            exit 1
            ;;
    esac
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    umask 077
    tmp="$(mktemp "$HOME/.ssh/opnsense_agent.XXXXXX")"
    tmp_pub="$(mktemp "$HOME/.ssh/opnsense_agent.pub.XXXXXX")"
    cleanup() {
        rm -f "$tmp" "$tmp_pub"
    }
    trap cleanup EXIT INT TERM
    printf '%s\n' "$priv" >"$tmp"
    printf '%s\n' "$pub" >"$tmp_pub"
    chmod 600 "$tmp"
    chmod 644 "$tmp_pub"
    ssh-keygen -y -f "$tmp" >/dev/null
    mv "$tmp" "$KEY_FILE"
    mv "$tmp_pub" "$PUB_FILE"
    trap - EXIT INT TERM
    chmod 600 "$KEY_FILE"
    chmod 644 "$PUB_FILE"
    printf 'materialized:%s\n' "$KEY_FILE"
}

case "$command_name" in
    status) cmd_status ;;
    store) cmd_store ;;
    sync) cmd_sync ;;
    -h|--help|help) usage ;;
    *)
        echo "Unknown subcommand: $command_name" >&2
        usage >&2
        exit 1
        ;;
esac
