#!/bin/sh
set -eu

# Store or replace 1Password item opnsense-api (username=key, password=secret).
# Never prints credentials. Then writes the machine-local secret file.

usage() {
    cat <<'EOF'
Usage: opnsense-store-secret [--from FILE]

Store the OPNsense API key/secret in 1Password item opnsense-api,
then run opnsense-api sync.

  --from FILE   Parse an OPNsense apikey.txt (key=... / secret=...).
  (default)     Prompt twice, hidden: API key then API secret.

1Password sign-in is handled by op-secret.
EOF
}

CONFIG_FILE="${OPNSENSE_CONFIG_FILE:-$HOME/.config/decent-angl/opnsense.env}"
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi

ITEM_NAME="${OPNSENSE_VAULT_ITEM:-opnsense-api}"
URI="${OPNSENSE_HOST:-https://10.77.77.1}"
FROM_FILE=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help|help)
            usage
            exit 0
            ;;
        --from)
            FROM_FILE="${2:-}"
            if [ -z "$FROM_FILE" ]; then
                echo "--from requires a file path." >&2
                exit 1
            fi
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

OP_SECRET="${OP_SECRET_BIN:-$HOME/.local/bin/op-secret}"
if [ ! -x "$OP_SECRET" ]; then
    echo "op-secret is unavailable." >&2
    exit 127
fi
if [ -n "$FROM_FILE" ] && [ ! -f "$FROM_FILE" ]; then
    echo "File not found: $FROM_FILE" >&2
    exit 1
fi
if [ -z "$FROM_FILE" ] && [ ! -t 0 ]; then
    echo "No TTY. Use --from /path/to/apikey.txt" >&2
    exit 1
fi

KEY=""
SECRET=""
if [ -n "$FROM_FILE" ]; then
    KEY="$(sed -n 's/^key=//p' "$FROM_FILE" | sed -n '1p')"
    SECRET="$(sed -n 's/^secret=//p' "$FROM_FILE" | sed -n '1p')"
else
    echo "Paste the OPNsense API key, then Enter. Nothing is echoed."
    stty -echo
    IFS= read -r KEY || true
    stty echo
    printf '\n'
    echo "Paste the OPNsense API secret, then Enter. Nothing is echoed."
    stty -echo
    IFS= read -r SECRET || true
    stty echo
    printf '\n'
fi

if [ -z "$KEY" ] || [ -z "$SECRET" ]; then
    echo "Empty key or secret; aborting." >&2
    exit 1
fi

OPNSENSE_API_KEY_VALUE="$KEY"
OPNSENSE_API_SECRET_VALUE="$SECRET"
export OPNSENSE_API_KEY_VALUE OPNSENSE_API_SECRET_VALUE
"$OP_SECRET" add --scope general --replace --url "$URI" "$ITEM_NAME" \
    username=env:OPNSENSE_API_KEY_VALUE password=env:OPNSENSE_API_SECRET_VALUE
unset KEY SECRET OPNSENSE_API_KEY_VALUE OPNSENSE_API_SECRET_VALUE
echo "stored:$ITEM_NAME"

if [ -x "$HOME/.local/bin/opnsense-api" ]; then
    "$HOME/.local/bin/opnsense-api" sync
fi
