#!/bin/sh
set -eu

# Store or replace Bitwarden item opnsense-api (username=key, password=secret).
# Never prints credentials. Then writes the machine-local secret file.

find_bin() {
    for candidate in "$@"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

usage() {
    cat <<'EOF'
Usage: opnsense-store-secret [--from FILE]

Store the OPNsense API key/secret in Vaultwarden item opnsense-api,
then run opnsense-api sync.

  --from FILE   Parse an OPNsense apikey.txt (key=... / secret=...).
  (default)     Prompt twice, hidden: API key then API secret.

bw must already be unlocked, or this script will prompt to unlock.
EOF
}

CONFIG_FILE="${OPNSENSE_CONFIG_FILE:-$HOME/.config/decent-angl/opnsense.env}"
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi

ITEM_NAME="${OPNSENSE_BW_ITEM:-opnsense-api}"
URI="${OPNSENSE_HOST:-https://10.77.77.1}"
FROM_FILE=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help|help)
            usage
            exit 0
            ;;
        --from)
            FROM_FILE="${2:-}"
            if [ -z "$FROM_FILE" ]; then
                echo "--from requires a file path." >&2
                exit 1
            fi
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

BW_BIN="$(find_bin \
    "${BW_BIN:-}" \
    "$HOME/.local/share/mise/shims/bw" \
    "$HOME/.local/share/mise/installs/npm-bitwarden-cli/2026.3.0/bin/bw" \
    "$HOME/.local/bin/bw" \
    "/opt/homebrew/bin/bw" \
    "/usr/local/bin/bw" \
    "$(command -v bw 2>/dev/null || true)")"

if [ -z "${BW_BIN:-}" ]; then
    echo "bw CLI not found." >&2
    exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required." >&2
    exit 1
fi

if [ -n "$FROM_FILE" ] && [ ! -f "$FROM_FILE" ]; then
    echo "File not found: $FROM_FILE" >&2
    exit 1
fi
if [ -z "$FROM_FILE" ] && [ ! -t 0 ]; then
    echo "No TTY. Use --from /path/to/apikey.txt" >&2
    exit 1
fi

status="$("$BW_BIN" status 2>/dev/null | sed -n 's/.*"status":"\([^"]*\)".*/\1/p' | sed -n '1p')"
status="${status:-unknown}"
case "$status" in
    unlocked)
        ;;
    locked)
        echo "Unlock Bitwarden (master password):"
        BW_SESSION="$("$BW_BIN" unlock --raw)"
        export BW_SESSION
        if [ -z "${BW_SESSION:-}" ]; then
            echo "Unlock failed." >&2
            exit 1
        fi
        ;;
    unauthenticated)
        echo "bw is unauthenticated; run 'bw login' first." >&2
        exit 1
        ;;
    *)
        echo "Unable to determine bw status." >&2
        exit 1
        ;;
esac

KEY=""
SECRET=""
if [ -n "$FROM_FILE" ]; then
    if [ ! -f "$FROM_FILE" ]; then
        echo "File not found: $FROM_FILE" >&2
        exit 1
    fi
    KEY="$(sed -n 's/^key=//p' "$FROM_FILE" | sed -n '1p')"
    SECRET="$(sed -n 's/^secret=//p' "$FROM_FILE" | sed -n '1p')"
else
    if [ -t 0 ]; then
        echo "Paste the OPNsense API key, then Enter. Nothing is echoed."
        stty -echo
        IFS= read -r KEY || true
        stty echo
        printf '\n'
        echo "Paste the OPNsense API secret, then Enter. Nothing is echoed."
        stty -echo
        IFS= read -r SECRET || true
        stty echo
        printf '\n'
    else
        echo "No TTY. Use --from /path/to/apikey.txt" >&2
        exit 1
    fi
fi

if [ -z "$KEY" ] || [ -z "$SECRET" ]; then
    echo "Empty key or secret; aborting." >&2
    exit 1
fi

EXISTING="$("$BW_BIN" list items --search "$ITEM_NAME" | python3 -c '
import json,sys
items=json.load(sys.stdin)
name="opnsense-api"
hit=next((i for i in items if i.get("name")==name), None)
print(hit["id"] if hit else "")
')"

PAYLOAD="$(KEY="$KEY" SECRET="$SECRET" URI="$URI" python3 -c '
import json,os,base64
obj={
  "type": 1,
  "name": "opnsense-api",
  "notes": "OPNsense REST API key/secret for agent-api. username=key, password=secret. Machine-local. Do not put in Git or chezmoi.",
  "favorite": False,
  "reprompt": 0,
  "login": {
    "username": os.environ["KEY"],
    "password": os.environ["SECRET"],
    "uris": [{"uri": os.environ["URI"]}],
  },
}
print(base64.b64encode(json.dumps(obj).encode()).decode())
')"

if [ -n "$EXISTING" ]; then
    echo "Updating existing item $ITEM_NAME"
    "$BW_BIN" edit item "$EXISTING" "$PAYLOAD" >/dev/null
else
    echo "Creating item $ITEM_NAME"
    "$BW_BIN" create item "$PAYLOAD" >/dev/null
fi

unset KEY SECRET PAYLOAD
"$BW_BIN" sync >/dev/null
echo "stored:$ITEM_NAME"

if [ -x "$HOME/.local/bin/opnsense-api" ]; then
    "$HOME/.local/bin/opnsense-api" sync
fi
