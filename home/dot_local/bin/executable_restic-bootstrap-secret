#!/bin/sh
set -eu

ITEM_NAME="${RESTIC_VAULT_ITEM:-restic-decent-angl}"
OP_SECRET="${OP_SECRET_BIN:-$HOME/.local/bin/op-secret}"
if [ ! -x "$OP_SECRET" ]; then
    echo "op-secret is unavailable." >&2
    exit 127
fi

if "$OP_SECRET" ref "$ITEM_NAME" password >/dev/null 2>&1; then
    echo "exists:$ITEM_NAME"
    exit 0
fi

if ! command -v openssl >/dev/null 2>&1; then
    echo "openssl is required." >&2
    exit 1
fi

RESTIC_BOOTSTRAP_PASSWORD="$(openssl rand -base64 48 | tr -d '\n')"
export RESTIC_BOOTSTRAP_PASSWORD
"$OP_SECRET" add --scope backup "$ITEM_NAME" password=env:RESTIC_BOOTSTRAP_PASSWORD
unset RESTIC_BOOTSTRAP_PASSWORD
echo "created:$ITEM_NAME"
