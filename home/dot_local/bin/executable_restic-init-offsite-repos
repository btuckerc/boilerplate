#!/bin/sh
set -eu

find_bin() {
    for candidate in "$@"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

RESTIC_BIN="${RESTIC_BIN:-}"
if [ -z "$RESTIC_BIN" ]; then
    RESTIC_BIN="$(find_bin \
        "$HOME/.local/share/mise/shims/restic" \
        "$HOME/.local/bin/restic" \
        "/opt/homebrew/bin/restic" \
        "/usr/local/bin/restic" \
        "$(command -v restic 2>/dev/null || true)")"
fi
RESTIC_OFFSITE_REPO_BIN="${RESTIC_OFFSITE_REPO_BIN:-}"
if [ -z "$RESTIC_OFFSITE_REPO_BIN" ]; then
    RESTIC_OFFSITE_REPO_BIN="$(find_bin "$HOME/.local/bin/restic-offsite-repo" "$(command -v restic-offsite-repo 2>/dev/null || true)")"
fi
RESTIC_BOOTSTRAP_SECRET_BIN="${RESTIC_BOOTSTRAP_SECRET_BIN:-}"
if [ -z "$RESTIC_BOOTSTRAP_SECRET_BIN" ]; then
    RESTIC_BOOTSTRAP_SECRET_BIN="$(find_bin "$HOME/.local/bin/restic-bootstrap-secret" "$(command -v restic-bootstrap-secret 2>/dev/null || true)")"
fi
RESTIC_OFFSITE_ENV_BIN="${RESTIC_OFFSITE_ENV_BIN:-}"
if [ -z "$RESTIC_OFFSITE_ENV_BIN" ]; then
    RESTIC_OFFSITE_ENV_BIN="$(find_bin "$HOME/.local/bin/restic-offsite-env" "$(command -v restic-offsite-env 2>/dev/null || true)")"
fi
OP_SECRET="${OP_SECRET_BIN:-$HOME/.local/bin/op-secret}"
PASSWORD_COMMAND="${RESTIC_PASSWORD_COMMAND:-$HOME/.local/bin/op-secret field ${RESTIC_VAULT_ITEM:-restic-decent-angl} password}"

for spec in "RESTIC_BIN:$RESTIC_BIN" "RESTIC_OFFSITE_REPO_BIN:$RESTIC_OFFSITE_REPO_BIN" "RESTIC_BOOTSTRAP_SECRET_BIN:$RESTIC_BOOTSTRAP_SECRET_BIN" "RESTIC_OFFSITE_ENV_BIN:$RESTIC_OFFSITE_ENV_BIN"; do
    name="${spec%%:*}"
    value="${spec#*:}"
    if [ -z "$value" ] || [ ! -x "$value" ]; then
        echo "$name helper not found." >&2
        exit 1
    fi
done
if [ ! -x "$OP_SECRET" ]; then
    echo "op-secret is unavailable." >&2
    exit 127
fi
if ! "$OP_SECRET" status >/dev/null; then
    echo "Run 'op-secret status' and enroll this machine per the machine-secrets skill." >&2
    exit 1
fi

export RESTIC_PASSWORD_COMMAND="$PASSWORD_COMMAND"
"$RESTIC_BOOTSTRAP_SECRET_BIN"
eval "$("$RESTIC_OFFSITE_ENV_BIN")"

if [ "$#" -eq 0 ]; then
    set -- omarchy btcaw macbook macmini
fi
for machine_id in "$@"; do
    repo="$("$RESTIC_OFFSITE_REPO_BIN" "$machine_id")"
    if "$RESTIC_BIN" -r "$repo" cat config >/dev/null 2>&1; then
        printf 'exists:%s:%s\n' "$machine_id" "$repo"
        continue
    fi
    "$RESTIC_BIN" -r "$repo" init
    printf 'initialized:%s:%s\n' "$machine_id" "$repo"
done
