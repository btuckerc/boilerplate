#!/usr/bin/env bash

set -euo pipefail

readonly AC_ONLINE_PATH="/sys/class/power_supply/AC/online"
readonly CONFIG_FILE="/etc/portable-laptop-power.conf"
readonly PLATFORM_PROFILE_PATH="/sys/firmware/acpi/platform_profile"

CHARGE_MODE="desk"
DESK_START_THRESHOLD="80"
DESK_STOP_THRESHOLD="85"
TRAVEL_START_THRESHOLD="95"
TRAVEL_STOP_THRESHOLD="100"
AC_POWER_PROFILE="performance"
BAT_POWER_PROFILE="power-saver"
AC_PLATFORM_PROFILE="performance"
BAT_PLATFORM_PROFILE="low-power"
AC_WIFI_POWER_SAVE="off"
BAT_WIFI_POWER_SAVE="on"
AC_RYZENADJ_CO_ALL="-30"
BAT_RYZENADJ_CO_ALL="-15"
RYZENADJ="/usr/local/bin/ryzenadj"
AC_GPU_DPM_STATE="performance"
BAT_GPU_DPM_STATE="battery"
AC_PCIE_ASPM="default"
BAT_PCIE_ASPM="powersave"
BAT_DOWN_UNLINKED_ETHERNET="on"
AC_RYZENADJ_MODE="max-performance"
BAT_RYZENADJ_MODE="power-saving"

log_warn() {
    printf 'thinkpad-power-source-policy: %s\n' "$*" >&2
}

if [[ -r "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi

write_value_if_needed() {
    local path="$1"
    local target="$2"
    local current

    [[ -e "$path" ]] || return 0
    [[ -w "$path" ]] || return 0

    if ! current="$(<"$path" 2>/dev/null)"; then
        log_warn "unable to read $path"
        return 0
    fi

    if [[ "$current" != "$target" ]]; then
        force_write_value "$path" "$target"
    fi
}

force_write_value() {
    local path="$1"
    local target="$2"

    [[ -e "$path" ]] || return 0
    [[ -w "$path" ]] || return 0

    if ! printf '%s' "$target" | tee "$path" >/dev/null 2>&1; then
        log_warn "unable to write $target to $path"
    fi
}

resolve_thresholds() {
    case "$CHARGE_MODE" in
        desk)
            BATTERY_START_THRESHOLD="$DESK_START_THRESHOLD"
            BATTERY_STOP_THRESHOLD="$DESK_STOP_THRESHOLD"
            ;;
        travel)
            BATTERY_START_THRESHOLD="$TRAVEL_START_THRESHOLD"
            BATTERY_STOP_THRESHOLD="$TRAVEL_STOP_THRESHOLD"
            ;;
        *)
            log_warn "unknown CHARGE_MODE=$CHARGE_MODE; defaulting to desk"
            BATTERY_START_THRESHOLD="$DESK_START_THRESHOLD"
            BATTERY_STOP_THRESHOLD="$DESK_STOP_THRESHOLD"
            ;;
    esac
}

apply_battery_thresholds() {
    local battery_dir

    for battery_dir in /sys/class/power_supply/BAT*; do
        [[ -d "$battery_dir" ]] || continue
        if [[ "$ac_online" == "1" ]]; then
            write_value_if_needed "$battery_dir/charge_control_start_threshold" "$BATTERY_START_THRESHOLD"
            write_value_if_needed "$battery_dir/charge_start_threshold" "$BATTERY_START_THRESHOLD"
        fi
        write_value_if_needed "$battery_dir/charge_control_end_threshold" "$BATTERY_STOP_THRESHOLD"
        write_value_if_needed "$battery_dir/charge_stop_threshold" "$BATTERY_STOP_THRESHOLD"
    done
}

set_power_profile() {
    local target_profile="$1"
    local target_platform_profile="$2"
    local current_profile

    if command -v powerprofilesctl >/dev/null 2>&1; then
        current_profile="$(powerprofilesctl get 2>/dev/null || true)"
        if [[ -n "$current_profile" && "$current_profile" != "$target_profile" ]]; then
            if ! powerprofilesctl set "$target_profile" >/dev/null 2>&1; then
                log_warn "unable to set power profile to $target_profile"
            fi
        fi
    fi

    # Always poke ACPI. Sysfs can already say "performance" while the EC
    # is still on the 11 W table after an AC plug-in.
    force_write_value "$PLATFORM_PROFILE_PATH" "$target_platform_profile"
}

set_wifi_power_save() {
    local target_wifi_power_save="$1"
    local wireless_dir iface current_wifi_power_save

    command -v iw >/dev/null 2>&1 || return 0

    for wireless_dir in /sys/class/net/*/wireless; do
        [[ -d "$wireless_dir" ]] || continue
        iface="$(basename "$(dirname "$wireless_dir")")"
        current_wifi_power_save="$(
            { iw dev "$iface" get power_save 2>/dev/null || true; } |
                awk '/Power save:/ { print tolower($3) }'
        )"
        if [[ -n "$current_wifi_power_save" && "$current_wifi_power_save" != "$target_wifi_power_save" ]]; then
            if ! iw dev "$iface" set power_save "$target_wifi_power_save" >/dev/null 2>&1; then
                log_warn "unable to set Wi-Fi power_save=$target_wifi_power_save for $iface"
            fi
        fi
    done
}

stop_idle_socket_activated_services_on_battery() {
    if [[ "$ac_online" == "1" ]]; then
        return
    fi

    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet docker.service 2>/dev/null; then
        if command -v docker >/dev/null 2>&1 && [[ -z "$(docker ps -q 2>/dev/null)" ]]; then
            if ! systemctl stop docker.service >/dev/null 2>&1; then
                log_warn "unable to stop docker.service"
            fi
        fi
    fi

    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet cups.service 2>/dev/null; then
        if command -v lpstat >/dev/null 2>&1 && ! lpstat -W not-completed -o 2>/dev/null | grep -q .; then
            if ! systemctl stop cups.service >/dev/null 2>&1; then
                log_warn "unable to stop cups.service"
            fi
        fi
    fi
}

set_gpu_dpm_state() {
    local target="$1"
    local path="/sys/class/drm/card1/device/power_dpm_state"

    [[ -n "$target" ]] || return 0
    write_value_if_needed "$path" "$target"
}

set_pcie_aspm() {
    local target="$1"
    local path="/sys/module/pcie_aspm/parameters/policy"

    [[ -n "$target" ]] || return 0
    [[ -e "$path" ]] || return 0

    # Runtime writes are rejected unless the kernel was booted with
    # pcie_aspm=force. Do not spam the journal every 5 minutes.
    if [[ -w "$path" ]]; then
        if ! printf '%s' "$target" | tee "$path" >/dev/null 2>&1; then
            return 0
        fi
    fi
}

set_runtime_pm_auto() {
    local device_path="$1"
    local control="$device_path/power/control"

    [[ -e "$control" ]] || return 0
    write_value_if_needed "$control" "auto"
}

apply_runtime_pm() {
    local net_dev pci_dev

    # Unused wired NICs, NVMe, Wi-Fi. Leave the APU and USB hosts alone.
    for net_dev in /sys/class/net/enp* /sys/class/net/wlp*; do
        [[ -e "$net_dev/device/power/control" ]] || continue
        set_runtime_pm_auto "$net_dev/device"
    done

    for pci_dev in /sys/bus/pci/devices/*/nvme; do
        [[ -e "$pci_dev" ]] || continue
        set_runtime_pm_auto "$(dirname "$pci_dev")"
    done
}

apply_unlinked_ethernet() {
    local iface_path iface carrier

    if [[ "$ac_online" == "1" ]]; then
        for iface_path in /sys/class/net/enp*; do
            [[ -d "$iface_path" ]] || continue
            iface="$(basename "$iface_path")"
            ip link set "$iface" up >/dev/null 2>&1 || true
        done
        return
    fi

    [[ "${BAT_DOWN_UNLINKED_ETHERNET:-on}" == "on" ]] || return 0

    for iface_path in /sys/class/net/enp*; do
        [[ -d "$iface_path" ]] || continue
        iface="$(basename "$iface_path")"
        carrier="$(<"$iface_path/carrier" 2>/dev/null || printf '0')"
        [[ "$carrier" != "1" ]] || continue
        ip link set "$iface" down >/dev/null 2>&1 || log_warn "unable to down unused ethernet $iface"
        if command -v nmcli >/dev/null 2>&1; then
            nmcli device disconnect "$iface" >/dev/null 2>&1 || true
        fi
    done
}


encode_curve_optimizer() {
    local co="$1"

    if [[ "$co" -ge 0 ]]; then
        printf '%s' "$co"
        return
    fi

    printf '%s' "$((0x100000 - ${co#-}))"
}

apply_curve_optimizer() {
    local co encoded mode_flag
    local -a args

    if [[ "$ac_online" == "1" ]]; then
        co="${AC_RYZENADJ_CO_ALL:-0}"
        mode_flag="${AC_RYZENADJ_MODE:-}"
    else
        co="${BAT_RYZENADJ_CO_ALL:-0}"
        mode_flag="${BAT_RYZENADJ_MODE:-}"
    fi

    if [[ -z "$co" && -z "$mode_flag" ]]; then
        return 0
    fi

    if [[ ! -x "$RYZENADJ" ]]; then
        log_warn "ryzenadj missing at $RYZENADJ"
        return 0
    fi

    if [[ -n "$co" ]] && ! [[ "$co" =~ ^-?[0-9]+$ ]]; then
        log_warn "invalid Curve Optimizer value: $co"
        return 0
    fi

    case "$mode_flag" in
        max-performance)
            mode_flag="--max-performance"
            ;;
        power-saving)
            mode_flag="--power-saving"
            ;;
        "")
            ;;
        *)
            log_warn "invalid RyzenAdj mode: $mode_flag"
            mode_flag=""
            ;;
    esac

    args=()
    [[ -n "$mode_flag" ]] && args+=("$mode_flag")
    if [[ -n "$co" ]]; then
        encoded="$(encode_curve_optimizer "$co")"
        args+=("--set-coall=$encoded")
    fi
    [[ "${#args[@]}" -gt 0 ]] || return 0

    # ACPI profile changes overwrite CO. Wait, then apply twice.
    sleep 0.4
    if ! "$RYZENADJ" "${args[@]}" >/dev/null 2>&1; then
        log_warn "unable to apply RyzenAdj co=$co mode=${mode_flag:-none}"
        return 0
    fi
    sleep 0.4
    if ! "$RYZENADJ" "${args[@]}" >/dev/null 2>&1; then
        log_warn "unable to reapply RyzenAdj co=$co mode=${mode_flag:-none}"
    fi
}

if [[ ! -r "$AC_ONLINE_PATH" ]]; then
    exit 0
fi

resolve_thresholds

ac_online="$(<"$AC_ONLINE_PATH")"
target_profile="$AC_POWER_PROFILE"
target_platform_profile="$AC_PLATFORM_PROFILE"
target_wifi_power_save="$AC_WIFI_POWER_SAVE"
target_gpu_dpm_state="$AC_GPU_DPM_STATE"
target_pcie_aspm="$AC_PCIE_ASPM"

if [[ "$ac_online" != "1" ]]; then
    target_profile="$BAT_POWER_PROFILE"
    target_platform_profile="$BAT_PLATFORM_PROFILE"
    target_wifi_power_save="$BAT_WIFI_POWER_SAVE"
    target_gpu_dpm_state="$BAT_GPU_DPM_STATE"
    target_pcie_aspm="$BAT_PCIE_ASPM"
fi

set_power_profile "$target_profile" "$target_platform_profile"
set_wifi_power_save "$target_wifi_power_save"
set_gpu_dpm_state "$target_gpu_dpm_state"
set_pcie_aspm "$target_pcie_aspm"
apply_runtime_pm
apply_unlinked_ethernet
apply_battery_thresholds
stop_idle_socket_activated_services_on_battery
apply_curve_optimizer
