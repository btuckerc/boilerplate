#!/bin/zsh
# Managed by chezmoi - https://github.com/btuckerc/boilerplate
# Zsh environment configuration
# This file is sourced on all invocations of the shell (login, interactive, scripts)
# Keep this minimal - most config should go in .zshrc

# XDG Base Directory Specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"

# Set ZDOTDIR for zsh config files
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Starship prompt configuration
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"

# Native array edits below: zsh does not word-split ${PATH} on IFS, and quoted
# "${(@)…}" keeps empty elements, so an inherited empty PATH component (current
# dir) stays. An empty PATH ties to path=(''); clear it so prepends do not turn
# it into such a component.
[[ -n $PATH ]] || path=()

# Make Homebrew and system admin tools visible in non-interactive macOS shells.
if [[ $OSTYPE == darwin* ]]; then
    for dir in /opt/homebrew/bin /opt/homebrew/sbin /usr/local/bin /usr/local/sbin; do
        (( ${path[(Ie)$dir]} )) || [[ ! -d $dir ]] || path[1,0]=$dir
    done
    export PATH
fi

# Keep user-managed bins and shims ahead of OS package-manager bins.
# Apply from lowest to highest precedence because each directory is prepended.
path=("${(@)path:#$HOME/.local/share/omarchy/bin}")
for dir in "$HOME/.local/share/mise/shims" "$HOME/.local/bin"; do
    [[ -d $dir ]] && path=("$dir" "${(@)path:#$dir}")
done
unset dir
# A lone empty element would export as PATH='' (no components); two keep the
# current directory.
(( ${#path} == 1 )) && [[ -z ${path[1]} ]] && path=('' '')

# Load Cargo environment if available
CARGODIR="$HOME/.cargo"
if [ -f "$CARGODIR/env" ]; then
    . "$CARGODIR/env"
fi

# Login shells run /etc/zprofile next; on macOS its path_helper reorders PATH.
# .zprofile restores the order captured here.
if [[ $OSTYPE == darwin* && -o login ]]; then
    _zshenv_path=$PATH
fi
