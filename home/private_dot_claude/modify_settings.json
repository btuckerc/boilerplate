{{- /* chezmoi:modify-template */ -}}
{{- /* Claude Code (/config, /model, /effort) and herdr (hooks) also write this
     file, so merge only the owned keys into its current contents. When the owned
     keys already hold these values, emit the file byte-for-byte so a rewrite in
     another key order never shows as drift. */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{- $config = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- $before := $config | toJson -}}
{{- $env := get $config "env" | default dict -}}
{{- $_ := set $env "DISABLE_AUTOUPDATER" "1" -}}
{{- $config = setValueAtPath "env" $env $config -}}
{{- $config = setValueAtPath "model" "claude-opus-5-5" $config -}}
{{- /* Opus 5.5 ignores a top-level effortLevel in user settings. */ -}}
{{- $config = setValueAtPath "modelSettings.claude-opus-5-5.effortLevel" "high" $config -}}
{{- $config = setValueAtPath "permissions.defaultMode" "bypassPermissions" $config -}}
{{- $config = setValueAtPath "skipDangerousModePermissionPrompt" true $config -}}
{{- /* The object form: Claude Code's schema treats false as exactly this object and warns that
     older versions reject a boolean, so hosts on different versions agree. */ -}}
{{- $config = setValueAtPath "attribution" (dict "commit" "" "pr" "" "sessionUrl" false) $config -}}
{{- /* Keep transcripts (Herdwick renders them); the default sweep deletes after 30 days. */ -}}
{{- $config = setValueAtPath "cleanupPeriodDays" 3650 $config -}}
{{- /* No auto-memory: durable guidance belongs in the managed config and rules, not in
     per-project memory files. autoMemoryEnabled=false stops reads and writes; autoDreamEnabled
     stops background consolidation. */ -}}
{{- $config = setValueAtPath "autoMemoryEnabled" false $config -}}
{{- $config = setValueAtPath "autoDreamEnabled" false $config -}}
{{- $config = setValueAtPath "statusLine" (dict "type" "command" "command" (joinPath .chezmoi.homeDir ".local/bin/claude-statusline")) $config -}}
{{- /* agent-run launches must notify the session; herdr owns other hooks, so append ours only
     when absent. */ -}}
{{- $guard := joinPath .chezmoi.homeDir ".local/bin/agent-launch-guard" -}}
{{- $hooks := get $config "hooks" | default dict -}}
{{- $pre := get $hooks "PreToolUse" | default list -}}
{{- $guarded := false -}}
{{- /* A matcher of "", "*" or a |-list naming Bash covers it; regex forms are not compiled here (Go and
     JavaScript regexes differ), so they at worst add a second, harmless registration. */ -}}
{{- if kindIs "slice" $pre -}}{{- range $pre -}}{{- if and (kindIs "map" .) (kindIs "slice" (get . "hooks")) -}}{{- $m := get . "matcher" -}}
{{- if or (not (hasKey . "matcher")) (and (kindIs "string" $m) (or (eq $m "" "*") (has "Bash" (splitList "|" (nospace $m))))) -}}
{{- range (get . "hooks") -}}{{- if and (kindIs "map" .) (eq (toString (get . "type")) "command") (kindIs "string" (get . "command")) -}}{{- if eq (get . "command") $guard -}}{{- $guarded = true -}}{{- end -}}{{- end -}}{{- end -}}
{{- end -}}{{- end -}}{{- end -}}{{- end -}}
{{- if and (not $guarded) (kindIs "slice" $pre) -}}
{{- $_ := set $hooks "PreToolUse" (append $pre (dict "matcher" "Bash" "hooks" (list (dict "type" "command" "command" $guard "timeout" 5)))) -}}
{{- $config = setValueAtPath "hooks" $hooks $config -}}
{{- end -}}
{{- if and .chezmoi.stdin (eq $before ($config | toJson)) -}}
{{ .chezmoi.stdin }}
{{- else -}}
{{ $config | toPrettyJson }}
{{ end -}}
