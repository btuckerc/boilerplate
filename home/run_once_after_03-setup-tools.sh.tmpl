#!/usr/bin/env bash
set -euo pipefail

# Fail if installation cannot complete; a skipped tool install is not success.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
if ! command -v mise >/dev/null 2>&1; then
    if command -v brew >/dev/null 2>&1; then
        brew install mise
    else
        installer="$(mktemp)"
        trap 'rm -f "$installer"' EXIT
        curl --proto '=https' --tlsv1.2 -fsSL https://mise.run -o "$installer"
        sh "$installer"
    fi
fi
command -v mise >/dev/null 2>&1 || { echo "mise installation failed." >&2; exit 1; }
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml" ] || {
    echo "Managed mise config is missing." >&2; exit 1;
}
# Do not parse mise config ls display text to guess whether tools exist.
mise -C "$HOME" install
mise reshim
