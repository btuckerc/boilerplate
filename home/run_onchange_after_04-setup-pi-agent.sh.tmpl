#!/usr/bin/env bash
set -euo pipefail

echo ""
echo "========================================"
echo "  Pi Agent Setup"
echo "========================================"
echo ""

PACKAGES=(
    "npm:pi-rtk-optimizer@0.5.4"
    "npm:pi-show-diffs@0.2.8"
    "npm:pi-prompt-template-model@0.8.2"
    "npm:pi-subagents@0.17.2"
    "npm:pi-resource-center@0.2.3"
)
NODE_VERSION="24.14.1"
PI_VERSION="0.75.0"
RTK_VERSION="0.37.2"

if command -v mise >/dev/null 2>&1; then
    if [ ! -x "$HOME/.local/share/mise/installs/node/${NODE_VERSION}/bin/npm" ]; then
        echo "Installing Node ${NODE_VERSION} for Pi package management..."
        mise install "node@${NODE_VERSION}"
    fi

    if ! command -v pi >/dev/null 2>&1; then
        echo "Installing Pi ${PI_VERSION}..."
        mise install "pi@${PI_VERSION}"
    fi

    if ! command -v rtk >/dev/null 2>&1; then
        echo "Installing RTK ${RTK_VERSION}..."
        mise install "rtk@${RTK_VERSION}"
    fi

    mise reshim
fi

if ! command -v pi >/dev/null 2>&1; then
    echo "pi not found. Skipping Pi package setup; run 'mise install' first."
    exit 0
fi

if ! command -v rtk >/dev/null 2>&1; then
    echo "rtk not found. The Pi RTK optimizer will fall back until 'mise install rtk' succeeds."
fi

export PI_TELEMETRY="${PI_TELEMETRY:-0}"

if command -v jq >/dev/null 2>&1 && [ -x "$HOME/.local/bin/pi-fireworks-key" ]; then
    auth_file="$HOME/.pi/agent/auth.json"
    auth_tmp="$(mktemp)"
    mkdir -p "$HOME/.pi/agent"

    if [ -s "$auth_file" ] && jq empty "$auth_file" >/dev/null 2>&1; then
        jq '.fireworks = {"type":"api_key","key":"!$HOME/.local/bin/pi-fireworks-key"}' "$auth_file" > "$auth_tmp"
    else
        printf '%s\n' '{"fireworks":{"type":"api_key","key":"!$HOME/.local/bin/pi-fireworks-key"}}' > "$auth_tmp"
    fi

    install -m 600 "$auth_tmp" "$auth_file"
    rm -f "$auth_tmp"
    echo "Configured local Pi Fireworks auth helper"
fi

NODE_BIN="$HOME/.local/share/mise/installs/node/${NODE_VERSION}/bin/node"
if [ -x "$NODE_BIN" ] && [ -s "$HOME/.codex/auth.json" ]; then
    "$NODE_BIN" <<'NODE'
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const home = process.env.HOME || os.homedir();
const codexPath = path.join(home, ".codex", "auth.json");
const piPath = path.join(home, ".pi", "agent", "auth.json");

function readJson(file) {
	try {
		return JSON.parse(fs.readFileSync(file, "utf8"));
	} catch {
		return undefined;
	}
}

function accessExpiryMs(token) {
	try {
		const payload = token.split(".")[1];
		if (!payload) return undefined;
		const normalized = payload.replace(/-/g, "+").replace(/_/g, "/");
		const decoded = JSON.parse(Buffer.from(normalized, "base64").toString("utf8"));
		return typeof decoded.exp === "number" ? decoded.exp * 1000 : undefined;
	} catch {
		return undefined;
	}
}

const codexAuth = readJson(codexPath);
const tokens = codexAuth && codexAuth.tokens;
if (!tokens || !tokens.access_token || !tokens.refresh_token) process.exit(0);

const piAuth = readJson(piPath) || {};
if (piAuth["openai-codex"] && piAuth["openai-codex"].access && piAuth["openai-codex"].refresh) {
	process.exit(0);
}

piAuth["openai-codex"] = {
	type: "oauth",
	access: tokens.access_token,
	refresh: tokens.refresh_token,
	expires: accessExpiryMs(tokens.access_token) || Date.now() + 60 * 60 * 1000,
	accountId: tokens.account_id,
};

fs.mkdirSync(path.dirname(piPath), { recursive: true });
const tmpPath = `${piPath}.tmp-${process.pid}`;
fs.writeFileSync(tmpPath, JSON.stringify(piAuth, null, 2) + "\n", { mode: 0o600 });
fs.renameSync(tmpPath, piPath);
fs.chmodSync(piPath, 0o600);
console.log("Seeded local Pi Codex auth from Codex login");
NODE
fi

for package in "${PACKAGES[@]}"; do
    echo "Installing Pi package: $package"
    pi install "$package"
done

echo ""
echo "✓ Pi agent packages configured"
echo ""
