#!/usr/bin/env bash
set -euo pipefail

# Any portable OMP source change changes this rendered hook and forces a
# targeted reapply, exact-version install, validation, and guard refresh.
# config={{ include "private_dot_omp/private_agent/config.yml" | sha256sum }}
# models={{ include "private_dot_omp/private_agent/models.yml" | sha256sum }}
# agents={{ include "private_dot_omp/private_agent/AGENTS.md.tmpl" | sha256sum }}
# rules={{ include "private_dot_omp/private_agent/RULES.md" | sha256sum }}
# manifest={{ include "dot_config/decent-angl/omp-baseline-manifest.tsv" | sha256sum }}

if [ -x "$HOME/.local/bin/omp-baseline" ]; then
  "$HOME/.local/bin/omp-baseline" apply
fi
