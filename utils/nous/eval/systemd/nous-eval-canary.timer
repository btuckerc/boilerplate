[Unit]
Description=Weekly nous-eval canary and upstream watch (a new radiance release takes the GPU for up to ~12 hours: canary, then t3)

[Timer]
# No Persistent=: a missed Sunday night must not take the GPU at boot, mid-day.
OnCalendar=Sun *-*-* 03:00:00
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
