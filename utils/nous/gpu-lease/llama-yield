#!/usr/bin/python3 -I
"""Host-local, systemd-owned exclusive GPU lease and production recovery."""
import argparse
import fcntl
import json
import math
import os
import queue
import re
import socket
import signal
import subprocess
import sys
import syslog
import threading
import time

UNIT = "llama-yield-gpu.service"
PLACEHOLDER = "llama-placeholder.service"
SELF = "/usr/local/bin/llama-yield"
BUSY = {"active", "activating", "deactivating", "reloading", "refreshing"}


def write_all(fd, data):
    try:
        while data:
            data = data[os.write(fd, data):]
    except OSError:
        pass  # The caller's pipe may have vanished; recovery must continue.


def emit(message):
    syslog.syslog(syslog.LOG_INFO, message)
    write_all(1, (message + "\n").encode())


def announce(message):
    """To syslog and the caller's output, waiting for them at most a second: a log or pipe
    nobody drains must not hold up a lease's stop, production's restore or the lease lock
    (release audits)."""
    writer = threading.Thread(target=emit, args=(message,), daemon=True)
    writer.start()
    writer.join(timeout=1)


def systemctl(*args):
    """systemctl with its output captured: nothing it writes waits for our caller."""
    return subprocess.run(["/usr/bin/systemctl", *args], capture_output=True, text=True)


def ctl(*args):
    done = systemctl(*args)
    if done.returncode:
        raise subprocess.CalledProcessError(done.returncode, done.args, done.stdout, done.stderr)
    return done.stdout.strip()


def describe(exc):
    """An error, with what systemctl said (its output is captured, see systemctl())."""
    return str(exc) + (": " + exc.stderr.strip() if getattr(exc, "stderr", None) else "")


def properties(unit):
    return dict(line.split("=", 1) for line in ctl(
        "show", unit, "-p", "ActiveState", "-p", "UnitFileState",
        "-p", "InactiveEnterTimestampMonotonic").splitlines())


def leases():
    lines = ctl("list-units", "--all", "--plain", "--no-legend", "--no-pager",
                "llama-yield-*.service").splitlines()
    return [parts[0] for line in lines if len(parts := line.split()) >= 4 and parts[2] in BUSY]


def placeholder_state():
    # One query per property: ExecStart of a multi-line `bash -c` lease spans several lines.
    fields = ["ActiveState", "ActiveEnterTimestampMonotonic", "RuntimeMaxUSec", "Description", "ExecStart"]
    state = {field: ctl("show", UNIT, "-p", field, "--value") for field in fields}
    if state["ActiveState"] != "active":
        raise OSError("placeholder requires an active GPU lease")
    factors = {"us": 0.000001, "ms": 0.001, "s": 1, "min": 60, "h": 3600, "d": 86400}
    duration = state["RuntimeMaxUSec"]
    parts = re.findall(r"([0-9]+(?:\.[0-9]+)?)(us|ms|min|s|h|d)", duration)
    if not parts or ''.join(number + unit for number, unit in parts) != duration.replace(' ', ''):
        raise OSError("unsupported lease runtime: " + duration)
    runtime = sum(float(number) * factors[unit] for number, unit in parts)
    resume = math.ceil(time.time() + int(state["ActiveEnterTimestampMonotonic"]) / 1_000_000 + runtime - time.monotonic())
    description = state["Description"]
    if description.startswith("GPU lease: "):
        label = description.removeprefix("GPU lease: ")
    else:
        match = re.search(r"path=([^ ;]+)", state["ExecStart"])
        if not match:
            raise OSError("cannot identify leased command")
        label = os.path.basename(match.group(1))
    label = ''.join(c for c in label if c.isprintable())[:80]
    until = time.strftime("%H:%M UTC", time.gmtime(resume))
    message = f"{socket.gethostname()} GPU is in use by {label}; inference resumes when it finishes, by {until} at the latest."
    os.makedirs("/run/llama-yield", mode=0o755, exist_ok=True)
    with open("/run/llama-yield/lease.json.new", "w") as output:
        json.dump({"message": message, "resume_at": resume}, output)
    os.chmod("/run/llama-yield/lease.json.new", 0o644)
    os.replace("/run/llama-yield/lease.json.new", "/run/llama-yield/lease.json")
    return 0


def reconcile_placeholder(args):
    if args.dry_run:
        return
    state = properties(UNIT)["ActiveState"]
    if args.restore or state not in {"active", "activating"}:
        # No ordering edge to the lease: this synchronous stop cannot wait for
        # our own ExecStopPost. Production additionally orders after this unit.
        ctl("stop", PLACEHOLDER)
    elif state == "active" and properties("llama.service")["ActiveState"] not in BUSY:
        ctl("start", PLACEHOLDER)


def recover(args):
    llama, bonsai = properties("llama.service"), properties("bonsai.service")
    if args.assume_llama_disabled:
        llama["UnitFileState"] = "disabled"
    if args.assume_bonsai_active:
        bonsai["ActiveState"] = "active"
    reason = None
    if llama["UnitFileState"] not in {"enabled", "enabled-runtime"}:
        reason = "llama.service is not enabled (intentional stop)"
    elif bonsai["ActiveState"] in BUSY:
        reason = "bonsai.service is active or transitioning"
    elif llama["ActiveState"] in BUSY:
        reason = "llama.service is active or transitioning"
    elif any(unit != UNIT or not args.restore for unit in leases()):
        reason = "a llama-yield lease is active"
    elif not args.restore:
        since = int(llama["InactiveEnterTimestampMonotonic"] or 0) / 1_000_000
        if time.monotonic() - since <= 300:
            reason = "llama.service has been inactive for at most five minutes"
    if reason:
        announce("llama-watchdog: skip: " + reason)
        return 0
    announce("llama-watchdog: " + ("would start" if args.dry_run else "starting") + " llama.service")
    if not args.dry_run:
        ctl("--no-block", "start", "llama.service")
    return 0


def lease_state():
    """(job, ActiveState) of our lease unit; None when systemd cannot say."""
    try:
        return (ctl("show", UNIT, "-p", "Job", "--value"),
                ctl("show", UNIT, "-p", "ActiveState", "--value"))
    except (OSError, subprocess.CalledProcessError):
        return None


def stop_own_lease():
    """Ask systemd to stop our lease, unless its start job is still pending: stopping it then
    cancels the job, and with it the ExecStopPost that restores production (it stayed down until
    the watchdog). Returns whether systemd took the stop; until then the caller asks again. Called
    only while this process holds the lease lock, so the unit by that name is ours."""
    state = lease_state()
    if state is None or state[0] or state[1] != "active":  # unknown, starting, or not running
        return False
    try:
        asked = systemctl("--no-block", "stop", UNIT).returncode == 0
    except OSError:
        return False
    if asked:  # after the request: announcing may take up to a second
        announce("llama-yield: stopping " + UNIT + " for its caller")
    return asked


def restore_after_lease():
    """What the lease's ExecStopPost does, again: a lease whose start job was cancelled (a stop
    by hand while production was stopping) never ran it."""
    args = argparse.Namespace(dry_run=False, restore=True, assume_llama_disabled=False,
                              assume_bonsai_active=False)
    try:
        reconcile_placeholder(args)
        recover(args)
    except (OSError, subprocess.CalledProcessError) as exc:
        announce("llama-yield: restore after the lease failed: " + describe(exc))


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--runtime", type=int, default=3600, help="maximum runtime in seconds (1..86400)")
    ap.add_argument("--label", help="short public lease label (default: command basename)")
    ap.add_argument("--env", action="append", default=[], metavar="NAME=VALUE")
    ap.add_argument("--directory", default=os.getcwd())
    ap.add_argument("--slice", choices=["llama.slice"],
                    help="run the lease in production's CPU reservation (benchmarks)")
    ap.add_argument("--watchdog", action="store_true")
    ap.add_argument("--restore", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--placeholder-state", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--assume-bonsai-active", action="store_true", help="dry-run policy probe only")
    ap.add_argument("--assume-llama-disabled", action="store_true", help="dry-run policy probe only")
    ap.add_argument("command", nargs=argparse.REMAINDER)
    args = ap.parse_args()
    if args.placeholder_state:
        if os.geteuid() != 0:
            ap.error("lease state requires root")
        return placeholder_state()
    if (args.assume_bonsai_active or args.assume_llama_disabled) and not args.dry_run:
        ap.error("state assumptions require --dry-run")
    if args.watchdog or args.restore:
        if not args.dry_run and os.geteuid() != 0:
            ap.error("recovery requires root")
        reconcile_placeholder(args)
        if args.watchdog and not args.dry_run:
            with open("/run/llama-yield.lock", "w") as lock:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    announce("llama-watchdog: skip: a llama-yield caller holds the lease")
                    return 0
                return recover(args)
        return recover(args)
    if args.dry_run:
        ap.error("--dry-run requires --watchdog")
    if args.command[:1] == ["--"]:
        args.command.pop(0)
    if not args.command:
        ap.error("use llama-yield [--runtime SECONDS] [--label LABEL] -- COMMAND [ARG...]")
    if not 1 <= args.runtime <= 86400:
        ap.error("--runtime must be between 1 and 86400 seconds")
    if args.label is not None and (not args.label.strip() or len(args.label) > 80 or not args.label.isprintable()):
        ap.error("--label must be 1..80 printable characters")
    if any(not re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", value) for value in args.env):
        ap.error("--env requires NAME=VALUE")
    environment = {"HOME": "/home/tux", "USER": "tux", "LOGNAME": "tux",
                   "PATH": os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin")}
    environment.update(value.split("=", 1) for value in args.env)
    if os.geteuid() != 0:
        options = ["--runtime", str(args.runtime), "--directory", args.directory]
        if args.label is not None:
            options += ["--label", args.label]
        if args.slice is not None:
            options += ["--slice", args.slice]
        for key, value in environment.items():
            options += ["--env", key + "=" + value]
        os.execv("/usr/bin/sudo", ["sudo", "-n", SELF, *options, "--", *args.command])
    # Held for the caller's lifetime, never by ExecStopPost. A fixed unit name
    # is the second, systemd-atomic exclusion barrier after caller death.
    # A stop of the caller (sudo relays its TERM/INT/HUP) stops the lease, from
    # here, under this lock: no other lease can have taken the unit's name.
    stop = []
    for number in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(number, lambda signum, frame: stop.append(signum))
    refusal = None
    with open("/run/llama-yield.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            refusal = "another llama-yield caller is running"
        else:
            if leases():
                refusal = "another llama-yield lease is active"
            elif properties("bonsai.service")["ActiveState"] in BUSY:
                refusal = "bonsai.service is active; refusing to take its GPU"
            else:
                return lease_under_lock(args, environment, stop)
    ap.error(refusal)  # once the lock is released: a stderr nobody drains must not hold it


def lease_under_lock(args, environment, stop):
    """One lease, while this process holds /run/llama-yield.lock: until its unit has ended,
    then production's restore."""
    cmd = ["/usr/bin/systemd-run", "--unit=" + UNIT, "--uid=tux", "--gid=tux",
           "--description=GPU lease: " + (args.label or os.path.basename(args.command[0])),
           "--collect", "--wait", "--pipe", "--service-type=exec", "--expand-environment=no",
           "--working-directory=" + args.directory,
           "-p", "Conflicts=llama.service", "-p", "After=llama.service",
           "-p", "PropagatesStopTo=" + PLACEHOLDER,
           "-p", "ExecStartPost=+/usr/bin/systemctl --no-block start " + PLACEHOLDER,
           "-p", "ExecStopPost=+" + SELF + " --restore",
           "-p", "RuntimeMaxSec=" + str(args.runtime), "-p", "TimeoutStopSec=15s",
           "-p", "KillMode=control-group"]
    if args.slice is not None:
        cmd += ["--slice=" + args.slice]
    for key, value in environment.items():
        cmd += ["--setenv=" + key + "=" + value]
    if stop:
        return 128 + stop[0]  # stopped before anything was leased
    # The service (including its cleanup) belongs to PID 1, not this caller. Its own
    # session keeps a terminal's signals from systemd-run, which stops waiting on them.
    lease = subprocess.Popen([*cmd, "--", *args.command], start_new_session=True,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    relays = [Relay(lease.stdout.fileno(), 1), Relay(lease.stderr.fileno(), 2)]
    try:
        asked = False
        # Until the unit has ended too: restoring production while it runs (or while systemd
        # cannot say) would stop it, and release its lock to a successor.
        while lease.poll() is None or (state := lease_state()) is None or state[0] or state[1] in BUSY:
            if stop and not asked:
                asked = stop_own_lease()
            time.sleep(0.2)
    finally:
        restore_after_lease()
    for relay in relays:
        relay.finish()
    return lease.returncode


class Relay:
    """Passes what systemd-run (and, through --pipe, the lease) writes to `source` on to our
    `target` without letting a caller that stops reading hold up systemd-run, and with it the
    lease lock (release audits): reading never waits for writing, and what does not fit the
    queue is dropped."""

    def __init__(self, source, target):
        self.source, self.target = source, target
        self.chunks = queue.Queue(maxsize=256)
        self.reader = threading.Thread(target=self.read, daemon=True)
        self.reader.start()
        threading.Thread(target=self.write, daemon=True).start()

    def read(self):
        try:
            while data := os.read(self.source, 65536):
                try:
                    self.chunks.put_nowait(data)
                except queue.Full:
                    pass  # our caller stopped reading
        except OSError:
            pass

    def write(self):
        while True:
            write_all(self.target, self.chunks.get())
            self.chunks.task_done()

    def finish(self):
        """What systemd-run wrote last (its result) reaches our caller, unless either side
        stalls: a second each."""
        self.reader.join(timeout=1)
        with self.chunks.all_tasks_done:
            self.chunks.all_tasks_done.wait_for(lambda: not self.chunks.unfinished_tasks, timeout=1)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, subprocess.CalledProcessError) as exc:
        sys.exit("llama-yield: " + describe(exc))