[Unit]
Description=llama.cpp GGUF API Server
After=network.target

[Service]
Type=simple
User=tux
Group=tux
WorkingDirectory=/srv/models
Environment=HOME=/home/tux
# RADV_DEBUG=nocompute: +3% decode on the R9700 (2026-09-25 bench, round 4).
Environment=RADV_DEBUG=nocompute
# Pinned llama.cpp master f805c57a2 Vulkan build; /opt/llama.cpp-vulkan
# (b11046) is kept for rollback.
ExecStart=/opt/llama.cpp-vulkan-f805c57a2/bin/llama-server \
  --models-dir /srv/models \
  --models-preset /home/tux/.config/llama/models.ini \
  --models-max 1 \
  --models-autoload \
  --host 127.0.0.1 \
  --port 8080
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
