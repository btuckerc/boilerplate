#!/usr/bin/python3
"""Restart production inference when ROCm decode is stuck in its slow state.

On the R9700, a ROCm process decodes at one of two speeds ~22% apart, chosen at
start and occasionally switched mid-process (ROCm/ROCm#6347; ledger M44). A
restart redraws it. Every timer tick this probes decode speed while production
is idle; two slow probes in a row restart llama.service. A ready server whose
/health fails is restarted the same way (startup stalls are bounded by the
unit's TimeoutStartSec instead).

A probe counts only if production was idle before and after it and the probe
was the one request finished meanwhile. A restart happens only under the GPU
lease lock, for the same running invocation that was probed, with llama
enabled, no lease and no Bonsai, at most MAX_RESTARTS per hour; an unreadable
restart record refuses restarts rather than resetting the budget. Each probe is
logged as `speedcheck tps=…` for calibration: `journalctl -u llama-speedcheck`.
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import subprocess
import sys
import time
import tomllib
import urllib.request
from pathlib import Path

SPEC = Path("/etc/nous-inference/serve.toml")
BASE = "http://127.0.0.1:8080"
STATE = Path("/var/lib/llama-speedcheck/restarts.json")
LEASE_LOCK = "/run/llama-yield.lock"  # llama-yield holds it for a lease's whole life
BUSY = {"active", "activating", "deactivating", "reloading", "refreshing"}  # as llama-yield
SETTLE_S = 180          # a fresh server finishes warm-up before it is judged
# This probe (greedy, so DFlash acceptance is identical every run) measured 142-143 t/s in
# all of 6 production processes on 2026-11-06; the slow state would be ~22% lower (~111).
# Threshold at the midpoint. Recalibrate when the engine, model or drafter changes.
SLOW_BELOW_TPS = 127
MAX_RESTARTS = 2
PROMPT = "Write a Python function that parses an ISO 8601 duration string into seconds, with tests."
TOKENS = 512


def log(message: str) -> None:
    print(f"speedcheck {message}", flush=True)


def get(path: str) -> str:
    with urllib.request.urlopen(BASE + path, timeout=10) as r:
        return r.read().decode()


def metric(text: str, name: str) -> float:
    return sum(float(m) for m in re.findall(rf"^{name}(?:{{[^}}]*}})? ([0-9.e+]+)$", text, re.M))


def busy(metrics: str) -> bool:
    return metric(metrics, "vllm:num_requests_running") + metric(metrics, "vllm:num_requests_waiting") > 0


def uncontaminated(before: str, after: str) -> bool:
    """Idle on both sides and only the probe finished: no other request overlapped it."""
    finished = metric(after, "vllm:request_success_total") - metric(before, "vllm:request_success_total")
    return not busy(before) and not busy(after) and finished == 1


def probe(model: str) -> float | None:
    """Decode t/s of a fixed greedy request, or None if other traffic overlapped it."""
    before = get("/metrics")
    if busy(before):
        return None
    body = json.dumps({"model": model, "messages": [{"role": "user", "content": PROMPT}],
                       "max_tokens": TOKENS, "temperature": 0, "ignore_eos": True,
                       "chat_template_kwargs": {"enable_thinking": False}}).encode()
    req = urllib.request.Request(BASE + "/v1/chat/completions", body, {"Content-Type": "application/json"})
    start = time.monotonic()
    with urllib.request.urlopen(req, timeout=120) as r:
        usage = json.load(r)["usage"]
    elapsed = time.monotonic() - start
    if not uncontaminated(before, get("/metrics")):
        return None
    return usage["completion_tokens"] / elapsed


def unit(name: str) -> dict:
    out = subprocess.run(["systemctl", "show", name, "-p", "ActiveState", "-p", "UnitFileState", "-p",
                          "InvocationID", "-p", "ActiveEnterTimestampMonotonic"],
                         capture_output=True, text=True, check=True).stdout
    return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)


def leases() -> list[str]:
    out = subprocess.run(["systemctl", "list-units", "--all", "--plain", "--no-legend", "--no-pager",
                          "llama-yield-*.service"], capture_output=True, text=True, check=True).stdout
    return [p[0] for line in out.splitlines() if len(p := line.split()) >= 4 and p[2] in BUSY]


def restarts_within_hour(now: float) -> list[float]:
    """Recorded restarts of the last hour; ValueError if the record exists but cannot be trusted."""
    try:
        recorded = json.loads(STATE.read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as exc:
        raise ValueError(f"unreadable restart record {STATE}: {exc}") from exc
    if not isinstance(recorded, list) or not all(isinstance(t, (int, float)) for t in recorded):
        raise ValueError(f"malformed restart record {STATE}")
    return [t for t in recorded if now - t < 3600]


def record(restarts: list[float]) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    with open(tmp, "w") as f:
        json.dump(restarts, f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, STATE)


def restart(probed: dict, reason: str) -> int:
    """Restart the probed invocation, unless anything changed or a lease/Bonsai/stop intervenes."""
    with open(LEASE_LOCK, "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log(f"skip restart ({reason}): a llama-yield caller holds the lease lock")
            return 0
        now_state = unit("llama.service")
        why_not = None
        if now_state.get("InvocationID") != probed.get("InvocationID") or now_state.get("ActiveState") != "active":
            why_not = "llama.service changed since the probe"
        elif now_state.get("UnitFileState") not in {"enabled", "enabled-runtime"}:
            why_not = "llama.service is not enabled (intentional stop)"
        elif leases():
            why_not = "a GPU lease is active"
        elif unit("bonsai.service").get("ActiveState") in BUSY:
            why_not = "bonsai.service is active"
        if why_not:
            log(f"skip restart ({reason}): {why_not}")
            return 0
        now = time.time()
        try:
            restarts = restarts_within_hour(now)
        except ValueError as exc:
            log(f"refuse restart ({reason}): {exc}")
            return 1
        if len(restarts) >= MAX_RESTARTS:
            log(f"refuse restart ({reason}): {len(restarts)} restarts in the last hour")
            return 1
        record(restarts + [now])
        log(f"{reason}; restarting llama.service")
        subprocess.run(["systemctl", "--no-block", "try-restart", "llama.service"], check=True)
    return 0


def main() -> int:
    probed = unit("llama.service")
    if probed.get("ActiveState") != "active":
        log("skip: llama.service not active (starting, stopped or leased)")
        return 0
    active_since = int(probed.get("ActiveEnterTimestampMonotonic") or 0) / 1e6
    if time.clock_gettime(time.CLOCK_MONOTONIC) - active_since < SETTLE_S:
        log("skip: llama.service is settling")
        return 0
    try:
        get("/health")
    except OSError as exc:
        return restart(probed, f"ready server fails /health ({exc})")
    model = tomllib.loads(SPEC.read_text())["served_model_name"]
    results = []
    for _ in range(2):
        tps = probe(model)
        if tps is None:
            log("skip: production busy")
            return 0
        results.append(tps)
        log(f"tps={tps:.1f}")
        if tps >= SLOW_BELOW_TPS:
            return 0
    return restart(probed, f"slow state ({', '.join(f'{t:.1f}' for t in results)} < {SLOW_BELOW_TPS} t/s)")


if __name__ == "__main__":
    sys.exit(main())
